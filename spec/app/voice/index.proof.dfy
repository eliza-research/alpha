lemma released_ensures(v: Voice, confirmed: bool, afterMs: int)
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysIdleVoiceHoldsNoMicrophone(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysEngineHeldOnlyWhileTalking(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysTheMicrophoneIsClosedWhileAlphaWorks(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysTheMicrophoneIsAskedForOnlyWhileStarting(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysAQuietConversationHoldsNothing(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysSentTurnsBelongToASession(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysHeardSpeechIsNotSent(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysPlaybackIsTheCurrentTurns(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysMutedMeansTheMicrophoneIsOff(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysAnOpenMicrophoneCanBeShut(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysTheRelayMicrophoneIsClosedWhileAlphaSpeaks(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysSpeakerControlsBelongToTalk(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysAnUnconfirmedStopKeepsVoiceClosed(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysAFailureIsKeptOnlyOnceStopped(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysAtMostTwoQuietRetries(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysNavigationClaimRequiresTalking(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysAClaimBelongsToAnActiveConversation(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysANetworkConversationHasConsent(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysOneVoiceAtATime(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> alwaysTheRecorderKeepsItsRules(released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepPrewarmNeverOpensTheMicrophone(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepEngineHoldIsBalanced(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepThePromptSurvivesHiding(v, "released", released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepATurnIsSentOnlyOnceTheMicrophoneHasClosed(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepPlaybackFollowsTheCurrentTurn(v, released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepReviewKeepsVoiceAndMicrophoneOpen(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepAFundingRefusalEndsVoiceQuietly(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepChangingOutputKeepsTheMicrophone(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepAnUnconfirmedStopIsAskedAgain(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepACallStopsTalk(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepNavigationBelongsToItsTurn(v, released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepVoiceFollowsOnlyItsOwnNavigation(v, "released", released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepAudioLeavesOnlyWithConsent(v, released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepARestartKeepsOnlyWhatIsStored(v, "released", released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepHiddenNativeStopKeepsTheClipWithoutAsking(v, "released", released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepMissingClipOffersNoRetry(v, "released", released(v, confirmed, afterMs).state))
  ensures (inv(v) ==> canReleased(v, confirmed, afterMs) ==> stepDictationFillsItsOwnField(v, released(v, confirmed, afterMs).state, released(v, confirmed, afterMs).out))
{
  if canReleased(v, confirmed, afterMs) && !confirmed {
    assert Release(againAfter(afterMs)) in released(v, confirmed, afterMs).out;
  }
}
