}

lemma ComeBackStepsA(m: Maps, res: Stepped)
  requires inv(m) && canComeBack(m)
  requires res == comeBack(m)
  ensures stepAnotherPlaceForgetsTheOldRoute(m, "comeBack", res.state)
  ensures stepBackLeavesOneMode(m, "comeBack", res.state)
  ensures stepTypingEndsALocate(m, "comeBack", res.state)
  ensures stepTheSameTextIsNotAskedAgain(m, "comeBack", res.state, res.out)
  ensures stepANewSearchIsTheNewest(m, "comeBack", res.state)
  ensures stepAnotherAccountForgetsTheRecentSearches(m, "comeBack", res.state)
  ensures stepAPinIsAPlaceOfTheGlobe(m, res.state, res.out)
  ensures stepAPressPinsOnce(m, "comeBack", res.state, res.out)
  ensures stepAMenuPinsOnlyWithNoFingerDown(m, "comeBack", res.state, res.out)
  ensures stepAHandedQueryNeverInterruptsGuidance(m, "comeBack", res.state)
  ensures stepAResultOpensItsPlace(m, "comeBack", res.state)
  ensures stepNamingThePinSavesNothing(m, "comeBack", res.state, res.out)
  ensures stepASavedPlaceOpensOnlyWhenSaved(m, "comeBack", res.state)
  ensures stepSavedPlacesAreKeptOnThePhone(m, "comeBack", res.state, res.out)
  ensures stepThePreviousListIsTakenOnlyByAnUnusedList(m, "comeBack", res.state)
  ensures stepAnUnreadableListIsNeverWrittenOver(m, res.state, res.out)
  ensures stepAChangeIsToldOnlyOnceItReadsBack(m, "comeBack", res.state)
  ensures stepOnlyThePlaceShownIsHandedOn(m, res.state, res.out)
  ensures stepACopyIsToldOnlyOfACopyAsked(m, "comeBack", res.state)
  ensures stepDetailsAreForThePlaceShown(m, res.state, res.out)
  ensures stepDirectionsOpenOnlyFromACard(m, "comeBack", res.state)
  ensures stepRoutesAreForThePlaceShown(m, res.state, res.out)
  ensures stepASwapExchangesTheEnds(m, "comeBack", res.state)
  ensures stepGuidanceStartsOnTheRouteShown(m, "comeBack", res.state)
  ensures stepArrivalAwayIsToldOnce(m, "comeBack", res.state, res.out)
  ensures stepScreenOffOnlyForThisJourney(m, res.state, res.out)
  ensures stepEndKeepsTheRoute(m, "comeBack", res.state)
{
  NoArrival(m, "comeBack", res.state, res.out);
}

