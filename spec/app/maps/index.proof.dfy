    hide *;
    reveal useMyLocation;
    var res := useMyLocation(m);
    if reusesTheFix(m) {
      assert res == Stepped(m, []);
      UseMyLocationB0C0(m, res);
      UseMyLocationB0C1(m, res);
      UseMyLocationB0C2(m, res);
    }
    else if kit__permission_allows(m.link.location) {
      assert res == Stepped(m.(link := app__maps__connection_locate(app__maps__connection_stopLocating(m.link), app__maps__connection_Locator.Finder), quiet := false, missedFix := false), ((if m.link.locator.Finder? then [Effect.StopLocation] else []) + [StartLocation(app__maps__connection_locate(app__maps__connection_stopLocating(m.link), app__maps__connection_Locator.Finder).session, true)]));
      UseMyLocationB1C0(m, res);
      UseMyLocationB1C1(m, res);
      UseMyLocationB1C2(m, res);
    }
    else if app__maps__connection_canAskLocation(m.link) {
      assert res == Stepped(m.(link := app__maps__connection_askLocation(m.link), owedLocate := true, missedFix := false), [Effect.AskLocation]);
      UseMyLocationB2C0(m, res);
      UseMyLocationB2C1(m, res);
      UseMyLocationB2C2(m, res);
    }
    else if app__maps__connection_canDisclose(m.link) {
      assert res == Stepped(m.(explaining := true), []);
      UseMyLocationB4C0(m, res);
      UseMyLocationB4C1(m, res);
      UseMyLocationB4C2(m, res);
    }
    else {
      assert res == Stepped(m, [Effect.OpenLocationSettings]);
      UseMyLocationB3C0(m, res);
      UseMyLocationB3C1(m, res);
      UseMyLocationB3C2(m, res);
    }
  }
}

