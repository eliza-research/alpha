{
  if inv(m) && canChooseTravel(m, travel) {
    var res := chooseTravel(m, travel);
    var t := app__maps__navigation_chooseTravel(m.trip, travel);
    if t.origin.Unset? {
      assert res == Stepped(m.(trip := t), []);
      ChooseTravelB0C0(m, travel, res);
      ChooseTravelB0C1(m, travel, res);
      ChooseTravelB0C2(m, travel, res);
    } else {
      var p := app__maps__navigation_plan(t, t.origin);
      assert res == Stepped(m.(trip := p), [asked(m, p, m.place)]);
      ChooseTravelB1C0(m, travel, res);
      ChooseTravelB1C1(m, travel, res);
      ChooseTravelB1C2(m, travel, res);
    }
  }
}

