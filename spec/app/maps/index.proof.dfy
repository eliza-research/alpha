lemma StepArrivalFilter(before: Maps, via: string, after: Maps, out: seq<Effect>)
  ensures stepArrivalAwayIsToldOnce(before, via, after, out) ==
    ((|ProofLib.Filter((e: Effect) => e.TellArrival?, out)| <= 1) && !((exists e :: e in out && !((if e.TellArrival? then ((((via == "locationFix") && before.trip.away) && after.trip.guidance.Arrived?) && (e.place == before.place)) else true)))))
{
}

lemma RecentFilter(m: Maps)
  ensures alwaysRecentSearchesAreFiveAtMost(m) ==
    (((|m.recent| <= 5) && !(("" in m.recent))) && !((exists q :: q in m.recent && !((|ProofLib.Filter((r: string) => (r == q), m.recent)| == 1)))))
{
}

lemma RememberedFilter(recent: seq<string>, query: string)
  ensures remembered(recent, query) ==
    (var local_1 := ([query] + ProofLib.Filter((q: string) => (q != query), recent));
     if (|local_1| > 5) then (if ((0 <= 5) && (5 < |local_1|)) then (local_1[0..5] + local_1[(5 + 1)..]) else local_1) else local_1)
{
}

lemma FilterLen<T>(p: T -> bool, xs: seq<T>)
  ensures |ProofLib.Filter(p, xs)| <= |xs|
  decreases |xs|
{
  if |xs| == 0 {
    ProofLib.FilterNil(p, xs);
  } else {
    ProofLib.FilterCons(p, xs);
    FilterLen(p, xs[1..]);
  }
}

lemma NoArrival(before: Maps, via: string, after: Maps, out: seq<Effect>)
  requires forall e :: e in out ==> !e.TellArrival?
  ensures stepArrivalAwayIsToldOnce(before, via, after, out)
{
  StepArrivalFilter(before, via, after, out);
  ProofLib.FilterNone((e: Effect) => e.TellArrival?, out);
}

lemma ArrivalAtMostOne(before: Maps, via: string, after: Maps, out: seq<Effect>)
  requires |out| <= 2
  requires |out| == 2 ==> !out[0].TellArrival?
  requires forall e :: e in out && e.TellArrival? ==> via == "locationFix" && before.trip.away && after.trip.guidance.Arrived? && e.place == before.place
  ensures stepArrivalAwayIsToldOnce(before, via, after, out)
{
  StepArrivalFilter(before, via, after, out);
  var p := (e: Effect) => e.TellArrival?;
  if |out| == 0 {
    ProofLib.FilterNil(p, out);
  } else if |out| == 1 {
    if p(out[0]) {
      ProofLib.FilterOne(p, out, 0);
    } else {
      ProofLib.FilterNone(p, out);
    }
  } else {
    if p(out[1]) {
      ProofLib.FilterOne(p, out, 1);
    } else {
      ProofLib.FilterNone(p, out);
    }
  }
}

lemma RememberedWellFormed(m: Maps, after: Maps, query: string)
  requires alwaysRecentSearchesAreFiveAtMost(m)
  requires query != ""
  requires after.recent == remembered(m.recent, query)
  ensures alwaysRecentSearchesAreFiveAtMost(after)
{
  RecentFilter(m);
  RecentFilter(after);
  RememberedFilter(m.recent, query);
  var recent := m.recent;
  var id := (s: string) => s;
  forall i, j | 0 <= i < |recent| && 0 <= j < |recent| && i != j
    ensures id(recent[i]) != id(recent[j])
  {
    assert recent[i] in recent;
    ProofLib.FilterCountOneIffUnique((r: string) => (r == recent[i]), recent, id, i);
  }
  assert ProofLib.DistinctBy(recent, id);
  var neq := (q: string) => (q != query);
  var tail := ProofLib.Filter(neq, recent);
  FilterLen(neq, recent);
  ProofLib.FilterKeepsDistinctBy(neq, recent, id);
  ProofLib.FilterMember(neq, recent, query);
  ProofLib.FilterMember(neq, recent, "");
  var kept := [query] + tail;
  assert |kept| <= 6;
  assert !("" in kept);
  forall i, j | 0 <= i < j < |kept|
    ensures kept[i] != kept[j]
  {
    if i == 0 {
      assert kept[j] == tail[j - 1];
      assert kept[j] in tail;
    } else {
      assert kept[i] == tail[i - 1] && kept[j] == tail[j - 1];
      assert id(tail[i - 1]) != id(tail[j - 1]);
    }
  }
  assert ProofLib.Distinct(kept);
  var res := after.recent;
  if |kept| > 5 {
    assert |kept| == 6;
    assert kept[6..] == [];
    assert res == kept[..5];
  } else {
    assert res == kept;
  }
  assert |res| <= 5;
  assert !("" in res);
  assert ProofLib.Distinct(res);
  forall q | q in res
    ensures |ProofLib.Filter((r: string) => (r == q), res)| == 1
  {
    ProofLib.FilterDistinctCountOne((r: string) => (r == q), res, q);
  }
}

