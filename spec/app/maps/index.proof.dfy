  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepNothingIsAskedWhileAWaitHolds(m, "search", search(m, query, chars).state, search(m, query, chars).out))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepTheDisclosureClosesWithTheVisit(m, "search", search(m, query, chars).state))
