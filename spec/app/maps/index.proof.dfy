  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepReturnGoesToTheEventMapsCameFrom(m, search(m, query, chars).state, search(m, query, chars).out))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepTheRevisionChangesOnlyWithWhatIsShown(m, search(m, query, chars).state))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepTheAgentNeverMakesAndroidAsk(m, "search", search(m, query, chars).state, search(m, query, chars).out))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepARerouteNeedsAFixThatGuides(m, "search", search(m, query, chars).state))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepEachReadIsSentOnce(m, search(m, query, chars).state, search(m, query, chars).out))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepAChangeVoidsTheQuestion(m, search(m, query, chars).state))
  ensures (inv(m) ==> canSearch(m, query, chars) ==> stepNoPlaceToTheAgentWithoutApproval(m, "search", search(m, query, chars).state, search(m, query, chars).out))
{
  if inv(m) && canSearch(m, query, chars) {
    var res := search(m, query, chars);
    NoArrival(m, "search", res.state, res.out);
    if query != "" && !answering(m, query) {
      RememberedWellFormed(m, res.state, query);
    }
  }
}

