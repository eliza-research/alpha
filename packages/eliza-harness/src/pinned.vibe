import { checkout, ready } from "./checkout.ts"
import { packCheckout, packRoot, stagePackEntry, type Pack, type ProductPackage } from "./pack.ts"

/** The pinned eliza checkout is not built where `eliza.lock.json` says it is: `pnpm eliza` builds it. */
export error NotBuilt { commit: string; dir: string }

/** The private clone the agent pack is built from could not be made with the plugins it carries, for `reason`. */
export error PackNotPrepared { commit: string; dir: string; reason: string }

/** The commit `eliza.lock.json` pins and the directory its build is in, for code that reads the built packages; it builds nothing. */
export effect function pinnedCheckout() {
  const at = checkout()
  const built = try Effect.try({ try: () => ready(at), catch: () => new NotBuilt({ commit: at.commit, dir: at.root }) })
  if (!built) throw new NotBuilt({ commit: at.commit, dir: at.root })
  return { commit: at.commit, dir: at.root }
}

/** The pack's private clone of the pinned eliza with `plugins` built, made where it is not yet, and its entry package written with `source`. */
export effect function pinnedPack(plugins: readonly string[], source: string, product?: ProductPackage) {
  const { commit } = checkout()
  const failed = (cause: unknown) => new PackNotPrepared({ commit, dir: packRoot(commit), reason: String(cause) })
  const pack: Pack = try tryPromise({ try: () => packCheckout(plugins), catch: failed })
  const entry = try Effect.try({ try: () => stagePackEntry(pack, source, product), catch: failed })
  return { commit: pack.commit, dir: pack.root, entry, packages: pack.packages }
}
