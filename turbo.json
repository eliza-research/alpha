{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["QUINT_HOME"],
  "globalDependencies": [
    ".nvmrc",
    "eliza.lock.json",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    "!vibestack/selftest.ts",
    "!vibestack/remote-cache.ts",
    "!vibestack/proof/lib.dfy",
    "!vibestack/{testing,stories,design}/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "//#no-bun": {
      "cache": false
    },
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "env": [
        "ELIZA_DEV_ALLOW_TEST_MOCKS",
        "ALPHA_FAKES"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen": {
      "env": ["!VITE_*"],
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "apps/*/spec/**",
        "packages/*/package.json",
        "packages/*/spec/**",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!vibestack/fixtures/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "*",
        "!.git",
        "!*.md",
        "vibestack/**",
        "!vibestack/{examples,studio}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "spec/**",
        "!spec/**/*.md",
        "src/**",
        "test/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:a": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:b": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:rest": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        ".gitignore",
        "eslint.config.js",
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "patches/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:docs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.claude/worktrees/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**"
      ],
      "outputs": []
    },
    "//#selftest:examples": {
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/{docs,tools}.ts",
        "!vibestack/{studio,fixtures}/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": [
        "vibestack/examples/*/.spec-cache/tests-*.json.{gz,zst}"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/agent#build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_ROOT$/eliza.lock.json",
        "$TURBO_ROOT$/packages/deployment/deployments.json",
        "$TURBO_ROOT$/packages/eliza-harness/src/**",
        "host/**",
        "src/**",
        "gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@repo/agent#test": {
      "dependsOn": [
        "@repo/agent#build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/app#build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eliza.lock.json"
      ],
      "env": [
        "ELIZA_DEV_ALLOW_TEST_MOCKS",
        "ALPHA_FAKES"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "@repo/cloud#build:pages": {
      "dependsOn": ["@repo/app#build:slack-web"],
      "inputs": ["pack-pages.ts", "package.json", "$TURBO_ROOT$/eliza.lock.json"],
      "outputs": [".cache/public-pages/**"]
    },
    "@repo/cloud#build": {
      "dependsOn": ["gen", "//#gen", "^build", "build:pages"],
      "outputs": ["dist/**"]
    },
    "@repo/cloud#test": {
      "dependsOn": ["@repo/cloud#build"],
      "outputs": [".cache/test-result-*.json"],
      "env": ["VIBESTACK_QUINT_EVALUATOR"]
    },
    "@repo/app#build:slack-web": {
      "dependsOn": ["//#gen", "@repo/deployment#build", "@repo/design-system#build", "@repo/eliza-harness#build", "@repo/ui#gen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eliza.lock.json"],
      "outputs": [".cache/hosted-slack/**"]
    },
    "@repo/app#typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eliza.lock.json"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "@repo/app#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "@repo/agent#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eliza.lock.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/app#test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eliza.lock.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/app#dev": {
      "dependsOn": [
        "@repo/agent#build"
      ],
      "cache": false,
      "persistent": true
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test",
        "@repo/app#build",
        "@repo/app#typecheck",
        "@repo/app#test",
        "@repo/app#test:browser",
        "@repo/eliza-harness#build",
        "@repo/eliza-harness#typecheck",
        "@repo/eliza-harness#test",
        "@repo/agent#build",
        "@repo/agent#typecheck",
        "@repo/agent#test",
        "@repo/deployment#build",
        "@repo/deployment#typecheck",
        "@repo/deployment#test",
        "@repo/cloud#build",
        "@repo/cloud#typecheck",
        "@repo/cloud#test",
        "@repo/site#build",
        "@repo/site#typecheck",
        "@repo/site#test"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/app#typecheck",
        "@repo/eliza-harness#typecheck",
        "@repo/agent#typecheck",
        "@repo/deployment#typecheck",
        "@repo/cloud#typecheck",
        "vibestack-studio#typecheck",
        "@repo/site#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "!vibestack/{examples,fixtures}/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "dependsOn": ["//#gen", "@repo/cloud#build", "@repo/design-system#build", "@repo/eliza-harness#build", "@repo/ui#gen", "vibestack-studio#gen"],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "eliza.lock.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#gen": {
      "env": ["!VITE_*"],
      "outputs": ["gen/**", "generated/**"]
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/fixtures/**",
        "$TURBO_ROOT$/vibestack/proof/lib.dfy",
        "!$TURBO_ROOT$/vibestack/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "styles.css",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    },
    "@repo/cli#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
