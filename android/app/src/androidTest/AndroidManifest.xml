<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <instrumentation android:name="androidx.test.runner.AndroidJUnitRunner"
    android:targetPackage="ai.alphacompute.alphaphone" />
  <instrumentation android:name="ai.alphacompute.alphaphone.WorkflowNoticeProcessRunner"
    android:targetPackage="ai.alphacompute.alphaphone"
    android:targetProcesses="ai.alphacompute.alphaphone:workflowNoticeTest" />
  <application>
    <activity android:name="ai.alphacompute.alphaphone.ShareReceiverActivity"
      android:exported="true" android:label="Alpha share verification">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/jpeg" />
      </intent-filter>
    </activity>
    <!-- Autofill campaign only (PasswordVaultFillInstrumentedTest): a native sign-in form in the
         test package, which has its own package name and the instrumentation signer. -->
    <activity android:name="ai.alphacompute.alphaphone.PasswordFillFixtureActivity"
      android:exported="true" android:label="Alpha autofill fixture" />
  </application>
</manifest>
