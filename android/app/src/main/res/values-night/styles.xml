<resources>
 <!-- Dark system: start on the renderer's dark background (config/alpha-product.json dark.bg)
      so a cold start does not flash white before the web view paints. -->
 <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#0000FF</item>
  <item name="android:windowLightStatusBar">false</item><item name="android:windowLightNavigationBar">false</item>
  <item name="android:statusBarColor">#000000</item><item name="android:navigationBarColor">#000000</item>
  <item name="android:windowDrawsSystemBarBackgrounds">true</item>
  <item name="android:windowBackground">#000000</item>
 </style>
 <style name="AppTheme.Launch" parent="Theme.SplashScreen">
  <item name="windowSplashScreenBackground">#000000</item><item name="windowSplashScreenAnimatedIcon">@drawable/app_icon</item>
  <item name="postSplashScreenTheme">@style/AppTheme</item>
 </style>
</resources>
