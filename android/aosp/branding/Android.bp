package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

runtime_resource_overlay {
    name: "AlphaFrameworkOverlay",
    manifest: "manifests/AlphaFrameworkOverlay.xml",
    resource_dirs: ["overlay/frameworks/base/core/res/res"],
    product_specific: true,
    certificate: "platform",
    sdk_version: "current",
}

