+            if (!ALPHA_ASSIST.equals(getAssistInfo())
+                    || mSelectedUserInteractor.getSelectedUserId() != mUserTracker.getUserId()
+                    || keyguard.isKeyguardLocked() || keyguard.isDeviceLocked()
+                    || !users.isUserUnlocked()) {
