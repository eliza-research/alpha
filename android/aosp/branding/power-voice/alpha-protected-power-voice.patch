+    private static boolean alphaPowerComponentEnabled(
+            PackageManager pm, ActivityInfo activity, ComponentName expected) {
+        if (!expected.getPackageName().equals(activity.packageName)
+                || !expected.getClassName().equals(activity.name)
+                || activity.targetActivity != null || !activity.exported || !activity.enabled
+                || activity.applicationInfo == null || !activity.applicationInfo.enabled) {
+            return false;
+        }
+        final int componentState = pm.getComponentEnabledSetting(expected);
+        final int appState = pm.getApplicationEnabledSetting(expected.getPackageName());
+        return (componentState == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                || componentState == PackageManager.COMPONENT_ENABLED_STATE_ENABLED)
+                && (appState == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                || appState == PackageManager.COMPONENT_ENABLED_STATE_ENABLED);
     }
 
