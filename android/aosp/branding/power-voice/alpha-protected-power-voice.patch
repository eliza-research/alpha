+            if (args == null || args.getInt(INVOCATION_TYPE_KEY, INVOCATION_TYPE_UNKNOWN)
+                    != INVOCATION_TYPE_POWER_BUTTON_LONG_PRESS
+                    || !ALPHA_ASSIST.equals(assistComponent)
