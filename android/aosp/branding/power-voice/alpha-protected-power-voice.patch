+                    || !mDeviceProvisionedController.isDeviceProvisioned()
+                    || !mDeviceProvisionedController.isCurrentUserSetup()
+                    || mSelectedUserInteractor.getSelectedUserId() != mUserTracker.getUserId()
+                    || context.checkSelfPermission(ALPHA_POWER_PERMISSION)
+                            != PackageManager.PERMISSION_GRANTED) {
+                return false;
+            }
+            final UserHandle user = mUserTracker.getUserHandle();
+            final Context userContext = context.createContextAsUser(user, 0);
+            final KeyguardManager keyguard = userContext.getSystemService(KeyguardManager.class);
+            final UserManager users = userContext.getSystemService(UserManager.class);
+            if (keyguard == null || users == null || keyguard.isKeyguardLocked()
+                    || keyguard.isDeviceLocked() || !users.isUserUnlocked()) {
+                return false;
+            }
+            final PackageManager pm = userContext.getPackageManager();
+            final ActivityInfo selected = pm.getActivityInfo(ALPHA_ASSIST, 0);
+            final ActivityInfo child = pm.getActivityInfo(ALPHA_POWER_VOICE, 0);
+            if (!alphaPowerComponentEnabled(pm, selected, ALPHA_ASSIST)
+                    || !alphaPowerComponentEnabled(pm, child, ALPHA_POWER_VOICE)
+                    || !ALPHA_POWER_PERMISSION.equals(child.permission)
+                    || selected.applicationInfo.uid != child.applicationInfo.uid
+                    || pm.checkSignatures(selected.packageName, child.packageName)
+                            != PackageManager.SIGNATURE_MATCH) {
+                return false;
+            }
+            // Drop all caller extras, URI, assist-context and origin hints. The explicit
+            // permission-protected component is the app's internally derived Power origin.
+            final Intent intent = new Intent(Intent.ACTION_ASSIST)
+                    .setComponent(ALPHA_POWER_VOICE)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+            final ActivityOptions options = ActivityOptions.makeCustomAnimation(context,
+                    R.anim.search_launch_enter, R.anim.search_launch_exit);
