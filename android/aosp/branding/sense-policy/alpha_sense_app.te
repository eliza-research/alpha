# Private system_ext domain for Alpha's separately packaged, offline listener.
type alpha_sense_app, domain, coredomain;
app_domain(alpha_sense_app)

type alpha_sense_app_data_file, file_type, data_file_type, core_data_file_type, app_data_file_type;
allow alpha_sense_app alpha_sense_app_data_file:dir create_dir_perms;
allow alpha_sense_app alpha_sense_app_data_file:file create_file_perms;

# App lifecycle, native consent UI, package checks and foreground notifications.
allow alpha_sense_app {
    accessibility_service
    activity_service
    activity_task_service
    content_service
    display_service
    input_method_service
    input_service
    notification_service
    package_service
    permissionmgr_service
    power_service
    surfaceflinger_service
    user_service
    window_service
}:service_manager find;

# AudioRecord/AudioPolicy and their permission, metrics and AppOps checks.
allow alpha_sense_app {
    appops_service
    audio_service
    audioserver_service
    mediametrics_service
    permission_service
    permission_checker_service
}:service_manager find;

# Keep the app domain outside the network socket and port grants.
neverallow alpha_sense_app self:{ tcp_socket udp_socket rawip_socket icmp_socket packet_socket } {
    create connect bind listen accept
};
