{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "alphaphone-production",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "exec",
        "vite",
        "--",
        "preview",
        "--host",
        "127.0.0.1",
        "--port",
        "4610",
        "--strictPort"
      ],
      "port": 4610
    },
    {
      "name": "alphaphone-dev-agent",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4611"
      ],
      "port": 4611
    },
    {
      "name": "alphaphone-dev-ui",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:ui",
        "--",
        "--port",
        "5420",
        "--strictPort"
      ],
      "port": 5420
    }
  ]
}
