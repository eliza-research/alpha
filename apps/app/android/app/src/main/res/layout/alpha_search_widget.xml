<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alpha_search_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alpha_search_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        android:src="@drawable/alpha_widget_dot" />

    <TextView
        android:id="@+id/alpha_search_widget_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/alpha_search_widget_prompt"
        android:textColor="@color/alpha_widget_muted"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/alpha_search_widget_mic"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/alpha_search_widget_voice_desc"
        android:padding="8dp"
        android:src="@drawable/alpha_widget_mic" />
</LinearLayout>
