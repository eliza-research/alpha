// spec/app/maps/index.md, "The screen holds its connection, its trip, the search, the place on the card, the directions sheet, the saved places, the Calendar event it came from, the agent's question and the agent's last read"
import type { CloudClient } from "../platform/index.vibe"
import { fresh } from "../runtime/index.vibe"
import { createShelf } from "../runtime/index.vibe"
import type { Point } from "./geometry.ts"

/** What Cloud answered about the account's Maps: its provider, coverage, tiles and credits. */
export type Coverage = Awaited<ReturnType<CloudClient["mapsCapabilities"]>>

/** A place of the map beyond its number, which the spec never holds: what the provider said of it, or a dropped pin. */
export interface Spot {
  readonly name: string
  readonly category: string
  readonly at: Point
  readonly providerId: string
  /** The provider's id of the place, or none for a pin. */
  readonly id: string
  readonly google: boolean
  readonly address?: string
  readonly phone?: string
  readonly website?: string
  readonly hours?: string
}

/** One turn of a route: what to do, where, and how far it runs. */
export interface Turn {
  readonly instruction: string
  readonly at: Point
  readonly meters: number
  /** The manoeuvre the provider names for the turn, drawn as its icon; none goes straight on. */
  readonly maneuver?: string
}

/** A route beyond its ticket: its length, time, line and turns. */
export interface Way {
  readonly meters: number
  readonly seconds: number
  readonly line: readonly Point[]
  readonly turns: readonly Turn[]
  /** Whether the provider timed the route with live traffic. */
  readonly live?: boolean
}

/** Where the phone was last seen, and whether the fix was only approximate. */
export interface Here {
  readonly at: Point
  readonly accuracy: number
  readonly approximate: boolean
}

/** A view of the map: its bounds in degrees and its whole zoom. */
export interface View {
  readonly north: number
  readonly south: number
  readonly east: number
  readonly west: number
  readonly zoom: number
}

/** What Maps last learned of the world, by the numbers its machine keeps. */
export interface Seen {
  readonly spots: ReadonlyMap<number, Spot>
  readonly results: ReadonlyArray<number>
  /** The places the newest search for a starting point found, in the provider's order. */
  readonly origins: ReadonlyArray<number>
  readonly ways: ReadonlyMap<number, ReadonlyArray<Way>>
  readonly here: Here | undefined
  /** Each coverage read's answer, by the ticket of the read: the machine decides which one is in force. */
  readonly coverages: ReadonlyMap<number, Coverage>
  /** The view the camera last settled on, and the area the last copyright request covers. */
  readonly view: View | undefined
  readonly credited: View | undefined
  /** How many times "Use my location" asked the map to show the phone. */
  readonly showings: number
  /** Whether Cloud Maps refused tiles or requests because the account has insufficient credits. */
  readonly insufficientCredits: boolean
}

const maxCached = 12
const maxCachedTiles = 4

const empty = (): Seen => ({
  spots: new Map(), results: [], origins: [], ways: new Map(), here: undefined, coverages: new Map(), view: undefined, credited: undefined, showings: 0, insufficientCredits: false,
})

// spec/app/maps/places.md, "A saved place keeps its name, its coordinates and the provider's identity of it, and nothing else"
/** Strip provider-supplied place details, retaining only the place identity, name, category and coordinates. */
export function withoutDetails(spot: Spot): Spot {
  const { address: _address, phone: _phone, website: _website, hours: _hours, ...kept } = spot
  return kept
}

function keyOf(spot: Spot): string {
  return spot.id !== "" && spot.providerId !== "" ? `${spot.providerId}/${spot.id}` : `@${spot.at.lat},${spot.at.lng}`
}

function mergeSpot(prior: Spot | undefined, next: Spot): Spot {
  if (prior === undefined) return next
  return {
    ...prior,
    ...next,
    ...(next.address !== undefined ? { address: next.address } : prior.address !== undefined ? { address: prior.address } : {}),
    ...(next.phone !== undefined ? { phone: next.phone } : prior.phone !== undefined ? { phone: prior.phone } : {}),
    ...(next.website !== undefined ? { website: next.website } : prior.website !== undefined ? { website: prior.website } : {}),
    ...(next.hours !== undefined ? { hours: next.hours } : prior.hours !== undefined ? { hours: prior.hours } : {}),
  }
}

function boundedMap<K, V>(prior: ReadonlyMap<K, V>, key: K, value: V, limit: number): Map<K, V> {
  const next = new Map(prior)
  next.delete(key)
  next.set(key, value)
  while (next.size > limit) {
    const oldest = next.keys().next()
    if (oldest.done) break
    next.delete(oldest.value)
  }
  return next
}

/** Scoped Maps atlas service, reset cleanly whenever its runtime scope closes. */
export service Atlas {
  readonly snapshot: () => Seen
  readonly subscribe: (listener: () => void) => () => void
  readonly numberOf: (spot: Spot) => number
  readonly numberAll: (spots: ReadonlyArray<Spot>) => number[]
  readonly spot: (place: number) => Spot | undefined
  readonly found: (places: ReadonlyArray<number>) => void
  readonly originsFound: (places: ReadonlyArray<number>) => void
  readonly routed: (ticket: number, ways: ReadonlyArray<Way>) => void
  readonly way: (ticket: number, chosen: number) => Way | undefined
  readonly located: (here: Here) => void
  readonly showMe: () => void
  readonly covered: (ticket: number, coverage: Coverage) => void
  readonly coverage: (ticket: number) => Coverage | undefined
  readonly setInsufficientCredits: (needed: boolean) => void
  readonly putTile: (key: string, bytes: Uint8Array) => void
  readonly takeTile: (key: string) => Uint8Array | undefined
  readonly viewed: (view: View) => void
  readonly creditedFor: (credited: View) => void
  readonly accountOf: (id: string) => number
  readonly handleOf: (place: number) => string
  readonly forgetDetails: () => void
  readonly forget: () => void
}

/**
 * The world around the Maps machine, scoped to one runtime: the places, routes, position and tiles its numbers stand
 * for. The shell writes it before telling the machine, and the screen reads it with `useSyncExternalStore`.
 */
export type AtlasStore = Effect.Success<typeof Atlas>

/** Creates an isolated `AtlasStore` backed by a `Shelf<Seen>`. */
function createAtlas(): AtlasStore & { readonly reset: () => void } {
  const shelf = createShelf<Seen>(empty(), { reset: empty })
  const accounts = new Map<string, number>()
  const byProvider = new Map<string, number>()
  const handles = new Map<number, string>()
  const tiles = new Map<string, Uint8Array>()
  let next = 1

  const change = (patch: Partial<Seen>): void => {
    shelf.update((current) => ({ ...current, ...patch }))
  }

  return {
    snapshot: shelf.snapshot,
    subscribe: shelf.subscribe,
    // spec/app/maps/places.md, "A saved place keeps its name, its coordinates and the provider's identity of it, and nothing else"
    numberOf(spot: Spot): number {
      const key = keyOf(spot)
      const number = byProvider.get(key) ?? next++
      byProvider.set(key, number)
      shelf.update((current) => ({ ...current, spots: new Map(current.spots).set(number, mergeSpot(current.spots.get(number), spot)) }))
      return number
    },
    numberAll(spots: ReadonlyArray<Spot>): number[] {
      if (spots.length === 0) return []
      const numbers: number[] = []
      shelf.update((current) => {
        const nextSpots = new Map(current.spots)
        for (const spot of spots) {
          const key = keyOf(spot)
          const number = byProvider.get(key) ?? next++
          byProvider.set(key, number)
          nextSpots.set(number, mergeSpot(nextSpots.get(number), spot))
          numbers.push(number)
        }
        return { ...current, spots: nextSpots }
      })
      return numbers
    },
    spot: (place: number): Spot | undefined => shelf.get().spots.get(place),
    found(places: ReadonlyArray<number>): void {
      change({ results: places })
    },
    originsFound(places: ReadonlyArray<number>): void {
      change({ origins: places })
    },
    routed(ticket: number, ways: ReadonlyArray<Way>): void {
      shelf.update((current) => ({ ...current, ways: boundedMap(current.ways, ticket, ways, maxCached) }))
    },
    way: (ticket: number, chosen: number): Way | undefined => shelf.get().ways.get(ticket)?.[chosen],
    located(here: Here): void {
      change({ here })
    },
    showMe(): void {
      shelf.update((current) => ({ ...current, showings: current.showings + 1 }))
    },
    covered(ticket: number, coverage: Coverage): void {
      shelf.update((current) => ({ ...current, coverages: boundedMap(current.coverages, ticket, coverage, maxCached) }))
    },
    coverage: (ticket: number): Coverage | undefined => shelf.get().coverages.get(ticket),
    setInsufficientCredits(needed: boolean): void {
      if (shelf.get().insufficientCredits !== needed) change({ insufficientCredits: needed })
    },
    putTile(key: string, bytes: Uint8Array): void {
      tiles.delete(key)
      while (tiles.size >= maxCachedTiles) {
        const oldest = tiles.keys().next()
        if (oldest.done) break
        tiles.delete(oldest.value)
      }
      tiles.set(key, bytes)
    },
    takeTile(key: string): Uint8Array | undefined {
      const found = tiles.get(key)
      if (found !== undefined) tiles.delete(key)
      return found
    },
    viewed(view: View): void {
      change({ view })
    },
    creditedFor(credited: View): void {
      change({ credited })
    },
    accountOf(id: string): number {
      const known = accounts.get(id) ?? accounts.size + 1
      accounts.set(id, known)
      return known
    },
    handleOf(place: number): string {
      const known = handles.get(place)
      if (known !== undefined) return known
      const made = `maps_${fresh()}`
      handles.set(place, made)
      return made
    },
    // spec/app/maps/index.md, "A place's details are read from its provider once it is on the card, and shown only while it still is"
    forgetDetails(): void {
      shelf.update((current) => ({
        ...current,
        spots: new Map([...current.spots].map(([place, spot]) => [place, withoutDetails(spot)])),
      }))
    },
    // spec/app/maps/places.md, "A saved place keeps its name, its coordinates and the provider's identity of it, and nothing else"
    forget(): void {
      byProvider.clear()
      handles.clear()
      tiles.clear()
      shelf.update((current) => {
        const kept = new Map<number, Spot>()
        for (const [place, spot] of current.spots) {
          if (spot.google) continue
          const stripped = withoutDetails(spot)
          kept.set(place, stripped)
          byProvider.set(keyOf(stripped), place)
        }
        return { ...empty(), spots: kept, here: current.here, view: current.view, showings: current.showings }
      })
    },
    reset(): void {
      accounts.clear()
      byProvider.clear()
      handles.clear()
      tiles.clear()
      next = 1
      shelf.reset()
    },
  }
}

let active: AtlasStore = createAtlas()

/** The currently mounted runtime's atlas, for callers outside a scoped `Atlas` context. */
export const atlas: AtlasStore = {
  snapshot: () => active.snapshot(),
  subscribe: (listener) => active.subscribe(listener),
  numberOf: (spot) => active.numberOf(spot),
  numberAll: (spots) => active.numberAll(spots),
  spot: (place) => active.spot(place),
  found: (places) => active.found(places),
  originsFound: (places) => active.originsFound(places),
  routed: (ticket, ways) => active.routed(ticket, ways),
  way: (ticket, chosen) => active.way(ticket, chosen),
  located: (here) => active.located(here),
  showMe: () => active.showMe(),
  covered: (ticket, coverage) => active.covered(ticket, coverage),
  coverage: (ticket) => active.coverage(ticket),
  setInsufficientCredits: (needed) => active.setInsufficientCredits(needed),
  putTile: (key, bytes) => active.putTile(key, bytes),
  takeTile: (key) => active.takeTile(key),
  viewed: (view) => active.viewed(view),
  creditedFor: (credited) => active.creditedFor(credited),
  accountOf: (id) => active.accountOf(id),
  handleOf: (place) => active.handleOf(place),
  forgetDetails: () => active.forgetDetails(),
  forget: () => active.forget(),
}

/** Provides a fresh scoped `Atlas` per runtime and clears it when the runtime scope closes. */
export const atlasLayer = Layer.effect(Atlas, effect {
  const store = createAtlas()
  active = store
  try Effect.addFinalizer(() => sync(() => {
    store.reset()
    if (active === store) active = createAtlas()
  }))
  return store
})
