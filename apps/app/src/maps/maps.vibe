// spec/app/maps/index.md, "Story: Search for a place"; spec/app/maps/index.md, "Story: Get directions"; spec/app/maps/index.md, "Story: Navigate"; spec/app/maps/index.md, "Story: Connect through my cloud account"
import { CloudError } from "@elizaos/cloud"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Screen from "../../gen/app__maps.effect.vibe"
import { pressMs, readable, shown, typingMs } from "../../gen/app__maps.effect.vibe"
import type { Change, Effect as Out, Event as Ev, HandOff, Maps as State } from "../../gen/app__maps.effect.vibe"
import * as Credits from "../../gen/app__maps__credits.effect.vibe"
import type { Effect as CreditsOut, Event as CreditsEv } from "../../gen/app__maps__credits.effect.vibe"
import { findTimeoutMs, holding, networkGraceMs, retryMs } from "../../gen/app__maps__connection.effect.vibe"
import type { Wait } from "../../gen/app__maps__connection.effect.vibe"
import { bandOf, judged, maxFixAgeMs, maxFixAheadMs } from "../../gen/app__maps__navigation.effect.vibe"
import type { Offer, Origin, Travel } from "../../gen/app__maps__navigation.effect.vibe"
import { type Saved, maxSaved } from "../../gen/app__maps__places.effect.vibe"
import type { Grant as Allowed } from "../../gen/kit__permission.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { type CloudClient, Cloud, Device, type LocationGrant as Grant, Location, Navigation, NetworkLocation, type Sighting } from "../platform/index.vibe"
import { type Job, Time, answer, due, following, reacting, run, started, stream, together, untimed } from "../runtime/index.vibe"
import { Atlas, type AtlasStore, type Coverage, type Spot, type View, type Way, atlas, atlasLayer, withoutDetails } from "./atlas.vibe"
import { type Point, coordinateOf, measured, meters, normalizeLng, pointOf } from "./geometry.ts"
import { dropHandedQuery, handedQuery, offerHandedQuery, watchHandoff } from "./handoff.ts"

type CloudPlace = Awaited<ReturnType<CloudClient["mapsPlacesSearch"]>>["places"][number]

module web {
  /** Hand `url` to the phone, which opens it in the app that owns it. @throws {never} */
  export function opened(url: string): void {
    globalThis.open?.(url, "_blank", "noopener,noreferrer")
  }
  /** An `http:` or `https:` URL parsed safely, or `undefined` if invalid or disallowed. @throws {never} */
  export function safeWebUrl(raw: string): string | undefined {
    try {
      const parsedUrl = new URL(raw)
      return parsedUrl.protocol === "https:" || parsedUrl.protocol === "http:" ? parsedUrl.href : undefined
    } catch {
      return undefined
    }
  }
  /** The phone's share sheet with `text`, or, where the phone has none, `text` copied: whether either took it. */
  export async function shared(title: string, text: string): Promise<boolean> {
    const phone = globalThis.navigator
    if (phone?.share !== undefined) {
      await phone.share({ title, text })
      return true
    }
    return copied(text)
  }
  /** `text` on the clipboard: whether it was put there. */
  export async function copied(text: string): Promise<boolean> {
    try {
      await globalThis.navigator.clipboard.writeText(text)
      return true
    } catch {
      return false
    }
  }
  /** `text` read as JSON, or `undefined` where it is not JSON. @throws {never} */
  export function parsed(text: string): unknown {
    try { return JSON.parse(text) } catch { return undefined }
  }
  /** The browser window event target for network-online notifications, if present. @throws {never} */
  export const onlineTarget = (): EventTarget | undefined => typeof globalThis.addEventListener === "function" ? globalThis : undefined
}
import { copied, onlineTarget, opened, parsed, safeWebUrl, shared } from web

/** A Maps request the phone did not get an answer to: held back by a wait Cloud named, refused or failed. */
error Unanswered { cause: unknown }

const google = "eliza-cloud-google"
const isGoogleProvider = (providerId: string): boolean => providerId === google || providerId === "google"
const travelModes = { Drive: "drive", Walk: "walk", Bicycle: "bicycle", Transit: "transit" } as const satisfies Record<Travel, string>
const noOffer: Offer = { drive: false, transit: false, walk: false, bicycle: false }

/** The wait a failure of Cloud names, with the seconds it names (0 for none), or nothing where it names no wait. */
function waitOf(failure: unknown, now: number): { readonly wait: Wait; readonly seconds: number } | undefined {
  if (!(failure instanceof CloudError)) return undefined
  const why = failure.failure
  const until = (at: number) => (at > now ? Math.ceil((at - now) / 1000) : 0)
  if (why.tag === "CloudRateLimited") return { wait: "RateLimited", seconds: until(why.retryAt) }
  if (why.tag === "CloudAllowanceExhausted") return { wait: "AllowanceSpent", seconds: until(why.resetsAt) }
  if (why.tag === "CloudUnavailable" && why.retryAfter > 0) return { wait: "Unnamed", seconds: 0 }
  return undefined
}

// spec/app/maps/connection.md, "A wait Cloud names holds every Maps request back until it ends: a rate limit for at most a day, a spent allowance for at most 400 days, and any other wait one minute"
effect function held(failure: unknown, account: number): void!!(Time | Screen.Machine | Atlas) {
  if (failure instanceof CloudError && failure.failure.tag === "CloudInsufficientCredits") {
    (try Atlas).setInsufficientCredits(true)
    try ignore((try Screen.Machine).send({ type: "cloudWaits", wait: "Unnamed", seconds: 60, now: untimed, account }))
    return
  }
  const named = waitOf(failure, try (try Time).now())
  if (named === undefined) return
  try ignore((try Screen.Machine).send({ type: "cloudWaits", wait: named.wait, seconds: named.seconds, now: untimed, account }))
}

/** A call of eliza's cloud client for Maps under `signal`, refused while a wait Cloud named still holds. */
effect function askedUnder<A>(call: (client: CloudClient, signal: AbortSignal) => Promise<A>, signal?: AbortSignal): A!Unanswered!(Cloud | Time | Screen.Machine | Atlas) {
  const { link } = try (try Screen.Machine).get()
  if (holding(link)) throw new Unanswered({ cause: "Cloud asked Alpha to wait" })
  const { client } = try Cloud
  const sent: A!Unanswered = tryPromise({ try: (own) => call(client, signal ?? own), catch: (cause) => new Unanswered({ cause }) })
  return try Effect.tapError(sent, (failure) => held(failure.cause, link.account))
}

const asked = <A>(call: (client: CloudClient, signal: AbortSignal) => Promise<A>) => askedUnder(call)

function offerOf(coverage: Coverage): Offer {
  if (!coverage.available) return noOffer
  const modes: ReadonlyArray<string> = coverage.capabilities.modes
  return { drive: modes.includes("drive"), transit: modes.includes("transit"), walk: modes.includes("walk"), bicycle: modes.includes("bicycle") }
}

function isGoogle(coverage: Coverage): boolean {
  return coverage.available && (isGoogleProvider(coverage.providerId) || coverage.sources.data === "Google Maps")
}

/** The coverage of the provider the machine installed, or none. */
export function coverageOf(state: State, store: AtlasStore = atlas): Coverage | undefined {
  return state.link.provider === 0 ? undefined : store.coverage(state.link.coverage.ticket)
}

// spec/app/maps/connection.md, "Only the newest read's answer is taken, while signed in, and a healthy answer installs the provider for that account"; spec/app/maps/connection.md, "Opening Maps, regaining the network or Retry reads the coverage again only when no provider is working"
effect function covered(ticket: number): Ev!!(Cloud | Time | Screen.Machine | Atlas) {
  const { client } = try Cloud
  const store = try Atlas
  store.setInsufficientCredits(false)
  return effect {
    const found = try tryPromise({ try: (signal) => client.mapsCapabilities({ signal }), catch: (cause) => new Unanswered({ cause }) })
    store.covered(ticket, found)
    if (!found.available) return { type: "answerCoverage", ticket, ok: true, covered: false, google: false, offer: noOffer }
    if (found.capabilities.map && found.tiles !== undefined) {
      const z = Math.max(0, found.tiles.minZoom)
      const probe = effect {
        const answer = try tryPromise({ try: (signal) => client.mapsTile({ z, x: 0, y: 0 }, { signal }), catch: (cause) => new Unanswered({ cause }) })
        return { ok: true as const, bytes: answer.bytes }
      } catch (failed) => ({ ok: false as const, cause: failed.cause })
      if (probe.ok) {
        store.putTile(`${z}/0/0`, probe.bytes)
      } else if (probe.cause instanceof CloudError && probe.cause.failure.tag === "CloudInsufficientCredits") {
        store.setInsufficientCredits(true)
        return { type: "answerCoverage", ticket, ok: true, covered: false, google: false, offer: noOffer }
      } else {
        const account = (try (try Screen.Machine).get()).link.account
        if (account !== 0) try held(probe.cause, account)
        return { type: "answerCoverage", ticket, ok: false, covered: false, google: false, offer: noOffer }
      }
    }
    return { type: "answerCoverage", ticket, ok: true, covered: found.capabilities.map, google: isGoogle(found), offer: offerOf(found) }
  } catch () => ({ type: "answerCoverage", ticket, ok: false, covered: false, google: false, offer: noOffer })
}

/** A provider's place as the atlas keeps it, with its most specific category where the provider names one. */
function spotOf(raw: CloudPlace): Spot {
  const categories = "categories" in raw ? (raw as { readonly categories?: unknown }).categories : undefined
  const category = Array.isArray(categories) && typeof categories[0] === "string" ? categories[0] : ""
  return {
    name: raw.name, category, at: pointOf(raw.coordinate), providerId: raw.providerId, id: raw.id, google: isGoogleProvider(raw.providerId),
    ...(raw.address !== undefined ? { address: raw.address } : {}),
    ...(raw.phone !== undefined ? { phone: raw.phone } : {}),
    ...(raw.website !== undefined ? { website: raw.website } : {}),
    ...(raw.openingHours !== undefined ? { hours: raw.openingHours } : {}),
  }
}

/** Where the screen ranks a search around: the phone's last position, when it has one. */
function near(store: AtlasStore): { near?: { latitude: number; longitude: number } } {
  const here = store.snapshot().here
  return here === undefined ? {} : { near: coordinateOf(here.at) }
}

// spec/app/maps/index.md, "Only the newest search's answer is shown: results, none, or a failure"
effect function searched(ticket: number, query: string): Ev!!(Cloud | Time | Screen.Machine | Atlas) {
  const store = try Atlas
  return effect {
    const found = try asked((client, signal) => client.mapsPlacesSearch({ query, limit: 10, ...near(store) }, { signal }))
    const places = store.numberAll(found.places.map(spotOf))
    store.found(places)
    return { type: "answerSearch", ticket, ok: true, found: places.length }
  } catch () => ({ type: "answerSearch", ticket, ok: false, found: 0 })
}

// spec/app/maps/index.md, "A starting point can be a place found by its name, around the phone or the last start"
effect function foundOrigins(ticket: number, query: string): Ev!!(Cloud | Time | Screen.Machine | Atlas) {
  const store = try Atlas
  const { startLat, startLng } = try (try Screen.Machine).get()
  const around = store.snapshot().here?.at ?? (startLat === 0 && startLng === 0 ? undefined : { lat: startLat, lng: startLng })
  return effect {
    const found = try asked((client, signal) => client.mapsPlacesSearch({ query, limit: 5, ...(around === undefined ? {} : { near: coordinateOf(around) }) }, { signal }))
    const places = store.numberAll(found.places.map(spotOf))
    store.originsFound(places)
    return { type: "answerOrigins", ticket, ok: true, found: places.length }
  } catch () => ({ type: "answerOrigins", ticket, ok: false, found: 0 })
}

// spec/app/maps/index.md, "The agent's search shows its cards in the conversation and leaves the screen alone"
effect function foundForAgent(query: string): void!!(Cloud | Time | Screen.Machine | Atlas) {
  const store = try Atlas
  try ignore(asked((client, signal) => client.mapsPlacesSearch({ query, limit: 5, ...near(store) }, { signal }))
    |> Effect.map(%, (found) => store.numberAll(found.places.map(spotOf))))
}

// spec/app/maps/index.md, "A place's details are read from its provider once it is on the card, and shown only while it still is"
effect function detailed(ticket: number, place: number): Ev!!(Cloud | Time | Screen.Machine | Atlas) {
  const store = try Atlas
  const spot = store.spot(place)
  const serving = coverageOf(try (try Screen.Machine).get(), store)
  return effect {
    if (spot === undefined || spot.id === "") throw new Unanswered({ cause: "a pin has no provider details" })
    if (serving?.available !== true || serving.providerId !== spot.providerId) throw new Unanswered({ cause: "another provider named the place" })
    const found = try asked((client, signal) => client.mapsPlaceDetails({ id: spot.id }, { signal }))
    if (found.place === null) throw new Unanswered({ cause: "the provider no longer knows the place" })
    store.numberOf(spotOf(found.place))
    return { type: "answerDetails", ticket, ok: true }
  } catch () => ({ type: "answerDetails", ticket, ok: false })
}

// spec/app/maps/index.md, "Coordinates typed into Search drop a pin"; spec/app/maps/index.md, "A finger held still on the map for half a second drops a pin there, never during guidance"
effect function pinned(at: Point): Ev!!Atlas {
  const store = try Atlas
  const name = `${(at.lat / 1e6).toFixed(5)}, ${(at.lng / 1e6).toFixed(5)}`
  return { type: "dropPin", place: store.numberOf({ name, category: "", at, providerId: "", id: "", google: false }) }
}

// spec/app/maps/index.md, "Routes are asked for the place on screen, under the trip's newest ticket"
effect function planned(ticket: number, origin: Origin, travel: Travel, place: number, start: Point): Ev!!(Cloud | Time | Screen.Machine | Atlas) {
  const store = try Atlas
  const from = origin === "MyLocation" ? store.snapshot().here?.at : origin === "Unset" ? undefined : start
  const to = store.spot(place)
  return effect {
    if (from === undefined || to === undefined) throw new Unanswered({ cause: "the route has no start or no end" })
    const found = try asked((client, signal) => client.mapsRoutes({ from: coordinateOf(from), to: coordinateOf(to.at), mode: travelModes[travel] }, { signal }))
    const ways: Way[] = found.routes
      .filter((route) => route.geometry.length > 0)
      .slice(0, 3)
      .map((route) => ({
        meters: Math.round(route.distanceMeters), seconds: Math.round(route.durationSeconds), line: route.geometry.map(pointOf), live: route.traffic === "live",
        turns: route.steps.map((step) => ({ instruction: step.instruction, at: pointOf(step.coordinate), meters: Math.round(step.distanceMeters), ...(step.maneuver === undefined ? {} : { maneuver: step.maneuver }) })),
      }))
    const first = ways[0]
    if (first === undefined) throw new Unanswered({ cause: "the provider returned no route" })
    store.routed(ticket, ways)
    return { type: "answerRoute", ticket, ok: true, turns: Math.max(1, first.turns.length), routes: ways.length }
  } catch () => ({ type: "answerRoute", ticket, ok: false, turns: 0, routes: 0 })
}

function allowedOf(grant: Grant): Allowed {
  return grant === "precise" ? "Granted" : grant === "approximate" ? "Limited" : grant === "denied" ? "Denied" : "Unasked"
}

// spec/app/maps/index.md, "A fix goes to whoever holds the location"; spec/app/maps/navigation.md, "A fix moves guidance only when it is precise, fresh and close: arrival within 25 meters, a turn passed within 40 meters or after two fixes beyond 60, the route left beyond 75"; spec/app/maps/connection.md, "\"Use my location\" gives up after 15 seconds without a fix"
function located(session: number, once: boolean): Stream.Stream<Ev, never, Location | NetworkLocation | Time | Screen.Machine | Atlas> {
  return Stream.unwrap(effect {
    const location = try Location
    const network = try NetworkLocation
    const time = try Time
    const screen = try Screen.Machine
    const store = try Atlas
    try ignore(location.clear())
    const began = try time.now()
    const exact = (try location.permission()) === "precise"
    let gps = false
    const fixes = location.watch()
      |> Stream.map(%, (heard): { readonly fix: Sighting; readonly fromGps: boolean } | undefined => {
        if (heard.kind !== "fix") return undefined
        return { fix: { ...heard, precise: heard.precise && exact }, fromGps: true }
      })
    const roughFix = effect {
      const fromNetwork = try network.locate()
      if (Option.isSome(fromNetwork)) {
        return Option.some<Sighting>({
          lat: fromNetwork.value.lat, lng: fromNetwork.value.lng, accuracy: fromNetwork.value.accuracy, precise: false, taken: fromNetwork.value.found,
        })
      }
      return try location.rough()
    }
    const standIn = Stream.fromEffect(time.until(began + networkGraceMs) |> Effect.andThen(%, roughFix))
      |> Stream.map(%, (rough): { readonly fix: Sighting; readonly fromGps: boolean } | undefined => (gps || Option.isNone(rough) ? undefined : { fix: rough.value, fromGps: false }))
    const heard = Stream.merge(fixes, standIn)
      |> Stream.mapEffect(%, (entry) => effect {
        if (entry === undefined) return undefined
        const ageMs = (try time.now()) - entry.fix.taken
        const fresh = ageMs <= maxFixAgeMs && ageMs >= -maxFixAheadMs
        if (entry.fromGps && fresh) gps = true
        if (once && !fresh) return undefined
        return { fix: entry.fix, ageMs, fresh }
      })
      |> Stream.filter(%, (seen): seen is { readonly fix: Sighting; readonly ageMs: number; readonly fresh: boolean } => seen !== undefined)
      |> Stream.mapEffect(%, ({ fix, ageMs, fresh }) => effect {
        const at: Point = { lat: fix.lat, lng: fix.lng }
        if (once || (fresh && (fix.accuracy <= 250 || store.snapshot().here === undefined))) {
          store.located({ at, accuracy: fix.accuracy, approximate: !fix.precise })
        }
        if (once) return { type: "locationFix", session, fix: "Along" } satisfies Ev
        const { trip, chosen } = try screen.get()
        const way = store.way(trip.route, chosen)
        if (way === undefined) return { type: "locationFix", session, fix: "Along" } satisfies Ev
        const along = measured(at, { line: way.line, turns: way.turns.map((turn) => turn.at) }, trip.turn)
        return { type: "locationFix", session, fix: judged(fix.precise, ageMs, fix.accuracy, along.toEnd, along.toRoute, along.toStep, along.beyond) } satisfies Ev
      })
      |> Stream.catch(%, () => Stream.succeed<Ev>({ type: "locationLost", session }))
    const active = once
      ? (Stream.merge(Stream.take(heard, 1), Stream.fromEffect(time.until(began + findTimeoutMs) |> Effect.as(%, { type: "findTimedOut", session } satisfies Ev))) |> Stream.take(%, 1))
      : heard
    return Stream.ensuring(active, ignore(location.clear()))
  })
}

effect function stopped(): void!!Location {
  try ignore((try Location).clear())
}

/** The words of the notification of guidance: where it goes and the next turn. */
effect function notified(): { readonly title: string; readonly text: string }!!(Screen.Machine | Atlas) {
  const store = try Atlas
  const { trip, chosen, place } = try (try Screen.Machine).get()
  const turn = store.way(trip.route, chosen)?.turns[trip.turn]
  return { title: `Navigating to ${store.spot(place)?.name ?? "your destination"}`, text: turn?.instruction ?? "Follow the route" }
}

// spec/app/maps/index.md, "Android confirms or loses the service of this journey"; spec/app/maps/index.md, "The phone guides with the screen off only for the journey that just started"
effect function guided(journey: number): Ev!!(Navigation | Screen.Machine | Atlas) {
  const { title, text } = try notified()
  return { type: "serviceReport", journey, running: try (try Navigation).start(journey, title, text) }
}

// spec/app/maps/index.md, "End stops guidance and its location and goes back to the directions"
effect function unguided(): void!!(Location | Navigation | Screen.Machine) {
  try ignore((try Location).clear())
  try (try Navigation).stop((try (try Screen.Machine).get()).trip.journey)
}

// spec/app/maps/index.md, "Arriving with Maps away is told once on the phone"
effect function arrivedAway(place: number): void!!(Navigation | Atlas) {
  const store = try Atlas
  try (try Navigation).arrived("Arrived", `Arrived at ${store.spot(place)?.name ?? "your destination"}.`)
}

// spec/app/maps/index.md, "Continuing past the disclosure asks Android, once, and then locates"
effect function permitted(): Ev!!Location {
  return { type: "observeLocation", grant: allowedOf(try (try Location).request()) }
}

// spec/app/maps/index.md, "Settings opens only once Android has said no"
effect function settingsOpened(): void!!Location {
  try ignore((try Location).openSettings())
}

const savedKey = "alpha/maps/saved@1"
const previousKey = "alpha.maps.saved-places.v1"

interface KeptPlace {
  readonly name: string
  readonly spot: Spot
}

const isRecord = (value: unknown): value is Record<string, unknown> => typeof value === "object" && value !== null

const isPoint = (at: unknown): at is Point =>
  isRecord(at) && typeof at.lat === "number" && typeof at.lng === "number" && Number.isInteger(at.lat) && Number.isInteger(at.lng)
    && Math.abs(at.lat) <= 90_000_000 && Math.abs(at.lng) <= 180_000_000

const isName = (name: unknown): name is string => typeof name === "string" && name.trim() !== "" && name.length <= 300

const optionalText = (value: unknown): string | undefined => typeof value === "string" ? value : undefined

/** The places Alpha kept under `savedKey`, or `undefined` where the list cannot be read. */
function keptIn(text: string): ReadonlyArray<KeptPlace> | undefined {
  const list = parsed(text)
  if (!Array.isArray(list) || list.length > maxSaved) return undefined
  const kept = list.flatMap((entry: unknown): KeptPlace[] => {
    if (!isRecord(entry) || !isName(entry.name) || !isRecord(entry.spot) || !isPoint(entry.spot.at) || !isName(entry.spot.name)) return []
    const category = optionalText(entry.spot.category) ?? ""
    const providerId = optionalText(entry.spot.providerId) ?? ""
    const id = optionalText(entry.spot.id) ?? ""
    if (isGoogleProvider(providerId)) return []
    return [{ name: entry.name, spot: { name: entry.spot.name, category, at: entry.spot.at, providerId, id, google: false } }]
  })
  return kept.length === list.length ? kept : undefined
}

/** One place the previous Alpha kept: the place, `"skipped"` for one this version does not take (a Google place, or one without a name or valid coordinates), or `undefined` where its row cannot be read. */
function previouslyKept(item: unknown): KeptPlace | "skipped" | undefined {
  if (!isRecord(item) || typeof item.label !== "string" || !isRecord(item.coordinate)) return undefined
  const { latitude, longitude } = item.coordinate
  if (typeof latitude !== "number" || typeof longitude !== "number") return undefined
  const providerId = optionalText(item.providerId) ?? ""
  const id = optionalText(item.providerPlaceId) ?? ""
  const name = item.label.trim()
  const at = pointOf({ latitude, longitude })
  if (isGoogleProvider(providerId) || !isName(name) || !isPoint(at)) return "skipped"
  return { name, spot: { name, category: "", at, providerId, id, google: false } }
}

// spec/app/maps/places.md, "A phone updated from the previous Alpha keeps its saved places"
/** The places the previous Alpha kept under `previousKey` that this version takes, in its order; none where its list cannot be read. */
function previouslyKeptIn(text: string): ReadonlyArray<KeptPlace> {
  const data = parsed(text)
  if (!isRecord(data) || data.version !== 1 || !Array.isArray(data.items)) return []
  const read: ReadonlyArray<KeptPlace | "skipped" | undefined> = data.items.map(previouslyKept)
  if (read.includes(undefined)) return []
  return read.filter((entry): entry is KeptPlace => entry !== undefined && entry !== "skipped")
}

/** The machine's saved list of `kept`, numbered in the atlas, once per place. */
function savedOf(store: AtlasStore, kept: ReadonlyArray<KeptPlace>): Saved[] {
  const numbers = store.numberAll(kept.map((entry) => entry.spot))
  const saved: Saved[] = []
  for (let index = 0; index < kept.length; index++) {
    const place = numbers[index]
    const entry = kept[index]
    if (place !== undefined && entry !== undefined && !saved.some((known) => known.place === place)) {
      saved.push({ place, name: entry.name })
    }
  }
  return saved
}

// spec/app/maps/index.md, "Saved places are kept on the phone, and are what survives a restart"; spec/app/maps/index.md, "A list this version never wrote takes the previous Alpha's places once, and keeps them"; spec/app/maps/index.md, "A saved list that cannot be read is never written over, and a change is told only once it reads back"; spec/app/maps/places.md, "A saved place keeps its name, its coordinates and the provider's identity of it, and nothing else"
effect function keep(saved: ReadonlyArray<Saved>, change: Change): Ev!!(KeyValueStore.KeyValueStore | Atlas) {
  const kv = try KeyValueStore.KeyValueStore
  const store = try Atlas
  const kept: KeptPlace[] = saved.flatMap((entry) => {
    const spot = store.spot(entry.place)
    return spot === undefined || spot.google ? [] : [{ name: entry.name, spot: { ...withoutDetails(spot), category: "", google: false } }]
  })
  const text = JSON.stringify(kept)
  const ok = try (kv.set(savedKey, text) |> Effect.andThen(%, kv.get(savedKey)) |> Effect.map(%, (back) => back === text) |> Effect.orElseSucceed(%, () => false))
  return { type: "savedKept", change, ok }
}

effect function restored(): readonly [Ev]!!(KeyValueStore.KeyValueStore | Atlas) {
  const kv = try KeyValueStore.KeyValueStore
  const store = try Atlas
  const read = (key: string) => kv.get(key)
    |> Effect.match(%, { onSuccess: (value) => ({ ok: true as const, value }), onFailure: () => ({ ok: false as const, value: undefined }) })
  const primary = try read(savedKey)
  if (!primary.ok) return [{ type: "savedUnreadable" }]
  if (primary.value === undefined) {
    const previous = try read(previousKey)
    return [{ type: "adoptPrevious", saved: !previous.ok || previous.value === undefined ? [] : savedOf(store, previouslyKeptIn(previous.value)).slice(0, maxSaved) }]
  }
  const kept = keptIn(primary.value)
  if (kept === undefined) return [{ type: "savedUnreadable" }]
  return [{ type: "restoreSaved", saved: savedOf(store, kept) }]
}

// spec/app/maps/index.md, "The card shares the place or the arrival time, opens its website, or opens it in the phone's maps app"
effect function handed(place: number, kind: HandOff): void!!(Screen.Machine | Time | Device | Atlas) {
  const store = try Atlas
  const spot = store.spot(place)
  if (spot === undefined) return
  if (kind === "CopyNumber") {
    const number = spot.phone ?? ""
    const copiedByDevice = number !== "" && (try (try Device).copyText(number))
    const ok = copiedByDevice || (number !== "" && (try (tryPromise(() => copied(number)) |> Effect.orElseSucceed(%, () => false))))
    try ignore((try Screen.Machine).send({ type: "numberCopied", ok }))
    return
  }
  const where = `${spot.at.lat / 1e6},${spot.at.lng / 1e6}`
  const link = `https://www.openstreetmap.org/?mlat=${spot.at.lat / 1e6}&mlon=${spot.at.lng / 1e6}#map=17/${spot.at.lat / 1e6}/${spot.at.lng / 1e6}`
  const text = `${spot.name}${spot.address === undefined ? "" : `, ${spot.address}`}\n${link}`
  const { trip, chosen } = try (try Screen.Machine).get()
  const way = store.way(trip.route, chosen)
  const arrival = way === undefined ? "" : new Date((try (try Time).now()) + way.seconds * 1000).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })
  try ignore(match (kind) {
    when "SharePlace": tryPromise(() => shared(spot.name, text));
    when "EmailPlace": sync(() => opened(`mailto:?subject=${encodeURIComponent(spot.name)}&body=${encodeURIComponent(text)}`));
    when "CopyLink": tryPromise(() => copied(link));
    when "EtaShare": tryPromise(() => shared(spot.name, `On my way to ${spot.name}${arrival === "" ? "" : `, arriving around ${arrival}`}`));
    when "Website": sync(() => {
      const target = spot.website === undefined ? undefined : safeWebUrl(spot.website)
      if (target !== undefined) opened(target)
    });
    when "MapsApp": sync(() => opened(`geo:${where}?q=${encodeURIComponent(`${where}(${spot.name})`)}`));
    when "Call": sync(() => {
      const digits = spot.phone?.replace(/[^+0-9]/g, "") ?? ""
      if (/\d/.test(digits)) opened(`tel:${digits}`)
    });
    when "CopyNumber": Effect.void;
  })
}

/** The numbers of the agent's reads a device action is holding for its answer: any other read is told as unknown. */
export const readsHeld = new Set<number>()

function carry(fx: Out): Job<Ev, Cloud | Time | Location | NetworkLocation | Navigation | Screen.Machine | KeyValueStore.KeyValueStore | Shell | Device | Atlas, []> {
  return match (fx) {
    when { tag: "ReadCoverage", let ticket }: answer("coverage", covered(ticket), { type: "answerCoverage", ticket, ok: false, covered: false, google: false, offer: noOffer });
    when { tag: "DrawMap" }: run("draw", Effect.void);
    when { tag: "FindPlaces", let ticket, let query }: answer("search", searched(ticket, query), { type: "answerSearch", ticket, ok: false, found: 0 });
    when { tag: "FindForAgent", let query }: run("agentSearch", foundForAgent(query));
    when { tag: "FindOrigins", let ticket, let query }: answer("origins", foundOrigins(ticket, query), { type: "answerOrigins", ticket, ok: false, found: 0 });
    when { tag: "ReadDetails", let ticket, let place }: answer("details", detailed(ticket, place), { type: "answerDetails", ticket, ok: false });
    when { tag: "MakePin", let lat, let lng }: answer("pin", pinned({ lat, lng }), { type: "dropPin", place: 0 });
    when { tag: "PlanRoute", let ticket, let origin, let travel, let place, let lat, let lng }: answer("route", planned(ticket, origin, travel, place, { lat, lng }), { type: "answerRoute", ticket, ok: false, turns: 0, routes: 0 });
    when { tag: "StartLocation", let session, let once }: stream("location", located(session, once), { type: "locationLost", session });
    when { tag: "StopLocation" }: run("location", stopped());
    when { tag: "AskLocation" }: answer("permission", permitted(), { type: "observeLocation", grant: "Denied" });
    when { tag: "OpenLocationSettings" }: run("settings", settingsOpened());
    when { tag: "ShowMyLocation" }: run("show", Effect.flatMap(Atlas, (store) => sync(() => store.showMe())));
    when { tag: "GuideWithScreenOff", let journey }: answer("service", guided(journey), { type: "serviceReport", journey, running: false });
    when { tag: "StopGuidance" }: run("location", unguided());
    when { tag: "TellArrival", let place }: run("arrival", arrivedAway(place));
    when { tag: "KeepSaved", let saved, let change }: answer("saved", keep(saved, change), { type: "savedKept", change, ok: false });
    when { tag: "HandedOn", let place, let kind }: run("handOn", handed(place, kind));
    when { tag: "OpenEvent" }: run("event", Effect.flatMap(Shell, (shell) => ignore(shell.send({ type: "openView", view: "Calendar" }))));
    when { tag: "TellAgent", let ticket }: readsHeld.has(ticket) ? run("tell", Effect.void) : answer("tell", succeed<Ev>({ type: "answerTell", ticket, confirmed: false, known: false }), { type: "answerTell", ticket, confirmed: false, known: false });
    when { tag: "BringMapsForward" }: run("forward", Effect.flatMap(Shell, (shell) => ignore(shell.send({ type: "openView", view: "Maps" }))));
  }
}

// spec/app/maps/index.md, "Cloud's wait holds the screen's requests until it ends, and its end lets them go again"; spec/app/maps/index.md, "A finger held still on the map for half a second drops a pin there, never during guidance"
const screen = reacting(Screen, {
  carry,
  open: restored(),
  timers: (state) => [
    ...(holding(state.link) ? [due("hold", state.link.holdEnds, { type: "waitEnded", hold: state.link.holds } satisfies Ev)] : []),
    ...(state.pressing ? [due("press", state.pressedAt + pressMs, { type: "pressHeld", press: state.presses } satisfies Ev)] : []),
    ...(state.pausing ? [due("typing", state.typedAt + typingMs, { type: "typingSettled", typed: state.types } satisfies Ev)] : []),
  ],
})

function normalizedView(view: View): View {
  return {
    north: Math.max(-90, Math.min(90, view.north)),
    south: Math.max(-90, Math.min(90, view.south)),
    east: normalizeLng(view.east),
    west: normalizeLng(view.west),
    zoom: view.zoom,
  }
}

/** A view grown by one view of margin on each side: the area a copyright is asked for. */
function grown(raw: View): View {
  const view = normalizedView(raw)
  const tall = Math.max(0, view.north - view.south)
  const wide = view.east >= view.west ? view.east - view.west : (360 - view.west) + view.east
  const wraps = view.east < view.west || wide * 3 >= 360
  return {
    north: Math.min(90, view.north + tall), south: Math.max(-90, view.south - tall),
    east: wraps ? 180 : Math.min(180, view.east + wide), west: wraps ? -180 : Math.max(-180, view.west - wide), zoom: view.zoom,
  }
}

const within = (rawView: View, area: View) => {
  const view = normalizedView(rawView)
  return view.zoom === area.zoom && view.north <= area.north && view.south >= area.south
    && (area.west === -180 && area.east === 180 || (view.east >= view.west && view.east <= area.east && view.west >= area.west))
}

// spec/app/maps/credits.md, "When the camera settles outside the area the shown copyright covers, the copyright is asked for that view, and within it nothing changes"
/** The camera settled on `view`: the credits are told whether the copyright shown still covers it. */
export effect function settled(view: View): void!!(Credits.Machine | Atlas) {
  const store = try Atlas
  const credited = store.snapshot().credited
  const clean = normalizedView(view)
  store.viewed(clean)
  try ignore((try Credits.Machine).send({ type: "cameraSettled", covered: credited !== undefined && within(clean, credited) }))
}

// spec/app/maps/credits.md, "Only the answer to the latest copyright request, for the view in place, is shown, and a failed one never breaks the map"
effect function copyrighted(token: number): CreditsEv!!(Cloud | Time | Screen.Machine | Atlas) {
  const store = try Atlas
  const view = store.snapshot().view
  return effect {
    if (view === undefined) throw new Unanswered({ cause: "the map has not settled" })
    const area = grown(view)
    const found = try asked((client, signal) => client.mapsViewport({ zoom: area.zoom, north: area.north, south: area.south, east: area.east, west: area.west }, { signal }))
    store.creditedFor(area)
    return { type: "copyrightAnswered", token, success: true, text: found.copyright }
  } catch () => ({ type: "copyrightAnswered", token, success: false, text: "" })
}

function carryCredits(fx: CreditsOut): Job<CreditsEv, Cloud | Time | Screen.Machine | Atlas, []> {
  return match (fx) {
    when { tag: "Copyright", let token }: answer("copyright", copyrighted(token), { type: "copyrightAnswered", token, success: false, text: "" });
  }
}

const credits = reacting(Credits, { carry: carryCredits })

// spec/app/maps/credits.md, "A failed tile never breaks a surface whose style has loaded, and a cancelled tile breaks nothing"
/** The provider's tile at `z/x/y` for the map drawing it, cancelled with `signal`, and refused while Cloud's wait holds. */
export effect function tile(z: number, x: number, y: number, signal: AbortSignal): Uint8Array!Unanswered!(Cloud | Time | Screen.Machine | Atlas) {
  const cached = (try Atlas).takeTile(`${z}/${x}/${y}`)
  if (cached !== undefined) return cached
  const found = try askedUnder((client, own) => client.mapsTile({ z, x, y }, { signal: own }), signal)
  return found.bytes
}

// spec/app/maps/connection.md, "Signing in, out or to another account retires the provider and reads the new account's coverage"; spec/app/maps/index.md, "Another account hides every route, place and search of the last one, and ends its guidance"
effect function accountRead(): void!!(Cloud | Screen.Machine | Atlas) {
  const { client } = try Cloud
  const store = try Atlas
  const number = try (tryPromise({ try: () => client.account(), catch: (cause) => new Unanswered({ cause }) })
    |> Effect.match(%, {
      onSuccess: (owner): number | undefined => store.accountOf(owner.id),
      onFailure: (failure): number | undefined => (failure.cause instanceof CloudError && failure.cause.failure.tag === "CloudCredentialInvalid" ? 0 : undefined),
    }))
  if (number === undefined) return
  const screen = try Screen.Machine
  const { link } = try screen.get()
  if (link.known && link.account === number) return
  store.forget()
  try ignore(screen.send({ type: "changeAccount", account: number }))
}

// spec/app/maps/connection.md, "A failed read is tried again"; spec/app/maps/connection.md, "Opening Maps, regaining the network or Retry reads the coverage again only when no provider is working"
const retried = started(effect {
  const screen = try Screen.Machine
  const time = try Time
  const failedWhileShown = screen.changes
    |> Stream.map(%, (s) => (!s.trip.away && s.link.coverage.status === "Failed" && s.link.account !== 0 ? s.link.coverage.ticket : 0))
    |> Stream.changes(%)
  const backoff = Stream.switchMap(failedWhileShown, (ticket) =>
    ticket === 0
      ? Stream.empty
      : Stream.fromEffect(effect {
          try time.until((try time.now()) + retryMs)
          if (!(try screen.get()).trip.away) try ignore(screen.send({ type: "connect" }))
        }),
  )
  const target = onlineTarget()
  const regained = target === undefined
    ? Stream.empty
    : Stream.fromEventListener(target, "online") |> Stream.mapEffect(%, () => effect {
        if (!(try screen.get()).trip.away) try ignore(screen.send({ type: "connect" }))
      })
  try Stream.runDrain(Stream.merge(backoff, regained))
}, "retrying Maps")

// spec/app/maps/index.md, "What Android reports about location is taken at once; guidance without it ends"; spec/app/maps/index.md, "Opening Maps with location already allowed and nothing chosen takes one fix quietly, once a visit"; spec/app/maps/connection.md, "Signing in, out or to another account retires the provider and reads the new account's coverage"
const opening = started(effect {
  const shell = try Shell
  const screen = try Screen.Machine
  const location = try Location
  const device = try Device
  try Stream.runForEach(shell.changes |> Stream.map(%, (s) => showing(s, "Maps")) |> Stream.changes(%), effect (shown) => {
    if (!shown) return
    const grant = allowedOf(try location.permission())
    try ignore(screen.send({ type: "observeLocation", grant }))
    const caps = try device.capabilities()
    try ignore(screen.send({ type: "admitDialer", on: caps.image }))
    try accountRead()
    try ignore(screen.send({ type: "connect" }))
    try ignore(screen.send({ type: "quietFix" }))
  })
}, "opening Maps")

// spec/app/maps/index.md, "Leaving Maps keeps guidance with its service and ends it without; a pending \"Use my location\" and the Calendar return end"; spec/app/maps/index.md, "A query another app hands to Maps opens as a search, never over navigation"; spec/app/maps/index.md, "The notification of this journey opens Maps on its guidance, or stops it"; spec/app/maps/index.md, "A place's details are read from its provider once it is on the card, and shown only while it still is"
const presence = started(effect {
  const shell = try Shell
  const device = try Device
  const screen = try Screen.Machine
  const location = try Location
  const navigation = try Navigation
  const store = try Atlas
  const checkNotification = effect {
    if (!(try navigation.opened())) return
    const showable = (try device.showing()) && (try shell.get()).assistant !== "Full"
    const { trip } = try screen.get()
    try ignore(screen.send({ type: "openNotification", journey: trip.journey, showable }))
  }
  try checkNotification
  const page = Stream.changes(Stream.concat(Stream.fromEffect(device.showing()), device.visible))
  const inFront = Stream.zipLatest(Stream.changes(Stream.map(shell.changes, (s) => showing(s, "Maps"))), page)
  const target = onlineTarget()
  const notificationTaps = target === undefined
    ? Stream.empty
    : Stream.as(Stream.fromEventListener(target, "alpha:maps-open"), undefined)
  let wasFront: boolean | undefined
  let wasVisible: boolean | undefined
  try Stream.runForEach(Stream.merge(inFront, notificationTaps), effect (visit) => {
    if (visit === undefined) {
      try checkNotification
      return
    }
    const [mapsShown, visible] = visit
    const returnedToForeground = visible && wasVisible === false
    wasVisible = visible
    if (returnedToForeground) try checkNotification
    const shown = mapsShown && visible
    if (shown === wasFront) return
    wasFront = shown
    if (shown) {
      try ignore(screen.send({ type: "comeBack" }))
      if (returnedToForeground) {
        const grant = allowedOf(try location.permission())
        try ignore(screen.send({ type: "observeLocation", grant }))
        try accountRead()
        try ignore(screen.send({ type: "connect" }))
      }
      if ((try screen.get()).link.known) try ignore(screen.send({ type: "quietFix" }))
      return
    }
    dropHandedQuery()
    try ignore(screen.send({ type: "leaveMaps" }))
    store.forgetDetails()
  })
}, "following whether Maps shows")

// spec/app/maps/index.md, "Android confirms or loses the service of this journey"
const serviceEnds = started(effect {
  const screen = try Screen.Machine
  try Stream.runForEach((try Navigation).ended, effect (ended) => {
    const event: Ev = ended.by === "notification" ? { type: "stopFromNotification", journey: ended.journey } : { type: "serviceReport", journey: ended.journey, running: false }
    try ignore(screen.send(event))
  })
}, "hearing guidance's service")

// spec/app/maps/navigation.md, "The ongoing notification belongs to the journey whose service runs, and opening it shows Maps"
const notificationWords = started(effect {
  const screen = try Screen.Machine
  const navigation = try Navigation
  const facts = screen.changes |> Stream.filter(%, (s) => s.trip.guidance === "Going" && s.trip.service === "Running") |> Stream.map(%, (s) => [s.trip.journey, s.trip.turn, s.trip.route, s.chosen] as const)
  try Stream.runForEach(Stream.changesWith(facts, (a, b) => a.every((x, i) => x === b[i])), effect ([journey]) => {
    const { title, text } = try notified()
    const ok = try navigation.update(journey, title, text)
    if (!ok) try ignore(screen.send({ type: "serviceReport", journey, running: false }))
  })
}, "writing guidance's notification")

const detailsReader = started(effect {
  const screen = try Screen.Machine
  const store = try Atlas
  const facts = screen.changes |> Stream.map(%, (state) => [state.place, state.details.status, state.trip.away, state.directions, state.trip.guidance] as const)
  try Stream.runForEach(Stream.changesWith(facts, (a, b) => a[0] === b[0] && a[1] === b[1] && a[2] === b[2] && a[3] === b[3] && a[4] === b[4]), effect ([place, status, away, directions, guidance]) => {
    if (away || directions || guidance !== "Stopped" || status !== "Idle" || (store.spot(place)?.id ?? "") === "") return
    try ignore(screen.send({ type: "readDetails", place }))
  })
}, "reading place details")

// spec/app/maps/index.md, "A query another app hands to Maps opens as a search, never over navigation"
const handoffs = started(effect {
  const shell = try Shell
  const screen = try Screen.Machine
  const wakes = Stream.concat(
    Stream.succeed(undefined),
    Stream.callback<void>((queue) => acquireRelease(sync(() => watchHandoff(() => { Queue.offerUnsafe(queue, undefined) })), (off) => sync(off))),
  )
  const ticks = Stream.mergeAll([wakes, Stream.as(shell.changes, undefined), Stream.as(screen.changes, undefined)], { concurrency: "unbounded" })
  let wasShown = false
  try Stream.runForEach(ticks, effect () => {
    const mapsShown = showing(try shell.get(), "Maps")
    if (!mapsShown) {
      if (wasShown) try sync(() => dropHandedQuery())
      wasShown = false
      return
    }
    wasShown = true
    const query = try sync(() => handedQuery())
    if (query === undefined) return
    const current = try screen.get()
    if (!Screen.canHandOver(current, query, query.length, 0) || Screen.canContinueDisclosure(current)) return
    const took = try promise(() => offerHandedQuery((q) => {
      if (!Screen.canHandOver(current, q, q.length, 0) || Screen.canContinueDisclosure(current)) return undefined
      return runPromise(screen.send({ type: "handOver", query: q, chars: q.length, meeting: 0 }) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
    }))
    void took
  })
}, "Maps search handoff")

// spec/app/maps/navigation.md, "An instruction is spoken for its turn and distance band: now within 50 meters, soon within 250, far beyond"
/** The words of the turn `at` of the route shown, as guidance speaks them from where the phone was last seen. */
function spokenOf(state: State, at: number, store: AtlasStore): string | undefined {
  const turn = store.way(state.trip.route, state.chosen)?.turns[at]
  if (turn === undefined) return undefined
  const here = store.snapshot().here
  const away = here === undefined ? 0 : Math.round(meters(here.at, turn.at))
  if (bandOf(away) === "Now") return turn.instruction
  return `In ${away < 1000 ? `${Math.round(away / 10) * 10} meters` : `${(away / 1000).toFixed(1)} kilometers`}, ${turn.instruction}`
}

// spec/app/maps/index.md, "Guidance speaks the newest instruction with Maps on screen, once, and the instruction owed on coming back"; spec/app/maps/navigation.md, "The newest instruction owns speech"
/** What the machine says is spoken, read aloud: the instruction of its turn when it starts, and nothing once it stops. */
const speaking = started(effect {
  const screen = try Screen.Machine
  const navigation = try Navigation
  const store = try Atlas
  try Stream.runForEach(screen.changes |> Stream.changesWith(%, (a, b) => a.trip.speaking === b.trip.speaking && a.trip.journey === b.trip.journey), effect (state) => {
    const words = state.trip.speaking < 0 ? undefined : spokenOf(state, state.trip.speaking, store)
    if (words === undefined) try navigation.hush()
    else try navigation.say(words)
  })
}, "speaking guidance")

/**
 * Maps: its screen and the map's credits, which live from Maps' first opening until Alpha closes; the saved places,
 * kept on the phone; and what each follows: the shell's showing Maps, the account, Android's permission and the surface.
 */
export const maps = Layer.provideMerge(
  together(
    screen,
    credits,
    retried,
    opening,
    presence,
    handoffs,
    serviceEnds,
    notificationWords,
    speaking,
    detailsReader,
    following(Screen.Machine, (state) => [state.trip.guidance, state.trip.away, state.trip.turn, state.trip.speaking, state.imprecise] as const, Screen.Machine,
      ([guidance, away, turn, spoken, imprecise]): Ev | undefined => (guidance === "Going" && !away && !imprecise && spoken !== turn ? { type: "speak", at: turn } : undefined)),
    following(Screen.Machine, (state) => [state.imprecise, state.trip.speaking] as const, Screen.Machine,
      ([imprecise, spoken]): Ev | undefined => (imprecise && spoken >= 0 ? { type: "stopSpeaking" } : undefined)),
    following(Screen.Machine, (state) => [state.link.plane, state.link.basemap === "Cloud"] as const, Credits.Machine, ([plane, raster]): CreditsEv => ({ type: "drawnOn", plane, raster })),
    following(Screen.Machine, (state) => [state.link.plane, state.link.surface] as const, Credits.Machine, ([plane, surface]): CreditsEv | undefined => (surface === "Drawn" ? { type: "planeDrawn", plane } : undefined)),
  ),
  atlasLayer,
)

// spec/app/maps/index.md, "An event's place opens on its card once Maps is on screen, never over navigation, and Maps remembers the event"
/** Calendar hands Maps an event's place by its words: Maps comes forward, finds the place and opens it on its card. */
export effect function enteredFromEvent(meeting: number, address: string): boolean!!(Cloud | Time | Screen.Machine | Shell | Atlas) {
  const store = try Atlas
  try ignore((try Shell).send({ type: "openView", view: "Maps" }))
  const found = try (asked((client, signal) => client.mapsGeocode({ query: address, limit: 1 }, { signal })) |> Effect.option(%))
  const first = Option.isSome(found) ? found.value.places[0] : undefined
  if (first === undefined) return false
  const place = store.numberOf(spotOf(first))
  return try (((try Screen.Machine).send({ type: "enterFromEvent", meeting, place })) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
}

// spec/app/maps/index.md, "A query another app hands to Maps opens as a search, never over navigation"
/** Another app, or a Calendar event under its number (0 for none), hands Maps words to search: Maps comes forward and searches them, never over guidance. */
export effect function handedOver(query: string, meeting: number): boolean!!(Screen.Machine | Shell) {
  const words = query.trim()
  try ignore((try Shell).send({ type: "openView", view: "Maps" }))
  return try (((try Screen.Machine).send({ type: "handOver", query: words, chars: [...words].length, meeting })) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
}

/** What Maps shows, as the agent's turn names it: the place or route on screen by its handle and revision, or nothing. */
export interface Selected {
  readonly kind: "map-place" | "map-route"
  readonly id: string
  readonly revision: string
}

// spec/app/maps/index.md, "While Maps is in front the agent is told what it shows, a place, a route or a search, by a handle that names it on this phone only"
export function selectedOf(state: State, inFront: boolean, store: AtlasStore = atlas): Selected | undefined {
  const what = shown(state, inFront)
  if (!readable(what)) return undefined
  return { kind: what === "ShowsRoute" ? "map-route" : "map-place", id: store.handleOf(state.place), revision: String(state.review.revision) }
}
