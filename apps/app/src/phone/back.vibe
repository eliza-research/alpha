// spec/app/phone/voicemail.md, "Closing the voicemail returns to the list"; spec/app/messages/index.md, "Back returns from a conversation or the picker to the list, and reads it again"; spec/app/messages/index.md, "The search field opens over the list, and Back closes it with what it typed"; spec/app/contacts/index.md, "Closing the contact returns to the list"
import * as Contacts from "../../gen/app__contacts.effect.vibe"
import * as Messages from "../../gen/app__messages.effect.vibe"
import * as Phone from "../../gen/app__phone.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Voicemail from "../../gen/app__phone__voicemail.effect.vibe"
import { contained } from "../runtime/index.vibe"

/** Whether `event` was a step of the screen's own, taken by the rules. */
effect function stepped<Ev>(machine: { send(event: Ev): unknown!unknown }, event: Ev | undefined): boolean!! {
  if (event === undefined) return false
  return try contained(machine.send(event), "back")
}

/** Back on Phone: a delete question first, then the open voicemail. */
export const phoneBack = effect {
  const voicemail = try Voicemail.Machine
  const state = try voicemail.get()
  return try stepped(voicemail, state.confirming ? { type: "keep" } as const : state.open ? { type: "close" } as const : undefined)
}

/** Back on Messages: a delete question first, then the conversation or the picker, then the search they were opened from. */
export const messagesBack = effect {
  const messages = try Messages.Machine
  const state = try messages.get()
  return try stepped(messages, state.confirming ? { type: "keep" } as const : state.pane !== "Threads" ? { type: "back" } as const : state.searching ? { type: "closeSearch" } as const : undefined)
}

/** Back on Contacts: a delete question, the form, the open contact, then any active filter. */
export const contactsBack = effect {
  const contacts = try Contacts.Machine
  const state = try contacts.get()
  const step = state.confirming ? { type: "keep" } as const
    : state.form !== "Shut" && !Contacts.pending(state) ? { type: "discard" } as const
    : state.opened ? { type: "closeContact" } as const
    : Contacts.canClearFilter(state) ? { type: "clearFilter" } as const
    : undefined
  return try stepped(contacts, step)
}


// spec/app/shell/index.md, "Returning to the prior communications app keeps Ask Alpha open at its current height"
/** Return from Phone's Contacts tab once, then select the latest tab the owner chose. */
export effect function returnPhoneTab(wanted: () => Phone.Tab): void!!(Phone.Machine | Shell.Machine) {
  const shell = try Shell.Machine
  const handset = try Phone.Machine
  const before = try shell.get()
  if (before.trail.at(-1) !== "Contacts" || before.trail.at(-2) !== "Phone") return
  const sameTrail = (where: Shell.Shell) => where.trail.length === before.trail.length && where.trail.every((view, at) => view === before.trail[at])
  const back = { type: "goBack" } as const
  const typing = before.assistant === "Typing"
  if (typing && !(try contained(shell.send(back, (where) => where.route === before.route && sameTrail(where) && where.assistant === "Typing"), "leaving typing for the Phone tabs"))) return
  const from = try shell.get()
  if (from.route !== before.route + (typing ? 1 : 0) || !sameTrail(from) || from.assistant === "Typing") return
  const go = from.assistant === "Bar" ? back : { type: "returnCommsView", previous: "Phone" } as const
  if (!(try contained(shell.send(go, (where) => where.route === from.route && sameTrail(where) && where.assistant === from.assistant), "returning to Phone from Contacts"))) return
  const front = timeout(Stream.runHead(Stream.filter(handset.changes, (state) => state.front)), "2 seconds") catch () => Option.none()
  const where = try shell.get()
  if (Option.isNone(front) || where.route !== from.route + 1 || where.trail.length !== before.trail.length - 1 || where.trail.some((view, at) => view !== before.trail[at])) return
  const state = try handset.get()
  const tab = wanted()
  if (state.front && Phone.canPickTab(state, tab)) {
    try contained(handset.send({ type: "pickTab", tab }, (current) => current.front && current.tab === state.tab), "selecting the Phone tab")
  }
}
