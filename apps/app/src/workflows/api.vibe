// spec/app/workflows/list.md, "The list is read from the agent for the owner signed in, one reading at a time"; spec/app/workflows/index.md, "Story: Open a workflow"
import { RuntimeRequestError } from "@elizaos/agent"
import { type WorkflowClient, type WorkflowRequest, workflowClient, workflowHttpError } from "@elizaos/plugin-workflow-client"
import { Agent } from "../platform/index.vibe"
import { ask } from "../platform/index.vibe"

export service WorkflowsApi {
  readonly workflow: WorkflowClient
  readonly request: WorkflowRequest
  scope(owner: string): void!!
}

module zone {
  /** The device's current IANA time zone, falling back to UTC. @throws {never} */
  export function localTimeZone(): string {
    return Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC"
  }
}
export { localTimeZone } from zone

/** Read and keep the reply only while the same owner still holds the request. */
export function checkedWorkflowRequest(request: WorkflowRequest, current: boolean!!): WorkflowRequest {
  return effect (path, body) => {
    if (!(try current)) throw workflowHttpError(0, {})
    const received = try request(path, body)
    if (!(try current)) throw workflowHttpError(0, {})
    return received
  }
}

/** A ready model can send the change it has queued. */
export function sendChangeWhenReady(ready: boolean): { readonly type: "sendChange" } | undefined {
  return ready ? { type: "sendChange" } : undefined
}

export const workflowsApi = Layer.effect(WorkflowsApi, effect {
  const { runtime } = try Agent
  const inFlight = new Map<string, Promise<unknown>>()
  let currentOwner = ""
  const read = (path: string) => {
    const key = `${currentOwner}\0${path}`
    const pending = inFlight.get(key)
    if (pending !== undefined) return pending
    const fresh = runtime.request(path).finally(() => {
      if (inFlight.get(key) === fresh) inFlight.delete(key)
    })
    inFlight.set(key, fresh)
    return fresh
  }
  const request: WorkflowRequest = effect (path: string, body: unknown) => try tryPromise({
    try: () => body === undefined ? read(path) : runtime.request(path, body),
    catch: (error) => error instanceof RuntimeRequestError
      ? workflowHttpError(error.status, { code: error.code, error: error.message })
      : workflowHttpError(0, {}),
  })
  return {
    workflow: workflowClient(request),
    request,
    scope: (owner: string) => sync(() => {
      if (owner === currentOwner) return
      currentOwner = owner
      inFlight.clear()
    }),
  }
})

const Identifier = Schema.NonEmptyString

const Once = { triggerType: Schema.Literal("once"), scheduledAtIso: Schema.NonEmptyString }
const Recurring = { triggerType: Schema.Literal("cron"), cronExpression: Schema.NonEmptyString }
const OnEvent = { triggerType: Schema.Literal("event"), eventKind: Schema.NonEmptyString }
const PromptFields = {
  id: Identifier,
  displayName: Schema.String,
  instructions: Schema.String,
  enabled: Schema.Boolean,
  revision: Schema.Int,
  timezone: Schema.NonEmptyString,
}
export const PromptSchema = Schema.Union([
  Schema.Struct({ ...PromptFields, ...Once }),
  Schema.Struct({ ...PromptFields, ...Recurring }),
  Schema.Struct({ ...PromptFields, ...OnEvent }),
])
export type Prompt = typeof PromptSchema.Type
type TimingOf<Variant> = Variant extends Prompt ? Omit<Variant, keyof typeof PromptFields> : never
export type PromptTiming = TimingOf<Prompt>

export schema ScheduledTask {
  readonly taskId: Identifier
  readonly kind: string
  readonly ownerVisible: boolean
  readonly promptInstructions: string
  readonly state: { readonly status: string; readonly firedAt?: string; readonly lastDecisionLog?: string }
  readonly trigger: { readonly kind: "once" | "cron" | "manual"; readonly atIso?: string; readonly expression?: string; readonly tz?: string }
}

const AgentFailure = Schema.Struct({
  lastCloudFailure: Schema.optionalKey(Schema.NullOr(Schema.Struct({ kind: Schema.String }))),
})

export effect function readAgentFailure() {
  return map(ask(Agent, HttpClientRequest.get("/api/status"), AgentFailure), ({ lastCloudFailure }) => lastCloudFailure?.kind) catch () => undefined
}

const Triggers = Schema.Struct({ triggers: Schema.Array(PromptSchema) })
const Tasks = Schema.Struct({ tasks: Schema.Array(ScheduledTask) })

export effect function readPrompts() {
  const { triggers } = try ask(Agent, HttpClientRequest.get("/api/triggers"), Triggers)
  return triggers
}

export effect function readSchedules() {
  const { tasks } = try ask(Agent, HttpClientRequest.get("/api/scheduled-tasks", { urlParams: { ownerVisibleOnly: "1" } }), Tasks)
  return tasks.filter((task) => task.ownerVisible)
}

export schema PromptRun {
  readonly startedAt: Schema.Int
  readonly finishedAt: Schema.Int
  readonly status: string
  readonly error?: string
}

const TriggerRuns = Schema.Struct({ runs: Schema.Array(PromptRun) })

export effect function readPromptRuns(id: string) {
  const { runs } = try ask(Agent, HttpClientRequest.get(`/api/triggers/${encodeURIComponent(id)}/runs`), TriggerRuns)
  return runs
}
