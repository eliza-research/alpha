import { Conversations, Inbox, elsewhere, noticeTransport } from "./messages.vibe"

/** A picture the owner attached: what the phone says it is, and its bytes. */
export interface Picture {
  readonly name: string
  readonly wireName?: string
  readonly contentType: MmsAttachmentType
  readonly bytes: Uint8Array
}

interface PictureOffer {
  readonly ticket: number
  readonly picture: Picture
}

/** The New message has its own address and body, independent of the drafts saved per conversation. */
export interface NewMessageDraft {
  readonly revision: number
  readonly recipients: string
  readonly body: string
  readonly pictures: ReadonlyArray<Picture>
  readonly androidInbound?: AndroidInboundDraft
}

/** What one send carries, kept from Send until its record is retired, so that a send read back after a restart is the same one. */
export interface Outgoing {
  readonly thread: number
  readonly to: ReadonlyArray<string>
  readonly body: string
  readonly sim: number | null
  readonly selectedSim?: TelephonySubscription | undefined
  readonly trustedTap?: boolean | undefined
  readonly pictures: ReadonlyArray<Picture>
  readonly pictured: boolean
  readonly operation: OperationId | undefined
  readonly mms: MmsReceiptBinding | undefined
  readonly status: SmsSendStatus | undefined
  readonly draft?: DraftReference | undefined
  readonly replaces?: number | undefined
}

interface MmsReceiptBinding {
  readonly hash: string
  readonly attachments: MmsBinding["attachments"]
}

/** The SIM the owner picked for this conversation, held only while Alpha is open. */
export interface PickedSubscription {
  readonly thread: number
  readonly subscription: TelephonySubscription
}

interface SubscriptionChoice {
  readonly get: () => PickedSubscription | undefined
  readonly subscribe: (listener: () => void) => () => void
  readonly pick: (thread: number, subscription: TelephonySubscription) => void
  readonly leave: (thread: number) => void
}

type NewMessageOpening = { readonly route: number; readonly address: string; readonly phase: "Opening" | "OpenFailed" }
type NewMessagePrefill = { readonly route: number; readonly address: string; readonly visit: number; readonly phase: "Saving" | "SaveFailed" }
export type NewMessageHandoff = NewMessageOpening | NewMessagePrefill

interface MessageHandoff {
  readonly get: () => NewMessageHandoff | undefined
  readonly subscribe: (listener: () => void) => () => void
  readonly replace: (expected: NewMessageHandoff | undefined, next: NewMessageHandoff | undefined) => void
}

/** The texts behind the composer: each conversation's draft, saved on the phone, the pictures of the open one, and the send in hand. */
export service Drafts {
  text(thread: number): string!!
  pictures(thread: number): ReadonlyArray<Picture>!!
  loadConversation(thread: number): (string | undefined)!!
  retireConversation(thread: number, observed: string): void!!
  readonly conversations: ConversationDrafts
  readonly edits: Semaphore.Semaphore
  newDraft(): NewMessageDraft!!
  openNewDraft(current: boolean!!): boolean!!Telephony
  saveNewDraft(draft: NewMessageDraft): boolean!!
  adoptNewSettlement(held: HeldDraft): void!!
  readonly newVisits: Semaphore.Semaphore
  readonly messageHandoff: MessageHandoff
  /** Owner interaction can take over the Messages surface while a native read is pending. */
  readonly messageTouches: { readonly version: () => number; readonly touch: () => void }
  subscriptions(): ReadonlyArray<TelephonySubscription>!!
  setSubscriptions(subscriptions: ReadonlyArray<TelephonySubscription>): void!!
  readonly subscriptionChoice: SubscriptionChoice
  offeredPicture(): (PictureOffer | undefined)!!
  setOfferedPicture(offer: PictureOffer | undefined): void!!
  outgoing(): Option.Option<Outgoing>!!
  sealedOutgoing(): Option.Option<Outgoing>!!
  setOutgoing(outgoing: Outgoing): void!!
  bindOutgoing(outgoing: Outgoing, replaces: OperationId | undefined): boolean!!
  retireOutgoing(operation: OperationId): void!!
  /** What the phone last said it can send itself: texts directly, and pictures. */
  sending(): { readonly direct: boolean; readonly pictures: boolean }!!
  setSending(sending: { readonly direct: boolean; readonly pictures: boolean }): void!!
}

const draftKey = (thread: number) => `alpha/messages/draft/${thread}@1`
const newDraftKey = "alpha/messages/draft/new@1"
const outgoingKey = "alpha/messages/outgoing@1"
const secureOutgoing: SmsOutgoingSlot = "sms-outgoing:v2:device"
const newSource = { kind: "new" } as const
const emptyNewDraft: NewMessageDraft = { revision: 0, recipients: "", body: "", pictures: [] }

function newContents(held: HeldDraft): NewMessageDraft {
  const found = held.record
  return found !== null && "recipients" in found ? found : emptyNewDraft
}

module text {
  import { MMS_ATTACHMENT_TYPES, MMS_MAX_ATTACHMENTS, MMS_MAX_TOTAL_BYTES, mmsBindingText, operationIdOf, type MmsAttachmentBinding, type MmsBinding, type OperationId } from "@elizaos/os-bridges"
  import { decodeDraftReference, type DraftReference } from "./draft-record.vibe"

  type Binding = { hash: string; attachments: MmsAttachmentBinding[] }
  const digest = /^[a-f0-9]{64}$/

  function record(value: unknown): Record<string, unknown> | undefined {
    return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : undefined
  }

  function positive(value: unknown): value is number {
    return typeof value === "number" && Number.isSafeInteger(value) && value > 0
  }

  /** The owner may reopen New after Back or a restart. An unopened state is the empty draft. @throws {never} */
  export function keptNewDraft(raw: string | undefined): { revision: number; recipients: string; body: string; pictures: never[] } {
    const empty = { revision: 0, recipients: "", body: "", pictures: [] }
    if (raw === undefined) return empty
    try {
      const row = record(JSON.parse(raw))
      if (row && positive(row.revision) && typeof row.recipients === "string" && typeof row.body === "string") {
        return { revision: row.revision, recipients: row.recipients, body: row.body, pictures: [] }
      }
      return empty
    } catch {
      return empty
    }
  }

  /** Add the New source to the prior durable Composer state without changing its journal scope. @throws {never} */
  export function withNewSource(raw: string | undefined): string | undefined {
    if (raw === undefined) return undefined
    try {
      const state = record(JSON.parse(raw))
      return state && !("newSend" in state) ? JSON.stringify({ ...state, newSend: { visit: 0, revision: 0 } }) : raw
    } catch { return raw }
  }

  function retainedBinding(value: unknown): Binding | undefined {
    const fields = record(value)
    if (fields === undefined || typeof fields.hash !== "string" || !digest.test(fields.hash)
      || !Array.isArray(fields.attachments) || fields.attachments.length > MMS_MAX_ATTACHMENTS) return undefined
    const attachments: MmsAttachmentBinding[] = []
    let size = 0
    for (const item of fields.attachments) {
      const row = record(item)
      const type = MMS_ATTACHMENT_TYPES.find((kind) => kind === row?.contentType)
      if (row === undefined || type === undefined || typeof row.name !== "string" || row.name.length === 0 || row.name.length > 64
        || typeof row.sha256 !== "string" || !digest.test(row.sha256) || typeof row.size !== "number" || !Number.isSafeInteger(row.size)
        || row.size <= 0 || size + row.size > MMS_MAX_TOTAL_BYTES) return undefined
      size += row.size
      attachments.push({ contentType: type, name: row.name, sha256: row.sha256, size: row.size })
    }
    return { hash: fields.hash, attachments }
  }

  /** What the store kept for the send in hand. It never keeps an attachment's bytes. @throws {never} */
  export function keptSend(raw: string | undefined): { thread: number; to: string[]; body: string; sim: number | null; pictures: never[]; pictured: boolean; operation: OperationId | undefined; mms: Binding | undefined; status: undefined; draft: DraftReference | undefined } | undefined {
    if (raw === undefined) return undefined
    try {
      const found = record(JSON.parse(raw))
      if (found === undefined || typeof found.thread !== "number" || !Number.isSafeInteger(found.thread) || found.thread <= 0
        || !Array.isArray(found.to) || !found.to.every((one): one is string => typeof one === "string") || typeof found.body !== "string"
        || !(found.sim === null || typeof found.sim === "number" && Number.isSafeInteger(found.sim) && found.sim >= 0)) return undefined
      return {
        thread: found.thread, to: found.to, body: found.body, sim: found.sim, pictures: [], pictured: found.pictured !== false,
        operation: operationIdOf(found.operation) ?? undefined, mms: retainedBinding(found.mms), status: undefined, draft: decodeDraftReference(found.draft),
      }
    } catch {
      return undefined
    }
  }
  /** The send in hand as the store keeps it. @throws {never} */
  export function keepSend(outgoing: { readonly pictures: ReadonlyArray<unknown>; readonly pictured: boolean }): string {
    return JSON.stringify({ ...outgoing, pictures: [], pictured: outgoing.pictured || outgoing.pictures.length > 0 })
  }

  /** New metadata leaves the existing attempt epoch, draft author table and send journal intact. @throws {never} */
  export function withDraftCustody(raw: string | undefined): string | undefined {
    if (raw === undefined) return undefined
    try {
      const state = record(JSON.parse(raw))
      if (state === undefined || "pendingClear" in state) return raw
      return JSON.stringify({ ...state, carriedDraft: { author: "Nobody", pictures: 0 }, savedPictures: 0, saveFailed: false,
        sendRevision: 0, pendingClear: { source: "ConversationDraft", thread: 0, revision: 0, id: 0, visit: 0 } })
    } catch {
      return raw
    }
  }

  export async function matchesBinding(binding: MmsBinding, expected: string): Promise<boolean> {
    const bytes = new TextEncoder().encode(mmsBindingText(binding))
    const found = new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))
    return Array.from(found, (one) => one.toString(16).padStart(2, "0")).join("") === expected
  }

  /** @throws {never} */
  export function canDigest(): boolean {
    return typeof globalThis.crypto?.subtle?.digest === "function"
  }

  /** A distinct name when the owner attaches another file with the same filename, such as a second camera capture. @throws {never} */
  export function uniquePictureName(name: string, taken: ReadonlySet<string>): string {
    if (!taken.has(name)) return name
    const dot = name.lastIndexOf(".")
    const stem = dot > 0 ? name.slice(0, dot) : name
    const ext = dot > 0 ? name.slice(dot) : ""
    for (let n = 2; n < 1000; n += 1) {
      const candidate = `${stem}-${n}${ext}`
      if (!taken.has(candidate)) return candidate
    }
    return `${stem}-${taken.size + 1}${ext}`
  }
}
import { canDigest, keepSend, keptNewDraft, keptSend, matchesBinding, uniquePictureName, withDraftCustody, withNewSource } from text

const drafts = Layer.effect(Drafts, effect {
  const store = try KeyValueStore.KeyValueStore
  const vault = try Vault
  const conversations = makeConversationDrafts()
  const edits = try Semaphore.make(1)
  const newVisits = try Semaphore.make(1)
  let touches = 0
  const messageTouches = { version: () => touches, touch: () => { touches += 1 } }
  let handing: NewMessageHandoff | undefined
  const handoffListeners = new Set<() => void>()
  const messageHandoff: MessageHandoff = {
    get: () => handing,
    subscribe: (listener) => {
      handoffListeners.add(listener)
      return () => { handoffListeners.delete(listener) }
    },
    replace: (expected, next) => {
      if (handing !== expected) return
      handing = next
      for (const listener of handoffListeners) listener()
    },
  }
  let fresh: NewMessageDraft = emptyNewDraft
  let heldNew: HeldDraft | undefined
  let subscriptions: ReadonlyArray<TelephonySubscription> = []
  let picked: PickedSubscription | undefined
  const simListeners = new Set<() => void>()
  const showPick = () => { for (const listener of simListeners) listener() }
  const subscriptionChoice: SubscriptionChoice = {
    get: () => picked,
    subscribe: (listener) => {
      simListeners.add(listener)
      return () => { simListeners.delete(listener) }
    },
    pick: (thread, subscription) => {
      if (picked?.thread === thread && sameSubscription(picked.subscription, subscription)) return
      picked = { thread, subscription }
      showPick()
    },
    leave: (thread) => {
      if (picked?.thread !== thread) return
      picked = undefined
      showPick()
    },
  }
  let offeredPicture: PictureOffer | undefined
  let sending = { direct: false, pictures: false }
  let retained = vault.read(secureOutgoing) catch () => undefined
  const earlier = store.get(outgoingKey) catch () => undefined
  if (retained !== undefined && Option.isNone(retained) && earlier !== undefined && keptSend(earlier)?.operation !== undefined) {
    const copy = Redacted.make(earlier)
    if ((vault.compareAndExchange(secureOutgoing, null, copy) catch () => undefined) === "saved") {
      retained = Option.some(copy)
    } else {
      retained = vault.read(secureOutgoing) catch () => undefined
    }
  }
  const sealedSend = () => retained !== undefined && Option.isSome(retained) ? Redacted.value(retained.value) : undefined
  if (earlier !== undefined && sealedSend() === earlier) try ignore(store.remove(outgoingKey))
  let outgoing: Option.Option<Outgoing> = Option.fromNullishOr(keptSend(sealedSend() ?? earlier))
  const savingSend = try Semaphore.make(1)
  return {
    text: (thread: number) => sync(() => conversations.current(thread)?.body ?? ""),
    pictures: (thread: number) => sync(() => conversations.current(thread)?.pictures ?? []),
    effect loadConversation(thread: number): (string | undefined)!! {
      return store.get(draftKey(thread)) catch () => undefined
    },
    effect retireConversation(thread: number, observed: string): void!! {
      const key = draftKey(thread)
      if ((store.get(key) catch () => undefined) === observed) try ignore(store.remove(key))
    },
    conversations,
    edits,
    newVisits,
    messageHandoff,
    messageTouches,
    newDraft: () => sync(() => fresh),
    effect openNewDraft(current: boolean!!): boolean!!Telephony {
      const initial = Effect.provideService(openDraftRecord(newSource), Vault, vault) catch () => undefined
      if (initial === undefined) return false
      let found: HeldDraft = initial
      const raw = store.get(newDraftKey) catch () => undefined
      const plain = keptNewDraft(raw)
      if (found.record === null || found.record.revision <= 2) {
        const legacy = readLegacySmsDraft(newSource) catch () => undefined
        if (!(try current) || (legacy === undefined && found.record === null)) return false
        if (legacy !== null && legacy !== undefined) {
          const recovered = Effect.provideService(recoverLegacySmsDraft(found, legacy, current), Vault, vault) catch () => undefined
          if (recovered?.kind === "ready") found = recovered.draft
          else if (recovered?.kind === "pending" || found.record === null) return false
        } else if (found.record === null && raw !== undefined) {
          if (plain.revision <= 0) return false
          const migrated = Effect.provideService(writeDraftRecord(found, { ...plain, source: newSource, author: plain.body === "" ? "Nobody" : "OwnerWrote" }), Vault, vault) catch () => undefined
          if (migrated === undefined) return false
          found = migrated
        }
      }
      if (!(try current)) return false
      fresh = newContents(found)
      heldNew = found
      if (raw !== undefined && fresh.revision === plain.revision && fresh.body === plain.body && fresh.recipients === plain.recipients &&
          (store.get(newDraftKey) catch () => undefined) === raw) try ignore(store.remove(newDraftKey))
      return true
    },
    effect saveNewDraft(draft: NewMessageDraft): boolean!! {
      const current = heldNew
      if (current === undefined || draft.revision !== fresh.revision + 1) return false
      const found = Effect.provideService(writeDraftRecord(current, { ...draft, source: newSource, author: draft.body === "" ? "Nobody" : "OwnerWrote" }), Vault, vault) catch () => undefined
      if (found === undefined) return false
      heldNew = found
      fresh = newContents(found)
      return true
    },
    adoptNewSettlement: (held: HeldDraft) => sync(() => {
      if (held.source.kind !== "new") return
      heldNew = held
      fresh = newContents(held)
    }),
    subscriptions: () => sync(() => subscriptions),
    setSubscriptions: (next: ReadonlyArray<TelephonySubscription>) => sync(() => { subscriptions = next }),
    subscriptionChoice,
    offeredPicture: () => sync(() => offeredPicture),
    setOfferedPicture: (offer: PictureOffer | undefined) => sync(() => { offeredPicture = offer }),
    outgoing: () => sync(() => outgoing),
    sealedOutgoing: () => sync(() => Option.fromNullishOr(keptSend(sealedSend()))),
    sending: () => sync(() => sending),
    setSending: (next: { readonly direct: boolean; readonly pictures: boolean }) => sync(() => { sending = next }),
    setOutgoing: (next: Outgoing) => sync(() => { outgoing = Option.some(next) }),
    effect bindOutgoing(next: Outgoing, replaces: OperationId | undefined): boolean!! {
      return try Semaphore.withPermit(savingSend, effect {
        const held = retained
        if (held === undefined || next.operation === undefined) return false
        const saved = keptSend(sealedSend())
        if (Option.isSome(held) && (saved?.operation === undefined || (saved.operation !== next.operation && saved.operation !== replaces))) return false
        const raw = Redacted.make(keepSend(next))
        const status = vault.compareAndExchange(secureOutgoing, Option.getOrNull(held), raw) catch () => undefined
        if (status !== "saved") return false
        retained = Option.some(raw)
        outgoing = Option.some(next)
        return true
      })
    },
    effect retireOutgoing(operation: OperationId): void!! {
      try Semaphore.withPermit(savingSend, effect {
        const held = retained
        if (held !== undefined && Option.isSome(held) && keptSend(Redacted.value(held.value))?.operation === operation) {
          const status = vault.compareAndExchange(secureOutgoing, held.value, null) catch () => undefined
          if (status !== "saved") return
          retained = Option.none()
        }
        const saved = keptSend(store.get(outgoingKey) catch () => undefined)
        if (saved?.operation === operation) try ignore(store.remove(outgoingKey))
        if (Option.isSome(outgoing) && outgoing.value.operation === operation) outgoing = Option.none()
      })
    },
  }
})

// spec/app/messages/composer.md, "The phone says how many SIMs it has, and with more than one the owner picks one, which needs SIM access"
/** Whether Android still reports the same subscription at the reviewed slot and carrier. */
export function sameSubscription(one: TelephonySubscription, other: TelephonySubscription): boolean {
  return one.id === other.id && one.slot === other.slot && one.carrierName === other.carrierName && one.displayName === other.displayName
}

effect function rememberSims(sims: ReadonlyArray<TelephonySubscription>): void!!(Drafts | Composer.Machine) {
  const composer = try Composer.Machine
  try (try Drafts).setSubscriptions(sims)
  const count = Math.max(1, sims.length)
  if ((try composer.get()).sims !== count) try contained(composer.send({ type: "simsReported", count }), "the SIMs")
}

/** The still-active SIM the owner picked, or Android's default or sole SIM if they did not choose one. */
effect function simOf(chosen: TelephonySubscription | undefined): (number | undefined)!!(Telephony | Drafts | Composer.Machine) {
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  if (status === undefined) return undefined
  const sims = status.subscriptions ?? []
  try rememberSims(sims)
  if (chosen !== undefined) return sims.find((sim) => sameSubscription(sim, chosen))?.id
  return textingDefault(sims)
}

const sentStatuses = new Set<SmsSendStatus>(["sent", "delivered"])
const usingMms = (recipients: number, pictured: boolean) => recipients > 1 || pictured

function mmsReview(send: Outgoing, sim: number): MmsReview {
  return { recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim, attachments: send.pictures.map((one) => ({ name: one.wireName ?? one.name, contentType: one.contentType, bytes: one.bytes })) }
}

effect function receiptOf(send: Outgoing, sim: number, operation: OperationId): (SmsSendStatus | undefined)!!Telephony {
  if (usingMms(send.to.length, send.pictured)) {
    if (send.mms === undefined) {
      if (send.pictured) return undefined
      const receipt = telephony("mmsSendResult", (c) => c.messages.mmsSendResult(mmsReview(send, sim), operation)) catch () => undefined
      return receipt?.status
    }
    const binding: MmsBinding = { recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim, attachments: send.mms.attachments }
    const hash = send.mms.hash
    const matches = tryPromise(() => matchesBinding(binding, hash)) catch () => false
    if (!matches) return undefined
    const receipt = telephony("mmsSendResult", (c) => c.mmsReceipt(binding, operation, hash)) catch () => undefined
    return receipt?.status
  }
  const receipt = telephony("smsSendResult", (c) => c.messages.smsSendResult({ recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim }, operation)) catch () => undefined
  return receipt?.status
}

/** Only evidence of refusal before native dispatch permits a fresh attempt. */
function refusedSend(failure: TelephonyAbsent | TelephonyRefused): (SmsSendStatus | undefined) {
  if (failure instanceof TelephonyAbsent) return "denied"
  if (failure.tag === "InvalidMessageRequest" || failure.tag === "SmsSendRefused" || failure.tag === "SmsSendNotAttempted"
    || failure.code === "busy" || failure.code === "too-large" || failure.code === "composer-not-started") return "denied"
  return undefined
}

// spec/app/messages/sending.md, "Send journals a new operation, or reads the journal back when the last outcome is unknown"; spec/app/messages/sending.md, "The journal entry lands, or the phone denies the send before any radio is used"
/** The send under its operation's key: the phone journals it before it uses the radio, and the same key never sends twice. */
function journaled(id: number, recipients: number): Stream.Stream<Event, never, Telephony | Drafts | Attempts | Composer.Machine | Phone | Messages | Shell> {
  return Stream.unwrap(effect {
    const store = try Drafts
    const phone = try Phone
    const composer = try Composer.Machine
    const messages = try Messages
    const shell = try Shell
    const denied = Stream.succeed<Event>({ type: "journaled", id, allowed: false })
    const held = try store.outgoing()
    if (Option.isNone(held) || !canDigest()) return denied
    const send = held.value
    const fresh = (try composer.get()).newSend
    const openThread = (state: MessagesState) => fresh.revision === 0
      ? state.front && state.pane === "Conversation" && state.thread === send.thread
      : holdsNewDraft(state, fresh.visit) && state.newDraft.revision === fresh.revision && state.newDraft.recipient === send.thread && !state.newDraft.picking
    const current = effect () => {
      const { outgoing, newSend } = try composer.get()
      return outgoing.op.id === id && outgoing.op.outcome === "Recorded" && outgoing.thread === send.thread
        && outgoing.recipients === recipients && send.to.length === recipients && clear(try phone.get()) && openThread(try messages.get())
        && (fresh.revision === 0 || (newSend.visit === fresh.visit && newSend.revision === fresh.revision
          && fresh.revision === (try store.newDraft()).revision && showing(try shell.get(), "Messages")))
    }
    if (!(try current()) || send.operation !== undefined) return denied
    const operation = (try (try Attempts).key(id)) as OperationId
    const sim = send.selectedSim?.id ?? (try simOf(undefined))
    if (sim === undefined) return denied
    const review = usingMms(send.to.length, send.pictured) ? mmsReview(send, sim) : undefined
    const bound = review === undefined ? undefined : (tryPromise(() => mmsBinding(review)) catch () => undefined)
    if (review !== undefined && bound === undefined) return denied
    if (send.selectedSim !== undefined && (try simOf(send.selectedSim)) !== sim) return denied
    const still = try store.outgoing()
    if (Option.isNone(still) || still.value !== send || !(try current())) return denied
    let replaces = send.replaces === undefined ? undefined : (try (try Attempts).key(send.replaces)) as OperationId
    const prior = try store.sealedOutgoing()
    if (Option.isSome(prior) && prior.value.sim !== null && prior.value.operation !== undefined && prior.value.operation !== replaces) {
      const status = try receiptOf(prior.value, prior.value.sim, prior.value.operation)
      if (status !== undefined && status !== "submitted" && status !== "unknown") replaces = prior.value.operation
    }
    if (!(try current())) return denied
    const next: Outgoing = { ...send, sim, selectedSim: undefined, trustedTap: undefined, replaces: undefined, operation, mms: bound === undefined ? undefined : { hash: bound.hash, attachments: bound.binding.attachments } }
    if (!(try store.bindOutgoing(next, replaces)) || !(try current())) return denied
    const to = send.to as PhoneNumber[]
    const wire = effect {
      return sendFromComposer(send.trustedTap === true, () => runPromise(current()), (client) => {
        const sent = review !== undefined ? client.sendMms(review, operation)
          : client.sendSms({ recipients: to, body: send.body, subscriptionId: sim } satisfies SmsReview & { subscriptionId: number }, operation)
        return sent.then((receipt) => receipt.status)
      }) catch (failure) => refusedSend(failure)
    }
    const left = Effect.as(Stream.runHead(Stream.filter(messages.changes, (state) => !openThread(state))), undefined)
    const status = try race(wire, left)
    const latest = try store.outgoing()
    const resolved = Option.isSome(latest) && latest.value.operation === operation ? latest.value.status ?? status : status
    if (Option.isSome(latest) && latest.value.operation === operation) try store.setOutgoing({ ...latest.value, status: resolved })
    if (resolved === undefined) return Stream.succeed<Event>({ type: "lost" })
    if (resolved === "denied" || resolved === "cancelled") return Stream.succeed<Event>({ type: "journaled", id, allowed: false })
    return Stream.fromIterable<Event>([{ type: "journaled", id, allowed: true }, ...Array.from({ length: recipients }, (): Event => ({ type: "transmit", id }))])
  })
}

// spec/app/messages/sending.md, "The radio reports each part sent or failed, and the send ends when every recipient has an answer"
effect function radioed(id: number): Event!!(Drafts | Telephony) {
  const store = try Drafts
  const held = try store.outgoing()
  if (Option.isNone(held)) return { type: "lost" }
  const send = held.value
  let status = send.status
  if (status === "submitted" && send.sim !== null && send.operation !== undefined) {
    const sim = send.sim
    const operation = send.operation
    status = try receiptOf(send, sim, operation)
    if (status === "submitted" && !usingMms(send.to.length, send.pictured)) {
      const noticed = Stream.runHead(Stream.filter(
        Stream.callback<OperationId, never, Telephony>((queue) => Effect.asVoid(acquireRelease(
          Effect.orElseSucceed(telephony("observeMessages", (c) => c.messages.observeMessages(() => {}, (op) => { Queue.offerUnsafe(queue, op) }, (op) => { Queue.offerUnsafe(queue, op) })), () => undefined),
          (unsubscribe) => (unsubscribe === undefined ? Effect.void : ignore(tryPromise(() => unsubscribe()))),
        ))),
        (op) => op === operation,
      ))
      for (let attempt = 0; status === "submitted" && attempt < 3; attempt += 1) {
        try race(noticed, sleep("100 millis"))
        status = try receiptOf(send, sim, operation)
      }
    }
    if (status !== undefined && status !== "submitted") {
      const latest = try store.outgoing()
      if (Option.isSome(latest) && latest.value.operation === operation) try store.setOutgoing({ ...latest.value, status })
    }
  }
  return status === undefined || status === "unknown" || status === "submitted" ? { type: "lost" } : { type: "partSent", id, ok: sentStatuses.has(status) }
}

// spec/app/messages/sending.md, "The journal read back settles an unknown outcome: sent, or never sent"
effect function readBack(id: number): Event!!(Telephony | Drafts | Attempts | Composer.Machine) {
  const held = try (try Drafts).outgoing()
  const operation = (try (try Attempts).key(id)) as OperationId
  const state = try (try Composer.Machine).get()
  if (Option.isNone(held) || held.value.operation !== operation || held.value.thread !== state.outgoing.thread) {
    return { type: "readBack", id, wasSent: false, known: false }
  }
  const send = held.value
  const status = send.sim === null ? undefined : try receiptOf(send, send.sim, operation)
  return { type: "readBack", id, wasSent: status !== undefined && sentStatuses.has(status), known: status !== undefined && status !== "unknown" && status !== "submitted" }
}

function sending(fx: SendOut): Job<Event, Telephony | Drafts | Attempts | Composer.Machine | Phone | Messages | Shell, []> {
  return match (fx) {
    when { tag: "Journal", let id, let recipients }: stream(`send ${id}`, journaled(id, recipients), { type: "lost" });
    when { tag: "Radio", let id, let recipient }: answer(`radio ${id} ${recipient}`, radioed(id), { type: "lost" });
    when { tag: "ReadJournal", let id }: answer(`read back ${id}`, readBack(id), { type: "readBack", id, wasSent: false, known: false });
    when { tag: "Tombstone", let id }: run("retired", effect {
      const operation = (try (try Attempts).key(id)) as OperationId
      try (try Drafts).retireOutgoing(operation)
    });
  }
}

/** What the agent answers to `POST /api/messages/reply-draft`: one short reply for the owner to read, or none. */
const Drafted = Schema.Struct({ draft: Schema.NullOr(Schema.String) })

/** The open conversation's tail as the agent's drafter reads it, oldest first. */
const tailLength = 20

type DraftEdit = Extract<Event, { type: "typeText" | "attach" | "detach" | "undo" | "agentDrafted" | "suggested" }>

/** Give the machine the edit only while its exact payload is waiting for the corresponding save. */
effect function stageEdit<R = never>(thread: number, event: DraftEdit, change: Partial<DraftContent>, check: boolean!!R = succeed(true)): boolean!!(Drafts | Composer.Machine | R) {
  const store = try Drafts
  const machine = try Composer.Machine
  return try Semaphore.withPermit(store.edits, effect {
    if (!(try check)) return false
    const before = try machine.get()
    if (before.thread !== thread || Composer.bound(before)) return false
    if ((event.type === "agentDrafted" || event.type === "suggested") && (before.slot.author !== "Nobody" || before.pictures !== 0)) return false
    const pending = store.conversations.stage(thread, before.slot.draft.edits + 1, change)
    if (pending === undefined) return false
    const result = machine.send(event, (current) => current.thread === thread && current.slot.draft.edits === before.slot.draft.edits) catch () => undefined
    if (result !== undefined && result.state.slot.draft.edits === pending.edits) return true
    store.conversations.rollback(pending)
    return false
  })
}

export effect function writeMessageDraft(thread: number, body: string): boolean!!(Drafts | Composer.Machine) {
  return try stageEdit(thread, { type: "typeText", empty: body === "" }, { body })
}

export effect function offerMessageDraft<R = never>(thread: number, body: string, current: boolean!!R = succeed(true)): boolean!!(Drafts | Composer.Machine | R) {
  if (body.trim() === "" || body.length > MMS_MAX_BODY) return false
  return try stageEdit(thread, { type: "agentDrafted", thread }, { body }, current)
}

export effect function discardMessageDraft(thread: number): void!!(Drafts | Composer.Machine) {
  try stageEdit(thread, { type: "undo" }, { body: "" })
}

export effect function takeSavedMessageDraft(thread: number): void!!(Drafts | Composer.Machine) {
  const store = try Drafts
  const machine = try Composer.Machine
  try Semaphore.withPermit(store.edits, effect {
    const state = try machine.get()
    if (state.thread !== thread || !Composer.canTakeSaved(state) || !store.conversations.takeSaved(thread)) return
    try contained(machine.send({ type: "takeSaved" }), "using the saved draft")
  })
}

export effect function removeMessagePicture(thread: number, at: number): void!!(Drafts | Composer.Machine) {
  const pictures = try (try Drafts).pictures(thread)
  if (at < 0 || at >= pictures.length) return
  try stageEdit(thread, { type: "detach" }, { pictures: pictures.filter((_, index) => index !== at) })
}

// spec/app/messages/composer.md, "Alpha's suggestion is asked for only when the draft is empty, and lands only if it still is"
/** Alpha's draft for `thread`, asked of the agent from the messages last read: it lands in the conversation's draft only while the owner has written nothing there. */
effect function suggestion(ticket: number, thread: number): void!!(Agent | Inbox | Drafts | Conversations | Messages | Composer.Machine) {
  const machine = try Composer.Machine
  const refuse = ignore(machine.send({ type: "suggested", ticket, ok: false }))
  const current = try (try Messages).get()
  if (!current.front || current.thread !== thread || current.sms.grant !== "Granted" || current.shown.rows === 0) return try refuse
  const visible = try (try Inbox).get()
  if (visible.messagesThread !== thread) return try refuse
  const rows = visible.messages.flatMap((row) => ("incomplete" in row ? [] : [{ direction: row.direction === "incoming" ? "in" : "out", date: row.date, body: row.body }]))
  const tail = [...rows].sort((a, b) => a.date - b.date).slice(-tailLength)
  const conversation = try (try Conversations).get(thread)
  const participant = Option.isSome(conversation) && conversation.value.addresses.length === 1 ? conversation.value.addresses[0] : null
  if (tail.length === 0 || tail[tail.length - 1].direction !== "in") return try refuse
  const answered = ask(Agent, HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post("/api/messages/reply-draft"), { participant, messages: tail, truncated: rows.length > tail.length }), Drafted) catch () => undefined
  const draft = answered?.draft?.trim() ?? ""
  if (draft === "" || draft.length > MMS_MAX_BODY || !(try stageEdit(thread, { type: "suggested", ticket, ok: true }, { body: draft }))) try refuse
}

effect function savedDraft(thread: number, base: number, edits: number, author: Composer.Author, pictures: number): Event!!(Drafts | Vault) {
  const result = try (try Drafts).conversations.persist(thread, base, edits, author, pictures)
  if (result.kind === "saved") return { type: "draftSaved", thread, base, edits }
  if (result.kind === "conflict") return { type: "draftCollided", thread, base, edits, held: result.revision, theirs: result.author, pictures: result.pictures }
  return { type: "draftSaveFailed", thread, base, edits }
}

/** A durable send record names the exact saved revision that the confirmed send can remove. */
effect function settleSentMessageDraft(clear: Composer.SentDraft): void!!(Drafts | Attempts | Composer.Machine | Vault | Conversations | Messages | Shell | Telephony) {
  const { source: kind, thread, revision, id, visit } = clear
  const machine = try Composer.Machine
  const store = try Drafts
  const expected = try (try Attempts).key(id)
  const outgoing = try store.sealedOutgoing()
  if (Option.isNone(outgoing) || outgoing.value.thread !== thread || outgoing.value.draft?.revision !== revision) return
  const operation = outgoing.value.operation
  if (operation === undefined || operation !== expected) return
  const { source } = outgoing.value.draft
  if ((kind === "NewMessageDraft") !== (source.kind === "new")) return
  if (source.kind === "new") {
    try Semaphore.withPermit(store.newVisits, effect {
      const held = openDraftRecord(source) catch () => undefined
      if (held === undefined) return
      const settled = settleDraftRecord(held, { source, revision, operation }) catch () => undefined
      if (settled === undefined) return
      try store.adoptNewSettlement(settled.draft)
      if (settled.kind === "settled") try finishNewMessage(thread, visit, revision)
      else {
        const messages = try Messages
        const page = try messages.get()
        const fresh = try store.newDraft()
        if (page.pane === "New" && page.newDraft.revision === revision) {
          if (fresh.revision > revision) {
            const recipient = try numberForNew(fresh)
            try contained(messages.send({ type: "editNewDraft", visit: page.newDraft.visit, revision: fresh.revision, thread: recipient, closePicker: false }), "loading the current New draft")
          } else {
            try contained(messages.send({ type: "back" }), "closing the replaced New draft")
          }
        }
      }
      try contained(machine.send({ type: "sentDraftCleared", source: kind, thread, revision, id, landedRevision: settled.kind === "settled" ? revision + 1 : 0 }), "confirming the sent New draft")
    })
    return
  }
  const held = openDraftRecord(source) catch () => undefined
  if (held === undefined) return
  const settled = settleDraftRecord(held, { source, revision, operation }) catch () => undefined
  if (settled === undefined) return
  const state = try machine.get()
  if (Composer.showsSentDraft(state, thread, revision)) {
    if (settled.kind === "settled") {
      if (!store.conversations.adoptSettlement(thread, settled.draft)) return
    } else {
      if (!(try contained(machine.send({ type: "closeDraft" }), "reopening the current saved message draft"))) return
      store.conversations.close(thread)
      try openMessageDraft(thread)
    }
  }
  const event = { type: "sentDraftCleared", source: kind, thread, revision, id, landedRevision: settled.kind === "settled" ? revision + 1 : 0 } as const
  try contained(machine.send(event), "confirming the sent draft")
}

function carry(fx: Out): Job<Event, Telephony | Drafts | Attempts | Conversations | Inbox | Agent | SystemSettings | Messages | Composer.Machine | Phone | Vault | Shell, []> {
  return match (fx) {
    when { tag: "SaveDraft", let thread, let author, let base, let edits, let pictures }: answer("save", savedDraft(thread, base, edits, author, pictures), { type: "draftSaveFailed", thread, base, edits });
    when { tag: "ClearSentDraft", let source, let thread, let revision, let id, let visit }: run(`clear sent ${id}`, settleSentMessageDraft({ source, thread, revision, id, visit }));
    when { tag: "Suggest", let ticket, let thread }: run("suggest", suggestion(ticket, thread));
    when { tag: "Prompt", let need }: answer("prompt", effect {
      const status = telephony("requestAccess", (c) => c.phone.requestAccess(need === "SendAccess" ? "sendSms" : "phoneState")) catch () => undefined
      if (status !== undefined) try rememberSims(status.subscriptions ?? [])
      return { type: "accessReported", need, grant: grantOf(need === "SendAccess" ? status?.permissions.sendSms : status?.permissions.phoneState) } satisfies Event
    }, { type: "accessReported", need, grant: "Unasked" });
    when { tag: "OpenSettings" }: run("settings", effect { try (try SystemSettings).open("AppPermissions", "") });
    when { tag: "OpenMessagingApp" }: run("elsewhere", effect {
      const state = try (try Composer.Machine).get()
      try elsewhere(state.thread, state.slot.author === "Nobody" ? "" : try (try Drafts).text(state.thread))
    });
    when { tag: "Sending" }: sending(fx.effect);
  }
}

// spec/app/messages/composer.md, "A restart closes the conversation and keeps the saved drafts, the send and its pending clear, access and the SIMs the phone has"
const machine = reacting({ ...Composer, stored: (key: string, start?: Composer.Composer) => Layer.unwrap(effect {
  const store = try KeyValueStore.KeyValueStore
  const compatible = Layer.succeed(KeyValueStore.KeyValueStore, {
    ...store,
    get: (at: string) => Effect.map(store.get(at), (raw) => at === key ? withDraftCustody(withNewSource(raw)) : raw),
  })
  return Layer.provide(Composer.stored(key, start), compatible)
}) }, { keep: 1, open: [{ type: "restart" }], carry })

// spec/app/messages/composer.md, "Opening a conversation brings back the draft the phone saved for it"; spec/app/messages/composer.md, "Closing the conversation's composer waits until its draft is saved"
/** The conversation Messages has open, and how many it is with, told to the composer until it takes it. */
export effect function openMessageDraft(thread: number): boolean!!(Messages | Drafts | Conversations | Composer.Machine | Vault | Telephony) {
  const drafts = try Drafts
  const messages = try Messages
  const composer = try Composer.Machine
  const numbered = try (try Conversations).get(thread)
  if (Option.isNone(numbered) || (try composer.get()).thread !== 0) return false
  const { id, addresses, promoted } = numbered.value
  const recipients = canonicalDraftRecipients(addresses)
  const provider = threadIdOf(id)
  if (recipients === undefined || recipients.length === 0 || (id !== "" && provider === null)) return false
  const candidate = { kind: "recipients", recipients } as const
  const state = try composer.get()
  const outgoing = try drafts.outgoing()
  const sealed = state.outgoing.thread === thread && (uncertain(state.outgoing) || state.pendingClear.thread === thread)
    && Option.isSome(outgoing) && outgoing.value.draft !== undefined && sameDraftSource(outgoing.value.draft.source, candidate)
  const source = provider === null || sealed ? candidate : { kind: "thread", thread: provider, recipients } as const
  const provisional = promoted && source.kind === "thread" ? candidate : undefined
  const prior = try drafts.loadConversation(thread)
  const opened = try drafts.conversations.open(thread, source, prior, Composer.savedFor(thread, state), provisional)
  if (opened.kind !== "opened") return false
  const front = try messages.get()
  if (front.front && front.pane === "Conversation" && front.thread === thread &&
      (try contained(composer.send({ type: "openDraft", thread, recipients: recipients.length, revision: opened.revision, author: opened.author, pictures: opened.pictures }), "opening the saved message draft"))) {
    if (prior !== undefined && opened.adoptedPlaintext) try drafts.retireConversation(thread, prior)
    try refreshMessageSending()
    return true
  }
  drafts.conversations.close(thread)
  return false
}

effect function refreshMessageSending(): (TelephonyStatus | undefined)!!(Drafts | Composer.Machine | Telephony) {
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  if (status === undefined) return undefined
  const composer = try Composer.Machine
  try rememberSims(status.subscriptions ?? [])
  try (try Drafts).setSending({ direct: status.sendMode === "direct", pictures: status.mmsSend })
  try contained(composer.send({ type: "accessReported", need: "SendAccess", grant: grantOf(status.permissions.sendSms) }), "send access")
  try contained(composer.send({ type: "accessReported", need: "SimAccess", grant: grantOf(status.permissions.phoneState) }), "SIM access")
  return status
}

// spec/app/messages/composer.md, "Closing the conversation's composer waits until its draft is saved"
const opened = started(effect {
  const messages = try Messages
  const composer = try Composer.Machine
  let taken = -1
  let newVisit = 0
  try Stream.runForEach(Stream.zipLatest(messages.changes, composer.changes), effect ([state]) => {
    const store = try Drafts
    const queued = try store.offeredPicture()
    if (queued !== undefined && state.offeredPicture !== queued.ticket && state.picker.ticket >= queued.ticket) {
      try store.setOfferedPicture(undefined)
    }
    const thread = state.pane === "Conversation" ? state.thread : 0
    const fresh = state.pane === "New" ? state.newDraft.visit : 0
    const forThread = queued !== undefined && state.offeredPicture === queued.ticket && thread > 0
    const currentThread = (try composer.get()).thread
    if (currentThread > 0 && currentThread !== thread) {
      if (!Composer.canCloseDraft(try composer.get()) ||
        !(try contained(composer.send({ type: "closeDraft" }), "closing the saved message draft"))) return
      store.conversations.close(currentThread)
    }
    if (thread === taken && newVisit === fresh && !forThread) return
    const needsOpen = thread > 0 && (try composer.get()).thread !== thread
    if (needsOpen && !(try openMessageDraft(thread))) return
    taken = thread
    newVisit = fresh
    if (thread === 0 && fresh === 0) return
    if (!needsOpen && !forThread) try refreshMessageSending()
    if (forThread && queued !== undefined && taken === thread) {
      const choosing = try messages.get()
      if (choosing.thread !== thread || choosing.offeredPicture !== queued.ticket) return
      const status = try refreshMessageSending()
      const current = try composer.get()
      try store.setOfferedPicture(undefined)
      try ignore(messages.send({ type: "clearPictureOffer", ticket: queued.ticket }))
      if (status?.sendMode !== "direct" || !status.mmsSend || !status.roles.sms.held) {
        try say("Picture messaging is unavailable", true)
      } else if (current.slot.author !== "Nobody" || (try store.text(thread)) !== "" || current.pictures !== 0 ||
        !(try attachPicture(thread, queued.picture))) {
        try say("Finish your existing message draft before adding this picture", true)
      }
    }
  })
}, "the composer's conversation")

// spec/app/messages/sending.md, "A delivery report counts only for a part reported sent"
/** The phone's word that a send's record changed: a delivery report for each recipient every part of which arrived, counted once. */
const reports: Stream.Stream<Event, never, Telephony | Drafts | Composer.Machine> = Stream.flatMap(
  Stream.callback<OperationId, never, Telephony>((queue) => Effect.asVoid(acquireRelease(
    Effect.orElseSucceed(telephony("observeMessages", (c) => c.messages.observeMessages(() => {}, (operation) => { Queue.offerUnsafe(queue, operation) }, (operation) => { Queue.offerUnsafe(queue, operation) })), () => undefined),
    (unsubscribe) => (unsubscribe === undefined ? Effect.void : ignore(tryPromise(() => unsubscribe()))),
  ))),
  (operation) => Stream.unwrap(effect {
    const store = try Drafts
    const machine = try Composer.Machine
    const held = try store.outgoing()
    if (Option.isNone(held) || held.value.operation !== operation || held.value.sim === null) return Stream.empty
    const send = held.value
    const sim = held.value.sim
    const mms = usingMms(send.to.length, send.pictured)
    const record: SmsSendResult | undefined = mms ? undefined : (telephony("smsSendResult", (c) => c.messages.smsSendResult({ recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim }, operation)) catch () => undefined)
    const status = mms ? try receiptOf(send, sim, operation) : record?.status
    if (status === undefined || status === "submitted" || status === "unknown") return Stream.empty
    const current = try store.outgoing()
    if (Option.isNone(current) || current.value.operation !== operation) return Stream.empty
    try store.setOutgoing({ ...current.value, status })
    const state = try machine.get()
    const id = state.outgoing.op.id
    const resolved: Event[] = Composer.canReadBack(state, id) ? [{ type: "readBack", id, wasSent: sentStatuses.has(status), known: true }] : []
    const arrived = record === undefined ? 0 : send.to.filter((_number, at) => {
      const parts = record.parts.filter((part) => part.recipientIndex === at)
      return parts.length > 0 && parts.every((part) => part.delivery === "success")
    }).length
    return Stream.fromIterable([...resolved, ...Array.from({ length: Math.max(0, arrived - state.outgoing.reported) }, (): Event => ({ type: "reportArrived", id }))])
  }),
)

// spec/app/messages/sending.md, "A finished record is retired by a tombstone"
const retiring = following(Composer.Machine, (state) => (Composer.canRetire(state, state.outgoing.op.id) ? state.outgoing.op.id : 0), Composer.Machine, (id): Event | undefined => (id === 0 ? undefined : { type: "retire", id }))

// spec/app/messages/composer.md, "The phone clears only the confirmed send's saved revision and acknowledges before the send retires"
const settling = following(Composer.Machine, (state) => state.pendingClear.id, Composer.Machine, (id): Event | undefined => id > 0 ? { type: "clearSentDraft" } : undefined)

// spec/app/messages/composer.md, "What Alpha cannot send is handed to the messaging app"
/** Single plain texts use SMS. Group messages and pictures need the phone's MMS capability. */
export effect function supported(recipients: number, pictures: number): boolean!!Drafts {
  const can = try (try Drafts).sending()
  return can.direct && (usingMms(recipients, pictures > 0) ? can.pictures && recipients <= MMS_MAX_RECIPIENTS : recipients === 1)
}

/** What the owner's Send carries, put in hand just before it: the draft, the conversation's numbers, the SIM and the pictures; a send whose outcome is unknown keeps what it carried. */
export effect function prepare(thread: number, selectedSim: TelephonySubscription | undefined, trustedTap: boolean): boolean!!(Drafts | Conversations | Composer.Machine) {
  const state = try (try Composer.Machine).get()
  const store = try Drafts
  if (state.thread !== thread || state.pendingClear.id !== 0 || busy(state.outgoing) || uncertain(state.outgoing)) return false
  const conversation = try (try Conversations).get(thread)
  if (Option.isNone(conversation) || conversation.value.addresses.length !== state.recipients || state.recipients === 0) return false
  const to = conversation.value.addresses
  const draft = store.conversations.reference(thread)
  const recipients = canonicalDraftRecipients(to)
  if (draft === undefined || recipients === undefined || draft.revision !== state.slot.draft.base) return false
  if (draft.source.kind === "thread") {
    const provider = threadIdOf(conversation.value.id)
    if (provider === null || !sameDraftSource(draft.source, { kind: "thread", thread: provider, recipients })) return false
  } else if (!sameDraftSource(draft.source, { kind: "recipients", recipients })) return false
  const pictures = try store.pictures(thread)
  const body = state.slot.author === "Nobody" ? "" : try store.text(thread)
  if (body.length > MMS_MAX_BODY) return false
  try store.setOutgoing({ thread, to, body, sim: null, selectedSim, trustedTap, pictures, pictured: pictures.length > 0, operation: undefined, mms: undefined, status: undefined, draft, replaces: completedSend(state) })
  return true
}

function completedSend(state: Composer.Composer): number | undefined {
  return state.pendingClear.id === 0 && (state.outgoing.op.outcome === "Confirmed" || state.outgoing.op.outcome === "Refused")
    ? state.outgoing.op.id : undefined
}

/** Typed recipient lists and contact choices use the same number validation before they can address a send. */
export function messageRecipients(input: string): ReadonlyArray<PhoneNumber> {
  const parts = input.split(",").map((part) => part.trim())
  const parsed = parts.map((part) => /^\+?[\d\s().-]+$/u.test(part) && part.replace(/\D/gu, "").length >= 3 ? normalizePhoneNumber(part) : null)
  return parsed.length <= MMS_MAX_RECIPIENTS && parsed.every((number) => number !== null) ? [...new Set(parsed)] : []
}

effect function numberForNew(draft: NewMessageDraft): number!!Conversations {
  const addresses = messageRecipients(draft.recipients)
  return addresses.length === 0 ? 0 : try (try Conversations).of({ id: "", addresses })
}

type NewMessageHost = Messages | Shell | Drafts | Conversations | Inbox | Composer.Machine | Telephony

/** Open the owner's separate New draft on this exact Threads visit. */
export effect function startNewMessage(handoff?: NewMessageOpening): boolean!!NewMessageHost {
  const store = try Drafts
  const messages = try Messages
  const shell = try Shell
  const route = handoff?.route ?? (try shell.get()).route
  const before = try messages.get()
  const current = effect {
    const page = try messages.get()
    const where = try shell.get()
    return where.route === route && showing(where, "Messages") && canStartNewDraft(page, 0, 0)
      && before.newDraft.visit === page.newDraft.visit && (handoff === undefined || store.messageHandoff.get() === handoff)
  }
  const opened = try Semaphore.withPermit(store.newVisits, effect {
    if (!(try current) || !(try store.openNewDraft(current))) return undefined
    const saved = try store.newDraft()
    const fillTo = handoff !== undefined && saved.recipients === ""
      && !newDraftHeld(try (try Composer.Machine).get(), saved.revision)
    const thread = try numberForNew(saved)
    if (!(try current)) return undefined
    try (try Inbox).set({ typed: "" })
    const event = { type: "startNewDraft", revision: saved.revision, thread } as const
    const moved = messages.send(event, (state) => state.newDraft.visit === before.newDraft.visit &&
      (handoff === undefined || store.messageHandoff.get() === handoff)) catch () => undefined
    return moved === undefined ? undefined : { visit: moved.state.newDraft.visit, fillTo }
  })
  if (handoff === undefined) return opened !== undefined
  if (opened === undefined) {
    store.messageHandoff.replace(handoff, (try current) ? { ...handoff, phase: "OpenFailed" } : undefined)
  } else if (opened.fillTo) {
    const pending = { route, address: handoff.address, visit: opened.visit, phase: "Saving" } as const
    store.messageHandoff.replace(handoff, pending)
    try saveMessageHandoff(pending)
  } else store.messageHandoff.replace(handoff, undefined)
  return opened !== undefined
}

// spec/app/phone/voicemail.md, "Call back hands the caller's number to Phone and Message opens Messages with it"; spec/app/contacts/index.md, "Call and Message open Phone or Messages with the number filled in, and do nothing else"
effect function newMessageFor(number: string, owner: MessageSource): void!!NewMessageHost {
  const address = number.trim().slice(0, 230)
  if (address === "") return
  const shell = try Shell
  const starting = try shell.get()
  if (starting.route !== owner.route || !showing(starting, owner.view)) return
  const event = starting.assistant === "Sheet" || starting.assistant === "Full"
    ? { type: "openCommsView", view: "Messages" } as const : { type: "openView", view: "Messages" } as const
  if (!(try contained(shell.send(event, (where) => where.route === owner.route), "the number handed to Messages"))) return
  const store = (try Drafts).messageHandoff
  const offer = { route: owner.route + 1, address, phase: "Opening" } as const
  if ((try shell.get()).route !== offer.route) return
  store.replace(store.get(), offer)
  const messages = try Messages
  const front = try Effect.timeoutOption(Stream.runHead(Stream.filter(messages.changes, (state) => state.front)), "3 seconds")
  if (Option.isSome(front)) try ignore(startNewMessage(offer))
  else store.replace(offer, (try shell.get()).route === offer.route ? { ...offer, phase: "OpenFailed" } : undefined)
}

const callers = Layer.effect(Callers, effect {
  const whole = try Whole
  return {
    message: (number: string, owner?: MessageSource) => owner === undefined
      ? Effect.void : flatMap(whole.context, (context) => Effect.provideContext(newMessageFor(number, owner), context as Context.Context<NewMessageHost>)),
  }
})

const abandoningHandoff = started(effect {
  const store = (try Drafts).messageHandoff
  try Stream.runForEach((try Shell).changes, effect (where) => {
    const handoff = store.get()
    if (handoff !== undefined && where.route > handoff.route) store.replace(handoff, undefined)
  })
}, "discarding stale message handoffs")

/** Only this exact New draft waits while its already-reviewed send is acting or being reconciled. */
export function newDraftHeld(state: Composer.Composer, revision: number): boolean {
  return revision > 0 && revision === state.newSend.revision
    && (busy(state.outgoing) || uncertain(state.outgoing) || sentAll(state.outgoing))
}

type NewDraftEdit = Partial<Pick<NewMessageDraft, "recipients" | "body" | "pictures">>

// spec/app/messages/index.md, "New message reads the contacts that have a number and brings back the owner's unsent New draft"
effect function saveMessageHandoff(handoff: NewMessagePrefill): boolean!!NewMessageHost {
  const store = (try Drafts).messageHandoff
  const current = effect {
    const where = try (try Shell).get()
    return where.route === handoff.route && showing(where, "Messages") && holdsNewDraft(try (try Messages).get(), handoff.visit)
  }
  if (!(try current) || store.get() !== handoff) {
    store.replace(handoff, undefined)
    return false
  }
  const saved = try editNewMessage(handoff.visit, { recipients: handoff.address }, false, undefined, undefined, handoff)
  store.replace(handoff, !saved && (try current) ? { ...handoff, phase: "SaveFailed" } : undefined)
  return saved
}

/** A retry belongs only to the Messages route and, once admitted, the same New visit. */
export effect function retryMessageHandoff(handoff: NewMessageHandoff): boolean!!NewMessageHost {
  const store = (try Drafts).messageHandoff
  if (store.get() !== handoff || (try (try Shell).get()).route !== handoff.route) return false
  if (handoff.phase === "OpenFailed") {
    const opening = { ...handoff, phase: "Opening" } as const
    store.replace(handoff, opening)
    return try startNewMessage(opening)
  }
  if (handoff.phase === "SaveFailed") {
    const saving = { ...handoff, phase: "Saving" } as const
    store.replace(handoff, saving)
    return try saveMessageHandoff(saving)
  }
  return false
}

/** Put a real edit in the visible New visit, preserving its other fields and retiring any replaced recipient. */
export effect function editNewMessage(visit: number, edit: NewDraftEdit, closePicker: boolean, expected?: number, picking?: boolean, handoff?: NewMessagePrefill): boolean!!(Messages | Shell | Drafts | Conversations | Composer.Machine) {
  const store = try Drafts
  const messages = try Messages
  const shell = try Shell
  const composer = try Composer.Machine
  return try Semaphore.withPermit(store.newVisits, effect {
    const place = try messages.get()
    const before = try store.newDraft()
    const where = try shell.get()
    if (!showing(where, "Messages") || !holdsNewDraft(place, visit) || before.revision !== place.newDraft.revision
      || (expected !== undefined && expected !== before.revision)
      || (picking !== undefined && picking !== place.newDraft.picking)
      || newDraftHeld(try composer.get(), before.revision)) return false
    if (handoff !== undefined && (where.route !== handoff.route || store.messageHandoff.get() !== handoff || before.recipients !== "")) return false
    const draft = { ...before, ...edit, revision: before.revision + 1 }
    if (draft.recipients.length > 230) return false
    const thread = edit.recipients === undefined ? place.newDraft.recipient : try numberForNew(draft)
    if (!canEditNewDraft(place, visit, draft.revision, thread, closePicker) || !(try store.saveNewDraft(draft))) return false
    return try contained(messages.send({ type: "editNewDraft", visit, revision: draft.revision, thread, closePicker }), "editing the New message draft")
  })
}

const incomingSmsDraft = Schema.Struct({
  token: AndroidDraftToken,
  recipients: Schema.Array(Schema.NonEmptyString.check(Schema.isMaxLength(24))).check(Schema.isMinLength(1), Schema.isMaxLength(SMS_DIRECT_MAX_RECIPIENTS)),
  body: Schema.String.check(Schema.isMaxLength(MMS_MAX_BODY)),
})
const androidDraft = Schema.decodeUnknownOption(incomingSmsDraft)
type AndroidDraftPort = ReturnType<typeof noticeTransport>
type IncomingSmsDraft = typeof incomingSmsDraft.Type
type AndroidDraftVisit = { readonly visit: number; readonly revision: number }

effect function pendingDraft(port: AndroidDraftPort): (IncomingSmsDraft | undefined)!! {
  const pending = try Effect.timeoutOption(Effect.option(tryPromise(() => port.smsDraftPending())), "2 seconds")
  return Option.getOrUndefined(androidDraft(Option.getOrUndefined(Option.flatten(pending))))
}

function sameAndroidDraft(current: IncomingSmsDraft | undefined, offer: IncomingSmsDraft): boolean {
  return current?.token === offer.token && current.body === offer.body && current.recipients.length === offer.recipients.length
    && current.recipients.every((recipient, at) => recipient === offer.recipients[at])
}

function emptyNew(draft: NewMessageDraft): boolean {
  return draft.recipients === "" && draft.body === "" && draft.pictures.length === 0
}

/** Save the native handoff only after its exact empty visit is admitted. */
effect function openAndroidDraft(port: AndroidDraftPort, offer: IncomingSmsDraft): boolean!!(Messages | Shell | Drafts | Conversations | Composer.Machine | Device | Layers | Telephony | Vault) {
  const store = try Drafts
  const messages = try Messages
  const shell = try Shell
  const layers = try Layers
  const device = try Device
  const composer = try Composer.Machine
  const recipients = offer.recipients.join(", ")
  const parsed = messageRecipients(recipients)
  if (parsed.length !== offer.recipients.length || !parsed.every((number, index) => number === offer.recipients[index]) || offer.body.includes("\0")) return false
  const starting = try shell.get()
  const beforeTouches = store.messageTouches.version()
  const untouched = () => store.messageTouches.version() === beforeTouches
  const uncovered = effect {
    const where = try shell.get()
    return where.image && where.assistant === "Bar" && !where.drawer && !pageInert(try layers.get()) && (try device.showing())
  }
  if (!(try uncovered)) return false
  const already = showing(starting, "Messages")
  const into = { type: "openView", view: "Messages" } as const
  if (!already && !(try contained(shell.send(into, (where) => where.route === starting.route), "opening Messages for the Android text"))) return false
  const route = already ? starting.route : starting.route + 1
  const onRoute = effect {
    const where = try shell.get()
    return where.route === route && showing(where, "Messages")
  }
  const current = effect { return (try onRoute) && (try uncovered) }
  const storedForOffer = effect {
    if (!(try current)) return false
    const held = openDraftRecord(newSource) catch () => undefined
    return held !== undefined && androidInboundOf(held.record)?.token === offer.token && (try current)
  }
  const acknowledge = effect {
    if (!sameAndroidDraft(try pendingDraft(port), offer) || !(try current)) return false
    return timeout(Effect.as(tryPromise(() => port.acknowledgeSmsDraft({ token: offer.token })), true), "2 seconds") catch () => false
  }
  const shown = try Effect.timeoutOption(Stream.runHead(Stream.filter(messages.changes, (state) => state.front)), "3 seconds")
  if (Option.isSome(shown) && (try storedForOffer)) return try acknowledge
  let openedNew = false
  const accepted = Option.isSome(shown) && (try Semaphore.withPermit(store.newVisits, effect {
    const listed = try messages.get()
    const sameList = (page: MessagesState) => untouched() && canNewMessage(page) && page.newDraft.visit === listed.newDraft.visit
      && page.list.ticket === listed.list.ticket
    const onList = effect {
      return (try current) && sameList(try messages.get())
    }
    if (!(try onList) || !(try store.openNewDraft(onList))) return false
    const before = try store.newDraft()
    if (before.androidInbound?.token === offer.token) return true
    if (!emptyNew(before) || newDraftHeld(try composer.get(), before.revision)) return false
    const revision = before.revision + 1
    const draft = { ...before, recipients, body: offer.body, revision, androidInbound: { token: offer.token, admittedRevision: revision } }
    const thread = try numberForNew(draft)
    if (thread === 0 || !sameAndroidDraft(try pendingDraft(port), offer) || !(try current)) return false
    const event = { type: "openAndroidDraft", requestCurrent: true, empty: true, revision: before.revision } as const
    const moved = messages.send(event, (page) => sameList(page) && canOpenAndroidDraft(page, true, true, before.revision)) catch () => undefined
    if (moved === undefined) return false
    openedNew = true
    const opening: AndroidDraftVisit = { visit: moved.state.newDraft.visit, revision: before.revision }
    const sameVisit = (page: MessagesState) => holdsNewDraft(page, opening.visit) && page.newDraft.revision === opening.revision && page.newDraft.recipient === 0
    const vacant = (page: MessagesState) => sameVisit(page) && !page.newDraft.picking && untouched()
    const exactOpening = effect {
      return (try current) && vacant(try messages.get()) && (try store.newDraft()) === before &&
        !newDraftHeld(try composer.get(), opening.revision)
    }
    if (!sameAndroidDraft(try pendingDraft(port), offer)) {
      if (try exactOpening) {
        const abandon = { type: "abandonAndroidDraft", ...opening, untouched: true } as const
        try contained(messages.send(abandon, vacant), "closing the replaced Android text draft")
      }
      return false
    }
    if (!(try exactOpening) || !(try store.saveNewDraft(draft))) return false
    if (try onRoute) {
      const landed = { type: "editNewDraft", visit: opening.visit, revision: draft.revision, thread, closePicker: false } as const
      try contained(messages.send(landed, sameVisit), "showing the saved Android text draft")
    }
    return true
  }))
  if (!accepted && !already && !openedNew && untouched() && (try current) && canNewMessage(try messages.get())) {
    try contained(shell.send({ type: "goBack" }, (where) => where.route === route), "closing the unused Android text opening")
  }
  return accepted && (try storedForOffer) && (try acknowledge)
}

// spec/app/messages/index.md, "A current Android text request opens New only when its saved draft is empty"
const androidDraftEntries = started(effect {
  if (!registered("ElizaTelephony")) return
  const port = noticeTransport()
  const wakes = Stream.callback<void>((queue) => effect {
    const listener = tryPromise(() => port.addListener("smsDraft", () => { Queue.offerUnsafe(queue, undefined) })) catch () => undefined
    if (listener !== undefined) try addFinalizer(() => ignore(tryPromise(() => listener.remove())))
    Queue.offerUnsafe(queue, undefined)
  })
  try Stream.runForEach(wakes, effect () => {
    const offered = try pendingDraft(port)
    if (offered !== undefined) try ignore(openAndroidDraft(port, offered))
  })
}, "reviewing Android text requests in Messages")

/** A chooser result belongs to the New visit and revision that opened it. */
export effect function attachNewPictures(visit: number, revision: number, files: ReadonlyArray<File>): void!!(Messages | Shell | Drafts | Conversations | Composer.Machine) {
  const store = try Drafts
  const before = try store.newDraft()
  if (before.revision !== revision || !(try supported(1, 1))) return
  const pictures = [...before.pictures]
  let size = pictures.reduce((total, one) => total + one.bytes.byteLength, 0)
  for (const file of files) {
    if (pictures.length >= MMS_MAX_ATTACHMENTS) break
    const contentType = MMS_ATTACHMENT_TYPES.find((type) => type === file.type)
    if (contentType === undefined || file.size <= 0 || size + file.size > MMS_MAX_TOTAL_BYTES
      || pictures.some((one) => one.name === file.name || one.wireName === file.name)) continue
    const bytes = tryPromise(() => file.arrayBuffer()) catch () => undefined
    if (bytes === undefined || bytes.byteLength !== file.size) continue
    pictures.push({ name: file.name, contentType, bytes: new Uint8Array(bytes) })
    size += bytes.byteLength
  }
  if (pictures.length > before.pictures.length && (try supported(1, 1))) {
    try editNewMessage(visit, { pictures }, false, revision)
  }
}

/** Use the same journal and trusted Send as a conversation draft, with New's own immutable payload. */
export effect function sendNewMessage(visit: number, revision: number, selectedSim: TelephonySubscription | undefined, trustedTap: boolean): boolean!!(Messages | Shell | Phone | Drafts | Composer.Machine) {
  const messages = try Messages
  const shell = try Shell
  const phone = try Phone
  const store = try Drafts
  const composer = try Composer.Machine
  return try Semaphore.withPermit(store.newVisits, effect {
    const place = try messages.get()
    const where = try shell.get()
    const draft = try store.newDraft()
    const state = try composer.get()
    if (!showing(where, "Messages") || where.assistant !== "Bar" || !holdsNewDraft(place, visit) || place.newDraft.picking
      || revision !== place.newDraft.revision || revision !== draft.revision || (!draft.body.trim() && draft.pictures.length === 0)
      || draft.body.length > MMS_MAX_BODY) return false
    const to = messageRecipients(draft.recipients)
    const thread = place.newDraft.recipient
    const support = try supported(to.length, draft.pictures.length)
    const clearToSend = clear(try phone.get())
    const checking = uncertain(state.outgoing)
    if (!Composer.canSendNew(state, thread, to.length, visit, revision, support, clearToSend)) return false
    if (!checking) {
      if (state.sims > 1 && selectedSim === undefined) return false
      try store.setOutgoing({ thread, to, body: draft.body, sim: null, selectedSim, trustedTap, pictures: draft.pictures,
        pictured: draft.pictures.length > 0, operation: undefined, mms: undefined, status: undefined, draft: { source: newSource, revision }, replaces: completedSend(state) })
    }
    return try contained(composer.send({ type: "sendNew", thread, recipients: to.length, visit, revision, supported: support, clear: clearToSend }), "sending the New message draft")
  })
}

/** Access to send from New still comes from the specific permission control the owner pressed. */
export effect function requestNewAccess(visit: number, need: Composer.Need, settings: boolean): void!!(Messages | Shell | Composer.Machine) {
  if (!showing(try (try Shell).get(), "Messages") || !holdsNewDraft(try (try Messages).get(), visit)) return
  const action: Event = settings ? { type: "settingsNew", need } : { type: "allowNew", need }
  try contained((try Composer.Machine).send(action), "requesting access from the New message")
}

/** The messaging app can review a New text the device cannot send here. */
export effect function handOffNewMessage(visit: number, revision: number): void!!(Messages | Shell | Drafts | Composer.Machine | Conversations | Telephony) {
  const messages = try Messages
  const where = try messages.get()
  if (!showing(try (try Shell).get(), "Messages") || !holdsNewDraft(where, visit) || where.newDraft.picking || where.newDraft.revision !== revision) return
  const draft = try (try Drafts).newDraft()
  const to = messageRecipients(draft.recipients)
  if (draft.revision !== revision || !draft.body.trim() || to.length === 0 || draft.pictures.length > 0
    || newDraftHeld(try (try Composer.Machine).get(), revision) || (try supported(to.length, 0))) return
  try elsewhere(where.newDraft.recipient, draft.body)
}

/** A receipt clears only the New draft it carried, and only the original visit returns to the list. */
effect function finishNewMessage(thread: number, visit: number, revision: number): void!!(Drafts | Messages | Shell) {
  const store = try Drafts
  const messages = try Messages
  const shell = try Shell
  const draft = try store.newDraft()
  if (draft.revision !== revision + 1) return
  const place = try messages.get()
  if (!showing(try shell.get(), "Messages") || !canFinishNewDraft(place, place.newDraft.visit, revision, thread)) return
  if (place.newDraft.visit === visit) {
    try contained(messages.send({ type: "finishNewDraft", thread, visit, revision }), "finishing the sent New draft")
  } else {
    try contained(messages.send({ type: "editNewDraft", thread: 0, visit: place.newDraft.visit, revision: draft.revision, closePicker: false }), "clearing the sent New draft")
  }
}

module pictureData {
  /** @throws {never} */
  export function pictureBytes(data: string, type: "image/png" | "image/jpeg" | "image/webp", size: number, max: number): Uint8Array | undefined {
    if (data.length % 4 !== 0 || data.length > Math.ceil(max / 3) * 4) return undefined
    try {
      const decoded = atob(data)
      if (decoded.length !== size) return undefined
      const signature = type === "image/png" ? [137, 80, 78, 71, 13, 10, 26, 10] : [255, 216, 255]
      const signatureMatches = type === "image/webp" ? decoded.startsWith("RIFF") && decoded.slice(8, 12) === "WEBP"
        : signature.every((byte, at) => decoded.charCodeAt(at) === byte)
      if (!signatureMatches) return undefined
      return Uint8Array.from(decoded, (byte) => byte.charCodeAt(0))
    } catch {
      return undefined
    }
  }
}
import { pictureBytes } from pictureData
export { pictureBytes }

// spec/app/messages/index.md, "A picture from Files is offered in a new recipient picker and can join only its chosen empty draft"
export effect function pictureMessagingReady(): boolean!!Telephony {
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  return status?.sendMode === "direct" && status.mmsSend && status.roles.sms.held
}

// spec/app/messages/index.md, "A picture from Files is offered in a new recipient picker and can join only its chosen empty draft"
export effect function handOverPicture(picture: Picture, source: "Files" | "Photos"): boolean!!(Drafts | Composer.Machine | Messages | Shell) {
  const shell = try Shell
  const messages = try Messages
  const drafts = try Drafts
  const composer = try (try Composer.Machine).get()
  if (!showing(try shell.get(), source) || Composer.bound(composer) || !Composer.settledDraft(composer) || composer.pictures > 0 ||
    (try drafts.offeredPicture()) !== undefined || (try messages.get()).front) return false
  if (!(try contained(shell.send({ type: "openView", view: "Messages" }), "the picture handed to Messages"))) return false
  const front = try Effect.timeoutOption(Stream.runHead(Stream.filter(messages.changes, (s) => s.front)), "3 seconds")
  if (Option.isNone(front) || !(showing(try shell.get(), "Messages"))) return false
  const state = try messages.get()
  if (!canNewPictureMessage(state)) return false
  try drafts.setOfferedPicture({ ticket: state.picker.ticket + 1, picture })
  if (try contained(messages.send({ type: "newPictureMessage" }), "the picture's recipient picker")) return true
  try drafts.setOfferedPicture(undefined)
  return false
}

// spec/app/messages/composer.md, "The owner attaches up to five pictures, and removes them one by one"
effect function attachPicture(thread: number, picture: Picture): boolean!!(Drafts | Composer.Machine) {
  const store = try Drafts
  const machine = try Composer.Machine
  const current = try machine.get()
  const held = try store.pictures(thread)
  const wireName = picture.wireName ?? picture.name
  const fits = !held.some((one) => one.name === picture.name || (one.wireName ?? one.name) === wireName) && held.reduce((sum, one) => sum + one.bytes.length, 0) + picture.bytes.byteLength <= MMS_MAX_TOTAL_BYTES
  if (current.thread !== thread || !Composer.canAttach(current, fits)) return false
  return try stageEdit(thread, { type: "attach", fits }, { pictures: [...held, picture] })
}

// spec/app/messages/composer.md, "The owner attaches up to five pictures, and removes them one by one"
/** Attach the owner's chosen files in turn: each the phone's MMS takes, a JPEG, PNG or GIF within its size with those before, is attached while the composer takes one. */
export effect function attachAll(files: ReadonlyArray<File>): void!!(Drafts | Composer.Machine | Toasts | Said) {
  const machine = try Composer.Machine
  const store = try Drafts
  const thread = (try machine.get()).thread
  let skipped: string | undefined
  for (const file of files) {
    const contentType = MMS_ATTACHMENT_TYPES.find((type) => type === file.type)
    if (contentType === undefined || file.size <= 0) {
      skipped ??= "Only JPEG, PNG, and GIF pictures can be attached"
      continue
    }
    if (file.size > MMS_MAX_TOTAL_BYTES) {
      skipped ??= "That picture is too large to send"
      continue
    }
    const bytes = tryPromise(() => file.arrayBuffer()) catch () => undefined
    if (bytes === undefined) {
      skipped ??= "Could not read the selected picture"
      continue
    }
    if ((try machine.get()).thread !== thread) return
    const held = try store.pictures(thread)
    const taken = new Set(held.flatMap((one) => [one.name, one.wireName ?? one.name]))
    const name = uniquePictureName(file.name || "image.jpg", taken)
    const attached = try attachPicture(thread, { name, contentType, bytes: new Uint8Array(bytes) })
    if (!attached) {
      skipped ??= (try machine.get()).pictures >= 5 ? "You can attach up to 5 pictures" : "That picture does not fit in this message"
    }
  }
  if (skipped !== undefined) try say(skipped, true)
}

// spec/app/messages/composer.md, "An edited draft is saved for its conversation, one save at a time"
const saving = following(Composer.Machine, (state) => Composer.canSaveDraft(state), Composer.Machine, (due): Event | undefined => (due ? { type: "saveDraft" } : undefined))

/** The composer: kept across restarts, so a draft and a send under way survive them; nothing is sent when Alpha opens again. */
export const composer = together(machine, drafts, opened, saving, settling, retiring, callers, abandoningHandoff, androidDraftEntries, hearing(reports, Composer.Machine, (event: Event) => event))
