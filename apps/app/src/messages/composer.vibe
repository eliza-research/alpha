// spec/app/messages/composer.md, "Story: Keep my draft"; spec/app/messages/composer.md, "Story: Let Alpha suggest a draft"; spec/app/messages/composer.md, "Story: Send a message"; spec/app/messages/sending.md, "Story: Send a message once"; spec/app/messages/sending.md, "Story: Know whether it arrived"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { MMS_ATTACHMENT_TYPES, MMS_MAX_ATTACHMENTS, MMS_MAX_BODY, MMS_MAX_RECIPIENTS, MMS_MAX_TOTAL_BYTES, SMS_DIRECT_MAX_RECIPIENTS } from "@elizaos/os-bridges"
import { mmsBinding, normalizePhoneNumber, type MmsAttachmentType, type MmsBinding, type MmsReview, type OperationId, type SmsReview, type SmsSendResult, type SmsSendStatus } from "@elizaos/os-bridges"
import { threadIdOf, type PhoneNumber, type TelephonyStatus, type TelephonySubscription } from "@elizaos/os-bridges"
import * as Composer from "../../gen/app__messages__composer.effect.vibe"
import type { Effect as Out, Event } from "../../gen/app__messages__composer.effect.vibe"
import type { Effect as SendOut } from "../../gen/app__messages__sending.effect.vibe"
import { Machine as Messages, canEditNewDraft, canFinishNewDraft, canNewMessage, canNewPictureMessage, canOpenAndroidDraft, canStartNewDraft, holdsNewDraft, type Messages as MessagesState } from "../../gen/app__messages.effect.vibe"
import { Machine as Phone, clear } from "../../gen/app__phone.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Machine as Layers, pageInert } from "../../gen/app__shell__layers.effect.vibe"
