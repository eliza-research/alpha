// spec/app/telegram/auth.md, "Story: Sign in to my Telegram user account"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Auth from "../../gen/app__telegram__auth.effect.vibe"
import type { AuthOutcome, Effect as Out, Event, SendOutcome, Trouble } from "../../gen/app__telegram__auth.effect.vibe"
import {
  AuthRevoked,
  BotTokenRejected,
  type MessagingFailure,
  MessagingSessions,
  Device,
  VoiceBridge,
  tokenValue,
  ProviderError,
  RateLimited,
  secretOf,
  sameCredential,
} from "../platform/index.vibe"
import { Unreachable, Unsent } from "../platform/index.vibe"
import { Telegram, type TelegramClient, type TelegramUser, assertTelegramUserToken } from "../platform/index.vibe"
import type { Outcome } from "../platform/index.vibe"
import { type Job, answer, contained, due, reacting, run, started, together, untimed } from "../runtime/index.vibe"
import { Time } from "../runtime/index.vibe"
import {
  TELEGRAM_SESSION_KEY,
  TelegramStore,
  acceptedReply,
  currentSessionToken,
  isBotTokenInput,
  isRevokedFailure,
  messagingOutcomeOf,
} from "./store.vibe"

function sendTroubleOf(failure: MessagingFailure): SendOutcome {
  return match (failure) {
    when RateLimited: { tag: "SendFailed", trouble: "FloodWait", wait: Math.max(1, failure.retryAfter ?? 1) * 1000 };
    when BotTokenRejected: { tag: "SendFailed", trouble: "BotTokenRejected", wait: 0 };
    when ProviderError: {
      tag: "SendFailed",
      trouble: failure.code === "PHONE_NUMBER_INVALID" ? "InvalidPhone" : "Unreachable",
      wait: 0,
    };
    when Unreachable: { tag: "SendFailed", trouble: "Offline", wait: 0 };
    when Unsent: { tag: "SendFailed", trouble: "Offline", wait: 0 };
    default: { tag: "SendFailed", trouble: "Unreachable", wait: 0 };
  }
}

function authFailureOutcomeOf(failure: MessagingFailure, fallback: Trouble): AuthOutcome {
  return match (failure) {
    when RateLimited: { tag: "AuthFailed", trouble: "FloodWait", wait: Math.max(1, failure.retryAfter ?? 1) * 1000 };
    when BotTokenRejected: { tag: "AuthBot" };
    when ProviderError: {
      tag: "AuthFailed",
      trouble: failure.code === "PHONE_CODE_EXPIRED"
        ? "ExpiredCode"
        : failure.code === "PHONE_CODE_INVALID"
          ? "WrongCode"
          : failure.code === "PASSWORD_HASH_INVALID"
            ? "WrongPassword"
            : fallback,
      wait: 0,
    };
    when AuthRevoked: { tag: "AuthFailed", trouble: "SessionRevoked", wait: 0 };
    when Unreachable: { tag: "AuthFailed", trouble: "Offline", wait: 0 };
    when Unsent: { tag: "AuthFailed", trouble: "Offline", wait: 0 };
    default: { tag: "AuthFailed", trouble: fallback, wait: 0 };
  }
}

effect function persistUserSession(
  sessionToken: string,
  user: TelegramUser,
  owner: string,
): AuthOutcome!!(MessagingSessions | TelegramStore) {
  const valid = Option.getOrUndefined(try Effect.option(assertTelegramUserToken(sessionToken)))
  if (valid === undefined) return { tag: "AuthBot" }
  const grant = secretOf(valid)
  if (!(try (try MessagingSessions).set(TELEGRAM_SESSION_KEY, grant, owner))) {
    return { tag: "AuthFailed", trouble: "Unreachable", wait: 0 }
  }
  try (try TelegramStore).update((snap) => ({
    ...snap,
    auth: {
      ...snap.auth,
      grant,
      user,
      phoneCodeHash: "",
      pendingAuthId: "",
      passwordHint: "",
      qrToken: "",
      qrLoginUrl: "",
    },
  }))
  return { tag: "AuthUser", account: user.id }
}

// spec/app/telegram/auth.md, "Opening sign-in moves to phone entry or QR login; phone submission respects FloodWait and takes the next ticket"
effect function sendPhoneCode(ticket: number, phone: string): Event!!(Telegram | TelegramStore | MessagingSessions) {
  if (isBotTokenInput(phone)) {
    return { type: "codeSent", ticket, sendOutcome: { tag: "SendFailed", trouble: "BotTokenRejected", wait: 0 }, now: untimed }
  }
  const owner = try (try MessagingSessions).owner()
  if (owner === undefined) return { type: "codeSent", ticket, sendOutcome: { tag: "SendFailed", trouble: "Unreachable", wait: 0 }, now: untimed }
  const sent = (try Telegram).sendCode(phone.trim()) catch (failure) => failure
  if ("_type" in sent) {
    try (try TelegramStore).update((snap) => ({
      ...snap,
      auth: { ...snap.auth, owner, phone: phone.trim(), phoneCodeHash: sent.phone_code_hash, pendingAuthId: "", passwordHint: "" },
    }))
    return { type: "codeSent", ticket, sendOutcome: { tag: "CodeDelivered" }, now: untimed }
  }
  return { type: "codeSent", ticket, sendOutcome: sendTroubleOf(sent), now: untimed }
}

// spec/app/telegram/auth.md, "A verification code is checked with a secret code, and may authenticate a user account, request two-factor password, expire or trigger FloodWait"
effect function verifyPhoneCode(ticket: number, code: string): Event!!(Telegram | MessagingSessions | TelegramStore) {
  if (isBotTokenInput(code)) {
    return { type: "codeVerified", ticket, authOutcome: { tag: "AuthBot" }, session: "", now: untimed }
  }
  const store = try TelegramStore
  const { owner, phone, phoneCodeHash } = (try store.get()).auth
  if (owner === undefined || owner !== (try (try MessagingSessions).owner())) {
    return { type: "codeVerified", ticket, authOutcome: { tag: "AuthFailed", trouble: "ExpiredCode", wait: 0 }, session: "", now: untimed }
  }
  const result = (try Telegram).signIn(phone, phoneCodeHash, code.trim()) catch (failure) => failure
  if ("kind" in result) {
    if (result.kind === "PasswordRequired") {
      try store.update((snap) => ({
        ...snap,
        auth: { ...snap.auth, pendingAuthId: result.pendingAuthId, passwordHint: result.hint },
      }))
      return { type: "codeVerified", ticket, authOutcome: { tag: "AuthNeeds2fa" }, session: "", now: untimed }
    }
    const outcome = try persistUserSession(result.sessionToken, result.user, owner)
    return { type: "codeVerified", ticket, authOutcome: outcome, session: outcome.tag === "AuthUser" ? result.sessionToken : "", now: untimed }
  }
  return { type: "codeVerified", ticket, authOutcome: authFailureOutcomeOf(result, "WrongCode"), session: "", now: untimed }
}

// spec/app/telegram/auth.md, "Two-factor cloud password is checked as a secret and authenticates only a user account"
effect function checkCloudPassword(ticket: number, password: string): Event!!(Telegram | MessagingSessions | TelegramStore) {
  const { owner, pendingAuthId } = (try (try TelegramStore).get()).auth
  if (owner === undefined || owner !== (try (try MessagingSessions).owner())) {
    return { type: "passwordChecked", ticket, authOutcome: { tag: "AuthFailed", trouble: "SessionRevoked", wait: 0 }, session: "", now: untimed }
  }
  const result = (try Telegram).checkPassword(pendingAuthId, password) catch (failure) => failure
  if ("_type" in result) {
    const outcome = try persistUserSession(result.session_token, result.user, owner)
    return { type: "passwordChecked", ticket, authOutcome: outcome, session: outcome.tag === "AuthUser" ? result.session_token : "", now: untimed }
  }
  return { type: "passwordChecked", ticket, authOutcome: authFailureOutcomeOf(result, "WrongPassword"), session: "", now: untimed }
}

// spec/app/telegram/auth.md, "QR login offers an alternate user-account path with expiry and optional two-factor check"
effect function readQrLogin(ticket: number, resume: boolean): Event!!(Telegram | TelegramStore | MessagingSessions) {
  const store = try TelegramStore
  const prior = (try store.get()).auth
  const owner = try (try MessagingSessions).owner()
  if (owner === undefined || (prior.qrToken !== "" && prior.owner !== owner)) {
    return { type: "qrAnswered", ticket, authOutcome: { tag: "AuthFailed", trouble: "SessionRevoked", wait: 0 }, session: "", now: untimed }
  }
  const token = resume ? prior.qrToken : undefined
  const client = try Telegram
  const first = client.exportLoginToken(token) catch (failure) => failure
  const result = token && first instanceof ProviderError && first.code === "AUTH_TOKEN_EXPIRED"
    ? (client.exportLoginToken() catch (failure) => failure)
    : first
  if (!("kind" in result)) return { type: "qrAnswered", ticket, authOutcome: authFailureOutcomeOf(result, "Unreachable"), session: "", now: untimed }
  if (result.kind === "Pending") {
    try store.update((snap) => ({ ...snap, auth: { ...snap.auth, owner, qrToken: result.token, qrLoginUrl: result.loginUrl } }))
    return { type: "qrOffered", ticket, expiresAt: result.expiresAt, now: untimed }
  }
  if (result.kind === "PasswordRequired") {
    try store.update((snap) => ({ ...snap, auth: { ...snap.auth, owner, pendingAuthId: result.pendingAuthId, passwordHint: result.hint, qrToken: "", qrLoginUrl: "" } }))
    return { type: "qrAnswered", ticket, authOutcome: { tag: "AuthNeeds2fa" }, session: "", now: untimed }
  }
  const valid = Option.getOrUndefined(try Effect.option(assertTelegramUserToken(result.sessionToken)))
  if (valid === undefined) return { type: "qrAnswered", ticket, authOutcome: { tag: "AuthBot" }, session: "", now: untimed }
  try store.update((snap) => ({ ...snap, auth: { ...snap.auth, owner, user: result.user, qrToken: "", qrLoginUrl: "" } }))
  return { type: "qrAnswered", ticket, authOutcome: { tag: "AuthUser", account: result.user.id }, session: valid, now: untimed }
}

// spec/app/telegram/auth.md, "Remote revocation and explicit sign-out wipe local data, advance the credential revision and stop sync"
effect function logOutRemote(ticket: number): Event!!(Telegram | MessagingSessions | TelegramStore) {
  const store = try TelegramStore
  const { owner, grant } = (try store.get()).auth
  const removed = owner !== undefined && grant !== undefined && (try (try MessagingSessions).exchange(TELEGRAM_SESSION_KEY, grant, undefined, owner))
  try store.wipe()
  if (removed && grant !== undefined) try ignore((try Telegram).logOut(tokenValue(grant)))
  return { type: "loggedOut", ticket }
}

effect function wipeLocal(credentialRev: number): void!!(TelegramStore | Auth.Machine) {
  const state = try (try Auth.Machine).get()
  if (state.work !== "LoggingOut" && state.credentialRev === credentialRev) try (try TelegramStore).wipe()
}

function carry(fx: Out): Job<Event, Telegram | MessagingSessions | TelegramStore | Auth.Machine, []> {
  return match (fx) {
    when { tag: "SendPhoneCode", let ticket, let phone }: answer(
      "auth",
      sendPhoneCode(ticket, phone),
      { type: "codeSent", ticket, sendOutcome: { tag: "SendFailed", trouble: "Unreachable", wait: 0 }, now: untimed },
    );
    when { tag: "VerifyPhoneCode", let ticket, let code }: answer(
      "auth",
      verifyPhoneCode(ticket, code),
      { type: "codeVerified", ticket, authOutcome: { tag: "AuthFailed", trouble: "Unreachable", wait: 0 }, session: "", now: untimed },
    );
    when { tag: "CheckCloudPassword", let ticket, let password }: answer(
      "auth",
      checkCloudPassword(ticket, password),
      { type: "passwordChecked", ticket, authOutcome: { tag: "AuthFailed", trouble: "Unreachable", wait: 0 }, session: "", now: untimed },
    );
    when { tag: "StartQrLogin", let ticket, let resume }: answer(
      "auth",
      readQrLogin(ticket, resume),
      { type: "qrAnswered", ticket, authOutcome: { tag: "AuthFailed", trouble: "Unreachable", wait: 0 }, session: "", now: untimed },
    );
    when { tag: "StopQrLogin" }: run("auth", effect {
      try (try Telegram).cancelLogin()
      try (try TelegramStore).update((snap) => ({ ...snap, auth: { ...snap.auth, qrToken: "", qrLoginUrl: "" } }))
    });
    when { tag: "SaveQrSession", let ticket, let account, let session }: answer("auth", effect {
      const store = try TelegramStore
      const { owner } = (try store.get()).auth
      const grant = secretOf(session)
      const ok = owner !== undefined && (try (try MessagingSessions).set(TELEGRAM_SESSION_KEY, grant, owner))
      if (ok) try store.update((s) => ({ ...s, auth: { ...s.auth, grant } }))
      return { type: "qrSaved", ticket, account, ok } as const
    }, { type: "qrSaved", ticket, account, ok: false });
    when { tag: "StoreSession", let credentialRev, let session }: run("store-session", effect {
      const valid = Option.getOrUndefined(try Effect.option(assertTelegramUserToken(session)))
      const { owner, grant } = (try (try TelegramStore).get()).auth
      const state = try (try Auth.Machine).get()
      if (valid !== undefined && owner !== undefined && grant !== undefined && tokenValue(grant) === valid && state.step === "Authenticated" && state.credentialRev === credentialRev) {
        try (try MessagingSessions).exchange(TELEGRAM_SESSION_KEY, grant, grant, owner)
      }
    });
    when { tag: "LogOutRemote", let ticket }: answer("logout", logOutRemote(ticket), { type: "loggedOut", ticket });
    when { tag: "WipeLocal", let credentialRev }: run("wipe-local", wipeLocal(credentialRev));
    when { tag: "StopSync" }: run("stop-sync", Effect.void);
  }
}

/** Notify the Telegram auth machine that the user session was revoked remotely. */
export effect function reportSessionRevoked(rejected?: string): void!!(Auth.Machine | MessagingSessions | TelegramStore) {
  const auth = try Auth.Machine
  const store = try TelegramStore
  const { owner, grant } = (try store.get()).auth
  if (owner === undefined || grant === undefined || (rejected !== undefined && tokenValue(grant) !== rejected)) return
  const sessions = try MessagingSessions
  if (owner !== (try sessions.owner())) return
  if (rejected === undefined) {
    if (Option.isSome(try sessions.get(TELEGRAM_SESSION_KEY, owner))) return
  } else if (!(try sessions.exchange(TELEGRAM_SESSION_KEY, grant, undefined, owner))) return
  if ((try store.get()).auth.grant === grant && Auth.canRevoked(try auth.get())) {
    try contained(auth.send({ type: "revoked" }), "telegram session revoked")
  }
}

/** Resolve the active user session token and `peerKey` for `chat`, triggering revocation when unauthenticated. */
export effect function resolveAuthedPeer(
  chat: number,
): Option.Option<{ readonly token: string; readonly peerKey: string }>!!(MessagingSessions | TelegramStore | Auth.Machine) {
  const token = try currentSessionToken()
  if (Option.isNone(token)) {
    try reportSessionRevoked()
    return Option.none()
  }
  const peerKey = try (try TelegramStore).peerKeyOf(chat)
  if (peerKey === undefined) return Option.none()
  return Option.some({ token: token.value, peerKey })
}

/** Execute an authenticated per-chat Telegram mutation, propagating revocation and mapping honest `kit/attempt` outcomes. */
export effect function runPeerMutation<A>(
  chat: number,
  invoke: (client: TelegramClient, token: string, peerKey: string) => A!MessagingFailure,
  onSuccess: (result: A, peerKey: string) => void!!TelegramStore,
): Outcome!!(Telegram | MessagingSessions | TelegramStore | Auth.Machine) {
  const target = try resolveAuthedPeer(chat)
  if (Option.isNone(target)) return { confirmed: false, known: true }
  const { token, peerKey } = target.value
  const res = acceptedReply(token, invoke(try Telegram, token, peerKey)) catch (failure) => ({ failed: failure })
  if (typeof res === "object" && res !== null && "failed" in res) {
    if (isRevokedFailure(res.failed)) try reportSessionRevoked(token)
    return messagingOutcomeOf(res.failed)
  }
  try onSuccess(res, peerKey)
  return { confirmed: true, known: true }
}

const machine = reacting(Auth, {
  keep: 1,
  open: [{ type: "restart" }],
  carry,
  timers: (state) => state.step === "QrPending" && state.qrExpiresAt > 0
    ? [due("qr", Auth.qrCheckAt(state), { type: "checkQr", ticket: state.ticket, now: untimed })] : [],
})

const floodWake = started(effect {
  const auth = try Auth.Machine
  const time = try Time
  const store = try TelegramStore
  const deadlines = Stream.changes(Stream.map(auth.changes, (state) => state.floodUntil))
  try Stream.runDrain(Stream.switchMap(deadlines, (untilAt) => untilAt <= 0 ? Stream.empty : Stream.fromEffect(effect {
    try time.until(untilAt)
    try store.update((snap) => snap)
  })))
}, "telegram flood wait wake")

const restoredOwner = started(effect {
  const auth = try Auth.Machine
  const store = try TelegramStore
  const sessions = try MessagingSessions
  const client = try Telegram
  const shell = try Shell.Machine
  const shown = Stream.filter(Stream.changes(Stream.map(shell.changes, (s) => s.trail.at(-1) === "Telegram")), (front) => front)
  const changes = Stream.merge(Stream.as(shown, true), Stream.merge(Stream.as((try VoiceBridge).signIns, true), Stream.filter((try Device).visible, (visible) => visible)))
  try Stream.runForEach(Stream.concat(Stream.make(true), changes), effect () => {
    const owner = try sessions.owner()
    const prior = (try store.get()).auth
    let initial = try auth.get()
    let grant = owner === undefined ? undefined : Option.getOrUndefined(try sessions.get(TELEGRAM_SESSION_KEY, owner))
    const changed = initial.step === "Authenticated" && (grant === undefined || prior.grant === undefined || !sameCredential(prior.grant, grant))
    if ((prior.owner !== undefined && owner !== prior.owner) || changed || (initial.step === "SessionExpired" && grant !== undefined)) {
      if ((try store.get()).auth.grant !== prior.grant) return
      if (!(try contained(auth.send({ type: "restoreSession", ticket: initial.ticket, account: 0 }), "switching Telegram session"))) return
      try store.wipe()
      try client.forgetSession()
      initial = try auth.get()
    }
    if (owner === undefined || initial.step !== "SignedOut" || initial.work !== "Idle") return
    try store.update((s) => s.auth.owner === owner ? s : { ...s, auth: { ...s.auth, owner } })
    if (client.accountAccess !== "connectedClient") return
    while (grant !== undefined) {
      const checked = grant
      const result = client.getMe(tokenValue(checked)) catch (failure) => failure
      if (!("user" in result) && isRevokedFailure(result) && (try sessions.exchange(TELEGRAM_SESSION_KEY, checked, undefined, owner))) return
      const current = try auth.get()
      if (current.step !== "SignedOut" || current.work !== "Idle" || current.ticket !== initial.ticket) return
      const saved = Option.getOrUndefined(try sessions.get(TELEGRAM_SESSION_KEY, owner))
      if (saved === undefined) return
      if (sameCredential(checked, saved)) {
        if ("user" in result && Auth.canRestoreSession(current, result.user.id, initial.ticket)) {
          try store.update((s) => ({ ...s, auth: { ...s.auth, owner, grant: checked, user: result.user } }))
          try contained(auth.send({ type: "restoreSession", ticket: initial.ticket, account: result.user.id }), "restoring Telegram user")
        }
        return
      }
      grant = saved
    }
  })
}, "following the signed-in Telegram owner")

/** Telegram user-account authentication shell over `Telegram` and isolated `MessagingSessions`. */
export const telegramAuth = together(machine, floodWake, restoredOwner)
