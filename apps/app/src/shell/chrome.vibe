// spec/app/shell/keyboard.md, "Ask Alpha's footprint is what it covers now and its bar alone, which is never more; while nothing of Ask Alpha shows, the last footprint stays"
import * as Canvas from "../../gen/app__shell__keyboard.effect.vibe"
import { contained } from "../runtime/index.vibe"

module page {
  import type { Event } from "../../gen/app__shell__keyboard.ts"

  export type Chrome = Extract<Event, { type: "dockMeasured" | "headerMeasured" }>

  const pageHeader = "[data-host-chrome]:not([data-alpha-comms-dock]):not([data-host-chrome=bottom])"

  /** Follow the mounted dock and headers, and measure again once an animation or transition that could have moved them ends. @throws {never} */
  export function watchChrome(root: HTMLElement, heard: (event: Chrome) => void): () => void {
    const page = root.querySelector<HTMLElement>("[data-alpha-shell-page]")
    const assistant = root.querySelector<HTMLElement>("[data-alpha-assistant-host]")
    const win = root.ownerDocument.defaultView
    let dock: HTMLElement | null = null
    let headers: HTMLElement[] = []
    let detent: string | undefined
    let clearance = 0
    let rest = 0
    let bar = 0
    let headerBottom = 0
    let overlap = -1
    const measure = () => {
      const frame = root.getBoundingClientRect()
      if (frame.height <= 0) return
      const scale = root.dataset.alphaDesktopPreview !== undefined && root.offsetHeight > 0 ? frame.height / root.offsetHeight : 1
      let headerPx = 0
      for (const header of headers) {
        const box = header.getBoundingClientRect()
        if (box.height > 0) headerPx = Math.max(headerPx, Math.round((box.bottom - frame.top) / scale))
      }
      if (headerPx !== headerBottom) {
        headerBottom = headerPx
        root.style.setProperty("--alpha-header-clearance", `${headerPx}px`)
        heard({ type: "headerMeasured", px: headerPx })
      }
      const dockBox = dock?.getBoundingClientRect()
      if (dockBox && dockBox.height > 0 && dock?.dataset.alphaDragging !== "true") {
        const total = Math.max(0, Math.round((frame.bottom - dockBox.top) / scale))
        if (detent === "bar" && total > 0) rest = total
        const floor = Math.min(total, rest || Math.round(dockBox.height / scale))
        if (floor > 0 && (total !== clearance || floor !== bar)) {
          clearance = total
          bar = floor
          root.style.setProperty("--alpha-dock-clearance", `${total}px`)
          heard({ type: "dockMeasured", clearance: total, bar: floor })
        }
      }
      const pageBox = page?.getBoundingClientRect()
      const beside = pageBox && dockBox && (dockBox.left >= pageBox.right || dockBox.right <= pageBox.left)
      if (dock?.dataset.alphaDragging !== "true") {
        const nextOverlap = dockBox && dockBox.height > 0 && pageBox && !beside ? Math.max(0, Math.round((pageBox.bottom - dockBox.top) / scale)) : 0
        if (nextOverlap !== overlap) {
          overlap = nextOverlap
          root.style.setProperty("--alpha-dock-overlap", `${nextOverlap}px`)
        }
      }
    }
    const sizes = typeof ResizeObserver === "undefined" ? undefined : new ResizeObserver(measure)
    const headerIn = (node: Node): boolean => node instanceof Element && (node.matches(pageHeader) || node.querySelector(pageHeader) !== null)
    const changes = typeof MutationObserver === "undefined" ? undefined : new MutationObserver((records) => {
      if (records.some((record) => record.type === "attributes" || record.target === assistant ||
        Array.from(record.addedNodes).some(headerIn) || Array.from(record.removedNodes).some(headerIn))) refresh()
    })
    const refresh = () => {
      const nextDock = assistant?.hidden ? null : assistant?.querySelector<HTMLElement>("[data-alpha-detent]") ?? null
      const nextDetent = nextDock?.dataset.alphaDetent
      const matches = nextDetent === "full" ? nextDock?.querySelectorAll<HTMLElement>("header") : page?.querySelectorAll<HTMLElement>(pageHeader)
      const nextHeaders = matches ? Array.from(matches) : []
      if (dock !== nextDock || detent !== nextDetent ||
        headers.length !== nextHeaders.length || headers.some((header, index) => header !== nextHeaders[index])) {
        dock = nextDock
        headers = nextHeaders
        detent = nextDetent
        observe()
      }
      measure()
    }
    const observe = () => {
      sizes?.disconnect()
      changes?.disconnect()
      sizes?.observe(root)
      if (page) {
        sizes?.observe(page)
        changes?.observe(page, { childList: true, subtree: true })
      }
      if (assistant) changes?.observe(assistant, { childList: true, subtree: true, attributes: true, attributeFilter: ["hidden"] })
      for (const header of headers) sizes?.observe(header)
      if (dock) {
        sizes?.observe(dock)
        changes?.observe(dock, { attributes: true, attributeFilter: ["data-alpha-detent", "data-alpha-dragging"] })
      }
    }
    const settled = (event: AnimationEvent | TransitionEvent) => {
      const moved = event.target
      if (moved instanceof Node && [page, dock, ...headers].some((box) => box !== null && moved.contains(box))) measure()
    }
    const doc = root.ownerDocument
    observe()
    refresh()
    win?.addEventListener("resize", measure)
    doc.addEventListener("animationend", settled, true)
    doc.addEventListener("transitionend", settled, true)
    return () => {
      sizes?.disconnect()
      changes?.disconnect()
      win?.removeEventListener("resize", measure)
      doc.removeEventListener("animationend", settled, true)
      doc.removeEventListener("transitionend", settled, true)
    }
  }
}
import { type Chrome, watchChrome } from page
export { watchChrome }

/** Report the mounted shell's geometry to the existing canvas machine. */
export effect function measureChrome(event: Chrome): void!!Canvas.Machine {
  const canvas = try Canvas.Machine
  if (Canvas.enabled(try canvas.get(), event)) try contained(canvas.send(event), "the canvas chrome")
}
