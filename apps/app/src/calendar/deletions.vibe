// spec/app/calendar/deletions.md, "Story: Undo a deletion before it is sent"
import * as View from "../../gen/app__calendar.effect.vibe"
import * as Held from "../../gen/app__calendar__deletions.effect.vibe"
import type { Effect as Out, Event, Reach } from "../../gen/app__calendar__deletions.effect.vibe"
import * as Editor from "../../gen/app__calendar__editor.effect.vibe"
import * as Notices from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, offer, say, withdraw } from "../notices/index.vibe"
import { type Due, Job, contained, due, filledStore, following, hearing, reacting, started, together, untimed } from "../runtime/index.vibe"
import { calendarInFront } from "./calendar.vibe"
import { PhoneCalendar } from "../platform/index.vibe"
import { deletionScope, pickOf, scopeOf } from "./shown.ts"
import { Shown } from "./stores.vibe"
import { readHolds } from "./time.ts"

const undoArea = "Calendar"

/** Scoped per-runtime metadata tracking released deletion revisions and the active Undo toast id. */
export service DeletionMeta {
  remember(id: number, revision: number, version: string, answer: string): void
  of(id: number): { readonly revision: number; readonly version: string; readonly answer: string } | undefined
  forget(id: number): void
  offered(): number
  setOffered(id: number): void
  clear(): void
}

const deletionMeta = Layer.effect(DeletionMeta, effect {
  const sent = new Map<number, { readonly revision: number; readonly version: string; readonly answer: string }>()
  let activeOffer = 0
  try Effect.addFinalizer(() => sync(() => { sent.clear(); activeOffer = 0 }))
  return {
    remember(id: number, revision: number, version: string, answer: string) { sent.set(id, { revision, version, answer }) },
    of: (id: number) => sent.get(id),
    forget(id: number) { sent.delete(id) },
    offered: () => activeOffer,
    setOffered(id: number) { activeOffer = id },
    clear() { sent.clear(); activeOffer = 0 },
  }
})

/** Undo the waiting deletion if its window or shown notice still permits it, and drop what the phone reviewed of it. */
effect function undoWaiting(): void!!(Held.Machine | Shown | PhoneCalendar) {
  const held = try Held.Machine
  const key = (try Shown).lastSeen((try held.get()).waiting)?.key
  if (!(try contained(held.send({ type: "undo", now: untimed }), "undoing a deletion"))) try contained(held.send({ type: "undoShown" }), "undoing a shown deletion")
  const phone = try PhoneCalendar
  if (key !== undefined && phone.cancel && (try held.get()).waiting === 0) try phone.cancel(key)
}

/** The Undo a deletion's notice offers, over this Calendar's deletions, rows and phone, wherever the notice runs it. */
effect function undoOffered() {
  const held = try Held.Machine
  const shown = try Shown
  const phone = try PhoneCalendar
  return Effect.provideService(Effect.provideService(Effect.provideService(undoWaiting(), Held.Machine, held), Shown, shown), PhoneCalendar, phone)
}

// spec/app/calendar/deletions.md, "Confirming the review holds the deletion; a deletion still waiting is sent first, so the only Undo shown is the newest"
/** Have the phone review a deletion of the event numbered `id` while Calendar is in front, as the owner confirms it, since it reviews nothing for a page it cannot see; its release then sends what it reviewed. */
effect function reviewWhileShown(id: number, reach: Reach): void!!(Shown | PhoneCalendar) {
  const row = (try Shown).find(id)
  const which = row === undefined || row.source !== "Phone" ? undefined : deletionScope(scopeOf(reach), row.recurring)
  if (row !== undefined && which !== undefined) try (try PhoneCalendar).stage(pickOf(row), which)
}

// spec/app/calendar/deletions.md, "Confirming the review holds the deletion; a deletion still waiting is sent first, so the only Undo shown is the newest"
/** Confirm the reviewed deletion and raise its Undo toast through the global notices area without racing the shell. */
export effect function confirmDelete(event: Extract<Event, { readonly type: "confirm" }>): boolean!!(Held.Machine | Shown | DeletionMeta | Notices.Machine | Said | PhoneCalendar) {
  const held = try Held.Machine
  const shown = try Shown
  const meta = try DeletionMeta
  const { asked: id, askedReach } = try held.get()
  if (id === 0) return false
  const title = shown.lastSeen(id)?.title || "Event"
  if (!(try contained(held.send(event), "confirming a deletion"))) return false
  try reviewWhileShown(id, askedReach)
  const prev = meta.offered()
  if (prev !== 0 && prev !== id) try withdraw(undoArea, prev)
  meta.setOffered(id)
  const undo = try undoOffered()
  try offer(`${title} deleted`, undoArea, id, undo)
  return true
}

// spec/app/calendar/deletions.md, "Confirming the review holds the deletion; a deletion still waiting is sent first, so the only Undo shown is the newest"; spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted, and whether it changed; a sent deletion hides it until a read no longer has it unchanged"; spec/app/calendar/deletions.md, "A deletion is sent only when its window ended with its notice gone, when the owner leaves, when a newer one is confirmed, or when the owner sends one a restart paused, at the revision confirmed"
/** A released deletion goes to the editor at the revision the owner confirmed, which sends it once; one the editor cannot take now ends refused, and its event shows again. */
function carry(fx: Out): Job<Event, Editor.Machine | Shown | DeletionMeta, []> {
  const released = effect {
    const shown = try Shown
    const meta = try DeletionMeta
    const row = shown.find(fx.id) ?? shown.lastSeen(fx.id)
    meta.remember(fx.id, fx.revision, row?.version ?? "", row?.answer ?? "")
    const remove: Editor.Event = {
      type: "deleteEvent", id: fx.id, revision: fx.revision,
      scope: scopeOf(fx.reach), repeating: row?.recurring ?? false,
    }
    return effect {
      try (try Editor.Machine).send(remove)
      return Stream.empty
    } catch () => Stream.succeed({ type: "ended", id: fx.id, done: false, changed: false } as Event)
  }
  return Job.Run({ key: `release ${fx.id}`, answers: Stream.unwrap(released), lost: Option.some({ type: "ended", id: fx.id, done: false, changed: false }), by: [], allowEmpty: true })
}

/** Emits whenever either calendar source transitions to or advances a loaded read. */
export function loadedReads(view: View.Machine.Shape) {
  const loaded = Stream.filter(view.changes, (s) => s.phone.status === "Loaded" || s.google.status === "Loaded")
  return Stream.changesWith(
    loaded,
    (a, b) =>
      a.phone.status === b.phone.status
      && a.phone.ticket === b.phone.ticket
      && a.google.status === b.google.status
      && a.google.ticket === b.google.ticket,
  )
}

// spec/app/calendar/deletions.md, "The window ends only once its Undo notice is no longer shown"
/** The Undo notice lasts the window; once it has gone, the window ends. A deletion a restart paused waits for the owner. */
function timers(state: Held.Deletions): ReadonlyArray<Due<Event, []>> {
  if (state.waiting === 0 || state.paused) return []
  return state.notice
    ? [due<Event, []>("notice", state.undo.until, { type: "noticeGone" })]
    : [due<Event, []>("window", state.undo.until, { type: "windowEnded", now: state.undo.until })]
}

/** Each time Calendar leaves: another app shown, the page hidden or the screen locked. */
const away = Stream.filter(calendarInFront, (front) => !front)

// spec/app/calendar/deletions.md, "Leaving Calendar sends a waiting deletion at once, and closes a review unsent"
const left = hearing(away, Held.Machine, (): Event => ({ type: "leave" }))

// spec/app/calendar/deletions.md, "The Undo window is ten seconds, scaled by Android's timeout setting"
const scaled = following(Notices.Machine, (notices) => notices.scale, Held.Machine, (scale): Event | undefined => (scale >= 100 ? { type: "scaleChanged", scale } : undefined))

// spec/app/calendar/deletions.md, "Another owner signing in drops a waiting deletion unsent, and says the event was not deleted"; spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted, and whether it changed; a sent deletion hides it until a read no longer has it unchanged"
/** Keep global toasts synchronized with waiting, dropped, and failed Calendar deletions. */
const notices = started(effect {
  const held = try Held.Machine
  const shown = try Shown
  const meta = try DeletionMeta
  let lastDropped = 0
  let lastFailed = 0
  try Stream.runForEach(held.changes, effect (state) => {
    const active = state.waiting !== 0 && state.notice && !state.paused ? state.waiting : 0
    const prev = meta.offered()
    if (prev !== 0 && prev !== active) {
      meta.setOffered(0)
      try withdraw(undoArea, prev)
    }
    if (active !== 0 && meta.offered() !== active) {
      meta.setOffered(active)
      const title = shown.lastSeen(active)?.title || "Event"
      const undo = try undoOffered()
      try offer(`${title} deleted`, undoArea, active, undo)
    }
    if (state.dropped !== 0 && state.dropped !== lastDropped) {
      const title = shown.lastSeen(state.dropped)?.title || "An event"
      try say(`${title} was not deleted: you signed in to another account.`, true)
    }
    lastDropped = state.dropped
    if (state.failed !== 0 && state.failed !== lastFailed) {
      const title = shown.lastSeen(state.failed)?.title || "the event"
      try say(state.changed ? `Event changed. ${title} was not deleted and is shown again.` : `Couldn't delete this event. ${title} is shown again.`, true)
    }
    lastFailed = state.failed
  })
}, "notifying Calendar deletions")

// spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted, and whether it changed; a sent deletion hides it until a read no longer has it unchanged"
/** Reconcile a hidden sent deletion after each calendar read so declined invitations reappear and removed events clear `hiding`; one whose number Calendar cannot tell, after a start that could not read the kept numbers, waits. */
const reconciled = started(effect {
  const view = try View.Machine
  const held = try Held.Machine
  const shown = try Shown
  const meta = try DeletionMeta
  try Stream.runForEach(loadedReads(view), effect (s) => {
    const d = try held.get()
    if (d.hiding === 0) return
    const id = d.hiding
    const prior = shown.lastSeen(id) ?? shown.seenAt(id)
    if (prior === undefined && !shown.known(id) && !shown.forgets(id)) return
    const sourceLoaded = prior === undefined
      ? s.phone.status === "Loaded" || s.google.status === "Loaded"
      : prior.source === "Phone" ? s.phone.status === "Loaded" : s.google.status === "Loaded"
    if (!sourceLoaded) return
    const current = shown.find(id)
    if (current === undefined) {
      const covered = prior === undefined
        || (prior.source === "Phone" ? !s.phoneLimited && readHolds(prior.begin, s.phoneDay) : !s.googleLimited && readHolds(prior.begin, s.googleDay))
      if (!covered) return
      meta.forget(id)
      try contained(held.send({ type: "readShows", id, unchanged: false }), "clearing a deleted event after read")
      return
    }
    const before = meta.of(id)
    const changed = current.answer === "AnsweredDeclined"
      || (before !== undefined
        ? current.revision !== before.revision || (before.version !== "" && current.version !== before.version) || current.answer !== before.answer
        : current.revision !== d.revision)
    if (changed) meta.forget(id)
    try contained(held.send({ type: "readShows", id, unchanged: !changed }), "updating a hidden deletion after read")
  })
}, "reconciling hidden Calendar deletions after reads")

// spec/app/calendar/deletions.md, "A restart pauses a deletion still in its window; the owner sends it or keeps the event"
/** A paused deletion whose number names no event Calendar kept a number for, as one kept before it kept numbers, is kept unsent as Keep it does. */
const unnamed = started(effect {
  const held = try Held.Machine
  const shown = try Shown
  try Stream.runForEach(held.changes, effect (state) => {
    if (state.paused && state.waiting !== 0 && shown.forgets(state.waiting)) try contained(held.send({ type: "undoShown" }), "keeping unsent a deletion whose event is unknown")
  })
}, "keeping unsent the deletions Calendar cannot name")

// spec/app/platform/index.md, "A state kept in a shape an earlier build wrote is read in today's shape, with what the owner kept in it"
/** Deletions kept before the reach of the one sent and the one hidden were held apart: read with each at a fresh machine's. */
function storedDeletions(key: string, start = Held.initial) {
  const { asked, askedReach, askedRevision, sendingReach, hidingReach, changed } = Held.initial
  return Layer.provide(Held.stored(key, start), filledStore(key, (kept) => ({ asked, askedReach, askedRevision, sendingReach, hidingReach, changed, ...kept }), Held.parseState))
}

// spec/app/calendar/deletions.md, "A restart pauses a deletion still in its window; the owner sends it or keeps the event"
/** Calendar's deletions: kept on the phone with their Undo window across a restart, which pauses one still waiting, and released to the editor. */
export const deletions = together(deletionMeta, reacting({ ...Held, stored: storedDeletions }, { keep: 1, open: [{ type: "restart" }], carry, timers }), left, scaled, notices, reconciled, unnamed)
