// spec/app/calendar/editor.md, "Story: Write an event"; spec/app/calendar/editor.md, "Story: Keep my draft through a restart"; spec/app/calendar/editor.md, "Story: Never create an event twice"; spec/app/calendar/editor.md, "Story: Delete an event, or answer an invitation"
import type { ReminderItemRecord } from "@repo/launcher-records"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { ScanEntry } from "../files/scanEntry.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import { say } from "../notices/index.vibe"
import * as Editor from "../../gen/app__calendar__editor.effect.vibe"
import type { Effect as Out, Event, Scope, Write } from "../../gen/app__calendar__editor.effect.vibe"
import * as View from "../../gen/app__calendar.effect.vibe"
import * as Held from "../../gen/app__calendar__deletions.effect.vibe"
import { loadedReads } from "./deletions.vibe"
import { type Readback, type WriteKind, agentCalendarAccepts, answerReadback, defaultStart, deviceRoute, newEventTarget, readbackSeen } from "../../gen/app__calendar__writing.effect.vibe"
import { Agent } from "../platform/index.vibe"
import { Device } from "../platform/index.vibe"
import { ask, attemptedWith } from "../platform/index.vibe"
import type { AndroidCalendarEditorFields } from "@elizaos/os-bridges"
import { launchOwnerAt, sameResidentOwner } from "../platform/index.vibe"
import { PhoneCalendar, type Written } from "../platform/index.vibe"
import { Attempts, fresh } from "../runtime/index.vibe"
import { civilDateAt, formatCivilDate } from "../reminders/recurrence.ts"
import { type DatedReminderFields, createReminderItem, editDatedReminder, needsReschedule } from "../reminders/reminders.vibe"
import { DEFAULT_LIST_ID, remindersStore } from "../reminders/store.ts"
import { answer, contained, filledStore, hearing, reacting, run, started, stream, together } from "../runtime/index.vibe"
import { Time } from "../runtime/index.vibe"
import { calendarInFront } from "./calendar.vibe"
import { type Target, eventKey, originOwner, storeOrigin } from "./noteOrigin.vibe"
import { type Row, androidWindowOf, deletionScope, pickOf } from "./shown.ts"
import { Shown } from "./stores.vibe"
import { civilDay, feedParams, readHolds, utcStart, wallDateTime, zone } from "./time.ts"

/** What the owner typed into the form, kept on the phone as it is typed: the spec counts the edits, this holds them. */
export schema Fields {
  readonly title: string
  readonly place: string
  readonly notes: string
  readonly begin: number
  readonly end: number
  readonly allDay: boolean
  readonly people: string
  readonly alert?: number
  readonly video?: boolean
  readonly repeat?: "NoRepeat" | "Daily" | "Weekdays" | "Weekly" | "Monthly" | "Yearly"
  readonly calendar?: "Agent" | "Phone" | "Reminders"
  readonly noteOrigin?: {
    readonly version: 2
    readonly noteId: string
    readonly revision: string
    readonly agent: string
    readonly owner: string
  }
  readonly noteCreation?: string
  readonly reminderId?: string
  readonly reminderSpecId?: number
  readonly reminderRevision?: number
  readonly reminderDateOnly?: boolean
  readonly reminderRepeat?: "none" | "daily" | "weekdays" | "weekly" | "monthly" | "yearly"
  readonly reminderAlert?: number | null
}

const rules: Readonly<Record<NonNullable<Fields["repeat"]>, string>> = { NoRepeat: "", Daily: "FREQ=DAILY", Weekdays: "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR", Weekly: "FREQ=WEEKLY", Monthly: "FREQ=MONTHLY", Yearly: "FREQ=YEARLY" }

// spec/app/calendar/writing.md, "A new event today starts at the next full hour; on another day it starts at ten"
/** The form a new event opens with on `day`, at `now`: an hour from the next full hour today, from ten on another day. */
export function blank(day: number, now: number): Fields {
  const today = civilDay(now)
  const first = defaultStart(day - today, new Date(now).getHours())
  const begin = wallDateTime(today + first.offset, first.hour, 0)
  return { title: "", place: "", notes: "", begin, end: begin + 3_600_000, allDay: false, people: "" }
}

/** Build editable form fields from a read event row. */
export function rowFields(row: Row): Fields {
  return { title: row.title, place: row.place, notes: row.notes, begin: row.begin, end: row.end, allDay: row.allDay, people: "" }
}

// spec/app/calendar/editor.md, "Another owner signing in closes the editor; the old owner's slot keeps its edits"
/** Where `owner`'s form fields are kept, each owner in a slot of their own, and the creation identity of a create whose outcome is unknown. */
function formKey(owner: number): string {
  return `alpha.calendar.form.${owner}`
}
const creationKey = "alpha.calendar.creation"

const decodeFields = Schema.decodeUnknownEffect(Schema.fromJsonString(Fields))

/** What `owner`'s slot holds that the phone cannot read as a form, as it was read; none where it holds nothing or a form. */
effect function unreadableText(owner: number): (string | undefined)!!KeyValueStore.KeyValueStore {
  const text = (try KeyValueStore.KeyValueStore).get(formKey(owner)) catch () => undefined
  if (text === undefined) return undefined
  return (effect { try decodeFields(text); return undefined } catch () => text)
}

/** The fields kept on the phone for `owner`, or none where no valid draft is stored. */
export effect function readKept(owner: number): Option.Option<Fields>!!KeyValueStore.KeyValueStore {
  const text = (try KeyValueStore.KeyValueStore).get(formKey(owner)) catch () => undefined
  if (text === undefined) return Option.none()
  return (decodeFields(text) |> Effect.map(%, Option.some)) catch () => Option.none<Fields>()
}

/** The fields kept on the phone for `owner`, or a blank form for `day` (or today when `day <= 0`) where none are, or none the phone can read. */
export effect function kept(day: number, owner: number): Fields!!(KeyValueStore.KeyValueStore | Time) {
  const now = try (try Time).latest()
  const found = try readKept(owner)
  return Option.isSome(found) ? found.value : blank(day > 0 ? day : civilDay(now), now)
}

// spec/app/calendar/editor.md, "A slot the phone cannot read is kept and explained; only a development build resets it, and only as it was when the owner confirmed"
/** Keep `fields` on the phone in `owner`'s slot; whether the phone kept them. A slot the phone cannot read is never written over. */
effect function keep(fields: Fields, owner: number): boolean!!KeyValueStore.KeyValueStore {
  if ((try unreadableText(owner)) !== undefined) return false
  return ((try KeyValueStore.KeyValueStore).set(formKey(owner), JSON.stringify(fields)) |> Effect.as(%, true)) catch () => false
}

/** The unreadable text the owner was shown, which a development reset removes only while the slot still holds exactly it. */
let unreadableShown: { readonly owner: number; readonly text: string } | undefined

/** Tell the form whether the owner's slot holds a draft the phone cannot read. */
export effect function checkSlot(): void!!(KeyValueStore.KeyValueStore | Editor.Machine) {
  const editor = try Editor.Machine
  const who = try owner()
  const text = try unreadableText(who)
  if (text === undefined) return
  unreadableShown = { owner: who, text }
  try contained(editor.send({ type: "slotUnreadable" }), "saying the kept draft cannot be read")
}

/** Remove the owner's unreadable slot, only while it holds exactly what was read when the owner was shown it; whether it was removed. */
effect function resetSlot(): boolean!!(KeyValueStore.KeyValueStore | Editor.Machine) {
  const store = try KeyValueStore.KeyValueStore
  const who = try owner()
  const shown = unreadableShown
  const now = store.get(formKey(who)) catch () => undefined
  if (shown === undefined || shown.owner !== who || now !== shown.text) return false
  return (store.remove(formKey(who)) |> Effect.as(%, true)) catch () => false
}

/** The owner the editor writes for now. */
effect function owner(): number!!Editor.Machine {
  return (try (try Editor.Machine).get()).owner
}

// spec/app/calendar/editor.md, "Each edit is counted and kept on the phone at once, unless the phone failed to keep the draft"
/** The owner typed into the form: keep it on the phone, then count the edit; a store that refuses says so. */
export effect function typed(fields: Fields, edit: Event) {
  const editor = try Editor.Machine
  const state = try editor.get()
  if (!Editor.enabled(state, edit)) return
  if (!state.unreadable && !(try keep(fields, try owner()))) try contained(editor.send({ type: "keepFailed" }), "saying the draft was not kept")
  try contained(editor.send(edit), "counting an edit of the event")
}

// spec/app/calendar/editor.md, "When the event moved on, the owner keeps their changes or takes the saved ones"
/** Replace the owner's draft with the saved event's fields and accept the saved changes in the editor machine. */
export effect function takeSaved(fields: Fields): boolean!!(Editor.Machine | KeyValueStore.KeyValueStore) {
  const editor = try Editor.Machine
  try ignore(keep(fields, try owner()))
  return try contained(editor.send({ type: "takeSavedChanges" }), "taking the saved event changes")
}

// spec/app/calendar/editor.md, "Story: Write an event"; spec/app/calendar/editor.md, "The form's edits always build on the revision of the event as last read"
/** Open the form: a new event blank on `day`, or `row` as last read; a draft set aside is offered back as it was, never replaced unseen. */
export effect function startForm(edit: Event, day: number, row?: Row) {
  const editor = try Editor.Machine
  const state = try editor.get()
  if (state.banner !== "Available") {
    const fields: Fields = row === undefined ? blank(day, try (try Time).latest()) : rowFields(row)
    try ignore(keep(fields, state.owner))
  }
  const opened = try contained(editor.send(edit), "opening the form")
  if (opened && edit.type === "newEvent" && View.asksAtNewEvent(try (try View.Machine).get())) try askForPhone()
}

// spec/app/calendar/index.md, "Calendar asks for the phone's calendar only while it lacks it, and only once"
/** Ask Android for the phone's calendar while Calendar still may, and finish once Android has answered. */
effect function askForPhone() {
  if (!(try PhoneCalendar).present) return
  const view = try View.Machine
  if (!View.canAskAccess(try view.get())) return
  if (!(try contained(view.send({ type: "askAccess" }), "asking for the phone's calendar"))) return
  try Stream.runHead(Stream.filter(view.changes, (state) => state.access.grant !== "Unasked"))
}

/** Save the form; one going to the phone's calendar first asks Android for it while Calendar still may, and goes out only with access, as live v119 did. */
export effect function saveEvent(toPhone: boolean) {
  if (toPhone) {
    try askForPhone()
    if (!(try PhoneCalendar).present || !View.phoneTakesASave(try (try View.Machine).get())) return
  }
  const editor = try Editor.Machine
  if (Editor.canSave(try editor.get())) try contained(editor.send({ type: "save" }), "saving the event")
}

/** Open Calendar's form for the exact reminder the owner is looking at. */
export effect function startReminderEdit(selected: number, item: ReminderItemRecord, begin: number) {
  const editor = try Editor.Machine
  const state = try editor.get()
  if (!Editor.canEditReminder(state, selected, item.revision)) return
  const view = try View.Machine
  const shown = try view.get()
  const cached = remindersStore.snapshot()
  if (!shown.front || shown.reminder !== selected || cached.hiddenIds.has(item.id) || remindersStore.findItem(item.id)?.revision !== item.revision) return
  const fields: Fields = {
    title: item.title, notes: item.notes, begin, end: begin + 900_000, place: "", allDay: false, people: "",
    calendar: "Reminders", reminderId: item.id, reminderSpecId: selected, reminderRevision: item.revision, reminderDateOnly: item.dueMinute === null,
    reminderRepeat: item.recurrence, reminderAlert: item.alertMinutes,
  }
  if (!(try keep(fields, state.owner))) return
  try contained(editor.send({ type: "editReminder", id: selected, revision: item.revision, day: civilDay(begin) }), "opening Calendar's reminder form")
}

// spec/app/calendar/editor.md, "A note or a scan opens a new event already filled in, as edits to review, only when no other draft is kept"
/** Notes or Scan hand Calendar what they read as an event for `day`: kept as the form's draft, for the owner to review and save. */
export effect function fromNote(fields: Fields, day: number) {
  const editor = try Editor.Machine
  if (!Editor.canFromNote(try editor.get())) return false
  if (!(try keep(fields, try owner()))) return false
  const opened = try contained(editor.send({ type: "fromNote", day }), "opening the note's event")
  if (opened && fields.title.trim() === "") {
    try ignore(editor.send({ type: "editTitle", blank: true }))
  }
  return opened
}

function fieldsOf(fields: Fields): AndroidCalendarEditorFields {
  return { title: fields.title.trim(), body: fields.notes, location: fields.place, begin: fields.begin, end: fields.end }
}

const refused: Written = { confirmed: false, known: true }

/** A write the phone refused because the event changed since Calendar read it. */
const changedSince: Written & { readonly changed: true } = { confirmed: false, known: true, changed: true }

/** The same dated fields Calendar uses for additions and edits. */
function reminderFields(fields: Fields): DatedReminderFields {
  const instant = new Date(fields.begin)
  return {
    title: fields.title.trim(), notes: fields.notes.trim(), dueDate: formatCivilDate(civilDateAt(fields.begin)),
    dueMinute: fields.reminderDateOnly === true ? null : instant.getHours() * 60 + instant.getMinutes(),
    recurrence: fields.reminderRepeat ?? "none",
    alertMinutes: fields.reminderAlert === undefined ? 0 : fields.reminderAlert,
  }
}

effect function calendarShown() {
  return (try (try Device).showing()) && Shell.showing(try (try Shell.Machine).get(), "Calendar")
}

/** Save active reminders normally and review an edit that would reopen a completed reminder. */
export effect function saveCalendarReminder() {
  const editor = try Editor.Machine
  const state = try editor.get()
  if (!Editor.canSaveReminder(state)) return
  const fields = try kept(state.day, state.owner)
  const item = fields.reminderId === undefined ? undefined : remindersStore.findItem(fields.reminderId)
  if (state.form === "EditReminder" && item !== undefined && item.revision === fields.reminderRevision && needsReschedule(item, reminderFields(fields))) {
    if (!(try calendarShown())) return
    if (fields.reminderRepeat === "weekdays" && [0, 6].includes(new Date(fields.begin).getDay())) {
      try say("Pick a weekday", true)
      return
    }
    const now = try (try Time).now()
    if (fields.begin - (fields.reminderAlert ?? 0) * 60_000 <= now) {
      try say("Time passed", true)
      return
    }
    try contained(editor.send({ type: "askReschedule" }), "reviewing the new reminder time")
    return
  }
  try contained(editor.send({ type: "saveReminder" }), "saving the Calendar reminder")
}

/** Dispatch an approved reschedule while its retained edit is still visible. */
export effect function confirmCalendarReschedule() {
  const editor = try Editor.Machine
  const state = try editor.get()
  if (!Editor.canReschedule(state) || !(try calendarShown())) return
  const fields = try kept(state.day, state.owner)
  const now = try (try Time).now()
  if (fields.begin - (fields.reminderAlert ?? 0) * 60_000 <= now) {
    try contained(editor.send({ type: "callOff" }), "retiring the expired reschedule")
    try say("Time passed", true)
    return
  }
  try contained(editor.send({ type: "reschedule" }), "rescheduling the completed reminder")
}

effect function sourceStillOwned(fields: Fields) {
  const origin = fields.noteOrigin
  if (origin === undefined) return true
  const owner = launchOwnerAt() catch () => undefined
  return sameResidentOwner(originOwner(origin), owner)
}

effect function linkSource(fields: Fields, owning: number, target: Target, id?: string) {
  const origin = fields.noteOrigin
  if (origin === undefined || (try owner()) !== owning) return
  if (id !== undefined && (try storeOrigin(owning, target, id, origin))) return
  if ((try owner()) === owning) try say("Saved without a link to the source note.", true)
}

/** One retained Calendar form creates at most one reminder with these reviewed fields. */
effect function createCalendarReminder(fields: Fields, owning: number) {
  if (fields.calendar !== "Reminders" || fields.title.trim() === "") return refused
  const id = fields.reminderId ?? `rem_${fresh()}`
  const input = reminderFields(fields)
  const alreadySaved = remindersStore.findItem(id)
  if (alreadySaved !== undefined) {
    if (alreadySaved.title !== input.title || alreadySaved.notes !== input.notes || alreadySaved.dueDate !== input.dueDate
      || alreadySaved.dueMinute !== input.dueMinute || alreadySaved.recurrence !== input.recurrence || alreadySaved.alertMinutes !== input.alertMinutes) return refused
    try linkSource(fields, owning, "Reminder", id)
    return { confirmed: true, known: true }
  }
  if (fields.reminderId === undefined && !(try keep({ ...fields, reminderId: id }, owning))) return refused
  if ((try owner()) !== owning) return refused
  const saved = try createReminderItem({ id, listId: DEFAULT_LIST_ID, ...input })
  if (saved === undefined) return refused
  try linkSource(fields, owning, "Reminder", saved.id)
  return { confirmed: true, known: true }
}

effect function updateCalendarReminder(fields: Fields, owning: number, id: number, attempt: number, reschedule: boolean) {
  if (fields.calendar !== "Reminders" || fields.reminderId === undefined || fields.reminderRevision === undefined
    || fields.reminderSpecId !== id || (try owner()) !== owning) return refused
  const saved = try editDatedReminder(fields.reminderId, fields.reminderRevision, reminderFields(fields), attempt, reschedule)
  if (saved && reschedule) try say(fields.reminderAlert === null ? "Saved · No alert" : "Reminder rescheduled")
  return { confirmed: saved, known: true }
}

const calendarBase = "/api/lifeops/calendar"

/** What a read back of the agent's calendar finds of one event: its persisted fields and the owner's reply. */
schema Found {
  readonly events: ReadonlyArray<{
    readonly id: string
    readonly title: string
    readonly description: string
    readonly location: string
    readonly startAt: string
    readonly endAt: string
    readonly isAllDay: boolean
    readonly attendees: ReadonlyArray<{ readonly self: boolean; readonly responseStatus: string | null }>
  }>
}

// spec/app/calendar/editor.md, "An event ends after it starts"
/** The provider's interval: whole exclusive UTC dates for all-day events (`end > begin`) and unchanged instants for other events. */
function providerTimes(fields: Fields) {
  const startDay = civilDay(fields.begin)
  const exclusiveEndDay = fields.end <= fields.begin
    ? startDay + 1
    : Math.max(startDay + 1, civilDay(Math.max(fields.begin, fields.end - 1)) + 1)
  const begin = fields.allDay ? utcStart(startDay) : fields.begin
  const end = fields.allDay ? utcStart(exclusiveEndDay) : fields.end
  return { begin, end, timeZone: fields.allDay ? "UTC" : zone() }
}

/** The fields of the form as the agent's calendar takes them: an all-day event as an exclusive whole UTC date range (`endAt > startAt`), a timed one as instants in the phone's zone. */
export function agentFields(fields: Fields) {
  const { begin, end, timeZone } = providerTimes(fields)
  return {
    title: fields.title.trim(),
    description: fields.notes,
    location: fields.place,
    startAt: new Date(begin).toISOString(),
    endAt: new Date(end).toISOString(),
    isAllDay: fields.allDay,
    timeZone,
  }
}

/** Whether a read-back event matches every field written by an update. */
function updatedMatches(event: Found["events"][number], fields: Fields): boolean {
  const expected = agentFields(fields)
  const sameStart = expected.isAllDay
    ? event.startAt.slice(0, 10) === expected.startAt.slice(0, 10)
    : Date.parse(event.startAt) === Date.parse(expected.startAt)
  const sameEnd = expected.isAllDay
    ? event.endAt.slice(0, 10) === expected.endAt.slice(0, 10)
    : Date.parse(event.endAt) === Date.parse(expected.endAt)
  return event.title === expected.title
    && event.location === expected.location
    && event.description === expected.description
    && event.isAllDay === expected.isAllDay
    && sameStart && sameEnd
}

// spec/app/calendar/writing.md, "An applied create, change or answer is read back; only a read back that finds it as asked says saved"; spec/app/calendar/writing.md, "An applied deletion is never reported as an event Calendar could not look up"
/** How a write of `kind` to `row` ended, by what its read back `found`: nothing where the read back failed. */
function endedBy(found: Found | undefined, row: Row, kind: WriteKind, reply: string, fields?: Fields): Written {
  const event = found?.events.find((candidate) => candidate.id === row.key)
  const declined = row.cancel === "DeclineInvitation" && (event?.attendees.some((person) => person.self && person.responseStatus === "declined") ?? false)
  const readback: Readback = found === undefined ? "ReadbackFailed"
    : kind === "AnswerKind"
      ? (reply === "declined" && event === undefined
        ? "ReadbackFound"
        : answerReadback(event !== undefined, event?.attendees.some((person) => person.self && person.responseStatus === reply) ?? false))
    : kind === "ChangeKind" ? (event !== undefined && (fields === undefined || updatedMatches(event, fields)) ? "ReadbackFound" : "ReadbackMissing")
    : event === undefined || declined ? "ReadbackMissing" : "ReadbackFound"
  const seen = readbackSeen(kind, readback)
  return seen === "Saved" || seen === "Deleted" || seen === "DeletedByReceipt" ? { confirmed: true, known: true }
    : seen === "NotDeleted" ? refused : { confirmed: false, known: false }
}

/** Read `row` back from the agent's calendar after a write of `kind` it confirmed, and say how the write ended. */
effect function readBackAgent(row: Row, kind: WriteKind, reply: string, fields?: Fields): Written!!Agent {
  const anchorDay = fields !== undefined ? civilDay(fields.begin) : civilDay(row.begin)
  const urlParams = feedParams(anchorDay)
  const found = ask(Agent, HttpClientRequest.get(`${calendarBase}/feed`, { urlParams }), Found) catch () => undefined
  return endedBy(found, row, kind, reply, fields)
}

/** Whether the agent filed the write for the owner's approval instead of making it: nothing changed yet, and the approval card says it waits. */
function filed(body: unknown): boolean {
  return typeof body === "object" && body !== null && "approvalRequestId" in body
}

/** A write the agent took as a request for the owner's approval: made only once the owner approves its card. */
const waiting: Written & { readonly filed: true } = { confirmed: true, known: true, filed: true }

// spec/app/calendar/writing.md, "A new event goes to the calendar chosen in the form: the agent's own calendar, or a writable calendar on this phone"; spec/app/calendar/writing.md, "The agent's own calendar holds no repeats, alerts or video rooms"
/** A new event on the agent's own calendar, sent once under the attempt's key, then read back. */
effect function createAgent(attempt: number, fields: Fields, owning: number) {
  if (!agentCalendarAccepts(true, (fields.repeat ?? "NoRepeat") !== "NoRepeat", fields.alert !== undefined, fields.video === true)) return refused
  const payload = agentFields(fields)
  const sent = try attemptedWith(Agent, (key) => HttpClientRequest.post(`${calendarBase}/events`) |> HttpClientRequest.bodyJsonUnsafe(%, {
    ...payload, idempotencyKey: key,
  }), attempt)
  if (filed(sent.body)) return waiting
  if (!sent.confirmed) return { confirmed: false, known: sent.known }
  const urlParams = feedParams(civilDay(fields.begin))
  const listed = ask(Agent, HttpClientRequest.get(`${calendarBase}/feed`, { urlParams }), Created) catch () => undefined
  const exact = Schema.decodeUnknownOption(CreatedEvent)(sent.body)
  const event = Option.getOrUndefined(exact)?.event
  const exactFound = event !== undefined && listed?.events.some((row) => row.id === event.id && row.calendarId === event.calendarId) === true
  const matched = exactFound || listed?.events.some((row) =>
    row.title === payload.title && Date.parse(row.startAt) === Date.parse(payload.startAt)) === true
  const readback: Readback = listed === undefined ? "ReadbackFailed" : matched ? "ReadbackFound" : "ReadbackMissing"
  const seen = readbackSeen("CreateKind", readback)
  if (seen !== "Saved") return { confirmed: false, known: false }
  try linkSource(fields, owning, "AgentEvent", event !== undefined && exactFound ? eventKey(event.calendarId, event.id) : undefined)
  return { confirmed: true, known: true }
}

/** What a read back of the agent's calendar finds of a new event: its title and start. */
schema Created { readonly events: ReadonlyArray<{ readonly id?: string; readonly calendarId?: string; readonly title: string; readonly startAt: string }> }
schema CreatedEvent { readonly event: { readonly id: Schema.NonEmptyString; readonly calendarId: Schema.NonEmptyString } }

// spec/app/calendar/writing.md, "An invitation answer is sent only by the invitee, at the version shown, under a key made of the event, the answer and that version"; spec/app/calendar/writing.md, "Deleting is an organizer's cancel or an invitee's decline, and nothing when the organizer is unknown"
/** A change, a deletion or an answer to an event of the agent's calendar, sent once at the version shown, then read back. */
effect function sendAgent(attempt: number, kind: "Update" | "Remove" | "Reply", row: Row, scope: Scope, going: boolean): Written!!(Agent | Attempts | KeyValueStore.KeyValueStore | Editor.Machine) {
  const event = `${calendarBase}/events/${encodeURIComponent(row.key)}`
  const recurrenceScope = !row.recurring ? undefined : scope === "WholeSeries" ? "series" : scope === "ThisAndFollowing" ? "this_and_following" : "instance"
  const scoped = recurrenceScope === undefined ? {} : { recurrenceScope }
  const reply = going ? "accepted" : "tentative"
  if (kind === "Reply") {
    if (!row.answerable) return refused
    const sent = try attemptedWith(Agent, () => HttpClientRequest.post(`${event}/response`) |> HttpClientRequest.bodyJsonUnsafe(%, {
      responseStatus: reply, notifyAttendees: false, expectedProviderVersion: row.version, idempotencyKey: `answer:${row.key}:${reply}:${row.version}`,
    }), attempt)
    if (filed(sent.body)) return waiting
    return sent.confirmed ? try readBackAgent(row, "AnswerKind", reply) : { confirmed: sent.confirmed, known: sent.known }
  }
  if (kind === "Remove") {
    if (row.cancel === "NoCancellation" || row.managed) return refused
    const declining = row.cancel === "DeclineInvitation"
    const cancellationMode = declining ? "decline_invitation" : "organizer_cancel"
    const sent = try attemptedWith(Agent, (key) => HttpClientRequest.delete(event, { urlParams: { ...scoped, expectedProviderVersion: row.version, idempotencyKey: key, cancellationMode, notifyAttendees: "false" } }), attempt)
    if (filed(sent.body)) return waiting
    return sent.confirmed ? try readBackAgent(row, declining ? "AnswerKind" : "DeleteKind", declining ? "declined" : "") : { confirmed: sent.confirmed, known: sent.known }
  }
  if (!row.editable) return refused
  const maybe = try readKept(try owner())
  if (Option.isNone(maybe)) return refused
  const fields = maybe.value
  const sent = try attemptedWith(Agent, (key) => HttpClientRequest.patch(event) |> HttpClientRequest.bodyJsonUnsafe(%, {
    ...agentFields(fields), ...scoped, expectedProviderVersion: row.version, idempotencyKey: key,
  }), attempt)
  if (filed(sent.body)) return waiting
  return sent.confirmed ? try readBackAgent(row, "ChangeKind", "", fields) : { confirmed: sent.confirmed, known: sent.known }
}

effect function readEventDraft(owning: number) {
  const maybe = try readKept(owning)
  if (Option.isNone(maybe) || maybe.value.calendar === "Reminders") return undefined
  const fields = maybe.value
  return { fields, rrule: rules[fields.repeat ?? "NoRepeat"], hasAlert: fields.alert !== undefined, hasVideo: fields.video === true }
}

// spec/app/calendar/editor.md, "Saving sends the form once, as a new numbered write built on the revision its edits began from"; spec/app/calendar/editor.md, "No create is sent while an earlier one is in doubt, unless the owner asked for a separate event"
// spec/app/calendar/writing.md, "Guests, alerts and video rooms go to Android Calendar; zones, all-day and repeats use the direct save for a new event"; spec/app/calendar/writing.md, "The agent's own calendar holds no repeats, alerts or video rooms"
// spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted, and whether it changed; a sent deletion hides it until a read no longer has it unchanged"
/** Carry out write `attempt`: a create under its own creation identity, a change or a deletion through the phone's review; a deletion only of the event at `base`, the revision the owner confirmed. */
effect function send(attempt: number, kind: Exclude<Write, "CreateReminder" | "UpdateReminder" | "RescheduleReminder">, id: number, scope: Scope, going: boolean, base: number) {
  const phone = try PhoneCalendar
  const owning = try owner()
  if (kind === "Create") {
    const draft = try readEventDraft(owning)
    if (draft === undefined) return refused
    const { fields, rrule, hasAlert, hasVideo } = draft
    const agentAccepts = agentCalendarAccepts(true, rrule !== "", hasAlert, hasVideo)
    const view = try (try View.Machine).get()
    if (newEventTarget(view.connected, fields.calendar === "Phone") === "AgentOwnCalendar") return agentAccepts ? try createAgent(attempt, fields, owning) : refused
    const route = deviceRoute(false, fields.people.trim() !== "", hasAlert, hasVideo, fields.allDay, false, rrule !== "")
    if (route === "AndroidHandoff") return refused
    const creation = try (try Attempts).key(attempt)
    try ignore((try KeyValueStore.KeyValueStore).set(creationKey, creation))
    const separate = (try (try Editor.Machine).get()).separate
    const event = fieldsOf(fields)
    if (fields.noteOrigin !== undefined && !(try keep({ ...fields, noteCreation: creation }, owning))) return refused
    const request = route === "OptionsSave" ? { kind: "Options", event: { ...event, ...providerTimes(fields), allDay: fields.allDay, rrule } } as const
      : { kind: "Timed", event } as const
    const result = try phone.create(request, creation, separate)
    if (result.confirmed) try linkSource(fields, owning, "PhoneEvent", creation)
    return result
  }
  const shown = try Shown
  const row = shown.find(id) ?? (kind === "Remove" ? shown.lastSeen(id) : undefined)
  if (row === undefined) return refused
  if (kind === "Remove" && row.revision !== base) {
    if (phone.cancel) try phone.cancel(row.key)
    return changedSince
  }
  if (kind === "Update") {
    const draft = try readEventDraft(owning)
    if (draft === undefined) return refused
    const { fields, rrule, hasAlert, hasVideo } = draft
    if (row.source === "Google") return agentCalendarAccepts(true, rrule !== "", hasAlert, hasVideo) ? try sendAgent(attempt, kind, row, scope, going) : refused
    const route = deviceRoute(true, fields.people.trim() !== "", hasAlert, hasVideo, fields.allDay || row.allDay, false, row.recurring || rrule !== "")
    return route === "DirectSave" ? try phone.update(pickOf(row), fieldsOf(fields)) : refused
  }
  if (row.source === "Google") return try sendAgent(attempt, kind, row, scope, going)
  if (kind === "Reply") return refused
  const which = deletionScope(scope, row.recurring)
  if (which === undefined) return refused
  const staged = try phone.stage(pickOf(row), which)
  if (staged.kind === "editor") {
    const dates = androidWindowOf(row)
    try ignore(phone.open(row.key, dates.begin, dates.end))
    return refused
  }
  if (staged.kind === "conflict") return changedSince
  if (staged.kind !== "ready") return refused
  const time = try Time
  try time.until((try time.now()) + staged.window)
  return try phone.dispatch(row.key)
}

// spec/app/calendar/editor.md, "While a create is in doubt its form waits; checking the phone's receipts finds it or not"; spec/app/calendar/editor.md, "Saving sends the form once, as a new numbered write built on the revision its edits began from"
/** Whether the phone's receipts say a create was made: one in doubt, or any not yet acknowledged before a new create; a failed read holds the create. */
effect function receipts(ticket: number) {
  const phone = try PhoneCalendar
  if (!phone.present) return { type: "receiptsChecked", ticket, found: false }
  const creation = (try KeyValueStore.KeyValueStore).get(creationKey) catch () => undefined
  if (creation === undefined) return { type: "receiptsChecked", ticket, found: false }
  return effect {
    const found = try phone.created(creation)
    if (found) {
      const owning = try owner()
      const draft = try readKept(owning)
      if (Option.isSome(draft) && draft.value.noteCreation === creation) try linkSource(draft.value, owning, "PhoneEvent", creation)
    }
    return { type: "receiptsChecked", ticket, found } as Event
  } catch () => ({ type: "receiptsFailed", ticket })
}

// spec/app/calendar/editor.md, "Such a form is handed to Android Calendar and closes; Alpha writes nothing of it"
effect function handOff() {
  const owning = try owner()
  const maybe = try readKept(owning)
  if (Option.isNone(maybe)) return
  const fields = maybe.value
  if (!(try sourceStillOwned(fields)) || (try owner()) !== owning) return
  const people = fields.people.split(",").map((person) => person.trim()).filter((person) => person !== "")
  const rrule = rules[fields.repeat ?? "NoRepeat"]
  const alerts = fields.alert === undefined ? [] : [fields.alert]
  try (try PhoneCalendar).handOff({ ...fieldsOf(fields), ...providerTimes(fields), allDay: fields.allDay, attendees: people, alerts, rrule })
}

type SavedDay = { readonly owner: number; readonly attempt: number; readonly route: number; readonly anchor: number; readonly day: number }

// spec/app/calendar/editor.md, "A saved form closes; a refused one keeps its edits to save again"
effect function showSavedDay(saved: SavedDay) {
  const editor = try Editor.Machine
  const view = try View.Machine
  const shell = try Shell.Machine
  const current = (form: Editor.Editor, calendar: View.Calendar, route: Shell.Shell) =>
    form.owner === saved.owner && form.write.id === saved.attempt && form.write.outcome === "Confirmed" && !form.shown &&
    calendar.owner === saved.owner && calendar.anchor === saved.anchor && calendar.front &&
    route.route === saved.route && Shell.showing(route, "Calendar")
  const changes = Stream.zipLatest(Stream.zipLatest(editor.changes, view.changes), shell.changes)
  try Stream.runHead(Stream.filter(changes, ([[form, calendar], route]) =>
    !current(form, calendar, route) || calendar.form === "NoFormShown"))
  const calendar = try view.get()
  if (current(try editor.get(), calendar, try shell.get()) && View.canPickDay(calendar, saved.day)) {
    try contained(view.send({ type: "pickDay", day: saved.day }), "showing the saved day")
  }
}

// spec/app/calendar/index.md, "A read asked for during a write waits for it, and follows it once"; spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted, and whether it changed; a sent deletion hides it until a read no longer has it unchanged"
/** How write `attempt` ended; the calendar asks to read its day again, which waits for the write and then shows it or releases its doubt. */
effect function writeAnswers(attempt: number, kind: Write, id: number, scope: Scope, going: boolean, base: number) {
  const owning = try owner()
  const view = try View.Machine
  const anchor = (try view.get()).anchor
  const route = (try (try Shell.Machine).get()).route
  const draft = try readKept(owning)
  const changingReminder = kind === "UpdateReminder" || kind === "RescheduleReminder"
  if (kind === "Create" || kind === "CreateReminder") {
    if (Option.isNone(draft) || !(try sourceStillOwned(draft.value)) || (try owner()) !== owning) {
      return Stream.succeed<Event>({ type: "written", attempt, confirmed: false, known: true, filed: false })
    }
  }
  const outcome: Written = kind === "CreateReminder"
    ? (Option.isSome(draft) ? try createCalendarReminder(draft.value, owning) : refused)
    : changingReminder
      ? (Option.isSome(draft) ? try updateCalendarReminder(draft.value, owning, id, attempt, kind === "RescheduleReminder") : refused)
      : try send(attempt, kind, id, scope, going, base)
  if (kind !== "CreateReminder" && !changingReminder) try contained(view.send({ type: "changeCommitted" }), "reading the day again after a write")
  if (kind === "Remove") try contained((try Held.Machine).send({ type: "ended", id, done: outcome.confirmed && !("filed" in outcome), changed: "changed" in outcome }), "telling the deletions how one ended")
  const result = Stream.succeed<Event>({ type: "written", attempt, confirmed: outcome.confirmed, known: outcome.known, filed: "filed" in outcome && outcome.filed === true })
  if ((kind === "Create" || kind === "CreateReminder" || kind === "Update") && outcome.confirmed && !("filed" in outcome) && Option.isSome(draft)) {
    const day = civilDay(draft.value.begin)
    if (day !== anchor) return Stream.concat(result, Stream.fromEffectDrain(showSavedDay({ owner: owning, attempt, route, anchor, day })))
  }
  return result
}

function carry(fx: Out) {
  return match (fx) {
    when { tag: "Send", let attempt, let kind, let id, let scope, let base }:
      stream(`write ${attempt}`, Stream.unwrap(writeAnswers(attempt, kind, id, scope, false, base)), { type: "written", attempt, confirmed: false, known: false, filed: false });
    when { tag: "Answer", let attempt, let id, let going, let base }:
      stream(`answer ${attempt}`, Stream.unwrap(writeAnswers(attempt, "Reply", id, "ThisOne", going, base)), { type: "written", attempt, confirmed: false, known: false, filed: false });
    when { tag: "HandOff" }: run("hand off", Effect.ignore(handOff()));
    when { tag: "CheckReceipts", let ticket }: answer("receipts", receipts(ticket), { type: "receiptsChecked", ticket, found: false });
    when { tag: "ResetSlot" }:
      answer("reset", effect {
        return { type: "slotReset", ok: try resetSlot() } as Event
      }, { type: "slotReset", ok: false });
    when { tag: "KeepDraft" }:
      answer("keep", effect {
        const who = try owner()
        const maybe = try readKept(who)
        return Option.isSome(maybe) && (try keep(maybe.value, who)) ? ({ type: "draftKept" } as Event) : ({ type: "keepFailed" } as Event)
      }, { type: "keepFailed" });
  }
}

// spec/app/calendar/editor.md, "A read of the event releases the doubt; a form waiting on it then shows the event as it now is"
/** A change in doubt whose number names no event Calendar kept a number for, as one an earlier build kept, can never be read back: its doubt is let go, as an event gone lets it go. */
const unnamed = started(effect {
  const editor = try Editor.Machine
  const shown = try Shown
  try Stream.runForEach(editor.changes, effect (form) => {
    for (const id of form.latched) if (shown.forgets(id)) try contained(editor.send({ type: "eventMissing", id, whole: true }), "letting go a doubt Calendar cannot name")
  })
}, "letting go the doubts Calendar cannot name")

// spec/app/calendar/editor.md, "A read of the event releases the doubt; a form waiting on it then shows the event as it now is"
/** Each read of either calendar tells the form what it found of the event it edits or holds in doubt, looked for where it was last seen, though only kept from before a restart. */
const reread = started(effect {
  const view = try View.Machine
  const editor = try Editor.Machine
  const shown = try Shown
  try Stream.runForEach(loadedReads(view), effect () => {
    const form = try editor.get()
    const state = try view.get()
    for (const id of new Set([...(form.form === "EditReminder" ? [] : [form.target]), ...form.latched])) {
      if (id === 0) continue
      const row = shown.find(id) ?? shown.lastSeen(id) ?? shown.seenAt(id)
      const read = row?.source === "Phone"
        ? { status: state.phone.status, limited: state.phoneLimited, day: state.phoneDay }
        : { status: state.google.status, limited: state.googleLimited, day: state.googleDay }
      const whole = row !== undefined && read.status === "Loaded" && !read.limited && readHolds(row.begin, read.day)
      const there = shown.find(id)
      if (there === undefined && whole) try contained(editor.send({ type: "eventMissing", id, whole }), "telling the form its event is gone")
      else if (there !== undefined) try contained(editor.send({ type: "eventRead", id, revision: there.revision, whole }), "telling the form what the read found")
    }
  })
}, "following the calendars' reads for the form")

module web {
  import { Stream } from "effect"

  /** The keys another page of Alpha changed in the store this one shares, as the browser says; none where there is no window. @throws {never} */
  export function storeChanged(): Stream.Stream<string> {
    const target = globalThis as unknown as Partial<EventTarget>
    if (typeof target.addEventListener !== "function") return Stream.empty
    return Stream.map(Stream.fromEventListener<StorageEvent>(target as EventTarget, "storage"), (changed) => changed.key ?? "")
  }
}
import { storeChanged } from web

// spec/app/calendar/editor.md, "When another copy replaced the kept draft, the owner keeps theirs or takes the other"
/** Another page of Alpha kept a draft over this one's: the form asks the owner which to keep. */
const elsewhere = hearing(Stream.filter(storeChanged(), (key) => key.includes("alpha.calendar.form.")), Editor.Machine, (): Event => ({ type: "replacedElsewhere" }))

// spec/app/calendar/editor.md, "A note or a scan opens a new event already filled in, as edits to review, only when no other draft is kept"
const scanned = started(effect {
  const entry = try ScanEntry
  const shell = try Shell.Machine
  try Stream.runForEach(Stream.zipLatest(shell.changes, entry.events), effect ([where, event]) => {
    if (event === undefined) return
    const note = event.noteSource
    if (!Shell.showing(where, "Calendar")) {
      if (note !== undefined && where.route >= note.route) try entry.releaseEvent(event)
      return
    }
    const review = try entry.takeEvent()
    if (review === undefined) return
    const offered = review.noteSource
    if (offered !== undefined) {
      const owner = launchOwnerAt() catch () => undefined
      const latest = try shell.get()
      if (latest.route !== offered.route || !Shell.showing(latest, "Calendar") || !sameResidentOwner(offered.owner, owner)) return
    }
    if (!(try fromNote(review.fields, review.day))) {
      try say(offered === undefined ? "Calendar already has a draft. Finish it before opening this scan’s event."
        : "Calendar couldn’t open the note’s draft. Finish any open draft first.", true)
    } else if (offered !== undefined) try say("Check time")
  })
}, "opening a scanned Calendar draft")

// spec/app/calendar/editor.md, "Cancel, Back, a hidden page, a locked screen or leaving Calendar closes the form and its confirmations; the slot keeps the edits"
const left = hearing(Stream.filter(calendarInFront, (front) => !front), Editor.Machine, (): Event => ({ type: "leave" }))

// spec/app/calendar/editor.md, "A slot the phone cannot read is kept and explained; only a development build resets it, and only as it was when the owner confirmed"
/** The owner's slot is read once Calendar is built and again whenever the owner changes. */
const slotChecked = started(effect {
  const editor = try Editor.Machine
  try Stream.runForEach(Stream.changes(Stream.map(editor.changes, (s) => s.owner)), () => checkSlot())
}, "reading the kept draft")

// spec/app/platform/index.md, "A state kept in a shape an earlier build wrote is read in today's shape, with what the owner kept in it"
function storedEditor(key: string, start = Editor.initial) {
  const { unreadable } = Editor.initial
  return Layer.provide(Editor.stored(key, start), filledStore(key, (kept) => ({ unreadable, ...kept }), Editor.parseState))
}

/** The editor: kept on the phone across restarts, which ends what was in flight; its writes go to the phone's calendar once. */
export const editor = together(
  reacting({ ...Editor, stored: storedEditor }, { keep: 1, open: [{ type: "restart" }], carry }),
  reread,
  unnamed,
  elsewhere,
  scanned,
  left,
  slotChecked,
)
