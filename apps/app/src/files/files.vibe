// spec/app/files/index.md, "Story: Browse my storage"
import type { ElizaFilesPlugin, FileOutcomeRow, FilesCategory, StorageEntry, TrashEntry } from "@elizaos/os-bridges"
import * as Browser from "../../gen/app__files.effect.vibe"
import type { Actor, Count, Effect as Out, Event, Tally, Volume } from "../../gen/app__files.effect.vibe"
import { type Filter, type Where, everything, inDates, ofKind } from "../../gen/app__files__search.effect.vibe"
import { type Item, type Kind, fitsKind } from "../../gen/app__files__shared.effect.vibe"
import * as Bin from "../../gen/app__files__trash.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Device } from "../platform/index.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, say } from "../notices/index.vibe"
import { Files, FilesFailed, called } from "../platform/index.vibe"
import { type Job, answer, applying, due, fieldsOf, filledStore, following, hearing, reacting, run, together, untimed, withFields } from "../runtime/index.vibe"
import { scopedShelf, type Shelf } from "../runtime/index.vibe"
import { scan, scanBack } from "./scan.vibe"
import type { Machine as ScanMachine } from "../../gen/app__files__scan.effect.vibe"
import type { Machine as CorrectionMachine } from "../../gen/app__files__correction.effect.vibe"
import { Handles, type Spot, handles } from "./handles.vibe"
import { childrenOf, kindOf, parentPath } from "./entries.vibe"
import { TrashFacts, type TrashItemFacts, trashFacts } from "./trashFacts.vibe"
import { type CategoryGroups, categoryGroups, groupsFor } from "./category.vibe"
import * as Shown from "../../gen/app__files__preview.effect.vibe"
import * as Recent from "../../gen/app__files__recent.effect.vibe"
import type { Documents } from "../platform/index.vibe"
import { type Opened, preview, taken, view } from "./preview.vibe"
import { Answers, type Receipt, type ReviewedBatch, answers } from "./agent.vibe"

module names {
  /** Whether `name` contains `text`, as the owner reads it: letters compared without their case. @throws {never} */
  export function containsText(name: string, text: string): boolean {
    return name.toLocaleLowerCase().includes(text.toLocaleLowerCase())
  }
  /** @throws {never} */
  export function joined(folder: string, name: string): string {
    return folder === "" ? name : `${folder}/${name}`
  }
  /** Put `text` on the clipboard. */
  export async function copied(text: string): Promise<void> {
    await navigator.clipboard.writeText(text)
  }
  const collator = new Intl.Collator()
  /** @throws {never} */
  export function compareNames(first: string, second: string): number {
    return collator.compare(first, second)
  }
}
import { compareNames, containsText, copied, joined } from names
export { parentPath as parentOf }

// spec/app/files/index.md, "A name matches a text when the phone's comparison says it contains it; every name contains the empty text and itself"
Browser.opaque.containsText = containsText
// spec/app/files/index.md, "Folders come before files in every sort: by name in the phone's order of names, by date the newest first, by size the largest first; choosing the sort again turns the order within the folders and within the files"
Browser.opaque.nameBefore = (first: string, second: string) => compareNames(first, second) < 0

/** The phone's category for a kind Files lists as one. */
const categories: Partial<Record<Kind, FilesCategory>> = { Download: "downloads", Image: "images", Video: "videos", Audio: "audio", Document: "documents" }

/** The volume the phone lists a category from, and searches. */
const primary = "primary"

/** Number the volume and its entries together, preserving the phone's listing order. */
effect function itemsOf(volume: string, entries: ReadonlyArray<StorageEntry>, kind?: Kind): Item[]!!Handles {
  if (entries.length === 0) return []
  const numbered = try Handles
  const [root, ...items] = try numbered.many([{ volume, path: "" }, ...entries.map((entry) => ({ volume, path: entry.path }))])
  const rows: Item[] = []
  for (const [index, entry] of entries.entries()) {
    const id = items[index]
    if (id === undefined || root === undefined) continue
    rows.push({
      id,
      name: entry.name,
      revision: Math.max(0, Math.trunc(entry.modified)),
      kind: entry.directory ? "Folder" : (kind ?? kindOf(entry)),
      volume: root,
      bytes: entry.directory ? 0 : Math.max(0, Math.trunc(entry.size)),
      children: childrenOf(entry),
    })
  }
  return rows
}

/** The spot a number names, or none where it names nothing this phone gave. */
effect function spotOf(handle: number): Option.Option<Spot>!!Handles {
  return try (try Handles).spot(handle)
}

/** The folder a trail ends at: its volume's root, or a folder under it. */
effect function folderOf(trail: ReadonlyArray<number>): Option.Option<Spot>!!Handles {
  return trail.length === 0 ? Option.none() : try spotOf(trail[trail.length - 1] ?? 0)
}

// spec/app/files/index.md, "The top shows each volume with a storage bar that is never fuller than the volume, or says the storage is unavailable"
effect function measured(ticket: number): Event!!(Files | Handles) {
  return effect {
    const state = try called("storageState", (plugin) => plugin.storageState())
    if (state.status !== "ready") return { type: "storageRead", ticket, ok: false, volumes: [], tally: Browser.untallied }
    const numbered = try Handles
    const volumes: Volume[] = []
    for (const volume of [...(state.volumes ?? [])].sort((a, b) => Number(b.primary) - Number(a.primary))) {
      const id = try numbered.of({ volume: volume.id, path: "" })
      try numbered.name(id, volume.name)
      volumes.push({ id, used: Math.max(0, Math.trunc(volume.total - volume.free)), total: Math.max(0, Math.trunc(volume.total)) })
    }
    return { type: "storageRead", ticket, ok: true, volumes, tally: try tallied((state.volumes ?? []).map((volume) => volume.id)) }
  } catch () => ({ type: "storageRead", ticket, ok: false, volumes: [], tally: Browser.untallied })
}

// spec/app/files/index.md, "The top shows how many files each category holds and the room they take, and how many items the Trash holds, as the storage was last read"
effect function tallied(volumes: ReadonlyArray<string>): Tally!!Files {
  const categoryEntries = Object.entries(categories) as [Kind, FilesCategory][]
  const [countsRaw, trashCounts] = try.all [
    Effect.forEach(categoryEntries, effect ([kind, category]) => {
      const reply = called("storageCategory", (plugin) => plugin.storageCategory({ category, countOnly: true })) catch () => undefined
      return reply?.status === "ready"
        ? { kind, items: Math.max(0, Math.trunc(reply.count ?? reply.entries?.length ?? 0)), bytes: Math.max(0, Math.trunc(reply.bytes ?? 0)) }
        : undefined
    }, { concurrency: 5 }),
    Effect.forEach(volumes.length === 0 ? [primary] : volumes, effect (volume) => {
      const reply = called("storageTrashList", (plugin) => plugin.storageTrashList({ volume })) catch () => undefined
      return reply?.status === "ready" ? (reply.items ?? []).length : 0
    }, { concurrency: 4 }),
  ]
  const counts = countsRaw.filter((one): one is Count => one !== undefined)
  const trashed = trashCounts.reduce((sum, count) => sum + count, 0)
  return { counts, trashed }
}

// spec/app/files/index.md, "The place showing is read again when asked, and only its newest answer is taken; a folder that no longer exists brings the owner back to the top and says so, never that the storage is unavailable"
effect function looked(ticket: number, trail: ReadonlyArray<number>, category: Kind, inCategory: boolean): Event!!(Files | Handles | CategoryGroups) {
  const failed: Event = { type: "listed", ticket, ok: false, gone: false, complete: false, entries: [] }
  return effect {
    if (inCategory) {
      const wanted = categories[category]
      if (wanted === undefined) return failed
      const reply = try called("storageCategory", (plugin) => plugin.storageCategory({ category: wanted }))
      if (reply.status !== "ready") return failed
      const entries = reply.entries ?? []
      if (category === "Image" || category === "Video") try groupsFor(ticket, entries, reply.folders)
      return { type: "listed", ticket, ok: true, gone: false, complete: reply.truncated !== true, entries: try itemsOf(primary, entries, category === "Download" ? "Download" : undefined) }
    }
    const found = try folderOf(trail)
    if (Option.isNone(found)) return { type: "listed", ticket, ok: false, gone: true, complete: false, entries: [] }
    const { volume, path } = found.value
    const reply = try called("storageList", (plugin) => plugin.storageList({ volume, path }))
    if (reply.status === "missing") return { type: "listed", ticket, ok: false, gone: true, complete: false, entries: [] }
    if (reply.status !== "ready") return failed
    return { type: "listed", ticket, ok: true, gone: false, complete: reply.truncated !== true, entries: try itemsOf(volume, reply.entries ?? []) }
  } catch () => failed
}

/** The most rows the phone's search gives in one answer: an answer that fills it may have stopped short of every match. */
const queryMost = 500

/** Whether the phone's search reached every file: as it says, or, where it does not say, an answer short of a full page. */
function whole(reply: { readonly entries?: ReadonlyArray<unknown> }): boolean {
  return "truncated" in reply ? reply.truncated === false : (reply.entries ?? []).length < queryMost
}

type NativeQuery = Parameters<ElizaFilesPlugin["storageQuery"]>[0]

/** What the phone's search takes for a filter in a place. */
effect function query(where: Where, wanted: Filter): (NativeQuery & { volume: string })!!Handles {
  const found = where.inCategory ? Option.none<Spot>() : try folderOf(where.trail)
  const kind = wanted.anyKind ? where.inCategory ? where.category : undefined : wanted.kind
  const prefix = kind === "Image" ? "image/" : kind === "Video" ? "video/" : kind === "Audio" ? "audio/" : kind === "Pdf" ? "application/pdf" : undefined
  return {
    volume: Option.isSome(found) ? found.value.volume : primary,
    ...(wanted.text === "" ? {} : { text: wanted.text }),
    ...(wanted.from === everything.from ? {} : { from: wanted.from }),
    ...(wanted.to === everything.to ? {} : { to: wanted.to }),
    ...(prefix === undefined ? {} : { mimePrefix: prefix }),
    ...(kind === "Document" ? { documents: true } : {}),
    ...(kind === "Folder" ? { folders: true } : {}),
    ...(where.inCategory && where.category === "Download" ? { folder: "Download" } : Option.isSome(found) && found.value.path !== "" ? { folder: found.value.path } : {}),
  }
}

function matches(wanted: Filter, item: Item): boolean {
  return containsText(item.name, wanted.text) && ofKind(wanted, item) && inDates(wanted, item.revision)
}

// spec/app/files/index.md, "The owner sets a filter of a kind and a text for the place showing, as a chip the owner sees and clears; only what matches both is shown"
effect function searched(ticket: number, where: Where, wanted: Filter): Event!!(Files | Handles) {
  const failed: Event = { type: "searched", ticket, ok: false, complete: false, entries: [] }
  return effect {
    const { volume, ...asked } = try query(where, wanted)
    if (volume !== primary) {
      const path = asked.folder ?? ""
      const reply = try called("storageList", (plugin) => plugin.storageList({ volume, path }))
      if (reply.status !== "ready") return failed
      const entries = (try itemsOf(volume, reply.entries ?? [])).filter((item) => matches(wanted, item))
      return { type: "searched", ticket, ok: true, complete: reply.truncated !== true && !(reply.entries ?? []).some((entry) => entry.directory), entries }
    }
    const reply = try called("storageQuery", (plugin) => plugin.storageQuery(asked))
    if (reply.status !== "ready") return { type: "searched", ticket, ok: false, complete: false, entries: [] }
    const items = try itemsOf(volume, reply.entries ?? [])
    const entries = where.inCategory && where.category !== "Download" ? items.filter((item) => fitsKind(where.category, item.kind)) : items
    return { type: "searched", ticket, ok: true, complete: whole(reply), entries }
  } catch () => ({ type: "searched", ticket, ok: false, complete: false, entries: [] })
}

// spec/app/files/index.md, "The owner opens the Move to sheet for the selection, at the folder showing, and goes through the volumes and folders in it"
effect function destination(ticket: number, trail: ReadonlyArray<number>): Event!!(Files | Handles) {
  return effect {
    const found = try folderOf(trail)
    if (Option.isNone(found)) return { type: "destRead", ticket, ok: false, entries: [] }
    const { volume, path } = found.value
    const reply = try called("storageList", (plugin) => plugin.storageList({ volume, path }))
    if (reply.status !== "ready") return { type: "destRead", ticket, ok: false, entries: [] }
    return { type: "destRead", ticket, ok: true, entries: try itemsOf(volume, reply.entries ?? []) }
  } catch () => ({ type: "destRead", ticket, ok: false, entries: [] })
}

// spec/app/files/index.md, "The agent reads a folder for itself, and only its newest reading is told to it; it is told it failed without access or on a protected screen"
effect function peeked(ticket: number, folder: number, wanted: Filter): Event!!(Files | Handles) {
  return effect {
    const found = try spotOf(folder)
    if (Option.isNone(found)) return { type: "agentLooked", ticket, ok: false, entries: [] }
    const { volume, path } = found.value
    const reply = try called("storageList", (plugin) => plugin.storageList({ volume, path }))
    if (reply.status !== "ready") return { type: "agentLooked", ticket, ok: false, entries: [] }
    const entries = (try itemsOf(volume, reply.entries ?? [])).filter((item) => matches(wanted, item))
    return { type: "agentLooked", ticket, ok: true, entries }
  } catch () => ({ type: "agentLooked", ticket, ok: false, entries: [] })
}

/** The items of one volume and their paths, in the order given; an item whose number names no spot is left out. */
effect function pathsOf(items: ReadonlyArray<Item>): Map<string, Map<string, number>>!!Handles {
  const byVolume = new Map<string, Map<string, number>>()
  for (const item of items) {
    const found = try spotOf(item.id)
    if (Option.isNone(found)) continue
    const paths = byVolume.get(found.value.volume) ?? new Map<string, number>()
    paths.set(found.value.path, item.id)
    byVolume.set(found.value.volume, paths)
  }
  return byVolume
}

/** How many paths one call of the phone takes in a change of many: well within the 500 it accepts. */
const chunk = 50

/** What the phone answered for a batch: each row it named, the paths of a chunk it refused or never sent, and those of a chunk whose answer was lost. */
interface Batch {
  readonly rows: FileOutcomeRow[]
  readonly unsent: string[]
  readonly lost: string[]
}

/**
 * `paths` sent in chunks, one at a time and each once: a chunk the phone refused stops the batch, and the rest is
 * known not done; a chunk whose answer never came may have taken effect, so nothing of it is claimed and the batch
 * stops there.
 */
effect function batched(method: string, paths: ReadonlyArray<string>, call: (plugin: ElizaFilesPlugin, part: string[]) => Promise<{ readonly status: string; readonly outcomes?: readonly FileOutcomeRow[] }>): Batch!!Files {
  const rows: FileOutcomeRow[] = []
  for (let from = 0; from < paths.length; from += chunk) {
    const part = paths.slice(from, from + chunk)
    const reply = called(method, (plugin) => call(plugin, part)) catch () => undefined
    if (reply === undefined) return { rows, unsent: paths.slice(from + chunk), lost: part }
    if (reply.status !== "ready") return { rows, unsent: paths.slice(from), lost: [] }
    rows.push(...(reply.outcomes ?? []))
  }
  return { rows, unsent: [], lost: [] }
}

/** What each row of the phone's answer says of the item it names: done only where it is the change's own result. */
function sorted(rows: ReadonlyArray<FileOutcomeRow>, paths: Map<string, number>, done: number[], failed: number[], result: "moved" | "copied") {
  for (const [path, id] of paths) {
    const replies = rows.filter((row) => row.path === path)
    const [row] = replies
    if (replies.length !== 1 || row === undefined) continue
    if (row.status === result && row.to !== undefined) done.push(id)
    else if (row.status !== result) failed.push(id)
  }
}

effect function reviewCurrent(binding: ReviewedBatch): boolean!!(Browser.Machine | Shell | Device) {
  if (!(try promise(binding.current)) || !(try (try Device).showing()) || !showing(try (try Shell).get(), "Files")) return false
  const state = try (try Browser.Machine).get()
  const there = Browser.where(state)
  return state.open && Browser.allowed(state) && !state.trash && there.inCategory === binding.where.inCategory
    && there.category === binding.where.category && there.trail.length === binding.where.trail.length
    && there.trail.every((id, at) => binding.where.trail[at] === id)
}

// spec/app/files/index.md, "An approved request runs only in Files on screen, in the folder the owner approved, on a screen that is not protected, and on the item as it was shown; otherwise the agent is told it did not run"
/**
 * Which of `paths` across their parent folders the phone still holds as `items` were shown, at the same revision and size, with the
 * identity the phone gives each so that its own write refuses one that changed after; the rest changed and are not sent.
 */
effect function asShown(volume: string, paths: ReadonlyMap<string, number>, items: ReadonlyArray<Item>, binding?: ReviewedBatch): { kept: string[]; reviewed: string[]; changed: number[] }!!Files {
  if (binding !== undefined) {
    const identities = new Map(binding.targets.map((entry) => [entry.path, entry]))
    const kept: string[] = []
    const reviewed: string[] = []
    const changed: number[] = []
    for (const [path, id] of paths) {
      const bound = identities.get(path)
      if (volume === primary && bound !== undefined && bound.item.id === id) {
        kept.push(path)
        reviewed.push(bound.token)
      } else changed.push(id)
    }
    return { kept, reviewed, changed }
  }
  const parents = [...new Set([...paths.keys()].map(parentPath))]
  const listings = try Effect.forEach(parents, effect (folder) => {
    const there = called("storageList", (plugin) => plugin.storageList({ volume, path: folder })) catch () => undefined
    return there?.status === "ready" ? (there.entries ?? []) : []
  }, { concurrency: 4 })
  const now = new Map(listings.flat().map((entry) => [entry.path, entry]))
  const kept: string[] = []
  const changed: number[] = []
  for (const [path, id] of paths) {
    const item = items.find((one) => one.id === id)
    const entry = now.get(path)
    const same = item !== undefined && entry !== undefined && Math.trunc(entry.modified) === item.revision && (entry.directory || Math.trunc(entry.size) === item.bytes)
    if (same) kept.push(path)
    else changed.push(id)
  }
  if (kept.length === 0) return { kept, reviewed: [], changed }
  const reply = called("storageReviewedIdentities", (plugin) => plugin.storageReviewedIdentities({ volume, paths: kept })) catch () => undefined
  if (reply?.status !== "ready" || reply.reviewed?.length !== kept.length) return { kept: [], reviewed: [], changed: [...changed, ...kept.map((path) => paths.get(path) ?? 0)] }
  return { kept, reviewed: [...reply.reviewed], changed }
}

// spec/app/files/change.md, "A file of the same name is replaced only when the owner chose to replace it, never for the agent"
/**
 * Make room in `folder` for `paths` the owner chose to put in place of what has their names: the phone never writes
 * over a file, so each file of the same name goes to the Trash first, where the owner can still bring it back. The
 * paths whose name could not be freed, which are not sent.
 */
effect function cleared(volume: string, folder: string, paths: ReadonlyMap<string, number>): string[]!!Files {
  const wanted = new Map([...paths.keys()].map((path) => [path.slice(path.lastIndexOf("/") + 1), path]))
  const there = called("storageList", (plugin) => plugin.storageList({ volume, path: folder })) catch () => undefined
  if (there?.status !== "ready") return [...paths.keys()]
  const clashing = (there.entries ?? []).filter((entry) => wanted.has(entry.name) && wanted.get(entry.name) !== entry.path)
  if (clashing.length === 0) return []
  const reviewed = called("storageReviewedIdentities", (plugin) => plugin.storageReviewedIdentities({ volume, paths: clashing.map((entry) => entry.path) })) catch () => undefined
  if (reviewed?.status !== "ready" || reviewed.reviewed?.length !== clashing.length) return clashing.map((entry) => wanted.get(entry.name) ?? "")
  const identity = new Map(clashing.map((entry, at) => [entry.path, reviewed.reviewed?.[at] ?? ""]))
  const batch = try batched("storageTrash", clashing.map((entry) => entry.path), (plugin, part) => plugin.storageTrash({ volume, paths: part, reviewed: part.map((path) => identity.get(path) ?? "") }))
  const freed = new Set(batch.rows.filter((row) => row.status === "trashed").map((row) => row.path))
  return clashing.filter((entry) => !freed.has(entry.path)).map((entry) => wanted.get(entry.name) ?? "")
}

// spec/app/files/index.md, "A change ends as its answer says, what a move took away is told, and the place is read again"
effect function performed(ticket: number, work: string, items: ReadonlyArray<Item>, name: string, folder: number, dest: number, replace: boolean, downloads: boolean): Event!!(Files | Handles | Answers | Browser.Machine | Shell | Device) {
  const unknown: Event = { type: "finished", ticket, done: [], failed: [] }
  return effect {
    const done: number[] = []
    const failed: number[] = []
    if (work === "NewFolder") {
      const at = try spotOf(folder)
      if (Option.isNone(at)) return { type: "finished", ticket, done, failed: [folder] }
      const change = (try (try Browser.Machine).get()).change
      if (change.attempt.id !== ticket) return unknown
      if (change.approval > 0) {
        const approved = try (try Answers).reviewed(change.approval)
        const parent = approved?.parent
        const refused: Event = { type: "finished", ticket, done, failed: [folder] }
        if (approved === undefined || parent === undefined || at.value.volume !== primary || at.value.path !== parent.path || folder !== parent.place.folder) return refused
        if (parent.token !== undefined) {
          const read = try called("storageReviewedIdentities", (plugin) => plugin.storageReviewedIdentities({ volume: primary, paths: [parent.path] }))
          if (read.status !== "ready" || read.reviewed?.length !== 1 || read.reviewed[0] !== parent.token) return refused
        }
        if (!(try reviewCurrent(approved))) return refused
      }
      let target = at.value.path
      if (downloads) {
        if (at.value.volume !== primary || target !== "" || change.approval !== 0) return { type: "finished", ticket, done, failed: [folder] }
        target = "Download"
        const ready = try called("storageList", (plugin) => plugin.storageList({ volume: primary, path: target }))
        if (ready.status === "missing") {
          const created = try called("storageCreateFolder", (plugin) => plugin.storageCreateFolder({ volume: primary, parent: "", name: target }))
          if (created.status !== "ready" && created.status !== "exists") return { type: "finished", ticket, done, failed: [folder] }
        } else if (ready.status !== "ready") return { type: "finished", ticket, done, failed: [folder] }
      }
      const reply = try called("storageCreateFolder", (plugin) => plugin.storageCreateFolder({ volume: at.value.volume, parent: target, name }))
      if (reply.status === "ready") {
        if (reply.path === undefined || reply.path === "" || parentPath(reply.path) !== target) return unknown
        done.push(try (try Handles).of({ volume: at.value.volume, path: reply.path }))
      } else failed.push(folder)
      return { type: "finished", ticket, done, failed }
    }
    if (work === "Rename") {
      const item = items[0]
      const at = item === undefined ? Option.none<Spot>() : try spotOf(item.id)
      if (item === undefined || Option.isNone(at)) return { type: "finished", ticket, done, failed: items.map((one) => one.id) }
      if (folder === 0) {
        const { volume, path } = at.value
        const parent = parentPath(path)
        const read = try called("storageList", (plugin) => plugin.storageList({ volume, path: parent }))
        const entry = read.status === "ready" ? read.entries?.find((one) => one.path === path) : undefined
        const active = try (try Browser.Machine).get()
        if (entry === undefined || entry.directory || entry.name !== item.name || Math.trunc(entry.modified) !== item.revision
          || Math.trunc(entry.size) !== item.bytes || !active.open || !Browser.allowed(active) || active.change.attempt.id !== ticket
          || !showing(try (try Shell).get(), "Files") || !(try (try Device).showing()))
          return { type: "finished", ticket, done, failed: [item.id] }
      }
      const reply = try called("storageRename", (plugin) => plugin.storageRename({ volume: at.value.volume, path: at.value.path, name }))
      return { type: "finished", ticket, done: reply.status === "ready" ? [item.id] : [], failed: reply.status === "ready" ? [] : [item.id] }
    }
    const into = try spotOf(dest)
    if (Option.isNone(into)) return { type: "finished", ticket, done, failed: items.map((one) => one.id) }
    const copy = work === "CopyTo"
    const change = (try (try Browser.Machine).get()).change
    if (change.attempt.id !== ticket) return unknown
    const binding = try (try Answers).reviewed(change.approval)
    if (change.approval !== 0 && (binding === undefined || !(try reviewCurrent(binding)))) return { type: "finished", ticket, done, failed: items.map((item) => item.id) }
    for (const [volume, paths] of try pathsOf(items)) {
      const shown = try asShown(volume, paths, items, binding)
      failed.push(...shown.changed)
      const identity = new Map(shown.kept.map((path, at) => [path, shown.reviewed[at] ?? ""]))
      for (const path of [...paths.keys()]) if (!identity.has(path)) paths.delete(path)
      if (replace) {
        const kept = try cleared(volume, into.value.path, paths)
        for (const path of kept) failed.push(paths.get(path) ?? 0)
        for (const path of kept) paths.delete(path)
      }
      const batch = try batched("storageTransfer", [...paths.keys()], (plugin, part) => plugin.storageTransfer({ volume, paths: part, dest: into.value.path, copy, reviewed: part.map((path) => identity.get(path) ?? "") }))
      sorted(batch.rows, paths, done, failed, copy ? "copied" : "moved")
      for (const path of batch.unsent) failed.push(paths.get(path) ?? 0)
    }
    return { type: "finished", ticket, done, failed }
  } catch () => unknown
}

// spec/app/files/index.md, "The owner opens the share sheet for a selection of one to a hundred files and no folder while none is open, shares from it, and Android says whether it could open it"; spec/app/files/change.md, "Each sheet sends once, by email when an account can take it, through the phone's chooser, as copied text or saved through the system picker, and then goes away; sharing by text message is not offered"
effect function shared(ticket: number, channel: string, items: ReadonlyArray<Item>, approval: number): Event!!(Files | Handles | Answers | Browser.Machine | Shell | Device | Toasts | Said) {
  return effect {
    if (approval > 0) {
      const bound = try (try Answers).reviewed(approval)
      const refused: Event = { type: "shareEnded", ticket, opened: false, known: true }
      if (channel !== "Chooser" || bound === undefined || bound.targets.length !== items.length || !bound.targets.every((entry, at) => entry.item.id === items[at]?.id)) return refused
      const paths = bound.targets.map((item) => item.path)
      const answer = try called("storageReviewedIdentities", (plugin) => plugin.storageReviewedIdentities({ volume: primary, paths }))
      if (answer.status !== "ready" || answer.reviewed?.length !== paths.length || !answer.reviewed.every((token, at) => token === bound.targets[at]?.token) || !(try reviewCurrent(bound))) return refused
      const reply = try called("storageShare", (plugin) => plugin.storageShare({ volume: primary, paths }))
      return { type: "shareEnded", ticket, opened: reply.status === "opened" && "count" in reply && reply.count === paths.length, known: reply.status !== "opened" || ("count" in reply && reply.count === paths.length) }
    }
    if (channel === "Copy") {
      const numbered = try Handles
      const lines: string[] = []
      for (const item of items) {
        const spot = try numbered.spot(item.id)
        const volume = Option.isSome(spot) ? try numbered.label(try numbered.of({ volume: spot.value.volume, path: "" })) : Option.none<string>()
        lines.push(Option.isSome(spot) ? `${Option.getOrElse(volume, () => spot.value.volume)}/${spot.value.path}` : item.name)
      }
      const text = lines.join("\n")
      const wroteNative = try (try Device).copyText(text)
      const wroteWeb = Exit.isSuccess(try exit(tryPromise(() => copied(text))))
      const wrote = wroteNative || wroteWeb
      if (!wrote) {
        try say("Could not copy to clipboard", true)
        return { type: "shareEnded", ticket, opened: false, known: true }
      }
      return { type: "shareEnded", ticket, opened: true, known: true }
    }
    if (channel !== "Chooser") return { type: "shareEnded", ticket, opened: false, known: true }
    for (const [volume, paths] of try pathsOf(items)) {
      const reply = try called("storageShare", (plugin) => plugin.storageShare({ volume, paths: [...paths.keys()] }))
      return { type: "shareEnded", ticket, opened: reply.status === "opened", known: true }
    }
    return { type: "shareEnded", ticket, opened: false, known: true }
  } catch () => ({ type: "shareEnded", ticket, opened: false, known: false })
}

/** What the phone says of the owner's access: the kit's grant, and whether this phone has shared storage at all. The phone answers `ready` whatever the grant and names the grant beside it, so only `ready` with `granted` lets Files read. */
effect function reported(asked: boolean): Event!!(Files | Browser.Machine) {
  const now = try (try Browser.Machine).get()
  const phone = Option.isSome((try Files).plugin)
  return effect {
    const state = try called("storageState", (plugin) => plugin.storageState())
    if (state.access === "unsupported" || state.status === "unavailable") return { type: "accessReported", grant: now.access, supported: false }
    if (state.status === "ready" && state.access === "granted") return { type: "accessReported", grant: "Granted", supported: true }
    return { type: "accessReported", grant: asked || now.access === "Denied" ? "Denied" : "Unasked", supported: true }
  } catch () => ({ type: "accessReported", grant: now.access, supported: phone })
}

// spec/app/files/index.md, "Allow goes to the permission flow while Android was never asked, and to Android's Settings after"
effect function allowed(settings: boolean): Event!!(Files | Browser.Machine) {
  try ignore(called("storageRequestAccess", (plugin) => plugin.storageRequestAccess(settings ? { settings } : undefined)))
  return try reported(true)
}

/** Scoped shelf holding each item handed to the Trash as Files showed it then, checked against phone writes. */
class Trashing extends Context.Service<Trashing, Shelf<ReadonlyMap<number, Item>>>()("@repo/app/files/Trashing") {}
const trashingShelf = scopedShelf(Trashing, (): ReadonlyMap<number, Item> => new Map())

effect function reportReceipt(fx: { readonly ticket: number; readonly ran: boolean; readonly outcome: Receipt["outcome"]; readonly done: number }): void!!Answers {
  const answers = try Answers
  const bound = try answers.reviewed(fx.ticket)
  try answers.receipt(fx.ticket, { ran: fx.ran, outcome: fx.outcome, ...(bound === undefined ? {} : { done: fx.done }) })
}

function carry(fx: Out): Job<Event, Files | Handles | Browser.Machine | Bin.Machine | Documents | Opened | Recent.Machine | Shown.Machine | Answers | CategoryGroups | Device | Shell | Toasts | Said | Trashing, [by: Actor]> {
  return match (fx) {
    when { tag: "AskAccess" }: answer("access", allowed(false), { type: "accessReported", grant: "Denied", supported: true }, "Phone");
    when { tag: "OpenSettings" }: answer("access", allowed(true), { type: "accessReported", grant: "Denied", supported: true }, "Phone");
    when { tag: "Measure", let ticket }: answer("measure", measured(ticket), { type: "storageRead", ticket, ok: false, volumes: [], tally: Browser.untallied }, "Phone");
    when { tag: "Look", let ticket, let trail, let category, let inCategory }: answer("look", looked(ticket, trail, category, inCategory), { type: "listed", ticket, ok: false, gone: false, complete: false, entries: [] }, "Phone");
    when { tag: "Search", let ticket, let where, let filter }: answer("search", searched(ticket, where, filter), { type: "searched", ticket, ok: false, complete: false, entries: [] }, "Phone");
    when { tag: "LookInto", let ticket, let trail }: answer("sheet", destination(ticket, trail), { type: "destRead", ticket, ok: false, entries: [] }, "Phone");
    when { tag: "AgentLook", let ticket, let folder, let filter }: answer("peek", peeked(ticket, folder, filter), { type: "agentLooked", ticket, ok: false, entries: [] }, "Phone");
    when { tag: "Tell", let request, let ok, let items, let complete }: run(`tell ${request}`, effect { try (try Answers).tell(request, { ok, items, complete }) }, "Phone");
    when { tag: "Perform", let ticket, let work, let items, let name, let folder, let dest, let replace, let downloads }: answer(`perform ${ticket}`, performed(ticket, work, items, name, folder, dest, replace, downloads), { type: "finished", ticket, done: [], failed: [] }, "Phone");
    when { tag: "ToTrash", let items, let approval }: run("trash", effect {
      if (approval === 0 || (try (try Answers).reviewed(approval)) === undefined) {
        const shown = (try (try Browser.Machine).get()).items
        const shelf = try Trashing
        shelf.update((current) => {
          const next = new Map(current)
          for (const item of shown) if (items.includes(item.id)) next.set(item.id, item)
          return next
        })
      }
      const sent = try exit((try Bin.Machine).send({ type: "moveToTrash", items, approval }, "Phone"))
      if (Exit.isFailure(sent) && approval > 0) {
        try (try Answers).receipt(approval, { ran: false, outcome: "Refused" })
      }
    }, "Phone");
    when { tag: "Show", let item, let siblings, let owner }: run("show", view(item, siblings, owner), "Phone");
    when { tag: "Share", let ticket, let channel, let items, let approval }: answer(`share ${ticket}`, shared(ticket, channel, items, approval), { type: "shareEnded", ticket, opened: false, known: false }, "Phone");
    when { tag: "Receipt" }: run(`receipt ${fx.ticket}`, reportReceipt(fx), "Phone");
    when { tag: "Taken", let items }: run("taken", taken(items), "Phone");
  }
}

// spec/app/files/index.md, "A restart closes Files, keeps the access, the place, the layout and the sort, reports a change cut off as unknown, and tells the agent its waiting requests failed"
// spec/app/platform/index.md, "A state kept in a shape an earlier build wrote is read in today's shape, with what the owner kept in it"
/** Files kept before its counts, its trash, its details, its date filter, or each item's size and contents: each is read as a fresh Files has it, or as an item not yet sized or counted. */
function stored(key: string, start = Browser.initial) {
  const { tally, partial, trash, details, handed, begun } = Browser.initial
  const listed = (items: unknown) => (Array.isArray(items) ? items.map((item) => withFields(item, { bytes: 0, children: 0 })) : items)
  return Layer.provide(Browser.stored(key, start), filledStore(key, (kept) => {
    const search = fieldsOf(kept.search)
    const change = fieldsOf(kept.change)
    return {
      tally, partial, trash, details, handed, begun, ...kept, items: listed(kept.items),
      search: search && { complete: Browser.initial.search.complete, ...search, hits: listed(search.hits), filter: withFields(search.filter, { from: everything.from, to: everything.to }) },
      change: change && { ...change, items: listed(change.items), sharing: listed(change.sharing), unsure: listed(change.unsure) },
    }
  }, Browser.parseState))
}

const browsing = reacting({ ...Browser, stored }, { keep: 1, open: [{ type: "restart" }, "Phone"], carry })

// spec/app/files/index.md, "Opening Files reads the storage and the place it left, and leaving Files drops every read, the selection, the confirmation and the sheets"
const onScreen = following(Shell, (shell) => showing(shell, "Files"), Browser.Machine, (shown): Event => ({ type: shown ? "enter" : "leave" }), "Phone")

// spec/app/files/index.md, "When the phone says Alpha may read the storage the place is read, and when it takes access away, or says the storage cannot be reached at all, everything read is dropped"
const access = hearing(
  Stream.unwrap(effect {
    const device = try Device
    return Stream.concat(Stream.fromEffect(device.showing()), device.visible) |> Stream.filter(%, (visible) => visible) |> Stream.mapEffect(%, () => reported(false))
  }),
  Browser.Machine,
  (event: Event) => event,
  "Phone",
)

// spec/app/files/index.md, "The place showing is read again when asked, and only its newest answer is taken; a folder that no longer exists brings the owner back to the top and says so, never that the storage is unavailable": when the phone says the storage changed, and when Alpha comes back to the front
const changes = hearing(
  Stream.unwrap(effect {
    const browser = try Browser.Machine
    const resumed = Stream.filterEffect(Stream.filter((try Device).visible, (visible) => visible), () => Effect.map(browser.get(), Browser.allowed))
    return Stream.merge((try Files).changed, resumed)
  }),
  Browser.Machine,
  (): Event => ({ type: "refresh" }),
  "Phone",
)

/** A volume's Trash: each item by its id, the file it was. */
const trashPath = (id: string) => `\u0000trash/${id}`

/** Every volume the phone names, or the primary one where it names none. */
effect function volumesOf(): string[]!!Files {
  const state = called("storageState", (plugin) => plugin.storageState()) catch () => undefined
  const named = (state?.volumes ?? []).map((volume) => volume.id)
  return named.length === 0 ? [primary] : named
}

/** What the Trash of every volume holds. */
effect function trashed(): Bin.Entry[]!FilesFailed!(Files | Handles | TrashFacts) {
  const numbered = try Handles
  const read: { volume: string; item: TrashEntry }[] = []
  for (const volume of try volumesOf()) {
    const reply = try called("storageTrashList", (plugin) => plugin.storageTrashList({ volume }))
    if (reply.status !== "ready") throw new FilesFailed({ method: "storageTrashList", cause: reply.status })
    for (const item of reply.items ?? []) read.push({ volume, item })
  }
  read.sort((a, b) => b.item.deletedAt - a.item.deletedAt)
  const handles = try numbered.many(read.flatMap(({ volume, item }) => [
    { volume, path: trashPath(item.id) }, { volume, path: joined(item.origin, item.name) }, { volume, path: "" },
  ]))
  const entries: Bin.Entry[] = []
  const metadata = new Map<number, TrashItemFacts>()
  for (const [at, { volume, item }] of read.entries()) {
    const mark = handles[at * 3]
    const id = handles[at * 3 + 1]
    const root = handles[at * 3 + 2]
    if (mark === undefined || id === undefined || root === undefined) continue
    const label = Option.getOrElse(try numbered.label(root), () => volume === primary ? "Internal storage" : "Storage")
    const location = [label, ...item.origin.split("/").filter((one) => one !== "")].join(" › ")
    entries.push({ mark, item: id, name: item.name, volume: root, until: Bin.keptUntil(Math.max(0, Math.trunc(item.deletedAt))) })
    metadata.set(mark, { location, directory: item.directory, mimeType: item.mimeType, bytes: Math.max(0, Math.trunc(item.size)) })
  }
  try (try TrashFacts).hold(metadata)
  return entries
}

// spec/app/files/trash.md, "The list is read again when asked while the Trash is seen and free, and only its newest answer is taken"
effect function binLooked(ticket: number): Bin.Event!!(Files | Handles | TrashFacts) {
  return effect {
    const listed: Bin.Event = { type: "listed", ticket, ok: true, rows: try trashed(), now: untimed }
    return listed
  } catch () => ({ type: "listed", ticket, ok: false, rows: [], now: untimed })
}

/** The answer to a job: what the phone confirmed, as the Trash lists it, and whether every item was answered. */
function jobDone(number: number, results: ReadonlyArray<Bin.Entry>, known: boolean): Bin.Event {
  return { type: "finished", number, results: [...results], known, now: untimed, window }
}

/** How long the Undo of a deletion is offered. */
const window = 5_000

// spec/app/files/trash.md, "A job ends as its answer says for each item: only what the phone confirmed is done, and the rest was refused or is unknown"
effect function binned(number: number, items: ReadonlyArray<number>): Bin.Event!!(Files | Handles | Answers | Bin.Machine | Browser.Machine | Shell | Device | TrashFacts | Trashing) {
  return effect {
    const ids = new Set<string>()
    let answered = 0
    const state = try (try Bin.Machine).get()
    if (state.attempt.id !== number) return jobDone(number, [], false)
    const binding = try (try Answers).reviewed(state.job.approval)
    if (state.job.approval !== 0 && (binding === undefined || !(try reviewCurrent(binding)))) return jobDone(number, [], true)
    const shelf = try Trashing
    let shown: Item[]
    if (binding !== undefined) {
      shown = binding.targets.filter((one) => items.includes(one.item.id)).map((one) => one.item)
    } else {
      const takenItems: Item[] = []
      shelf.update((current) => {
        const next = new Map(current)
        for (const id of items) {
          const item = next.get(id)
          if (item !== undefined) { takenItems.push(item); next.delete(id) }
        }
        return next
      })
      shown = takenItems
    }
    answered += items.length - shown.length
    for (const [volume, paths] of try pathsOf(shown)) {
      const asked = try asShown(volume, paths, shown, binding)
      answered += asked.changed.length
      const identity = new Map(asked.kept.map((path, at) => [path, asked.reviewed[at] ?? ""]))
      const batch = try batched("storageTrash", asked.kept, (plugin, part) => plugin.storageTrash({ volume, paths: part, reviewed: part.map((path) => identity.get(path) ?? "") }))
      answered += batch.unsent.length
      for (const path of asked.kept) {
        const replies = batch.rows.filter((row) => row.path === path)
        const [row] = replies
        if (replies.length !== 1 || row === undefined) continue
        if (row.status === "trashed") {
          if (row.to === undefined) continue
          ids.add(`${volume}\u0000${row.to}`)
        }
        answered += 1
      }
    }
    const results: Bin.Entry[] = []
    for (const entry of try trashed()) {
      const at = try spotOf(entry.mark)
      if (Option.isSome(at) && ids.has(`${at.value.volume}\u0000${at.value.path.slice(trashPath("").length)}`)) results.push(entry)
    }
    return jobDone(number, results, answered === items.length && results.length === ids.size)
  } catch () => jobDone(number, [], false)
}

/** The trash ids of `entries`, by volume. */
effect function idsOf(entries: ReadonlyArray<Bin.Entry>): Map<string, Bin.Entry[]>!!Handles {
  const byVolume = new Map<string, Bin.Entry[]>()
  for (const entry of entries) {
    const at = try spotOf(entry.mark)
    if (Option.isNone(at)) continue
    byVolume.set(at.value.volume, [...(byVolume.get(at.value.volume) ?? []), entry])
  }
  return byVolume
}

effect function idOf(entry: Bin.Entry): string!!Handles {
  const at = try spotOf(entry.mark)
  return Option.isSome(at) ? at.value.path.slice(trashPath("").length) : ""
}

// spec/app/files/trash.md, "The owner restores a listed item before its time, from a list read since the last job"
effect function restored(number: number, entries: ReadonlyArray<Bin.Entry>): Bin.Event!!(Files | Handles) {
  const results: Bin.Entry[] = []
  let answered = 0
  for (const [volume, mine] of try idsOf(entries)) {
    const byId = new Map<string, Bin.Entry>()
    for (const entry of mine) byId.set(try idOf(entry), entry)
    const batch = try batched("storageRestore", [...byId.keys()], (plugin, ids) => plugin.storageRestore({ volume, ids }))
    const unsent = new Set(batch.unsent)
    const outcomes = new Map<string, FileOutcomeRow | null>()
    for (const row of batch.rows) outcomes.set(row.path, outcomes.has(row.path) ? null : row)
    for (const [id, entry] of byId) {
      const row = outcomes.get(id)
      if (unsent.has(id)) answered += 1
      else if (row) {
        if (row.status !== "restored") answered += 1
        else if (row.to !== undefined) { results.push(entry); answered += 1 }
      }
    }
  }
  return jobDone(number, results, answered === entries.length)
}

// spec/app/files/trash.md, "Confirming erases exactly the entries shown"
effect function erased(number: number, entries: ReadonlyArray<Bin.Entry>): Bin.Event!!(Files | Handles) {
  const groups = try idsOf(entries)
  const results: Bin.Entry[] = []
  let known = true
  for (const [volume, mine] of groups) {
    const ids: string[] = []
    for (const entry of mine) ids.push(try idOf(entry))
    const reply = called("storageEmptyTrash", (plugin) => plugin.storageEmptyTrash({ volume, ids, confirmed: true })) catch () => undefined
    if (reply === undefined) { known = false; continue }
    if (reply.status === "ready" && reply.count === ids.length) results.push(...mine)
    else if (reply.status === "ready") known = false
  }
  return jobDone(number, results, known)
}

function carryBin(fx: Bin.Effect): Job<Bin.Event, Files | Handles | Bin.Machine | Browser.Machine | Recent.Machine | Shown.Machine | Answers | Device | Shell | TrashFacts | Trashing, [by: Bin.Actor]> {
  return match (fx) {
    when { tag: "Look", let ticket }: answer("look", binLooked(ticket), { type: "listed", ticket, ok: false, rows: [], now: untimed }, "Phone");
    when { tag: "Bin", let ticket, let items }: answer(`job ${ticket}`, binned(ticket, items), jobDone(ticket, [], false), "Phone");
    when { tag: "Restore", let ticket, let entries }: answer(`job ${ticket}`, restored(ticket, entries), jobDone(ticket, [], false), "Phone");
    when { tag: "Erase", let ticket, let entries }: answer(`job ${ticket}`, erased(ticket, entries), jobDone(ticket, [], false), "Phone");
    when { tag: "Binned", let items }: run("binned", ignore(effect {
      try taken(items)
      try (try Browser.Machine).send({ type: "refresh" }, "Phone")
    }), "Phone");
    when { tag: "Receipt" }: run(`receipt ${fx.ticket}`, reportReceipt(fx), "Phone");
  }
}

// spec/app/files/trash.md, "A restart closes the Trash, reports a job cut off as unknown, drops what was waiting and what was read, and closes the confirmation and the moment to undo"
// spec/app/files/trash.md, "When the moment to undo has passed, the phone ends it, and Undo is no longer offered"
// spec/app/platform/index.md, "A state kept in a shape an earlier build wrote is read in today's shape, with what the owner kept in it"
/** A Trash kept before entries could be marked or their details shown: read with none marked and no details open. */
function storedTrash(key: string, start = Bin.initial) {
  const { marked, details } = Bin.initial
  return Layer.provide(Bin.stored(key, start), filledStore(key, (kept) => ({ marked, details, ...kept }), Bin.parseState))
}
const binning = reacting({ ...Bin, stored: storedTrash }, {
  keep: 1,
  open: [{ type: "restart" }, "Phone"],
  carry: carryBin,
  timers: (s) => (s.undo.holding === "Held" ? [due("undo", s.undo.until, { type: "letGo", now: untimed } as Bin.Event, "Phone" as Bin.Actor)] : []),
})

// spec/app/files/trash.md, "Looking at the Trash reads its list when it is free and Alpha may read the storage; leaving it, or losing access, drops the list but what a job or the moment to undo still holds"
const trashAccess = following(Browser.Machine, Browser.allowed, Bin.Machine, (allowed): Bin.Event => ({ type: "accessReported", allowed }), "Phone")
const trashShown = following(Browser.Machine, (state) => ({ shows: Browser.trashShows(state), allowed: Browser.allowed(state) }), Bin.Machine, ({ shows, allowed }): Bin.Event => (shows ? { type: "enter", allowed } : { type: "leave" }), "Phone")

/** The place the phone watches for changes while Files shows it: a folder by its path, a category, or none at the top or away. */
function watched(s: Browser.Files): { trail: ReadonlyArray<number>; category?: Kind } | undefined {
  if (!s.open || !Browser.allowed(s) || Browser.atTop(s)) return undefined
  return s.inCategory ? { trail: [], category: s.category } : { trail: s.trail }
}

// spec/app/files/index.md, "The place showing is read again when asked, and only its newest answer is taken; a folder that no longer exists brings the owner back to the top and says so, never that the storage is unavailable": the phone tells of changes only to the place it watches
effect function watch(place: { trail: ReadonlyArray<number>; category?: Kind } | undefined): void!!(Files | Handles) {
  try ignore(effect {
    if (place === undefined) return try called("storageUnwatch", (plugin) => plugin.storageUnwatch())
    const category = place.category === undefined ? undefined : categories[place.category]
    if (category !== undefined) return try called("storageWatch", (plugin) => plugin.storageWatch({ category }))
    const found = try folderOf(place.trail)
    if (Option.isNone(found)) return try called("storageUnwatch", (plugin) => plugin.storageUnwatch())
    return try called("storageWatch", (plugin) => plugin.storageWatch({ volume: found.value.volume, path: found.value.path }))
  })
}

const watching = applying(Browser.Machine, watched, watch)

/** Files and its Trash, kept across restarts, carried out through the phone's storage and told by the shell whether Files shows. */
export const files = Layer.provideMerge(together(browsing, onScreen, access, changes, watching, binning, trashAccess, trashShown, preview, scan), Layer.mergeAll(handles, answers, categoryGroups, trashFacts, trashingShelf))

// spec/app/files/index.md, "Another area opens Files at Downloads: the Download folder of the main volume where the phone has one, else the Downloads category; the owner's own move to the top, a volume or a category ends that walk"
/** Show Files at Downloads for another area, such as the Browser's Show in Files: Back from there returns to that area. */
export const showDownloads = downloadsAt(false)

export const showBrowserDownloads = downloadsAt(true)

effect function downloadsAt(fromBrowser: boolean): void!!(Files | Handles | Browser.Machine | Shell) {
  const shell = try Shell
  if (fromBrowser && !showing(try shell.get(), "Browser")) return
  const numbered = try Handles
  const state = called("storageState", (plugin) => plugin.storageState()) catch () => undefined
  const main = (state?.volumes ?? []).find((volume) => volume.primary)?.id ?? primary
  const root = called("storageList", (plugin) => plugin.storageList({ volume: main, path: "" })) catch () => undefined
  const folder = root?.status === "ready" ? (root.entries ?? []).find((entry) => entry.directory && entry.path === "Download") : undefined
  const trail = folder === undefined ? [] : [try numbered.of({ volume: main, path: "" }), try numbered.of({ volume: main, path: folder.path })]
  if (fromBrowser && !showing(try shell.get(), "Browser")) return
  try ignore((try Browser.Machine).send({ type: "showDownloads", trail }, "Phone"))
  try ignore(shell.send({ type: "openView", view: "Files" }))
}

// spec/app/files/index.md, "The owner selects items of the place showing, all of them, or none, and a changed selection closes the sheets, telling the owner a share sheet sent nothing, and voids the delete confirmation"
/** Wait for a Files row hold. The pointer handler cancels this wait after movement or release. */
export effect function fileRowHeld(held: () => void): void!! {
  try sleep("500 millis")
  try sync(held)
}

/** Holding a listed row selects it once, including when selection changed while the pointer was down. */
export effect function selectListedFile(target: number): void!!Browser.Machine {
  const files = try Browser.Machine
  const state = try files.get()
  if (!state.picked.includes(target) && Browser.canToggle(state, target, "Owner")) {
    try ignore(files.send({ type: "toggle", target }, "Owner"))
  }
}

// spec/app/shell/index.md, "Back closes one layer: Ask Alpha by a step, then the app on top"; spec/app/files/index.md, "Back closes one layer inside Files: the Move to sheet, the share sheet, the name clash, the delete confirmation, the details, the Trash, the selection and the filter, then goes up the path a step; at the top, or back where another area's walk began, it leaves Files"
/** Back inside Files: the layer the rules name, closed by its own event. Whether it took one. */
export const back: boolean!!(Browser.Machine | Shown.Machine | Recent.Machine | ScanMachine | CorrectionMachine | Bin.Machine) = effect {
  if (try scanBack) return true
  const recent = try Recent.Machine
  if ((try recent.get()).live !== 0) {
    return effect { try recent.send({ type: "cancelPicker" }, "Owner"); return true } catch () => false
  }
  const machine = try Browser.Machine
  const s = try machine.get()
  const preview = try Shown.Machine
  if (Shown.showing(try preview.get()) && !s.sheet.open && !s.deleting.showing && !s.change.clash.showing) {
    return effect { try preview.send({ type: "close" }, "Owner"); return true } catch () => false
  }
  if (s.trash) {
    const bin = try Bin.Machine
    const trash = try bin.get()
    if (Bin.canKeepThem(trash, "Owner")) {
      return effect { try bin.send({ type: "keepThem" }, "Owner"); return true } catch () => false
    }
    if (Bin.canCloseItemDetails(trash, "Owner")) {
      return effect { try bin.send({ type: "closeItemDetails" }, "Owner"); return true } catch () => false
    }
  }
  const step: Event | undefined = match (Browser.backLayer(s)) {
    when "SheetLayer": { type: "closeMoveTo" };
    when "ShareLayer": { type: "closeShare" };
    when "ClashLayer": { type: "goBack" };
    when "ConfirmLayer": { type: "keepFiles" };
    when "DetailsLayer": { type: "closeDetails" };
    when "TrashLayer": { type: "closeTrash" };
    when "SelectionLayer": { type: "cancelSelection" };
    when "FilterLayer": { type: "clearFilter" };
    when "TopLayer": { type: "openTop" };
    when "UpLayer": { type: "openCrumb", depth: s.trail.length - 1 };
    when "NoLayer": undefined;
  }
  if (step === undefined) return false
  return effect { try machine.send(step, "Owner"); return true } catch () => false
}
