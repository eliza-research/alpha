// spec/app/assistant/context.md, "A spoken turn carries what a typed turn sent at that moment would, the view claim included"; spec/app/voice/index.md, "A heard turn waits for the send in hand, is sent once after it, and is given up quietly only after 30 s"
function sendVoiceTurn(session: number, turn: number): Stream.Stream<Voice.Event, never, Agent | VoiceWords | Voice.Machine | Shell.Machine> {
  const send = (queue: Queue.Queue<Voice.Event, Cause.Done>, shared: SpokenChat) => effect {
    const { memory } = try VoiceWords
    const voice = try Voice.Machine
    const heard = memory.heardText
    memory.setHeard(undefined)
    const spoken = heard?.session === session && heard.turn === turn ? heard.text.trim() : ""
    // spec/app/voice/index.md, "A reply that needs the owner's review in chat keeps voice listening with the microphone open": every spoken turn goes to the agent, and a review is decided only by the owner's touch on it.
    const finishLocally = (guard?: TalkTurnGuard) => effect {
      if (guard !== undefined) try noteTalkTurn(guard, session, turn)
      Queue.offerUnsafe(queue, { type: "replyEnds", session, turn, asks: false, says: true })
      Queue.endUnsafe(queue)
    }
    if (spoken === "") return try finishLocally("NothingHeard")
    if (!Voice.canSentence(try voice.get(), session, turn)) return try finishLocally("TurnRetired")
    const current = effect { return Voice.canSentence(try voice.get(), session, turn) }
    const decided = try Deferred.make<void>()
    const unlessDecided = (guard: TalkTurnGuard) => effect {
      return (try Deferred.succeed(decided, undefined)) ? guard : try Effect.never
    }
    const retired = Stream.runHead(Stream.filter(voice.changes, (state) => !Voice.canSentence(state, session, turn)))
    const abandoned = Effect.andThen(retired, unlessDecided("TurnRetired"))
    const expired = Effect.andThen(Effect.sleep(Voice.spokenTurnWaitMs), unlessDecided("WaitExpired"))
    const taken = effect {
      if (!(try shared.free)) return undefined
      return try shared.writer.withPermits(1)(effect {
        if (!(try shared.free)) return undefined
        if (!(try Deferred.succeed(decided, undefined))) return try Effect.never
        const lease = try Effect.raceFirst(shared.begin(session, turn, current), Effect.as(retired, "TurnRetired" as const))
        if (lease === "TurnRetired" || lease === undefined) return lease ?? "NoChat" as const
        return { completion: try postVoiceTurn({ session, turn, queue, lease, spoken }) }
      })
    }
    const posted = Effect.map(Stream.runHead(Stream.filter(Stream.mapEffect(shared.changes, () => taken), (outcome) => outcome !== undefined)),
      (outcome) => Option.isSome(outcome) && outcome.value !== undefined ? outcome.value : "NoChat" as const)
    const carried = try Effect.raceFirst(posted, Effect.raceFirst(abandoned, expired))
    if (typeof carried === "string") return try finishLocally(carried === "NoChat" ? undefined : carried)
    if (carried.completion !== undefined) Queue.offerUnsafe(queue, carried.completion)
    Queue.endUnsafe(queue)
  }
  return Stream.callback<Voice.Event, never, VoiceWords>((queue) => effect {
    const { memory } = try VoiceWords
    const shared = memory.chat
    if (shared !== undefined) {
      try Effect.ensuring(Effect.provideContext(send(queue, shared), shared.context), sync(() => memory.retireSaid(session, turn)))
      return
    }
    try noteTalkTurn("NoChat", session, turn)
    memory.setHeard(undefined)
    memory.retireSaid(session, turn)
    Queue.offerUnsafe(queue, { type: "replyEnds", session, turn, asks: false, says: true })
    Queue.endUnsafe(queue)
  })
}

// spec/app/voice/index.md, "An active voice conversation may ask the shell to open Home or any admitted screen"; spec/app/voice/index.md, "An exact spoken Files request may follow its own leased navigation once"; spec/app/shell/index.md, "Only a spoken move from its exact source route is marked as Talk's navigation"
/**
 * How Talk's move treats Ask Alpha: "Show" shows the view, lowering Ask Alpha where it would hide it; "Keep" opens it
 * under Ask Alpha at its height, as an exact spoken Files request does; "Inside" opens a page inside the view, as a
 * saved note is, keeping a sheet and lowering the full screen.
 */
type SpokenMove = "Show" | "Keep" | "Inside"

effect function openRouteForVoice(place: number, sourceRoute: number, session: number, turn: number, current: Effect.Effect<boolean>,
  memory: VoiceMemory, voice: Voice.Machine.Shape, shell: Shell.Machine.Shape, move: SpokenMove = "Show"): boolean!! {
  const before = try shell.get()
  if (before.route !== sourceRoute || memory.spokenNavigation !== undefined || !(try current)) return false
  const target = viewOfPlace(place)
  if (target === undefined ? !Shell.canAgentGoHome(before)
    : Shell.showing(before, target) && (move === "Keep" || !(move === "Inside" ? Shell.canAgentShowInside(before, target) : Shell.canAgentShowView(before, target)))) return true
  if (!Voice.canAgentNavigates(try voice.get(), session, turn, place, sourceRoute)) return false
  const opened = try Deferred.make<boolean>()
  const allowed = () => Effect.runSync(current)
  let lease: SpokenNavigation
  let reserved = false
  const owns = (now: Voice.Voice) => now.session === session && now.turn === turn && now.claim === place && now.claimRoute === sourceRoute + 1
  const apply = effect {
    const guard = () => {
      const now = Effect.runSync(voice.get())
      return reserved && memory.spokenNavigation === lease && !Deferred.isDoneUnsafe(opened)
        && owns(now) && Voice.canSentence(now, session, turn) && allowed()
    }
    return target === undefined
      ? try contained(shell.send({ type: "agentHomeSpoken", route: sourceRoute }, guard), "going Home for Talk")
      : move === "Keep" ? try contained(shell.send({ type: "agentOpenSpoken", view: target, route: sourceRoute }, guard), "opening the view for Talk")
      : move === "Inside" ? try contained(shell.send({ type: "agentShowInsideSpoken", view: target, route: sourceRoute }, guard), "opening the page for Talk")
      : try contained(shell.send({ type: "agentShowSpoken", view: target, route: sourceRoute }, guard), "showing the view for Talk")
  }
  const decline = effect {
    if (memory.spokenNavigation !== lease || (try Deferred.isDone(opened))) return
    const held = reserved
    reserved = false
    if (held) try contained(voice.send({ type: "claimReleased", session }, owns), "releasing the spoken route")
    try Deferred.succeed(opened, false)
  }
  lease = { session, turn, place, sourceRoute, opened, apply, decline }
  memory.spokenNavigation = lease
  return try Effect.ensuring(effect {
    const claimed = try contained(voice.send({ type: "agentNavigates", session, turn, place, sourceRoute }, (now) => {
      reserved = memory.spokenNavigation === lease && Voice.canAgentNavigates(now, session, turn, place, sourceRoute) && allowed()
      return reserved
    }), "claiming the spoken route")
    if (!claimed) return false
    return try Deferred.await(opened)
  }, effect {
    try decline
    if (memory.spokenNavigation === lease) memory.spokenNavigation = undefined
  })
}

effect function navigateLeased(session: number, turn: number, place: number, sourceRoute: number): void!!VoiceWords {
  const lease = (try VoiceWords).memory.spokenNavigation
  if (lease === undefined || lease.session !== session || lease.turn !== turn || lease.place !== place || lease.sourceRoute !== sourceRoute) return
  try Effect.ensuring(effect {
    if (try lease.apply) try Deferred.succeed(lease.opened, true)
  }, lease.decline)
}

effect function dictationVisible(): boolean!!(Device | Layers.Machine | VoiceBridge) {
  if (!(try (try Device).showing()) || Layers.assistantInert(try (try Layers.Machine).get())) return false
  return try (try VoiceBridge).dictationForeground()
}

function carryVoice(fx: Voice.Effect): Job<Voice.Event, Agent | Device | Layers.Machine | VoiceBridge | VoiceWords | SystemSettings | Shell.Machine | Voice.Machine | Time, []> {
  return match (fx) {
    when { tag: "Prewarm", let network }: run("prewarm", effect { try (try VoiceBridge).prewarm(network) });
    when { tag: "HoldEngine" }: run("holdEngine", effect { try (try VoiceBridge).holdEngine() });
    when { tag: "ReleaseEngineHold" }: run("releaseEngineHold", effect { try (try VoiceBridge).releaseEngineHold() });
    when { tag: "AskMicrophone" }: answer("permission", effect {
      const grant = try (try VoiceBridge).requestPermission()
      return { type: "answerPrompt", granted: grant === "granted" }
    }, { type: "answerPrompt", granted: false });
    when { tag: "OpenSettings" }: run("openSettings", effect { try (try SystemSettings).open("AppPermissions", "") });
    when { tag: "Listen", let session, let network }: answer("mic", effect {
      const bridge = try VoiceBridge
      const prepare = (try VoiceWords).memory.prepareInterim
      const preview = prepare === undefined ? undefined : try prepare(session)
      return effect {
        try bridge.openMic(session, network, preview)
        return { type: "micOpened", session } as Voice.Event
      } catch effect (failure) => {
        preview?.retire()
        if (interruptedByCall(failure.cause)) {
          return { type: "callInterrupted", session, foreground: try (try Device).showing() } as Voice.Event
        }
        if (refusedForFunds(failure.cause)) return try stopForFunds(session, (try (try Voice.Machine).get()).turn)
        if (!network) return { type: "micFailed", session } as Voice.Event
        const { fault, waitMs } = classifyVoiceFault(failure, true)
        if (fault === "NotTheNetwork") return { type: "micFailed", session } as Voice.Event
        const status = bridge.probeStatus(false) catch () => ({ ready: false, ttsReady: false, liveCapture: false })
        return { type: "speechFailed", session, fault, wait: waitMs, deviceReady: status.ready && status.liveCapture, now: untimed } as Voice.Event
      }
    }, { type: "micFailed", session });
    when { tag: "SetSpeakerOutput", let session, let speakerTicket, let muted }: answer(`speaker ${session}:${speakerTicket}`, effect {
      const confirmed = try (try VoiceBridge).setSpeakerMuted(session, muted)
      return { type: "speakerSet", session, speakerTicket, muted, confirmed }
    }, { type: "speakerSet", session, speakerTicket, muted, confirmed: false });
    when { tag: "CloseMicrophone", let session }: answer("mic", effect {
      const closed = effect { try (try VoiceBridge).closeMic(session); return true } catch () => false
      return closed ? { type: "micClosed", session } : { type: "micCloseFailed", session }
    }, { type: "micCloseFailed", session });
    when { tag: "Send", let session, let turn }: stream("send", sendVoiceTurn(session, turn), { type: "replyEnds", session, turn, asks: false, says: true });
    when { tag: "Play", let session, let turn }: answer(`play ${session}:${turn}:${fresh()}`, effect {
      const { memory } = try VoiceWords
      const bridge = try VoiceBridge
      const voice = try Voice.Machine
      const epoch = memory.playbackEpoch
      const current = effect {
        return memory.playbackEpoch === epoch && Voice.canSentencePlayed(try voice.get(), session, turn)
      }
      let heard: SpokenCue | undefined
      try Semaphore.withPermit(memory.playLock, effect {
        if (!(try current)) return
        try bridge.awaitSpeechOutputWarmup(session)
        if (!(try current)) return
        const piece = memory.dequeueSentence(turn)
        if (piece === undefined) return
        const cue = memory.cue
        // spec/app/assistant/reply.md, "A spoken acknowledgment starts at once; a reply ready before it is audible drops it, and an audible one finishes before the reply, within 2.5 s": the cue plays on its own fiber so the reply's first sentence can drop or bound it.
        if (piece.cue && cue?.turn === turn) {
          heard = cue
          try Effect.forkDetach(Effect.ensuring(ignore(bridge.playCue(session, turn, piece.text, () => memory.cueAudible(turn))),
            sync(() => memory.endCue(turn, "Ended"))))
          return
        }
        let append = piece.append
        if (cue?.turn === turn && !cue.followed) {
          cue.followed = true
          append = false
          if (cue.phase === "Preparing") {
            memory.endCue(turn, "Dropped")
            try bridge.hush(turn)
          } else if (cue.phase === "Audible") {
            const finished = try Effect.timeoutOption(Effect.promise(() => cue.ended), replyWaitMs("Audible", cueBoundMs))
            if (Option.isNone(finished)) {
              memory.endCue(turn, "Dropped")
              try bridge.hush(turn)
            }
          }
          if (!(try current)) return
        }
        bridge.playSentence(session, turn, piece.text, append) catch effect (failure) => {
          try noteTalkTurn("PlaybackFailed", session, turn, failureName(failure))
        }
      })
      const playing = heard
      if (playing !== undefined) try Effect.promise(() => playing.ended)
      return { type: "sentencePlayed", session, turn }
    }, { type: "sentencePlayed", session, turn });
    when { tag: "Hush", let turn }: run("hush", effect {
      const { memory } = try VoiceWords
      memory.clearQueued(turn)
      if (memory.heardText !== undefined && memory.heardText.turn <= turn) memory.setHeard(undefined)
      if (memory.activeTurn !== undefined && memory.activeTurn.turn <= turn) try memory.activeTurn.stop()
      try (try VoiceBridge).hush(turn)
    });
    when { tag: "Shut", let session }: answer("shut", effect {
      const { memory } = try VoiceWords
      memory.clearQueued()
      memory.setHeard(undefined)
      try memory.abortTurn()
      const confirmed = try (try VoiceBridge).shut(session)
      return { type: "stopped", confirmed }
    }, { type: "stopped", confirmed: false });
    when { tag: "Release", let afterMs }: answer("release", effect {
      const time = try Time
      if (afterMs > 0) try time.until((try time.now()) + afterMs)
      return { type: "released", confirmed: try (try VoiceBridge).release(), afterMs }
    }, { type: "released", confirmed: false, afterMs });
    when { tag: "Navigate", let session, let turn, let place, let sourceRoute }: run("spoken navigation", navigateLeased(session, turn, place, sourceRoute));
    when { tag: "CheckDictation", let ticket }: answer("check dictation recognition", effect {
      const voice = try Voice.Machine
      if (!Voice.canRecognitionChecked(try voice.get(), ticket, true)) return { type: "recognitionChecked", ticket, ready: false }
      const recognition = try (try VoiceBridge).probeStatus(false)
      return { type: "recognitionChecked", ticket, ready: recognition.ready }
    }, { type: "recognitionChecked", ticket, ready: false });
    when { tag: "Record", let ticket }: answer("record", effect {
      const current = try (try Voice.Machine).get()
      if (Voice.canRecordingStarted(current, ticket)) {
        (try VoiceWords).memory.setDictated("", undefined)
      }
      const started = effect { try (try VoiceBridge).startRecording(ticket); return true } catch () => false
      return started ? { type: "recordingStarted", ticket } : { type: "recordingFailed", ticket, failure: "NoMicrophone" }
    }, { type: "recordingFailed", ticket, failure: "NoMicrophone" });
    when { tag: "Transcribe", let ticket, let network, let automatic }: answer("transcribe", effect {
      if (automatic && !(try dictationVisible())) return { type: "transcribed", ticket, failure: "AgentUnavailable" } as Voice.Event
      const result = try (try VoiceBridge).transcribe(ticket, network, automatic)
      if (result.kind === "lost") return { type: "clipLost", ticket }
      const trimmed = result.kind === "recognized" ? result.text.trim() : ""
      const failure = result.kind === "obscured" ? "AgentUnavailable" : result.kind === "failed" ? "Recognition" : trimmed === "" ? "NoSpeech" : "NoFailure"
      const current = try (try Voice.Machine).get()
      if (Voice.canTranscribed(current, ticket, failure)) {
        (try VoiceWords).memory.setDictated(trimmed, result.durationMs)
      }
      return { type: "transcribed", ticket, failure } as Voice.Event
    }, { type: "transcribed", ticket, failure: "Recognition" });
    when { tag: "Abandon", let recording }: run(`abandon ${recording}`, effect { try (try VoiceBridge).abandon(recording) });
    when { tag: "Fill", let field, let filling }: run(`fill ${filling}`, effect {
      const { memory } = try VoiceWords
      const target = memory.fillTarget
      if (target?.field !== field || target.filling !== filling) return
      const words = memory.dictatedText.trim()
      memory.fillTarget = undefined
      memory.setDictated("", undefined)
      if (words !== "") try target.apply(words)
    });
  }
}

const autoPrewarm = started(effect {
  const voice = try Voice.Machine
  try Stream.runForEach(voice.changes, effect (state) => {
    if (!state.warmed && !state.latched && !state.prompting) {
      try contained(voice.send({ type: "prewarm", now: untimed }), "prewarming voice")
    }
  })
}, "auto-prewarming voice")

const visibility = started(effect {
  const device = try Device
  const bridge = try VoiceBridge
  const voice = try Voice.Machine
  const phone = Option.getOrUndefined(try Effect.serviceOption(Phone))
  try Stream.runForEach(device.visible, effect (shown) => {
    if (shown) {
      try bridge.invalidateCache()
      if (phone !== undefined && liveCall(try phone.get())) {
        const { session } = try voice.get()
        try contained(voice.send({ type: "callInterrupted", session, foreground: true }), "identifying the call on return")
      }
      try contained(voice.send({ type: "returned" }), "voice foreground return")
    } else {
      const current = try voice.get()
      if (current.recorder.field === "MessagesBar" && Voice.canCloseRecorder(current)) try contained(voice.send({ type: "closeRecorder" }), "discarding message dictation in the background")
      try contained(voice.send({ type: "pageHidden" }), "voice page hidden")
    }
  })
}, "voice visibility")

const navigation = started(effect {
  const shell = try Shell.Machine
  const voice = try Voice.Machine
  let last: { readonly place: number; readonly route: number } | undefined
  try Stream.runForEach(shell.changes, effect (state) => {
    const place = placeOf(state.trail.at(-1))
    const previous = last
    last = { place, route: state.route }
    if (previous === undefined || state.route === previous.route) return
    const spoken = state.spokenRoute === state.route
    if (place === previous.place && !spoken) return
    try contained(voice.send({ type: "navigated", place, arrivedRoute: state.route, spoken }), "voice observing navigation")
  })
}, "voice observing shell navigation")

// spec/app/voice/index.md, "A phone call ends Talk quietly, and only the owner starts it again"
export const voiceWithCalls = started(effect {
  const phone = try Phone
  const device = try Device
  const voice = try Voice.Machine
  const { memory } = try VoiceWords
  const calls = Stream.changes(Stream.map(phone.changes, liveCall))
  try Stream.runForEach(Stream.zipLatest(calls, voice.changes), effect ([live, speech]) => {
    if (!live) return
    if (speech.recorder.field === "MessagesBar" && Voice.canCloseRecorder(speech)) {
      try contained(voice.send({ type: "closeRecorder" }), "discarding message dictation during a call")
      return
    }
    const foreground = try device.showing()
    if (Voice.canCallInterrupted(speech, speech.session, foreground)) {
      memory.setHeard(undefined)
      try memory.abortTurn()
      try contained(voice.send({ type: "callInterrupted", session: speech.session, foreground }), "stopping Talk for a call")
    }
  })
}, "voice observing calls")

// spec/app/voice/index.md, "A failed conversation ends quietly: why it failed is kept only until voice returns to idle, and nothing is shown"
const quietly = following(Voice.Machine, (voice) => voice.phase === "Failed", Voice.Machine, (failed): Voice.Event | undefined => (failed ? { type: "dismiss" } : undefined))

// spec/app/voice/dictation.md, "A microphone failure ends dictation quietly and a failed transcription keeps its clip"
const dictationQuietly = following(Voice.Machine, (voice) => voice.recorder.stage === "Ready" && voice.recorder.failure !== "NoFailure", Voice.Machine, (failed): Voice.Event | undefined => (failed ? { type: "closeRecorder" } : undefined))

// spec/app/voice/index.md, "Using the transcript fills the field dictation started in, and dictation never sends"
const messageTranscript = following(Voice.Machine, (voice) => voice.recorder.field === "MessagesBar" && Voice.canFill(voice), Voice.Machine,
  (ready): Voice.Event | undefined => ready ? { type: "fill" } : undefined)

const discardedDictation = applying(Voice.Machine, (voice) => voice.recorder, effect (recorder) => {
  if (recorder.stage !== "Closed") return
  const latest = (try (try Voice.Machine).get()).recorder
  if (latest.stage !== "Closed" || latest.ticket !== recorder.ticket) return
  const { memory } = try VoiceWords
  if (memory.fillTarget === undefined || memory.fillTarget.filling <= recorder.filled) return
  memory.fillTarget = undefined
  memory.setDictated("", undefined)
  memory.transcriptReading = undefined
})

const permissions = started(effect {
  const bridge = try VoiceBridge
  const device = try Device
  const voice = try Voice.Machine
  const syncGrant = effect {
    const raw = try bridge.checkPermission()
    if (raw === "unknown") return
    const grant = raw === "granted" ? "Granted" : raw === "denied" ? "Denied" : "Unasked"
    const current = try voice.get()
    if (current.permission.grant !== grant && Voice.canPermissionChanged(current, grant)) {
      try contained(voice.send({ type: "permissionChanged", grant }), "syncing microphone permission")
    }
  }
  try syncGrant
  try Stream.runForEach(Stream.filter(device.visible, (shown) => shown), () => syncGrant)
}, "syncing microphone permission")

const bridgeEvents = hearing(
  Stream.unwrap(effect {
    const bridge = try VoiceBridge
    const voice = try Voice.Machine
    const { memory } = try VoiceWords
    return Stream.mapEffect(bridge.events, effect (event: VoiceEvent): (Voice.Event | undefined)!!(Device | Layers.Machine | VoiceBridge | Voice.Machine | Shell.Machine) => {
      if (event.kind === "speechEnd" && event.text !== "") {
        // spec/app/voice/index.md, "When the owner finishes speaking, the microphone closes, and only then is the turn sent, once and automatically": a gap that ends while the microphone Unmute reopened is still opening ends the turn as soon as it is open.
        const settled = try Stream.runHead(Stream.filter(voice.changes, (live) => !Voice.turnEndWaits(live, event.session)))
        const state = Option.isSome(settled) ? settled.value : try voice.get()
        if (Voice.canTurnEnded(state, event.session)) {
          memory.setHeard({ session: state.session, turn: state.turn, text: event.text })
          // spec/app/voice/index.md, "What the owner said shows at once as their message, with Alpha's working dots and then its reply under it, until the conversation records it"
          memory.publishSaid({ session: state.session, turn: state.turn, text: event.text.trim() })
        }
      }
      if (event.kind === "ended") {
        if (event.reason === "ended") return undefined
        if (event.reason === "call-active") return { type: "callInterrupted", session: event.session, foreground: try (try Device).showing() }
        if (event.reason === "insufficient_credits") return try stopForFunds(event.session, (try voice.get()).turn)
        const classified = event.fault !== undefined
          ? { fault: event.fault, waitMs: event.waitMs ?? 0 }
          : classifyVoiceFault(event.cause ?? event.reason, (try voice.get()).network)
        const status = bridge.probeStatus(false) catch () => ({ ready: false, ttsReady: false, liveCapture: false })
        return { type: "speechFailed", session: event.session, fault: classified.fault, wait: classified.waitMs, deviceReady: status.ready && status.liveCapture, now: untimed }
      }
      return match (event) {
        when { kind: "speechStart", let session }: { type: "speechHeard", session };
        when { kind: "speechEnd", let session }: { type: "turnEnded", session };
        when { kind: "bargeIn", let session, let echo }: { type: "bargeIn", session, echo };
        when { kind: "recordingStopped", let ticket, let recorded }: recorded
          ? { type: "recordingStopped", ticket, showing: try dictationVisible(), now: untimed }
          : { type: "recordingFailed", ticket, failure: "NoMicrophone" };
      }
    })
  }),
  Voice.Machine,
  (event) => event,
)

module previous {
  /** Settings the previous Voice snapshot keeps on restart. @throws {never} */
  export function rememberedVoice(raw: string): { readonly permission: unknown; readonly route: unknown } | undefined {
    try {
      const state: unknown = JSON.parse(raw)
      if (typeof state !== "object" || state === null || !("permission" in state) || !("route" in state)) return undefined
      return { permission: state.permission, route: state.route }
    } catch {
      return undefined
    }
  }
}
import { rememberedVoice } from previous

// spec/app/voice/index.md, "After a restart only the account and the owner's answer to the disclosure remain"
function stored(key: string, start?: Voice.Voice) {
  return Layer.unwrap(effect {
    const store = try KeyValueStore.KeyValueStore
    const current = store.get(key) catch () => undefined
    if (current !== undefined) return Voice.stored(key, start)
    const earlier = store.get("alpha/app/voice/index@2") catch () => undefined
    const raw = earlier ?? (store.get("alpha/app/voice/index@1") catch () => undefined)
    const old = raw === undefined ? undefined : rememberedVoice(raw)
    const recovered = old === undefined ? undefined : (Voice.decodeState({ ...Voice.initial, ...old }) catch () => undefined)
    return Voice.stored(key, recovered ?? start)
  })
}

export const voicing = Layer.provideMerge(
  together(
    reacting({ ...Voice, stored }, {
      keep: 3,
      open: [{ type: "restart" }],
      carry: carryVoice,
      timers: (v) => (v.retryAt > 0 ? [due("retry", v.retryAt, { type: "retryDue", now: untimed })] : []),
    }),
    autoPrewarm,
    dictationClock,
    visibility,
    navigation,
    permissions,
    bridgeEvents,
    signedIn,
    quietly,
    dictationQuietly,
    messageTranscript,
    discardedDictation,
  ),
  voiceWords,
)
