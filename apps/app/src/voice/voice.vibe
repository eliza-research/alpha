interface SpokenNavigation {
  readonly session: number
  readonly turn: number
  readonly place: number
  readonly sourceRoute: number
  readonly opened: Deferred.Deferred<boolean>
  readonly apply: Effect.Effect<boolean>
  readonly decline: Effect.Effect<void>
}

export interface VoiceSnapshot {
  readonly dictatedText: string
  readonly dictatedDurationMs: number | undefined
  readonly heardText: string
}

export interface SpokenChatLease {
  readonly session: number
  readonly turn: number
  readonly record: ConversationRecord
  readonly authority: DraftSeat["authority"]
  readonly conversation: number
  readonly current: boolean!!
  readonly verified: boolean!!
  readonly retired: Stream.Stream<void>
  settle(result: Extract<TurnResult, { kind: "Replied" }>, spoken: string, resent: boolean): void!!
}

export type SpokenChatContext = Agent | VoiceWords | Voice.Machine | Shell.Machine | Conversation | Chats | Phone | Views | Talk | MediaReview

interface SpokenChat {
  readonly context: Context.Context<SpokenChatContext>
  readonly writer: Semaphore.Semaphore
  /** Whether no typed message, request or conversation being made holds the posting place now. */
  readonly free: boolean!!
  /** Each change after which the posting place may be free, from the moment it is run. */
  readonly changes: Stream.Stream<void>
  readonly begin: (session: number, turn: number, current: boolean!!) => (SpokenChatLease | undefined)!!
}

/** Where a heard Talk turn ended without the agent asked, or with nothing said aloud. */
export type TalkTurnGuard = "NothingHeard" | "TurnRetired" | "WaitExpired" | "NoChat" | "NoSeat" | "DraftInBlankChat" | "ChatNotMade"
  | "RecordMissing" | "SelectionMoved" | "LeaseRefused" | "SendFailed" | "ReplyStale" | "PlaybackFailed"

/** Names, in a development build's log and nowhere else, the guard that ended a heard Talk turn unsent or unsaid, so a device run shows which one fired. */
export effect function noteTalkTurn(guard: TalkTurnGuard, session: number, turn: number, detail?: string): void!! {
  if (development()) try logInfo(`talk turn ${session}:${turn} ended at ${guard}${detail === undefined ? "" : ` (${detail})`}`)
}

export interface InterimWords {
  readonly session: number
  readonly turn: number
  readonly text: string
}

/** What the owner said for the turn Alpha is answering, and the reply's text once it is queued to be spoken. */
export interface SaidWords extends InterimWords {
  readonly reply?: string
}

interface InterimCapture extends VoicePreview {
  readonly current: (state: Voice.Voice) => boolean
}

type InterimContext = Device | Layers.Machine | Shell.Machine | Voice.Machine | VoiceWords | Talk | Chats | Conversation

export type PageSpeech = {
  readonly item: number
  readonly source?: "workflow" | "workflow-step"
  readonly words: string | NativePageSpeech
  readonly current: () => boolean!!
  readonly retire: (result: "Finished" | "Stopped") => void!!
}

export interface VoiceMemory {
  prepareInterim: ((session: number) => (InterimCapture | undefined)!!) | undefined
  interimCapture: InterimCapture | undefined
  interimSnapshot(): InterimWords | undefined
  subscribeInterim(listener: () => void): () => void
  publishInterim(value: InterimWords | undefined): void
  /** What the owner said for the turn Alpha is answering, shown as their message until the conversation records it. */
  readonly saidSnapshot: () => SaidWords | undefined
  readonly subscribeSaid: (listener: () => void) => () => void
  readonly publishSaid: (value: SaidWords | undefined) => void
  /** The reply's text for that turn, shown in the dots' place from the moment it is queued to be spoken. */
  readonly showSpoken: (session: number, turn: number, reply: string) => void
  readonly retireSaid: (session: number, turn: number) => void
  chat: SpokenChat | undefined
  activeController: TurnController | undefined
  heardText: { readonly session: number; readonly turn: number; readonly text: string } | undefined
  lastReply: string
  readonly queuedSentences: string[]
  dispatchedSentences: number
  playbackTurn: number
  clearedThrough: number
  playbackEpoch: number
  activeTurn: { readonly turn: number; readonly stop: () => void!! } | undefined
  readonly playLock: Semaphore.Semaphore
  dictatedText: string
  dictatedDurationMs: number | undefined
  transcriptReading: { readonly review: number; readonly scene: string; readonly words: string } | undefined
  pageReading: PageSpeech | undefined
  fillTarget: { readonly field: Field; readonly filling: number; readonly apply: (words: string) => void!! } | undefined
  spokenNavigation: SpokenNavigation | undefined
  /** The observation and the open Files document a turn sent now from `shown` takes with it, read as Ask Alpha reads them. */
  screen: ((shown: Screen) => {
    readonly metadata: TurnContext | undefined
    readonly sms: MessageSmsRequest | undefined
    readonly attachment: Attached | undefined
  }!!) | undefined
  /** Whether the turn's spoken acknowledgment is queued and not yet handed to speech. */
  cueWaiting: boolean
  /** The turn's spoken acknowledgment, from queued to audible to ended or dropped; `ended` settles when it is no longer heard, and `followed` once a sentence of the reply came after it. */
  cue: SpokenCue | undefined
  setDictated(text: string, durationMs: number | undefined): void
  setHeard(value: { readonly session: number; readonly turn: number; readonly text: string } | undefined): void
  abortTurn(): void!!
  enqueueSentence(turn: number, text: string): void
  /** Queue the turn's acknowledgment to speak at once, before any sentence of its reply; false when the turn already has speech. */
  enqueueCue(turn: number, text: string): boolean
  dequeueSentence(turn: number): { readonly text: string; readonly append: boolean; readonly cue: boolean } | undefined
  /** The turn's acknowledgment is heard now, unless it already ended or was dropped. */
  cueAudible(turn: number): void
  /** The turn's acknowledgment is no longer heard: it played out, or it was dropped or cut. */
  endCue(turn: number, how: "Ended" | "Dropped"): void
  clearQueued(through?: number): void
}

interface SpokenCue {
  readonly turn: number
  phase: Cue
  followed: boolean
  readonly ended: Promise<void>
  readonly end: () => void
}

export service VoiceWords {
  readonly memory: VoiceMemory
  readonly snapshot: (this: void) => VoiceSnapshot
  readonly subscribe: (this: void, listener: () => void) => () => void
}

export const voiceWords = Layer.effect(VoiceWords, effect {
  const playLock = try Semaphore.make(1)
  const shelf = createShelf<VoiceSnapshot>({ dictatedText: "", dictatedDurationMs: undefined, heardText: "" })
  const publish = () => {
    shelf.set({ dictatedText: memory.dictatedText, dictatedDurationMs: memory.dictatedDurationMs, heardText: memory.heardText?.text ?? "" })
  }
  let interim: InterimWords | undefined
  const interimListeners = new Set<() => void>()
  let said: SaidWords | undefined
  const saidListeners = new Set<() => void>()
  const memory: VoiceMemory = {
    prepareInterim: undefined,
    interimCapture: undefined,
    interimSnapshot: () => interim,
    subscribeInterim: (listener) => {
      interimListeners.add(listener)
      return () => { interimListeners.delete(listener) }
    },
    publishInterim(value) {
      if (interim?.session === value?.session && interim?.turn === value?.turn && interim?.text === value?.text) return
      interim = value
      for (const listener of interimListeners) listener()
    },
    saidSnapshot: () => said,
    subscribeSaid: (listener) => {
      saidListeners.add(listener)
      return () => { saidListeners.delete(listener) }
    },
    publishSaid: (value) => {
      if (said?.session === value?.session && said?.turn === value?.turn && said?.text === value?.text && said?.reply === value?.reply) return
      said = value
      for (const listener of saidListeners) listener()
    },
    showSpoken: (session, turn, reply) => {
      // spec/app/voice/index.md, "What the owner said shows at once as their message, with Alpha's working dots and then its reply under it, until the conversation records it"
      if (said === undefined || said.session !== session || said.turn !== turn || reply.trim() === "") return
      memory.publishSaid({ ...said, reply })
    },
    retireSaid: (session, turn) => {
      if (said?.session === session && said.turn === turn) memory.publishSaid(undefined)
    },
    chat: undefined,
    activeController: undefined,
    heardText: undefined,
    lastReply: "",
    queuedSentences: [],
    dispatchedSentences: 0,
    playbackTurn: 0,
    clearedThrough: 0,
    playbackEpoch: 0,
    activeTurn: undefined,
    playLock,
    dictatedText: "",
    dictatedDurationMs: undefined,
    transcriptReading: undefined,
    pageReading: undefined,
    fillTarget: undefined,
    spokenNavigation: undefined,
    screen: undefined,
    cueWaiting: false,
    cue: undefined,
    setDictated(text: string, durationMs: number | undefined) {
      memory.dictatedText = text
      memory.dictatedDurationMs = durationMs
      publish()
    },
    setHeard(value: { readonly session: number; readonly turn: number; readonly text: string } | undefined) {
      memory.heardText = value
      publish()
    },
    abortTurn: () => effect {
      const active = memory.activeTurn
      const controller = memory.activeController
      memory.activeTurn = undefined
      memory.activeController = undefined
      if (active !== undefined) try active.stop()
      else if (controller !== undefined) try ignore(tryPromise(() => controller.interrupt()))
    },
    enqueueSentence(turn: number, text: string) {
      if (!prepareTurn(turn, true)) return
      // spec/app/assistant/reply.md, "A spoken acknowledgment starts at once; a reply ready before it is audible drops it, and an audible one finishes before the reply, within 2.5 s": a cue still queued is dropped here; one already handed to speech is dropped or bounded when this sentence plays.
      if (memory.cueWaiting) {
        memory.queuedSentences.shift()
        memory.endCue(turn, "Dropped")
      }
      memory.cueWaiting = false
      memory.queuedSentences.push(text)
    },
    enqueueCue(turn: number, text: string) {
      if (!prepareTurn(turn, false)) return false
      // spec/app/assistant/reply.md, "One brief acknowledgment at most, only from the agent's acknowledgment frame, before any tool runs": sentences streamed before it and not yet spoken are the cue's own words, which the acknowledgment replaces; once one is spoken, it is the cue.
      if (memory.dispatchedSentences > 0) return false
      memory.queuedSentences.length = 0
      memory.endCue(memory.cue?.turn ?? turn, "Dropped")
      const { promise, resolve } = Promise.withResolvers<void>()
      memory.cue = { turn, phase: "Preparing", followed: false, ended: promise, end: resolve }
      memory.cueWaiting = true
      memory.queuedSentences.push(text)
      return true
    },
    dequeueSentence(turn: number) {
      if (memory.playbackTurn !== turn) return undefined
      const text = memory.queuedSentences.shift()
      if (text === undefined) return undefined
      const cue = memory.cueWaiting
      memory.cueWaiting = false
      const append = memory.dispatchedSentences > 0
      memory.dispatchedSentences += 1
      return { text, append, cue }
    },
    cueAudible(turn: number) {
      if (memory.cue?.turn === turn && memory.cue.phase === "Preparing") memory.cue.phase = "Audible"
    },
    endCue(turn: number, how: "Ended" | "Dropped") {
      const cue = memory.cue
      if (cue?.turn !== turn || cue.phase === "Ended" || cue.phase === "Dropped") return
      cue.phase = how === "Ended" && cue.phase === "Audible" ? "Ended" : "Dropped"
      cue.end()
    },
    clearQueued(through?: number) {
      memory.playbackEpoch += 1
      const retired = through ?? Math.max(memory.playbackTurn, memory.activeTurn?.turn ?? 0)
      if (retired > memory.clearedThrough) memory.clearedThrough = retired
      memory.queuedSentences.length = 0
      memory.dispatchedSentences = 0
      memory.cueWaiting = false
      if (memory.cue !== undefined) memory.endCue(memory.cue.turn, "Dropped")
    },
  }
  function prepareTurn(turn: number, clearCue: boolean): boolean {
    if (turn <= memory.clearedThrough || turn < memory.playbackTurn) return false
    if (memory.playbackTurn !== turn) {
      memory.playbackTurn = turn
      memory.queuedSentences.length = 0
      memory.dispatchedSentences = 0
      if (clearCue) memory.cueWaiting = false
    }
    return true
  }
  return { memory, snapshot: shelf.snapshot, subscribe: shelf.subscribe }
})

// spec/app/voice/index.md, "What the owner says is shown as it is heard"
effect function prepareInterim(session: number): (InterimCapture | undefined)!!InterimContext {
  const { memory } = try VoiceWords
  memory.interimCapture?.retire()
  const { board } = try Talk
  const chats = try Chats
  const conversation = try Conversation
  const seat = board.draftSeat
  if (seat === undefined) return undefined
  const voice = try Voice.Machine
  const shell = try Shell.Machine
  const layers = try Layers.Machine
  const device = try Device
  const page = try chats.get()
  const record = board.known(page.chosen)?.record
  const context = (try conversation.get()).context
  const route = (try shell.get()).route
  if (context.sensitive || (page.chosen !== 0 && record === undefined)) return undefined
  const scopeIsCurrent = effect {
    if (board.draftSeat !== seat || !(try device.showing()) || Layers.assistantInert(try layers.get())) return false
    const chat = try chats.get()
    if ((try shell.get()).route !== route || chat.chosen !== page.chosen || chat.page.ticket !== page.page.ticket) return false
    const showing = (try conversation.get()).context
    const now = board.known(chat.chosen)?.record
    return !showing.sensitive && showing.revision === context.revision && now?.id === record?.id && now?.roomId === record?.roomId
  }
  const { route: voiceRoute, network } = try voice.get()
  const retired = new AbortController()
  const capture: InterimCapture = {
    retired: retired.signal,
    current: (state) => memory.interimCapture === capture && state.session === session
      && state.route.account === voiceRoute.account && state.route.key === voiceRoute.key && state.network === network && !state.muted
      && Voice.talking(state) && (state.mic === "Opening" || state.mic === "On") && Effect.runSync(scopeIsCurrent),
    show(text) {
      const state = Effect.runSync(voice.get())
      if (state.phase !== "Listening" || state.mic !== "On" || !capture.current(state)) return
      const words = text.trim()
      memory.publishInterim(words === "" ? undefined : { session, turn: state.turn, text: words })
    },
    clear() {
      if (memory.interimCapture === capture) memory.publishInterim(undefined)
    },
    retire() {
      if (memory.interimCapture === capture) {
        memory.interimCapture = undefined
        memory.publishInterim(undefined)
      }
      retired.abort()
    },
  }
  memory.interimCapture = capture
  return capture
}

/** Ask Alpha supplies the preview scope when its own machines have finished starting. */
export const interimLiveness = started(effect {
  const { memory } = try VoiceWords
  const context = try Effect.context<InterimContext>()
  const prepare = (session: number) => Effect.provideContext(prepareInterim(session), context)
  const { board } = try Talk
  const chats = try Chats
  const conversation = try Conversation
  const voice = try Voice.Machine
  const shell = try Shell.Machine
  const layers = try Layers.Machine
  const device = try Device
  const boardChanges = Stream.callback<boolean>((queue) => acquireRelease(
    sync(() => board.subscribe(() => { Queue.offerUnsafe(queue, true) })),
    (off) => sync(off),
  ))
  const sources: ReadonlyArray<Stream.Stream<boolean>> = [
    boardChanges,
    Stream.as(chats.changes, true),
    Stream.as(conversation.changes, true),
    Stream.as(voice.changes, true),
    Stream.as(shell.changes, true),
    Stream.as(layers.changes, true),
    Stream.filter(device.visible, (shown) => !shown),
  ]
  const changes = Stream.mergeAll(sources, { concurrency: "unbounded" })
  const watch = Stream.runForEach(changes, effect (visible) => {
    const capture = memory.interimCapture
    if (capture === undefined) return
    if (visible === false) { capture.retire(); return }
    const state = try voice.get()
    if (!capture.current(state)) capture.retire()
    else if (state.phase !== "Listening" || state.mic !== "On" || memory.interimSnapshot()?.turn !== state.turn) capture.clear()
  })
  try Effect.ensuring(effect {
    memory.prepareInterim = prepare
    try watch
  }, sync(() => {
    if (memory.prepareInterim !== prepare) return
    memory.prepareInterim = undefined
    memory.interimCapture?.retire()
  }))
}, "retiring the Talk preview with its capture")

// spec/app/voice/index.md, "Using the transcript fills the field dictation started in, and dictation never sends"
export effect function openDictation<R>(field: Field, apply: (words: string) => void!!R): boolean!!(Voice.Machine | VoiceWords | R) {
  const voice = try Voice.Machine
  const { memory } = try VoiceWords
  const context = try Effect.context<R>()
  const filling = (try voice.get()).recorder.filled + 1
  if (!(try contained(voice.send({ type: "openRecorder", target: field }), "opening dictation"))) return false
  memory.setDictated("", undefined)
  memory.fillTarget = { field, filling, apply: (words) => Effect.provideContext(apply(words), context) }
  return true
}

module pure {
  import { clockWords, meridiemOf, twelveHour } from "../../gen/app__voice.ts"
  import { withoutTurnTags } from "../assistant/words.ts"

  /** The reply's speakable text, without the agent's turn tag: each run of spaces is one space and each line break is kept as one, so no spoken form joins two lines. @throws {never} */
  export function speakableText(text: string): string {
    return withoutTurnTags(text)
      .replace(/\[(APPROVAL|PROPOSAL|REVIEW|DRAFT|CALENDAR_APPROVAL|EMAIL_DRAFT)[^\]]*\]/gi, "")
      .replace(/:[ \t]*(?=\r?\n)/g, ".")
      .replace(/\s*\n\s*/g, "\n")
      .replace(/[^\S\n]+/g, " ")
      .trimStart()
  }

  const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
  const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
  const ordinals = [
    "", "first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth",
    "eleventh", "twelfth", "thirteenth", "fourteenth", "fifteenth", "sixteenth", "seventeenth", "eighteenth", "nineteenth", "twentieth",
    "twenty-first", "twenty-second", "twenty-third", "twenty-fourth", "twenty-fifth", "twenty-sixth", "twenty-seventh", "twenty-eighth",
    "twenty-ninth", "thirtieth", "thirty-first",
  ]
  const ones = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
    "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
  const tens = ["", "", "twenty", "thirty", "forty", "fifty"]

  function numberWords(n: number): string {
    if (n < 20) return ones[n] ?? String(n)
    return n % 10 === 0 ? tens[n / 10] ?? String(n) : `${tens[Math.floor(n / 10)] ?? ""} ${ones[n % 10] ?? ""}`
  }

  function namesPattern(names: readonly string[]): string {
    return names.flatMap((name) => (name.length > 3 ? [name, name.slice(0, 3)] : [name])).flatMap((name) => [name, name.toUpperCase()]).join("|")
  }

  const weekdayNames = namesPattern(weekdays)
  const monthNames = `${namesPattern(months)}|Sept|SEPT`
  const namedDate = new RegExp(
    String.raw`\b(?:(${weekdayNames})\.?,?[ \t]+)?(${monthNames})\.?[ \t]+(0?[1-9]|[12]\d|3[01])(?:st|nd|rd|th)?(?![\p{L}\d/-]|[.:]\d)`,
    "gu",
  )
  const clock = String.raw`(?:0?[1-9]|1[0-2])(?::[0-5]\d)?`
  const bareClock = String.raw`(?:[01]?\d|2[0-3]):[0-5]\d`
  const meridiem = String.raw`[ \t]*[aApP]\.?[ \t]*[mM](?:\.(?=[ \t]*[,;!?–—−-]|[ \t]+(?:\p{Ll}|[tT][oO][ \t])))?`
  const rangeSeparator = String.raw`(?:[ \t]*[-–—−][ \t]*|[ \t]+[tT][oO][ \t]+)`
  const clockEnd = String.raw`(?![\p{L}\d:/-]|\.\d)`
  const clockStart = String.raw`(?<![\p{L}\d:+./−-])`
  const clockRange = new RegExp(String.raw`${clockStart}(?:(${clock}(?:${meridiem})?)${rangeSeparator}(${clock}${meridiem})|(${bareClock})${rangeSeparator}(${bareClock}))${clockEnd}`, "gu")
  const clockWithMeridiem = new RegExp(String.raw`${clockStart}(${clock}${meridiem})${clockEnd}`, "gu")
  const bareClockTime = new RegExp(String.raw`${clockStart}${bareClock}${clockEnd}`, "gu")
  const unfinishedWeekday = new RegExp(String.raw`\b(?:${weekdayNames})\.,?(?:[ \t]+([A-Z][A-Za-z]*)\.?(?:[ \t]+0)?)?[ \t]*$`, "u")
  const unfinishedMonth = new RegExp(String.raw`\b(?:${monthNames})\.(?:[ \t]+0)?[ \t]*$`, "u")
  const unfinishedClock = new RegExp(String.raw`${clockStart}${clock}[ \t]*[ap](?:\.|\.?[ \t]*m\.(?:[ \t]+t(?:o)?)?)[ \t]*$`, "iu")
  const abbreviation = /\b(?:Dr|Mr|Mrs|Ms|Prof|Jr|Sr|St|vs|e\.g|i\.e)\./gi

  function hidePeriods(text: string): string {
    return text.replaceAll(".", "·")
  }

  /** What kind of failure ended a Talk turn, by its tag or class alone, never its message. @throws {never} */
  export function failureName(failure: unknown, depth = 0): string {
    if (typeof failure !== "object" || failure === null) return typeof failure
    const tag: unknown = Reflect.get(failure, "_tag")
    const cause: unknown = Reflect.get(failure, "cause")
    if (typeof tag === "string") return cause === undefined || depth >= 3 ? tag : `${tag} from ${failureName(cause, depth + 1)}`
    const made: unknown = Reflect.get(failure, "constructor")
    return typeof made === "function" ? made.name : "object"
  }

  /** Returns complete written sentences and how much of the unchanged input they consumed. @throws {never} */
  export function takeCompleteSentences(buffer: string, final: boolean): { readonly ready: readonly string[]; readonly consumed: number } {
    const scan = (final ? buffer : buffer
      .replace(unfinishedWeekday, (tail, month?: string) =>
        month === undefined || months.some((name) => name.startsWith(month) || name.toUpperCase().startsWith(month)) ? hidePeriods(tail) : tail)
      .replace(unfinishedMonth, hidePeriods)
      .replace(unfinishedClock, hidePeriods))
      .replace(abbreviation, hidePeriods)
      .replace(namedDate, hidePeriods)
      .replace(clockRange, hidePeriods)
      .replace(clockWithMeridiem, hidePeriods)
    const ready: string[] = []
    let consumed = 0
    for (const boundary of scan.matchAll(/[.!?](?=\s|$)\s*/g)) {
      if (!final && boundary[0] === "." && boundary.index + 1 === scan.length && /\d/.test(scan.charAt(boundary.index - 1))) break
      ready.push(buffer.slice(consumed, boundary.index + 1).trim())
      consumed = boundary.index + boundary[0].length
    }
    if (final) {
      const tail = buffer.slice(consumed).trim()
      if (tail !== "") ready.push(tail)
      consumed = buffer.length
    }
    return { ready, consumed }
  }

  function clockSaid(value: string): string {
    const found = /^(\d{1,2})(?::(\d{2}))?[ \t]*([ap])?/i.exec(value)
    if (found === null) return value
    const hour = Number(found[1])
    const minute = Number(found[2] ?? "0")
    const written = found[3] === undefined ? "NoMeridiem" : found[3].toLowerCase() === "p" ? "Afternoon" : "Morning"
    const period = meridiemOf(hour, written)
    const suffix = period === "Afternoon" ? " P M" : period === "Morning" ? " A M" : ""
    switch (clockWords(hour, minute, written, found[2] !== undefined)) {
      case "NoonWord": return "noon"
      case "MidnightWord": return "midnight"
      case "HourAndMinutes": return `${numberWords(twelveHour(hour))} ${minute < 10 ? "oh " : ""}${numberWords(minute)}${suffix}`
      case "HourOClock": return `${numberWords(twelveHour(hour))} o'clock`
      case "HourAlone": return `${numberWords(twelveHour(hour))}${suffix}`
    }
  }

  /** What Alpha says for a sentence of its reply: dates, clock times, ranges and percentages in words. @throws {never} */
  export function spokenForm(sentence: string): string {
    return sentence
      .replace(namedDate, (_, day: string | undefined, month: string, date: string) => {
        const fullDay = day === undefined ? undefined : weekdays.find((name) => name.toLowerCase().startsWith(day.toLowerCase()))
        const fullMonth = months.find((name) => name.toLowerCase().startsWith(month.toLowerCase())) ?? month
        return `${fullDay === undefined ? "" : `${fullDay}, `}${fullMonth} ${ordinals[Number(date)] ?? date}`
      })
      .replace(clockRange, (_, from?: string, to?: string, fromBare?: string, toBare?: string) => `${clockSaid(from ?? fromBare ?? "")} to ${clockSaid(to ?? toBare ?? "")}`)
      .replace(clockWithMeridiem, clockSaid)
      .replace(bareClockTime, clockSaid)
      .replace(/(?<![\p{L}\d:./-])(\d{1,2})[ \t]*[-–][ \t]*(\d{1,2})(?![\p{L}\d:/-]|\.\d)/gu, "$1 to $2")
      .replace(/(?<=\d)[ \t]?%(?![\p{L}\d])/gu, " percent")
      .replace(/(?<=\p{L}):(?=[ \t]+\S)/gu, ",")
      .replace(/\s+/g, " ")
  }
}
import { failureName, speakableText, spokenForm, takeCompleteSentences } from pure
export { speakableText, spokenForm }

interface VoicePost {
  readonly session: number
  readonly turn: number
  readonly queue: Queue.Queue<Voice.Event, Cause.Done>
  readonly lease: SpokenChatLease
  readonly spoken: string
}

type VoiceCompletion = Extract<Voice.Event, { type: "replyEnds" | "refusedForFunds" }>

/** Voice ending for spent funds, leaving the conversation showing its one fixed line for it, once, with Ask Alpha raised to show it. */
effect function stopForFunds(session: number, turn: number, messageId?: string): Extract<Voice.Event, { type: "refusedForFunds" }>!!(Voice.Machine | Shell.Machine) {
  const chat = Option.getOrUndefined(try Effect.serviceOption(Talk))?.board
  if (chat !== undefined && Voice.canRefusedForFunds(try (try Voice.Machine).get(), session, turn)) {
    chat.change({ failure: { kind: "OutOfFunds", fix: "FundingFix", waitMs: -1, cutOff: "NotCutOff", ...(messageId === undefined ? {} : { messageId }) } })
    const shell = try Shell.Machine
    if (Shell.canRaise(try shell.get(), "Sheet")) try contained(shell.send({ type: "raise", detent: "Sheet" }), "showing the out-of-funds line")
  }
  return { type: "refusedForFunds", session, turn }
}

type VoiceOutput = Pick<VoicePost, "session" | "turn" | "queue"> & {
  readonly memory: VoiceMemory
}

function voiceTurnOutput({ session, turn, queue, memory }: VoiceOutput) {
  let shown = ""
  let said = 0
  const say = (sentence: string) => {
    if (turn <= memory.clearedThrough || turn < memory.playbackTurn) return
    memory.enqueueSentence(turn, spokenForm(replyWords(sentence, true)))
    Queue.offerUnsafe(queue, { type: "sentence", session, turn })
  }
  const sayFrom = (written: string, final: boolean) => {
    const split = takeCompleteSentences(written.slice(said), final)
    said += split.consumed
    for (const sentence of split.ready) say(sentence)
  }
  let awaitingFiles = false
  let proposing = false
  let usedDirect = false
  const feed = (written: string, provisional: boolean) => {
    if (provisional || proposing || turn <= memory.clearedThrough) return
    const clean = speakableText(replyBlocks(written, true).words)
    if (clean.length <= shown.length) return
    shown = clean
    sayFrom(clean, false)
    // spec/app/voice/index.md, "What the owner said shows at once as their message, with Alpha's working dots and then its reply under it, until the conversation records it": v119 45f6bed30 agent-adapter.ts:2253-2254 set the spoken text and the chat text in the same frame.
    memory.showSpoken(session, turn, written)
  }

  // spec/app/assistant/reply.md, "One brief acknowledgment at most, only from the agent's acknowledgment frame, before any tool runs": it is said at once, with no hold, as the turn's first line. Text streamed before it is the cue's own words, which the agent starts again after the acknowledgment, so the reply's text is read from its start.
  let cued = false
  let toolRan = false
  const cue = (text: string) => {
    if (cued || toolRan || turn <= memory.clearedThrough) return
    const line = spokenForm(speakableText(text)).trim()
    if (line === "") return
    cued = true
    shown = ""
    said = 0
    if (memory.enqueueCue(turn, line)) Queue.offerUnsafe(queue, { type: "sentence", session, turn })
  }
  const ran = (name: string) => {
    toolRan = true
    if (name === "PROPOSE_DEVICE_ACTION") {
      proposing = true
      awaitingFiles = usedDirect
    }
  }
  const ready = (fullText: string, actionResults: readonly { readonly action: string }[]) => {
    for (const { action } of actionResults) ran(action)
    if (proposing || turn <= memory.clearedThrough) return
    const full = speakableText(replyBlocks(fullText).words)
    if (full.length > shown.length) shown = full
    sayFrom(full.length >= shown.length ? full : shown, true)
    memory.showSpoken(session, turn, fullText)
  }
  const hooks = { onPreview: feed, onAcknowledgment: cue, onReady: ready, onTool: ran }
  return {
    hooks,
    beginAttempt(direct: boolean) {
      usedDirect = direct
      proposing = false
      awaitingFiles = false
    },
    get usedDirect() { return usedDirect },
    get awaitingFiles() { return awaitingFiles },
    finishSpeech(finalText: string) {
      const full = speakableText(replyBlocks(finalText).words)
      sayFrom(full.length >= shown.length ? full : shown, true)
      memory.showSpoken(session, turn, finalText)
    },
  }
}

effect function postVoiceTurn({ session, turn, queue, lease, spoken }: VoicePost): (VoiceCompletion | undefined)!!(Agent | VoiceWords | Voice.Machine | Shell.Machine) {
