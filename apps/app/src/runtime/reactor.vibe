// spec/kit/read.md, "Only the newest ticket's answer is taken, once"; spec/kit/undo.md, "A held change takes effect only once its time has come"; spec/kit/attempt.md, "Only a recorded attempt is sent"; spec/app/platform/index.md, "A kept value that is no longer a state is set aside where nothing is held, and its machine starts afresh"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { Attempts, Install, attemptsOf, fresh } from "./attempts.vibe"
import { Time } from "./time.vibe"
import { setAside } from "../../gen/app__platform.effect.vibe"

module pure {
  const undefinedWritten = "__alpha_undefined__"
  const unserializableWritten = "__alpha_unserializable__"
  const correlationKeys = ["ticket", "id", "session", "hold"] as const
  /** What a screen and a shell write for an event's `now` or `at`: the reactor replaces it with Alpha's time. */
  export const untimed = 0
  /** `value` as text, to tell whether two facts are the same. @throws {never} */
  export function written(value: unknown): string {
    if (value === undefined) return undefinedWritten
    try { return JSON.stringify(value) ?? undefinedWritten } catch { return unserializableWritten }
  }
  /**
   * `event` with Alpha's `now` stamped in: `now` is always stamped when present, and `at` is stamped only when it
   * holds `untimed` (`0`), preserving explicit non-zero domain timestamps or indices. @throws {never}
   */
  export function stamped<A>(event: A, now: number): A {
    if (typeof event !== "object" || event === null) return event
    const record = event as Record<string, unknown>
    const stampNow = "now" in record
    const stampAt = "at" in record && record.at === untimed
    if (!stampNow && !stampAt) return event
    return {
      ...event,
      ...(stampNow ? { now } : {}),
      ...(stampAt ? { at: now } : {}),
    }
  }
  /** The fields of `value` where it is a JSON object, as a kept state is. @throws {never} */
  export function fieldsOf(value: unknown): Readonly<Record<string, unknown>> | undefined {
    return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Readonly<Record<string, unknown>> : undefined
  }
  /** `value` with each of `fields` it lacks, where it is a JSON object, and as it was otherwise. @throws {never} */
  export function withFields(value: unknown, fields: Readonly<Record<string, unknown>>): unknown {
    const kept = fieldsOf(value)
    return kept === undefined ? value : { ...fields, ...kept }
  }
  /** `value` without each of `names`, where it is a JSON object, and as it was otherwise. @throws {never} */
  export function withoutFields(value: unknown, names: ReadonlyArray<string>): unknown {
    const kept = fieldsOf(value)
    return kept === undefined ? value : Object.fromEntries(Object.entries(kept).filter(([name]) => !names.includes(name)))
  }
  /** Whether a stored-layer failure is `NotAState` rather than a transient store read error. @throws {never} */
  export function isNotAState(cause: unknown): boolean {
    return typeof cause === "object" && cause !== null && "_tag" in cause && (cause as { readonly _tag?: unknown })._tag === "NotAState"
  }
  /** Whether `event` carried a correlation token while `lost` carries none, so a stale refusal must not send `lost`. @throws {never} */
  export function isUnticketedLost(event: unknown, lost: unknown): boolean {
    if (typeof event !== "object" || event === null || typeof lost !== "object" || lost === null) return false
    const ev = event as Record<string, unknown>
    const lo = lost as Record<string, unknown>
    return correlationKeys.some((key) => key in ev) && !correlationKeys.some((key) => key in lo)
  }
}
import { fieldsOf, isNotAState, isUnticketedLost, stamped, untimed, withFields, withoutFields, written } from pure
export { fieldsOf, stamped, untimed, withFields, withoutFields }

/** What a transition that returns effects gives: the state it led to and what it asks of the world. */
export interface Moved<S, Fx> {
  readonly state: S
  readonly out: ReadonlyArray<Fx>
}

/**
 * The members of every generated `Machine`, whatever its module. `M` is what `send` returns, the state or a `Moved`;
 * `By` is `[]`, or `[by: Sender]` where the spec's events take a sender.
 */
export interface Steps<S, Ev, M, Refused, Undecoded, By extends ReadonlyArray<unknown>> {
  readonly changes: Stream.Stream<S>
  get(): S!!
  send(event: Ev, ...by: NoInfer<By>): M!Refused
  receive(input: unknown, ...by: By): M!Undecoded
}

/** A generated module, as `import * as Notes from "../../gen/app__notes.effect.vibe"` names one. */
export interface Spec<I, S, Ev, M, Refused, Undecoded, By extends ReadonlyArray<unknown>, SE, SR> {
  readonly Machine: Context.Key<I, Steps<S, Ev, M, Refused, Undecoded, By>> & { readonly key: string }
  readonly machine: (start?: S) => Layer.Layer<I>
  readonly stored: (key: string, start?: S) => Layer.Layer<I, SE, SR>
}

/**
 * How the shell carries out one item of `out`. `Run` sends each of its answers to the machine as an event from `by`.
 * It ends with its stream, at the first answer the rules refuse, or when it dies; ended in one of the last two ways it
 * sends `lost`, so that no state waits for ever on a job that is gone. A later `Run` or a `Stop` under the same key
 * interrupts it, and then nothing more is sent.
 */
export data Job<Ev, R, By> {
  Run { key: string; answers: Stream.Stream<Ev, never, R>; lost: Option.Option<Ev>; by: By; allowEmpty: boolean }
  Stop { key: string }
}

/** A deadline a state waits on: `event`, from `by`, once the time is `at`. */
export interface Due<Ev, By> {
  readonly key: string
  readonly at: number
  readonly event: Ev
  readonly by: By
}

/** The one answer of `answered`, an effect that has already turned each failure into an event; `lost` where it never answers. */
export function answer<Ev, R, By extends ReadonlyArray<unknown>>(key: string, answered: Ev!!R, lost: Ev, ...by: By): Job<Ev, Exclude<R, Attempts>, By> {
  return stream(key, Stream.fromEffect(answered), lost, ...by)
}

/** Every answer of `answers`, a stream that has already turned its failure into a last event; `lost` where it is cut short. */
export function stream<Ev, R, By extends ReadonlyArray<unknown>>(key: string, answers: Stream.Stream<Ev, never, R>, lost: Ev, ...by: By): Job<Ev, Exclude<R, Attempts>, By> {
  return Job.Run({ key, answers: answers as Stream.Stream<Ev, never, Exclude<R, Attempts>>, lost: Option.some(lost), by, allowEmpty: false })
}

/** `work`, which has nothing to tell the machine. */
export function run<Ev, R, By extends ReadonlyArray<unknown>>(key: string, work: unknown!!R, ...by: By): Job<Ev, R, By> {
  return Job.Run({ key, answers: Stream.fromEffectDrain(work), lost: Option.none(), by, allowEmpty: true })
}

/** Interrupt what runs under `key`. */
export function stop<Ev, By extends ReadonlyArray<unknown>>(key: string): Job<Ev, never, By> {
  return Job.Stop({ key })
}

/** `event` once the time is `at`, for a spec that asks for its own wakes in `out`; a deadline the state holds is a `due` in `timers`. */
export function wake<Ev, By extends ReadonlyArray<unknown>>(key: string, at: number, event: Ev, ...by: By): Job<Ev, Time, By> {
  return Job.Run({ key, answers: Stream.fromEffect(effect { try (try Time).until(at); return event }), lost: Option.none(), by, allowEmpty: true })
}

/** A deadline of `timers`: `event` once the time is `at`. */
export function due<Ev, By extends ReadonlyArray<unknown>>(key: string, at: number, event: Ev, ...by: By): Due<Ev, By> {
  return { key, at, event, by }
}

/**
 * Send `said` to the machine `target` names, of this runtime, and answer `taken` where its rules took it and
 * `refused` where they did not, or it could not be sent.
 */
export function tell<IB, Ev2, Refused2, By2 extends ReadonlyArray<unknown>, Ev, By extends ReadonlyArray<unknown>>(
  key: string,
  target: Context.Key<IB, { send(event: Ev2, ...by: By2): unknown!Refused2 }>,
  said: readonly [event: Ev2, ...by: By2],
  answers: { readonly taken?: Ev; readonly refused: Ev },
  ...by: By
): Job<Ev, IB, By> {
  const told = effect {
    const to = try target
    return effect {
      try to.send(...said)
      return answers.taken === undefined ? Stream.empty : Stream.succeed(answers.taken)
    } catch () => Stream.succeed(answers.refused)
  }
  return Job.Run({ key, answers: Stream.unwrap(told), lost: Option.some(answers.refused), by, allowEmpty: answers.taken === undefined })
}

/**
 * Every service of the runtime a machine lives in, once that runtime is whole. A job and a follower take their
 * services from it when they start, so machines that tell or follow each other are built in any order.
 */
export service Whole {
  readonly context: Context.Context<never>!!
  fill(context: Context.Context<never>): void!!
}

/**
 * `layer`, the machines of one runtime, closed: each machine a job or a follower of it needs must be one it provides.
 * What is left to provide is the platform, and for an area the resident machines.
 */
export function whole<Out, E, In>(layer: Layer.Layer<Out, E, In>): Layer.Layer<Out, E, Exclude<In, Out | Whole>> {
  const late = Layer.effect(Whole, effect {
    const cell = try Deferred.make<Context.Context<never>>()
    return { context: Deferred.await(cell), fill: (context: Context.Context<never>) => asVoid(Deferred.succeed(cell, context)) }
  })
  const filled = Layer.effectDiscard(effect {
    try (try Whole).fill(try Effect.context<never>())
  })
  return Layer.provideMerge(filled, Layer.provideMerge(layer, late)) as unknown as Layer.Layer<Out, E, Exclude<In, Out | Whole>>
}

/**
 * The layers of one runtime, side by side: machines, and what follows, hears and applies them. Each finds the others
 * once the runtime is whole, so their order means nothing, and none may take another while it is built.
 */
export const together = Layer.mergeAll

/** `work`, with what killed it logged: nothing here dies silently, and nothing that dies takes its neighbours along. Whether it succeeded. */
export effect function contained<R = never>(work: unknown!unknown!R, what: string): boolean!!R {
  const ended = try exit(work)
  if (Exit.isSuccess(ended)) return true
  if (!Cause.hasInterruptsOnly(ended.cause) && Cause.hasDies(ended.cause)) try logError(`${what} died`, ended.cause)
  return false
}

/** Where a machine's state is kept: under the spec's own path, so no two machines share a key, and a version the area raises when the state's shape changes. */
export function storeKey(machine: string, version: number): string {
  return `alpha/${machine.replace(/^.*\/spec\//, "").replace(/\.md#Machine$/, "")}@${version}`
}

/**
 * The store, reading what is kept under `key` through `migrate`: a state kept in an older shape is brought to the
 * current one before its machine decodes it.
 */
export function migratedStore(key: string, migrate: (raw: string | undefined) => (string | undefined)!!) {
  return Layer.effect(KeyValueStore.KeyValueStore, effect {
    const store = try KeyValueStore.KeyValueStore
    return KeyValueStore.make({ ...store, get: (name: string) => name === key ? Effect.flatMap(store.get(name), migrate) : store.get(name) })
  })
}

/**
 * The store for a state kept in a shape an earlier build wrote: `filled` brings what is kept under `key` to today's
 * shape, giving each field it lacks the value a fresh machine starts with and dropping each it no longer has, and
 * `parse` says whether that is a state. A state in today's shape, and what is still not a state after it is filled, are
 * read as they were, so that the one is never changed and the other is set aside.
 */
export function filledStore(key: string, filled: (kept: Readonly<Record<string, unknown>>) => unknown, parse: (input: unknown) => unknown) {
  return migratedStore(key, effect (raw: string | undefined) => {
    if (raw === undefined) return undefined
    const kept = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown)))(raw) catch () => undefined
    if (kept === undefined || parse(kept) !== undefined) return raw
    const state = parse(filled(kept))
    return state === undefined ? raw : JSON.stringify(state)
  })
}

/** Where the epoch of a durable machine's attempts is kept, beside its state under `key`. */
const epochKey = (key: string): string => `${key}.epoch`

/**
 * Look up a durable attempt under the same scope the reactor gave its sender: the machine's store key and the epoch
 * kept beside it, or this launch where none could be kept.
 */
export effect function keptAttempts(machine: { readonly key: string }, version: number): Attempts.Shape!!(Install | KeyValueStore.KeyValueStore) {
  const install = try Install
  const store = try KeyValueStore.KeyValueStore
  const scope = storeKey(machine.key, version)
  const epoch = store.get(epochKey(scope)) catch () => undefined
  return attemptsOf(install, `${scope}@${epoch ?? install.launch}`)
}

/** The places a value kept under `key` that is no longer a state may be copied to, in order. */
export const asides = (key: string): ReadonlyArray<string> => [`${key}.unreadable`, ...Array.from({ length: 8 }, (_, index) => `${key}.unreadable.${index + 2}`)]

/** Whether this machine is actually backed by durable storage at runtime (false when falling back to memory). */
service Durability {
  readonly durable: boolean
}

/**
 * The machine kept under `key`. What is stored there and is not a state, after a change of its shape or of an
 * `always` rule, is copied to the first of its `asides` that holds nothing and the machine starts afresh: one area's
 * state never keeps Alpha from opening, and no copy is written over. Where every place is taken, or the store cannot
 * be read at all, the value stays and the machine runs in memory without reusing the persisted attempt epoch.
 */
function kept<I, S, SE, SR>(key: string, stored: (key: string, start?: S) => Layer.Layer<I, SE, SR>, memory: Layer.Layer<I>) {
  const asMemory = Layer.merge(memory, Layer.succeed(Durability, { durable: false }))
  const asStored = (layer: Layer.Layer<I, SE, SR>) => Layer.merge(layer, Layer.succeed(Durability, { durable: true }))
  const aside = Layer.unwrap(effect {
    const store = try KeyValueStore.KeyValueStore
    const found = store.get(key) catch () => undefined
    if (found === undefined) return asMemory
    let place: string | undefined
    for (const one of asides(key)) {
      const held = (store.get(one) catch () => "") !== undefined
      if (setAside("KeptUnreadable", held)) {
        place = one
        break
      }
    }
    if (place === undefined) return asMemory
    const at = place
    try logError(`what is kept under ${key} is not a state: set aside under ${at}`)
    const copied = effect { try store.set(at, found); return true } catch () => false
    if (!copied) return asMemory
    const removed = effect { try store.remove(key); return true } catch () => false
    if (!removed) return asMemory
    try ignore(store.remove(epochKey(key)))
    return Layer.catch(asStored(Layer.fresh(stored(key))), () => asMemory)
  })
  return Layer.catch(asStored(stored(key)), (cause) => (isNotAState(cause) ? aside : asMemory))
}

interface Parts<S, Ev, M, Fx, R, By extends ReadonlyArray<unknown>> {
  /** What names this machine: its key in the store, or, in memory, its spec. */
  readonly scope: string
  readonly stateOf: (moved: M) => S
  readonly outOf: (moved: M) => ReadonlyArray<Fx>
  readonly carry: (fx: Fx) => Job<Ev, R, By>
  readonly timers: (state: S) => ReadonlyArray<Due<Ev, By>>
  readonly open: Opening<Ev, R, By> | undefined
}

function reactor<I, S, Ev, M, Fx, Refused, Undecoded, By extends ReadonlyArray<unknown>, R>(
  tag: Context.Key<I, Steps<S, Ev, M, Refused, Undecoded, By>>,
  { scope, stateOf, outOf, carry, timers, open }: Parts<S, Ev, M, Fx, R, By>,
) {
  return Layer.effect(tag, effect {
    const inner = try tag
    const { durable } = try Durability
    const whole = try Whole
    const time = try Time
    const install = try Install
    const store = try KeyValueStore.KeyValueStore
    effect function epoch(): string!! {
      if (!durable) return install.launch
      const found = store.get(epochKey(scope)) catch () => undefined
      if (found !== undefined) return found
      const made = fresh()
      return effect { try store.set(epochKey(scope), made); return made } catch () => install.launch
    }
    const attempts = attemptsOf(install, `${scope}@${try epoch()}`)
    const running = try FiberMap.make<string>()
    const turn = try Semaphore.make(1)
    const armed = new Map<string, { readonly at: number; readonly signature: string; readonly token: number }>()
    let timerToken = 0

    function halt(key: string): void {
      const found = FiberMap.getUnsafe(running, key)
      if (Option.isSome(found)) found.value.interruptUnsafe()
    }
    effect function launch(key: string, work: void!!R): void!! {
      const provided = flatMap(whole.context, (context) => Effect.provideContext(Effect.provideService(work, Attempts, attempts), context as Context.Context<R>))
      try FiberMap.run(running, key, provided, { startImmediately: false })
    }
    effect function taken(event: Ev, by: By): boolean!! {
      return effect { try send(event, ...by); return true } catch () => false
    }
    effect function job(key: string, answers: Stream.Stream<Ev, never, R>, lost: Option.Option<Ev>, by: By, allowEmpty: boolean): void!!R {
      let refused = false
      let refusedEvent: unknown
      let delivered = 0
      const ended = try exit(Stream.runForEachWhile(answers, effect (event: Ev) => {
        if (try taken(event, by)) {
          delivered += 1
          return true
        }
        refused = true
        refusedEvent = event
        return false
      }))
      if (Exit.isFailure(ended)) {
        if (Cause.hasInterruptsOnly(ended.cause)) return
        try logError(`job ${key} died`, ended.cause)
      }
      if (Option.isNone(lost)) return
      const empty = Exit.isSuccess(ended) && !refused && delivered === 0 && !allowEmpty
      const notifyRefused = refused && !isUnticketedLost(refusedEvent, lost.value)
      if (notifyRefused || Exit.isFailure(ended) || empty) try contained(send(lost.value, ...by), `job ${key}, telling that it was lost,`)
    }
    effect function start(moved: M): void!! {
      for (const fx of outOf(moved)) {
        match (carry(fx)) {
          when { _tag: "Run", let key, let answers, let lost, let by, let allowEmpty }: try launch(key, job(key, answers, lost, by, allowEmpty));
          when { _tag: "Stop", let key }: halt(key);
        }
      }
    }
    effect function arm(state: S): void!! {
      const waiting = timers(state)
      const wanted = new Set(waiting.map((one) => `timer ${one.key}`))
      for (const key of [...armed.keys()]) {
        if (wanted.has(key)) continue
        armed.delete(key)
        halt(key)
      }
      for (const { key, at, event, by } of waiting) {
        const name = `timer ${key}`
        const signature = written([event, by])
        const current = armed.get(name)
        if (current !== undefined && current.at === at && current.signature === signature && Option.isSome(FiberMap.getUnsafe(running, name))) continue
        const token = ++timerToken
        armed.set(name, { at, signature, token })
        const clear = sync(() => {
          if (armed.get(name)?.token === token) armed.delete(name)
        })
        try launch(name, Effect.ensuring(effect {
          try time.until(at)
          try clear
          try contained(send(event, ...by), name)
        }, clear))
      }
    }
    effect function send(event: Ev, ...by: By): M!Refused {
      return try Semaphore.withPermit(turn, effect {
        uninterruptible {
          const moved = try inner.send(stamped(event, try time.now()), ...by)
          try start(moved)
          try arm(stateOf(moved))
          return moved
        }
      })
    }
    effect function receive(input: unknown, ...by: By): M!Undecoded {
      return try Semaphore.withPermit(turn, effect {
        uninterruptible {
          const moved = try inner.receive(stamped(input, try time.now()), ...by)
          try start(moved)
          try arm(stateOf(moved))
          return moved
        }
      })
    }
    if (open !== undefined) {
      if (Effect.isEffect(open)) try launch("open", effect {
        const opened = (try open) as unknown as readonly [Ev, ...By]
        try contained(send(...opened), `opening ${scope}`)
      })
      else try contained(send(...(open as unknown as readonly [Ev, ...By])), `opening ${scope}`)
    }
    try contained(Semaphore.withPermit(turn, effect { try arm(try inner.get()) }), `arming ${scope}`)
    return { changes: inner.changes, get: () => inner.get(), send, receive }
  })
}

/** One call to a machine's `send`, with its sender held at the type `spec` declared so literals in `open` never widen `By`. */
type OpeningArgs<Ev, By extends ReadonlyArray<unknown>> = NoInfer<By> extends readonly []
  ? readonly [event: Ev]
  : NoInfer<By> extends readonly [infer A]
    ? readonly [event: Ev, by: A]
    : never

/**
 * The event a machine is sent once when it is built, with its sender: the event itself, or, where the event carries
 * what only the world knows (what the phone kept, today's date), an effect that asks and returns it.
 */
export type Opening<Ev, R, By extends ReadonlyArray<unknown>> = OpeningArgs<Ev, By> | (OpeningArgs<Ev, By>!never!R)

/** A machine is kept only with the event that takes up what was under way when Alpha stopped: the spec's `reopen`, `restart` or `start`. */
type Kept<Ev, R, By extends ReadonlyArray<unknown>> =
  | { readonly keep: number; readonly open: Opening<Ev, R, By> }
  | { readonly keep?: undefined; readonly open?: Opening<Ev, R, By> }

/** What `reacting` takes beside the spec. */
export type Options<S, Ev, R, By extends ReadonlyArray<unknown>> = Kept<Ev, R, By> & {
  /** Name separate in-memory instances of the same model in their effect attempt identities. */
  readonly attemptScope?: string
  /** The deadlines `state` waits on. Each is told to the machine once its time has come, also after a restart. */
  readonly timers?: (state: S) => ReadonlyArray<Due<Ev, By>>
}

/** `carry`, for a machine whose transitions return `{ state, out }`, and nothing for one whose transitions return the state. */
type Carrying<M, Ev, R, By extends ReadonlyArray<unknown>> = M extends { readonly out: ReadonlyArray<infer Fx> }
  ? { readonly carry: (fx: Fx) => Job<Ev, R, By> }
  : { readonly carry?: undefined }

/** What a reacting machine needs to be built: the platform's part, and, in name only, what its jobs need when they run. */
type Needs<SR, R> = SR | KeyValueStore.KeyValueStore | Whole | Time | Install | Exclude<R, Attempts>

/**
 * The machine of the generated module `spec`, in memory or, with `keep`, in the store under the spec's own name.
 * Each event's `now` is Alpha's time, on `send` and on `receive`. Each item of `out` is carried out by `carry` once
 * the state that asked for it is kept, and each deadline of `timers` is told when its time has come. `open` is sent
 * once when the layer is built.
 */
export function reacting<I, S, Ev, M, Refused, Undecoded, By extends ReadonlyArray<unknown>, SE, SR, R = never, RO = never>(
  spec: Spec<I, S, Ev, M, Refused, Undecoded, By, SE, SR>,
  options: Options<S, Ev, RO, By> & Carrying<M, Ev, R, By>,
): Layer.Layer<I, never, Needs<SR, R | RO>> {
  const carry = options.carry as ((fx: unknown) => Job<Ev, R | RO, By>) | undefined
  const key = options.keep === undefined ? undefined : storeKey(spec.Machine.key, options.keep)
  const parts: Parts<S, Ev, M, unknown, R | RO, By> = {
    scope: key ?? (options.attemptScope === undefined ? spec.Machine.key : `${spec.Machine.key}/${options.attemptScope}`),
    stateOf: (moved) => (carry === undefined ? moved as unknown as S : (moved as unknown as Moved<S, unknown>).state),
    outOf: (moved) => (carry === undefined ? [] : (moved as unknown as Moved<S, unknown>).out),
    carry: carry ?? ((fx: unknown) => Job.Stop({ key: written(fx) })),
    timers: options.timers ?? (() => []),
    open: options.open,
  }
  const inner = key === undefined
    ? Layer.merge(spec.machine(), Layer.succeed(Durability, { durable: false }))
    : kept(key, spec.stored, spec.machine())
  return Layer.provide(reactor(spec.Machine, parts), inner) as unknown as Layer.Layer<I, never, Needs<SR, R | RO>>
}

/**
 * `work`, started once every machine of the runtime is built, with the services it names, and running until the
 * runtime closes. A layer that needs another machine is written with it, and never takes that machine while it is
 * built: machines are built side by side, in no order.
 */
export function started<R>(work: unknown!!R, what: string): Layer.Layer<never, never, R | Whole> {
  return Layer.effectDiscard(effect {
    const whole = try Whole
    try fork.scoped contained(flatMap(whole.context, (context) => Effect.provideContext(work, context as Context.Context<R>)), what)
  }) as unknown as Layer.Layer<never, never, R | Whole>
}

/**
 * Tell the machine `target` names each new fact it needs from the machine `source` names: `fact` reads it from each
 * state the source publishes, and `told` makes it the target's event, from `by`, or nothing for a fact the target has
 * no event for. Equal facts in a row are told once. A fact the target refuses is told again each time the target
 * changes, until it is taken or a newer one replaces it.
 */
export function following<IA, A, IB, Ev, Refused, By extends ReadonlyArray<unknown>, F>(
  source: Context.Key<IA, { readonly changes: Stream.Stream<A> }>,
  fact: (a: A) => F,
  target: Context.Key<IB, { readonly changes: Stream.Stream<unknown>; send(event: Ev, ...by: By): unknown!Refused }>,
  told: (fact: F) => Ev | undefined,
  ...by: By
): Layer.Layer<never, never, IA | IB | Whole> {
  return started(effect {
    const from = try source
    const to = try target
    let taken: string | undefined
    try Stream.runForEach(Stream.zipLatest(Stream.map(from.changes, fact), to.changes), effect ([value]) => {
      const text = written(value)
      if (text === taken) return
      const event = told(value)
      if (event === undefined || (try contained(to.send(event, ...by), "following"))) taken = text
    })
  }, "following")
}

/**
 * Tell the machine `target` names each thing a service says: `heard` is the service's stream (the page shown or
 * hidden, a plugin's events, the agent's feed), and `told` makes each item the target's event, from `by`, or nothing.
 * An event the rules refuse is dropped: what must not be lost is a fact of a machine, which `following` tells again.
 */
export function hearing<A, R, IB, Ev, Refused, By extends ReadonlyArray<unknown>>(
  heard: Stream.Stream<A, never, R>,
  target: Context.Key<IB, { send(event: Ev, ...by: By): unknown!Refused }>,
  told: (said: A) => Ev | undefined,
  ...by: By
): Layer.Layer<never, never, R | IB | Whole> {
  return started(effect {
    const to = try target
    try Stream.runForEach(heard, effect (said) => {
      const event = told(said)
      if (event !== undefined) try contained(to.send(event, ...by), "hearing")
    })
  }, "hearing")
}

/**
 * Do `apply` with each new fact of the machine `source` names, from its first state on: what the whole page follows,
 * such as its look or its text size, held from launch by a resident machine and applied through a service.
 */
export function applying<IA, A, F, R>(
  source: Context.Key<IA, { readonly changes: Stream.Stream<A> }>,
  fact: (a: A) => F,
  apply: (fact: F) => unknown!!R,
): Layer.Layer<never, never, IA | R | Whole> {
  return started(effect {
    const from = try source
    try Stream.runForEach(Stream.changesWith(Stream.map(from.changes, fact), (a, b) => written(a) === written(b)), (value) => contained(apply(value), "applying"))
  }, "applying")
}
