// spec/app/shell/index.md, "Phone and Messages exist only on an Alpha image, and Contacts only where that image admits it"; spec/app/platform/index.md, "Alpha hears it came back to the front once for each return, and a screen that has gone hears nothing more"; spec/app/platform/index.md, "Story: Reach the phone's native capabilities"; spec/app/platform/index.md, "Mocks, fixtures and developer surfaces exist only when the build allows test mocks"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { fixturesAllowed, news, reachable, variantOf } from "../../gen/app__platform.effect.vibe"
import { allowsTestMocks } from "./build.ts"

module web {
  import { Capacitor } from "@capacitor/core"
  import { plugin as capacitorPlugin } from "./capacitor.ts"

  /** Alpha's own Android plugin: Android's touch feedback and its accessibility timeout. */
  interface AlphaDevice {
    haptic(options: { kind: string }): Promise<void>
    recommendedTimeout(options: { baseMs: number }): Promise<{ timeoutMs: number }>
    setSystemBarAppearance(options: { dark: boolean }): Promise<void>
    setAgentGoogleConsent(options: { gmailChanges: boolean; calendarEdits: boolean }): Promise<void>
    diagnosticsFacts(): Promise<unknown>
    textAsk(): Promise<{ readonly ticket: number }>
    closeTextAsk(options: { readonly ticket: number }): Promise<{ readonly closed: boolean }>
    copyText(options: { text: string }): Promise<void>
    takeBillingReturn(): Promise<unknown>
    shareText(options: { readonly title: string; readonly text: string }): Promise<{ readonly status: string }>
  }
  /** @throws {never} */
  export function alpha(): AlphaDevice {
    return capacitorPlugin<AlphaDevice>("AlphaDevice")
  }

  /** Whether the phone's host registered `plugin` in this build. @throws {never} */
  export function registered(plugin: string): boolean {
    if (!Capacitor.isNativePlatform()) return false
    const headers = (globalThis as { Capacitor?: { PluginHeaders?: ReadonlyArray<{ readonly name: string }> } }).Capacitor?.PluginHeaders
    return headers !== undefined ? headers.some((one) => one.name === plugin) : Capacitor.isPluginAvailable(plugin)
  }
  /** Whether the page runs inside the phone's host. @throws {never} */
  export function native(): boolean {
    return Capacitor.isNativePlatform()
  }
  /** Text at `percent` of its size, published for CSS beside the measured scale, and the percent the page then has. @throws {never} */
  export function zoom(percent: number): number {
    document.documentElement.style.fontSize = `${percent}%`
    document.documentElement.style.setProperty("--alpha-own-text-scale", String(percent / 100))
    return Number.parseFloat(document.documentElement.style.fontSize)
  }
  /** @throws {never} */
  export function marked(name: string, value: string | undefined): void {
    if (value === undefined) document.documentElement.removeAttribute(`data-alpha-${name}`)
    else document.documentElement.setAttribute(`data-alpha-${name}`, value)
  }
  /** @throws {never} */
  export const page = (): EventTarget => window
  /** @throws {never} */
  export const pages = (): EventTarget => document
  /** @throws {never} */
  export const showing = (): boolean => document.visibilityState === "visible"
  /** Open exactly one chooser for the selected words. Cancel does not choose another destination. */
  export async function shareWords(title: string, text: string): Promise<boolean> {
    if (!showing() || !text.trim() || title.length > 200 || new TextEncoder().encode(text).length > 65536 || text.includes("\0")) return false
    if (native()) return registered("AlphaDevice") && (await alpha().shareText({ title, text })).status === "opened"
    if (!navigator.share) return false
    try { await navigator.share({ title, text }); return true }
    catch (error) { if (error instanceof DOMException && error.name === "AbortError") return true; throw error }
  }
  /** Copy the exact text after the owner's action. */
  export async function copyToBrowser(text: string): Promise<void> {
    await navigator.clipboard.writeText(text)
  }
}
import { alpha, copyToBrowser, marked, native, page, pages, registered, shareWords, showing, zoom } from web

/** A native signal stays subscribed for the lifetime of its consumer. */
export function pluginChanges(subscribe: (notify: () => void) => Promise<{ remove(): Promise<void> }>): Stream.Stream<void> {
  return Stream.callback<void>((queue) => Effect.asVoid(acquireRelease(
    Effect.option(tryPromise(() => subscribe(() => { Queue.offerUnsafe(queue, undefined) }))),
    (handle) => Option.isSome(handle) ? ignore(tryPromise(() => handle.value.remove())) : Effect.void,
  )))
}
export { native, registered }

const CheckoutReturn = Schema.Struct({ session: Schema.NullOr(Schema.String.check(Schema.isPattern(/^cs_[A-Za-z0-9_]{1,250}$/))) })

/** A browser return is a hint about a checkout Alpha already opened. */
export effect function takeBillingReturn(): (string | null)!! {
  if (!registered("AlphaDevice")) return null
  const raw = tryPromise(() => alpha().takeBillingReturn()) catch () => undefined
  const returned = Schema.decodeUnknownOption(CheckoutReturn)(raw)
  return Option.isSome(returned) ? returned.value.session : null
}

/** The host received a return while it already had an activity. */
export const billReturned = Stream.suspend(() => Stream.as(Stream.fromEventListener(page(), "alpha-billing-return"), true))


/** Whether a text chooser opened or the owner cancelled it without a handoff. */
export effect function shareSystemText(title: string, text: string): boolean!! {
  return tryPromise(() => shareWords(title, text)) catch () => false
}

/** Whether this build may load fixtures, the fake world and developer surfaces: only one made with `ELIZA_DEV_ALLOW_TEST_MOCKS=1`. */
export function testMocks(): boolean {
  return fixturesAllowed(allowsTestMocks())
}

/** What this phone admits: an Alpha image's apps, and Contacts where the image grants them. */
export interface Capabilities {
  readonly image: boolean
  readonly contacts: boolean
}

/** What the owner lets the agent change through Google, as eliza's agent launch names it. */
export interface GoogleConsent {
  readonly gmailChanges: boolean
  readonly calendarEdits: boolean
}

/** A hardware or gesture button the system hands to the launcher. */
export type Button = "back" | "home"

/** The sizes text may have, in percent of the page's own. */
const [smallest, largest] = [75, 150]

/** The phone itself: what it admits, the page's text size and marks, the Back and Home it hands to Alpha, and whether the page shows. */
export service Device {
  capabilities(): Capabilities!!
  /** The text size that is kept, in percent, or none where the owner never chose one. */
  textScale(): Option.Option<number>!!
  /**
   * Text at `percent` of its size, 75 to 150: the page's root size, which every `rem` follows, on a phone as in a
   * browser, kept so that the next launch opens with it. Whether the page has it now and it was kept.
   */
  setTextScale(percent: number): boolean!!
  /** `data-alpha-<name>` on the page's root element, for what the whole page follows, such as its look; `undefined` takes it off. */
  mark(name: string, value: string | undefined): void!!
  readonly buttons: Stream.Stream<Button>
  readonly textAskVisits: Stream.Stream<unknown>
  textAsk(): number!!
  closeTextAsk(ticket: number): boolean!!
  /** Each time the page is shown or hidden, and which: a page that was hidden may have slept. */
  readonly visible: Stream.Stream<boolean>
  /** Whether the page shows now. */
  showing(): boolean!!
  /** How much longer than asked Android shows what asks for action, in percent, where it says. */
  timeoutScale(): Option.Option<number>!!
  /** Android's touch feedback of `kind`, where the phone plays it; nothing elsewhere. */
  haptic(kind: string): void!!
  /** Whether the phone plays touch feedback. */
  feels(): boolean!!
  /** Android's status and navigation bars drawn for a dark look or a light one; nothing where there are none. */
  bars(dark: boolean): void!!
  /** What Alpha's Android host says about its build for a support report, untrusted; none off the phone or where it could not say. */
  buildFacts(): Option.Option<unknown>!!
  /** Whether the phone's host took the Google consent it launches the agent with from now on, restarting a running agent when it changed; it keeps what it had when it refuses. True where no agent is hosted. */
  agentConsent(consent: GoogleConsent): boolean!!
  /** Whether the owner's text was put on the system clipboard. */
  copyText(text: string): boolean!!
}

/**
 * The events Alpha's Android host dispatches on the page's window, since eliza's Android package hands a page neither
 * button: `alpha-back` for Back while the page says it can go back, in `data-alpha-can-go-back` on its root element,
 * and `launcher-home` for Home, and for Back where it cannot.
 */
const buttons: Stream.Stream<Button> = Stream.suspend(() => Stream.merge(
  Stream.as(Stream.fromEventListener(page(), "alpha-back"), "back" as const),
  Stream.as(Stream.fromEventListener(page(), "launcher-home"), "home" as const),
))

/**
 * Each time the page is shown or hidden, for as long as the one listening reads it: a word Android gives again
 * without a change is no news, and a listener that has gone is removed with it.
 */
function heard(): Stream.Stream<boolean> {
  return Stream.suspend(() => {
    let was = showing()
    return Stream.filter(Stream.map(Stream.fromEventListener(pages(), "visibilitychange"), () => showing()), (now) => {
      const told = news(was, now)
      was = now
      return told
    })
  })
}

const key = "alpha.textScale"

/** The page's part of the phone, the same on a phone and in a browser; the text size kept is applied before the first paint. */
effect function paged() {
  const store = try KeyValueStore.KeyValueStore
  effect function textScale(): Option.Option<number>!! {
    const kept = Number((store.get(key) catch () => undefined) ?? Number.NaN)
    return Number.isFinite(kept) && kept >= smallest && kept <= largest ? Option.some(kept) : Option.none()
  }
  const kept = try textScale()
  if (Option.isSome(kept)) zoom(kept.value)
  return {
    textScale,
    effect setTextScale(percent: number): boolean!! {
      const wanted = Math.min(largest, Math.max(smallest, Math.round(percent)))
      return effect { try store.set(key, String(wanted)); return zoom(wanted) === wanted } catch () => false
    },
    mark: (name: string, value: string | undefined) => sync(() => marked(name, value)),
    buttons,
    textAskVisits: Stream.suspend(() => Stream.merge(Stream.fromEventListener(page(), "alpha-text-ask"), Stream.fromEventListener(page(), "focus"))),
    visible: heard(),
    showing: () => sync(showing),
  }
}

/** The plugin of Alpha's own Android host for touch feedback and the accessibility timeout. */
const alphaDevice = "AlphaDevice"

/** Android's recommended timeout for a five-second base, as a percent of it. */
effect function scaleOf(): Option.Option<number>!! {
  if (!registered(alphaDevice)) return Option.none()
  const answer = tryPromise(() => alpha().recommendedTimeout({ baseMs: 5000 })) catch () => ({ timeoutMs: 0 })
  return Number.isFinite(answer.timeoutMs) && answer.timeoutMs > 0 ? Option.some(Math.round(answer.timeoutMs / 50)) : Option.none()
}

/** The plugins whose presence in this build is what the phone admits: eliza's telephony plugin, which a host registers only on an Alpha image, and its contacts plugin where that image grants contacts. */
const telephony = "ElizaTelephony"
const contacts = "ElizaContacts"

/** The phone: what it admits is which plugins its host registered, and an image's plugins only on an image. */
export const phoneDevice = Layer.effect(Device, effect {
  return {
    ...(try paged()),
    timeoutScale: scaleOf,
    haptic: (kind: string) => registered(alphaDevice) ? ignore(tryPromise(() => alpha().haptic({ kind }))) : Effect.void,
    feels: () => sync(() => registered(alphaDevice)),
    effect textAsk() {
      if (!registered(alphaDevice)) return 0
      const reply = timeout(tryPromise(() => alpha().textAsk()), "5 seconds") catch () => undefined
      const ticket = reply?.ticket ?? 0
      return Number.isSafeInteger(ticket) && ticket > 0 ? ticket : 0
    },
    effect closeTextAsk(ticket: number) {
      if (!registered(alphaDevice)) return false
      const reply = timeout(tryPromise(() => alpha().closeTextAsk({ ticket })), "5 seconds") catch () => undefined
      return reply?.closed === true
    },
    bars: (dark: boolean) => registered(alphaDevice) ? ignore(tryPromise(() => alpha().setSystemBarAppearance({ dark }))) : Effect.void,
    buildFacts: () => registered(alphaDevice) ? Effect.option(tryPromise(() => alpha().diagnosticsFacts())) : succeed(Option.none<unknown>()),
    agentConsent: (consent: GoogleConsent) => registered(alphaDevice) ? Effect.map(Effect.option(tryPromise(() => alpha().setAgentGoogleConsent(consent))), Option.isSome) : succeed(true),
    copyText: (text: string) => registered(alphaDevice) ? Effect.map(Effect.option(tryPromise(() => alpha().copyText({ text }))), Option.isSome) : succeed(false),
    effect capabilities() {
      const variant = variantOf(native(), registered(telephony))
      return { image: variant === "Image", contacts: reachable("ImageOnly", variant) && registered(contacts) }
    },
  }
})

/** A browser: no Alpha image. */
export const browserDevice = Layer.effect(Device, effect {
  return {
    ...(try paged()),
    effect capabilities() { return { image: false, contacts: false } },
    timeoutScale: () => succeed(Option.none<number>()),
    haptic: () => Effect.void,
    feels: () => succeed(false),
    textAsk: () => succeed(0),
    closeTextAsk: () => succeed(false),
    bars: () => Effect.void,
    buildFacts: () => succeed(Option.none<unknown>()),
    agentConsent: () => succeed(true),
    copyText: (text: string) => Effect.map(Effect.option(tryPromise(() => copyToBrowser(text))), Option.isSome),
  }
})
