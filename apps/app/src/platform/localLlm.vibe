// spec/app/account/provider.md, "Story: See where my requests go"; spec/app/platform/index.md, "Story: Reach the phone's native capabilities"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { Agent } from "./agent.vibe"
import { subscribePluginListener } from "./capacitor.ts"
import { registered } from "./device.vibe"

/** Shared preference key selecting the active AI execution mode across AlphaCore and all thin apps. */
export const AI_MODE_KEY = "alpha.aiMode"

/** Shared preference key naming the preferred on-device GGUF model id. */
export const LOCAL_MODEL_KEY = "alpha.localModel"

/** Default recommended on-device model id for Pixel 10a and 8 GB class Android phones. */
export const DEFAULT_LOCAL_MODEL_ID = "gemma-4-e2b-it-q4"

/** Active AI backend mode persisted in `AlphaPreferences`. */
export type AiMode = "local" | "cloud" | "own-key"

/** Memory fit classification for an on-device GGUF model relative to device RAM. */
export type LocalModelFit = "fits" | "tight" | "insufficient"

/** Catalog entry describing one on-device GGUF model. */
export interface LocalLlmModel {
  readonly id: string
  readonly name: string
  readonly family: string
  readonly quantization: string
  readonly license: string
  readonly sizeBytes: number
  readonly minRamMb: number
  readonly recommended: boolean
  readonly role: "chat" | "embedding"
  readonly summary: string
  readonly downloaded: boolean
  readonly active: boolean
  readonly installPhase: "absent" | "downloading" | "verifying" | "installed" | "partial" | "failed" | "cancelled"
  readonly fit: LocalModelFit
  readonly fitReason?: string
  readonly downloadProgress?: number
  readonly lastError?: string
}

/** Snapshot of the device's on-device LLM runtime state. */
export interface LocalLlmStatus {
  readonly mode: AiMode
  readonly activeModelId: string
  readonly loaded: boolean
  readonly downloadingModelId?: string
  readonly downloadProgress?: number
  readonly nativeAvailable: boolean
  readonly totalRamMb: number
  readonly freeDiskMb: number
  readonly metered: boolean
}

/** Combined catalog and runtime status returned to Settings and Provider views. */
export interface LocalLlmCatalogSnapshot {
  readonly status: LocalLlmStatus
  readonly models: ReadonlyArray<LocalLlmModel>
}

/** Outcome of requesting a resumable on-device model download. */
export interface LocalLlmDownloadResult {
  readonly ok: boolean
  readonly meteredRequired: boolean
  readonly error?: string
}

/** Progress payload emitted by `AlphaLocalLlm` during a resumable model download. */
export interface LocalLlmDownloadProgress {
  readonly modelId: string
  readonly downloadedBytes: number
  readonly totalBytes: number
  readonly percent: number
  readonly phase: "downloading" | "verifying" | "installed" | "failed" | "cancelled"
  readonly error?: string
}

/** Pinned Apache-2.0 and MIT on-device model catalog matching `AlphaLocalLlmCatalog.java`. */
