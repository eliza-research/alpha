// spec/app/voice/index.md, "Story: Hold a spoken conversation"; spec/app/voice/index.md, "The speech pipeline warms on startup, foreground return and account readiness without opening the microphone"; spec/app/voice/index.md, "Starting asks for the microphone the first time, opens it once it is allowed, and holds the speech engine while talking"
import { parseVoiceTranscriptEnvelope } from "@elizaos/agent"
import { type CloudStreamPort, type CloudStreamingSpeech, createCloudStreamingSpeech, type CredentialId, type EnvironmentName } from "@elizaos/os-bridges"
import { fresh } from "../runtime/index.vibe"
import { Agent } from "./agent.vibe"
import { registered } from "./device.vibe"
import { pageMicrophone, pageSpeechBase, pageSpeechRelay } from "./pageSpeech.ts"
import { TurnGap } from "./turnGap.ts"

export type VoiceGrant = "granted" | "denied" | "prompt" | "unknown"

export type VoiceFault = "Brief" | "AccountRefused" | "RateLimited" | "SignInNeeded" | "NotTheNetwork"

export type VoiceEvent =
  | { readonly kind: "speechStart"; readonly session: number }
  | { readonly kind: "speechEnd"; readonly session: number; readonly text: string }
  | { readonly kind: "bargeIn"; readonly session: number; readonly echo: boolean }
  | { readonly kind: "ended"; readonly session: number; readonly reason: string; readonly fault?: VoiceFault; readonly waitMs?: number; readonly cause?: unknown }
  | { readonly kind: "recordingStopped"; readonly ticket: number; readonly recorded: boolean }

export type ReadingEvent = { readonly kind: "ready" | "ended"; readonly ok: boolean }

export interface SpeechStatus {
  readonly ready: boolean
  readonly ttsReady: boolean
  readonly liveCapture: boolean
}

export interface RecordedClip {
  readonly recordingId: string
}

/** Who the phone's sign-in says holds its Cloud key: an account, by the id of its key, no one, or unknown where it could not be read. */
export type CloudSignIn =
  | { readonly kind: "signedIn"; readonly credential: string }
  | { readonly kind: "signedOut" }
  | { readonly kind: "unknown" }

interface LiveCapture {
  readonly session: number
  readonly captureId: string
  readonly preview: VoicePreview | undefined
  stopPreview: (() => void) | undefined
  phase: "Opening" | "Listening" | "Cancelling" | "Retired"
  requested: boolean
  openingStop: Promise<{ captureId: string; serverClosed: boolean }> | undefined
  echoCancelled: boolean
}

interface DictationClip extends RecordedClip {
  readonly started: number
  state: "recording" | "recorded" | "failed"
  durationMs?: number
}

const recordedClip = Schema.Struct({
  recordingId: Schema.NonEmptyString, status: Schema.Literal("recorded"),
  durationMs: Schema.Int.check(Schema.makeFilter((duration) => duration >= 0)),
})
const recordingStop = Schema.Union([
  recordedClip,
  Schema.Struct({ recordingId: Schema.NonEmptyString, status: Schema.Literal("failed") }),
])
type RecordingStop = typeof recordingStop.Type

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { BrowserReadingBinding, ElizaCloudSpeechPlugin } from "@elizaos/os-bridges"
  import { type SignInClient, signInClient } from "@elizaos/os-bridges"

  export interface ListenerHandle { remove(): Promise<void> }
  export type NativePageSpeech = Extract<BrowserReadingBinding, { execution: "device" }> & { readonly readingToken: string }

  /** One time window of a retained Notes recording. */
  export type SavedNoteWindow = { readonly recordingId: string; readonly noteId: string; readonly offsetMs: number; readonly durationMs: number }

  export interface LocalVoicePlugin {
    checkPermissions(): Promise<{ microphone?: string }>
    requestPermissions(): Promise<{ microphone?: string }>
    warmSpeechOutput(options: Record<string, never>): Promise<unknown>
    localSpeechStatus(options: { requestId: string; ttsOnly?: boolean }): Promise<{ ready?: boolean; ttsReady?: boolean }>
    holdSpeechEngine(options: Record<string, never>): Promise<{ held?: boolean }>
    releaseSpeechEngineHold(options: Record<string, never>): Promise<unknown>
    liveCaptureStatus(options: Record<string, never>): Promise<{ available?: boolean; nativeTransport?: boolean }>
    startLiveCapture(options: { captureId: string; nativeAsr: boolean; echoCancel: boolean; bargeIn: boolean; reopen: boolean }): Promise<{ captureId: string; nativeAsr: boolean; echoCancelled: boolean }>
    stopLiveCapture(options: { captureId: string; discard: boolean }): Promise<{ captureId: string; serverClosed: boolean }>
    synthesizeLocal(options: { requestId: string; text: string; append?: boolean; replace?: boolean }): Promise<{ playbackId?: string }>
    synthesizeLocalBrowserReading(options: NativePageSpeech & { readonly requestId: string; readonly replace: false }): Promise<{ playbackId?: string; execution?: string }>
    play(options: { playbackId: string; replace?: boolean }): Promise<unknown>
    setSpeechOutputMuted(options: { muted: boolean }): Promise<void>
    stopPlayback(options: { requestId?: string }): Promise<unknown>
    cancel(options: { requestId: string }): Promise<unknown>
    startRecording(options: Record<string, never>): Promise<{ recordingId?: string }>
    stopRecording(options: Record<string, never>): Promise<unknown>
    dictationForeground(options: Record<string, never>): Promise<{ available?: boolean }>
    cancelRecording(options: Record<string, never>): Promise<unknown>
    transcribeLocalRecording(options: { requestId: string; recordingId: string; automatic: boolean }): Promise<{ text?: string }>
    transcribeSavedNote(options: SavedNoteWindow & { readonly requestId: string }): Promise<unknown>
    transcribeVoicemail(options: { requestId: string; id: string }): Promise<unknown>
    cancelVoicemailTranscription(options: { requestId: string }): Promise<void>
    addListener(event: string, listener: (data: unknown) => void): Promise<ListenerHandle>
  }

  let made: LocalVoicePlugin | undefined
  /** @throws {never} */
  export function localPlugin(): LocalVoicePlugin {
    return (made ??= registerPlugin<LocalVoicePlugin>("AlphaVoiceCloud"))
  }

  /** Cancel and retire the same native request if its caller stops waiting. */
  export async function readSavedNote(input: SavedNoteWindow, requestId: string, signal: AbortSignal): Promise<unknown> {
    signal.throwIfAborted()
    const plugin = localPlugin()
    const cancel = () => { void plugin.cancel({ requestId }).catch(() => undefined) }
    signal.addEventListener("abort", cancel, { once: true })
    try {
      const result = await plugin.transcribeSavedNote({ ...input, requestId })
      signal.throwIfAborted()
      return result
    } finally {
      signal.removeEventListener("abort", cancel)
    }
  }

  export async function readVoicemail(id: string, requestId: string, signal: AbortSignal): Promise<string> {
    if (signal.aborted) return ""
    const plugin = localPlugin()
    const cancel = () => { void plugin.cancelVoicemailTranscription({ requestId }).catch(() => {}) }
    signal.addEventListener("abort", cancel, { once: true })
    try {
      const reply = await plugin.transcribeVoicemail({ id, requestId })
      return !signal.aborted && typeof reply === "object" && reply !== null && "text" in reply
        && typeof reply.text === "string" && reply.text.length <= 8_000 ? reply.text : ""
    } finally {
      signal.removeEventListener("abort", cancel)
    }
  }

  /** eliza's Cloud speech relay with the methods its TypeScript definition does not list yet: the warm-up and the timing records. */
  export interface CloudRelay extends ElizaCloudSpeechPlugin {
    prewarmCloudSpeech(options: { environment: string }): Promise<unknown>
    cloudStreamTiming(options: Record<string, never>): Promise<unknown>
  }

  let relay: CloudRelay | undefined
  /** @throws {never} */
  export function relayPlugin(): CloudRelay {
    return (relay ??= registerPlugin<CloudRelay>("ElizaCloudSpeech"))
  }

  let signIn: SignInClient | undefined
  /** eliza's client of the phone's sign-in, made once. @throws {never} */
  export function signInAccounts(): SignInClient {
    return (signIn ??= signInClient())
  }

  /** @throws {never} */
  export function makeAbort(): AbortController {
    return new AbortController()
  }

  /** @throws {never} */
  export function makeSessionGuard(current: () => number, expected: number): () => void {
    return () => {
      if (current() !== expected) throw new Error("session-changed")
    }
  }
}
import { type NativePageSpeech, type SavedNoteWindow, localPlugin, makeAbort, makeSessionGuard, readSavedNote, readVoicemail, relayPlugin, signInAccounts } from capacitor
export { type NativePageSpeech, type SavedNoteWindow, readSavedNote, signInAccounts }

export error VoiceBridgeFailed { method: string; cause: unknown }
/** Recognition ran on the confirmed clip, stayed in custody, or could not start. */
export type DictationAnswer =
  | { readonly kind: "recognized"; readonly text: string; readonly durationMs: number | undefined }
  | { readonly kind: "obscured" | "failed"; readonly durationMs: number | undefined }
  | { readonly kind: "lost" }

/** A preview outlet owned by one admitted microphone capture. */
export interface VoicePreview {
  readonly retired: AbortSignal
  show(text: string): void
  clear(): void
  retire(): void
}

export service VoiceBridge {
  available(): boolean!!
  checkPermission(): VoiceGrant!!
  requestPermission(): VoiceGrant!!
  /** Warm speech only: on-device output and status, and the Cloud speech relay on the network route. The agent's model is warmed by Ask Alpha's warm-up alone (spec/app/assistant/index.md). */
  prewarm(network: boolean): void!!
  streamTimings(): unknown!!
  probeStatus(ttsOnly: boolean): SpeechStatus!!
  invalidateCache(): void!!
  /** Forget the Cloud key read for the account before, and the relay session made under it while none runs. */
  forgetAccount(): void!!
  holdEngine(): boolean!!
  releaseEngineHold(): void!!
  openMic(session: number, network: boolean, preview?: VoicePreview): boolean!VoiceBridgeFailed!Agent
  closeMic(session: number): void!VoiceBridgeFailed
  awaitSpeechOutputWarmup(session: number): void!!
  playSentence(session: number, turn: number, text: string, append: boolean): void!VoiceBridgeFailed
  /** Speak a turn's acknowledgment in place of anything playing, running `started` at its first audible playback (never at synthesis); settles once it has played, failed or was hushed. */
  playCue(session: number, turn: number, text: string, started: () => void): void!VoiceBridgeFailed
  setSpeakerMuted(session: number, muted: boolean): boolean!!
  hush(turn: number): void!!
  canRead(): boolean!!
  readAloud(ticket: number, text: string | NativePageSpeech, stillCurrent?: () => boolean!!): Stream.Stream<ReadingEvent>
  silenceReading(ticket: number): boolean!!
  /** Stop the microphone and Alpha's speech, answering whether both are confirmed off; what is not stays kept for `release`. */
  shut(session: number): boolean!!
  /** Ask again to stop what a shut could not confirm off, answering whether nothing is left unconfirmed. */
  release(): boolean!!
  readonly events: Stream.Stream<VoiceEvent>
  account(): CloudSignIn!!
  /** Each sign-in on the phone that settles on an account. */
  readonly signIns: Stream.Stream<void>
  startRecording(ticket: number): RecordedClip!VoiceBridgeFailed
  dictationForeground(): boolean!!
  transcribe(ticket: number, network: boolean, automatic: boolean): DictationAnswer!!
  /** Cancel the recording, optionally after rechecking which recorder still owns it, and report native confirmation. */
  abandon(ticket: number, isCurrent?: () => boolean!!): boolean!!
}

const LOCAL_PLUGIN = "AlphaVoiceCloud"

/** The installed phone can read text aloud through its on-device speech bridge. */
export function nativeReadingAvailable(): boolean {
  return registered(LOCAL_PLUGIN)
}

/** The installed phone has Alpha's on-device speech bridge. */
export const recognizesVoicemail = nativeReadingAvailable

/** The selected provider row is decoded and recognized on the phone, without sending it audio. */
export effect function transcribeVoicemail(id: string): string!VoiceBridgeFailed {
  const requestId = `voicemail-${fresh()}`
  return try tryPromise({
    try: (signal) => readVoicemail(id, requestId, signal),
    catch: (cause) => new VoiceBridgeFailed({ method: "transcribeVoicemail", cause }),
  })
}
const CLOUD_STREAM_PLUGIN = "ElizaCloudSpeech"
const SIGN_IN_PLUGIN = "ElizaSignIn"
/** The cloud the phone signs in to, whose account the relay speaks for. */
export const CLOUD_ENVIRONMENT = "production" as EnvironmentName
/** The key a page names to its own Cloud, whose server holds the account's real key: the page never holds one. */
const PAGE_CREDENTIAL = "page" as CredentialId
/** How long a background call to the relay, a warm-up or its timing records, may run before it is dropped. */
const RELAY_WARMUP_BOUND = "5 seconds"
const LOCAL_OUTPUT_WARMUP_BOUND = "10 seconds"

function parseGrant(raw: string | undefined): VoiceGrant {
  return raw === "granted" ? "granted" : raw === "denied" ? "denied" : "prompt"
}

/** The local speech plug-in's microphone state, with no assumed grant when it cannot answer. */
export effect function microphoneAccess(request: boolean): (string | undefined)!! {
  if (!registered(LOCAL_PLUGIN)) return undefined
  const read = try Effect.option(tryPromise(() => request ? localPlugin().requestPermissions() : localPlugin().checkPermissions()))
  return Option.getOrUndefined(read)?.microphone
}

function asRecord(value: unknown): Record<string, unknown> | undefined {
  return typeof value === "object" && value !== null ? (value as Record<string, unknown>) : undefined
}

/** Whether the native speech request says a call owns the audio path. */
export function interruptedByCall(cause: unknown): boolean {
  const data = asRecord(cause)
  return data?.code === "call-active" || data?.reason === "call-active"
}

const fundsCodes = new Set(["insufficient_credits", "allowance_exhausted", "out_of_funds", "credit_exhausted"])

/** Whether a Cloud speech startup or stream failure is a credit/allowance refusal from Cloud. */
export function refusedForFunds(cause: unknown, depth = 0): boolean {
  if (depth > 4 || cause === undefined || cause === null) return false
  if (typeof cause === "string") {
    const lower = cause.toLowerCase()
    return lower.includes("insufficient_credits") || lower.includes("allowance_exhausted") || lower.includes("out_of_funds") || lower.includes("credit_exhausted")
  }
  const data = asRecord(cause)
  if (data === undefined) return false
  if (data.status === 402) return true
  for (const field of ["code", "cloudCode", "reason", "error"] as const) {
    const value = data[field]
    if (typeof value === "string" && fundsCodes.has(value.toLowerCase())) return true
  }
  if (typeof data.message === "string" && refusedForFunds(data.message, depth + 1)) return true
  return refusedForFunds(data.data, depth + 1) || refusedForFunds(data.cause, depth + 1)
}

function asString(value: unknown): string {
  return typeof value === "string" ? value : ""
}

/** Classify a speech bridge error into a route fault and optional wait in milliseconds. */
export function classifyVoiceFault(cause: unknown, network: boolean): { readonly fault: VoiceFault; readonly waitMs: number } {
  const inner = cause instanceof VoiceBridgeFailed ? cause.cause : cause
  const record = asRecord(inner)
  const status = typeof record?.status === "number" ? record.status : undefined
  const code = asString(record?.code).toLowerCase()
  const message = (inner instanceof Error ? inner.message : typeof inner === "string" ? inner : asString(record?.message)).toLowerCase()
  const detail = `${code} ${message}`
  const rawWaitMs = typeof record?.retryAfterMs === "number" && Number.isFinite(record.retryAfterMs)
    ? Math.max(0, Math.round(record.retryAfterMs))
    : typeof record?.retryAfter === "number" && Number.isFinite(record.retryAfter)
      ? Math.max(0, Math.round(record.retryAfter * 1000))
      : 0
  if (detail.includes("session-changed") || detail.includes("already active") || detail.includes("cancel") || detail.includes("abort")
    || detail.includes("no-voice-plugin") || detail.includes("resident-speech") || detail.includes("not-closed")) {
    return { fault: "NotTheNetwork", waitMs: 0 }
  }
  if (!network) return { fault: "NotTheNetwork", waitMs: 0 }
  if (status === 401 || code === "signed-out" || detail.includes("signed-out") || detail.includes("unauthorized") || detail.includes("sign_in") || detail.includes("sign-in")) {
    return { fault: "SignInNeeded", waitMs: 0 }
  }
  if (status === 429 || /rate.?limit|too.?many|429/.test(detail)) {
    return { fault: "RateLimited", waitMs: rawWaitMs }
  }
  if (status === 402 || status === 403 || /account|forbidden|allowance|credit|billing|credential|refused/.test(detail)) {
    return { fault: "AccountRefused", waitMs: 0 }
  }
  if ((status !== undefined && status >= 500) || /network|timeout|timed.?out|offline|disconnect|socket|connection|transport|502|503|504|transient|brief/.test(detail)) {
    return { fault: "Brief", waitMs: 0 }
  }
  return { fault: "Brief", waitMs: 0 }
}

function captureEvent(raw: unknown, capture: LiveCapture | undefined): { data: Record<string, unknown>; live: LiveCapture } | undefined {
  const data = asRecord(raw)
  if (capture === undefined || capture.phase !== "Listening" || data === undefined || data.captureId !== capture.captureId) return undefined
  return { data, live: capture }
}

function retireNativePreview(capture: LiveCapture): void {
  const stop = capture.stopPreview
  capture.stopPreview = undefined
  stop?.()
  capture.preview?.retire()
}

effect function hearNativePreview(capture: LiveCapture, current: () => boolean, lifetime: Scope.Scope): void!!Agent {
  const preview = capture.preview
  if (preview === undefined) return
  const heard = (try Agent).feed("voice")
  let turn: { readonly id: string; sequence: number; open: boolean } | undefined
  const listen = Stream.runForEach(heard, (event) => sync(() => {
    if (!current()) return
    const words = parseVoiceTranscriptEnvelope({ type: "event", event }, capture.captureId)
    if (words === undefined) return
    if (words.kind === "speechStart") {
      if (turn?.id !== words.turnId) {
        preview.clear()
        turn = { id: words.turnId, sequence: 0, open: true }
      }
      return
    }
    if (turn === undefined) turn = { id: words.turnId, sequence: 0, open: words.kind === "partial" }
    if (turn.id !== words.turnId || !turn.open) return
    if (words.kind !== "partial") {
      turn.open = false
      preview.clear()
      return
    }
    if (capture.phase !== "Listening" || words.seq <= turn.sequence) return
    turn.sequence = words.seq
    preview.show(words.text)
  }))
  const retired = Effect.callback<void>((resume) => {
    const stop = () => resume(Effect.void)
    if (preview.retired.aborted) { stop(); return }
    preview.retired.addEventListener("abort", stop, { once: true })
    return sync(() => preview.retired.removeEventListener("abort", stop))
  })
  const owned = Effect.raceFirst(Effect.ignore(listen), retired)
  uninterruptible {
    const fiber = try Effect.forkIn(Effect.ensuring(owned, sync(() => preview.retire())), lifetime, { uninterruptible: false })
    capture.stopPreview = () => { fiber.interruptUnsafe() }
  }
}

function makeNativeEvents(
  subscribers: Set<(event: VoiceEvent) => void>,
  currentCapture: () => LiveCapture | undefined,
  stoppedRecording: (stopped: RecordingStop) => void,
): Stream.Stream<VoiceEvent> {
  return Stream.callback<VoiceEvent>((queue) => effect {
    const forward = (event: VoiceEvent) => { Queue.offerUnsafe(queue, event) }
    const handles: Array<{ remove(): Promise<void> }> = []
    uninterruptible {
      subscribers.add(forward)
      try addFinalizer(() => effect {
        subscribers.delete(forward)
        for (const one of handles) try ignore(tryPromise(() => one.remove()))
      })
      if (registered(LOCAL_PLUGIN)) {
        const plugin = localPlugin()
        const register = (name: string, map: (data: Record<string, unknown>, live: LiveCapture) => ReadonlyArray<VoiceEvent>) =>
          Effect.orElseSucceed(
            tryPromise(() => plugin.addListener(name, (raw) => {
              const event = captureEvent(raw, currentCapture())
              if (event !== undefined) for (const item of map(event.data, event.live)) forward(item)
            })),
            () => undefined,
          )
        const attached = try Effect.all([
          Effect.orElseSucceed(tryPromise(() => plugin.addListener("recordingStopped", (raw) => {
            const stopped = Schema.decodeUnknownOption(recordingStop)(raw)
            if (Option.isSome(stopped)) stoppedRecording(stopped.value)
          })), () => undefined),
          register("liveCaptureTranscript", (data, live) => {
            const { session } = live
            const failure = asString(data.error)
            if (failure !== "") {
              retireNativePreview(live)
              return [{ kind: "ended", session, reason: failure, fault: "NotTheNetwork", waitMs: 0 }]
            }
            const text = asString(asRecord(data.final)?.text).trim()
            if (text === "") {
              live.preview?.clear()
              return []
            }
            retireNativePreview(live)
            return [{ kind: "speechStart", session }, { kind: "speechEnd", session, text }]
          }),
          register("liveCaptureBargeIn", (_data, { session, echoCancelled }) => {
            return [{ kind: "bargeIn", session, echo: !echoCancelled }]
          }),
          register("liveCaptureEnded", (data, live) => {
            retireNativePreview(live)
            const reason = asString(data.error) || "ended"
            return [{ kind: "ended", session: live.session, reason, ...(reason === "ended" ? {} : { fault: "NotTheNetwork" as const, waitMs: 0 }) }]
          }),
        ], { concurrency: "unbounded" })
        for (const one of attached) if (one !== undefined) handles.push(one)
      }
    }
  })
}

/** The id of the key the phone's sign-in holds for the cloud now: the relay speaks only for that key, and refuses any other. */
effect function signedInKey(accounts: ReturnType<typeof signInAccounts>): CredentialId!VoiceBridgeFailed {
  const status = try tryPromise({
    try: () => accounts.status({ environment: CLOUD_ENVIRONMENT }),
    catch: (cause) => new VoiceBridgeFailed({ method: "status", cause }),
  })
  if (status.account.kind !== "signedIn") throw new VoiceBridgeFailed({ method: "status", cause: "signed-out" })
  return status.account.credentialId
}

/** Who the phone's sign-in says holds its Cloud key now, or unknown where there is no sign-in to ask or it did not answer in time. */
function signedInAccount(): CloudSignIn!! {
  return registered(SIGN_IN_PLUGIN)
    ? Effect.orElseSucceed(
      Effect.map(timeout(tryPromise(() => signInAccounts().status({ environment: CLOUD_ENVIRONMENT })), RELAY_WARMUP_BOUND), (status): CloudSignIn =>
        status.account.kind === "signedIn" ? { kind: "signedIn", credential: status.account.credentialId } : { kind: "signedOut" }),
      (): CloudSignIn => ({ kind: "unknown" }))
    : succeed<CloudSignIn>({ kind: "unknown" })
}

/** Each sign-in the phone settles on an account, as eliza's sign-in client hears it. */
function settledSignIns(): Stream.Stream<void> {
  return Stream.callback<void>((queue) => effect {
    if (!registered(SIGN_IN_PLUGIN)) return
    uninterruptible {
      const handle = try Effect.orElseSucceed(tryPromise(() => signInAccounts().addListener("signInSettled", (receipt) => {
        if (receipt.verdict.kind === "SignedInAs") Queue.offerUnsafe(queue, undefined)
      })), () => undefined)
      try addFinalizer(() => handle === undefined ? Effect.void : ignore(tryPromise(() => handle.remove())))
    }
  })
}

/** Coalesced, interruption-safe local speech status prober separating full ASR probes from TTS-only probes. */
function phoneSpeechStatus() {
  let cachedStatus: SpeechStatus | undefined
  let fullStatusFlight: Deferred.Deferred<SpeechStatus | undefined> | undefined
  let ttsStatusFlight: Deferred.Deferred<SpeechStatus | undefined> | undefined

  effect function probeStatus(ttsOnly: boolean): SpeechStatus!! {
    for (;;) {
      if (cachedStatus !== undefined && (!ttsOnly ? cachedStatus.ready : cachedStatus.ttsReady || cachedStatus.ready)) {
        return cachedStatus
      }
      const existing = ttsOnly ? (fullStatusFlight ?? ttsStatusFlight) : fullStatusFlight
      if (existing !== undefined) {
        const awaited = try Deferred.await(existing)
        if (awaited !== undefined) return awaited
        continue
      }
      const absent: SpeechStatus = { ready: false, ttsReady: false, liveCapture: false }
      if (!registered(LOCAL_PLUGIN)) {
        cachedStatus = absent
        return absent
      }
      const flight = try Deferred.make<SpeechStatus | undefined>()
      if (ttsOnly) ttsStatusFlight = flight
      else fullStatusFlight = flight
      let settled: SpeechStatus | undefined
      return try ensuring(effect {
        const plugin = localPlugin()
        const [localResult, liveResult] = try Effect.all([
          Effect.orElseSucceed(tryPromise(() => plugin.localSpeechStatus({ requestId: fresh(), ttsOnly })), () => ({ ready: false, ttsReady: false })),
          Effect.orElseSucceed(tryPromise(() => plugin.liveCaptureStatus({})), () => ({ available: false, nativeTransport: false })),
        ], { concurrency: "unbounded" })
        const status: SpeechStatus = {
          ready: !ttsOnly && localResult.ready === true,
          ttsReady: localResult.ttsReady === true || localResult.ready === true,
          liveCapture: liveResult.available === true && liveResult.nativeTransport === true,
        }
        settled = status
        if (!ttsOnly || cachedStatus === undefined || !cachedStatus.ready) cachedStatus = status
        return status
      }, effect {
        if (ttsOnly) { if (ttsStatusFlight === flight) ttsStatusFlight = undefined }
        else if (fullStatusFlight === flight) fullStatusFlight = undefined
        try Deferred.succeed(flight, settled)
      })
    }
  }

  effect function awaitWarmup(current: () => boolean): void!! {
    const warming = ttsStatusFlight ?? fullStatusFlight
    if (warming !== undefined && current()) {
      try ignore(timeout(Deferred.await(warming), LOCAL_OUTPUT_WARMUP_BOUND))
    }
  }

  const warmDevice = () => registered(LOCAL_PLUGIN)
    ? Effect.all([
      ignore(tryPromise(() => localPlugin().warmSpeechOutput({}))),
      Effect.asVoid(probeStatus(true)),
    ], { concurrency: "unbounded" })
    : Effect.void
  const invalidateStatus = () => { cachedStatus = undefined }
  return { probeStatus, warmDevice, invalidateStatus, awaitWarmup }
}

type PhoneDictation = Pick<VoiceBridge.Shape, "startRecording" | "dictationForeground" | "transcribe" | "abandon"> & {
  readonly stoppedRecording: (stopped: RecordingStop) => void
}

effect function phoneDictation(publish: (event: VoiceEvent) => void): PhoneDictation!! {
  const recordingLock = try Semaphore.make(1)
  let recording: DictationClip | undefined
  let openingRecording: Map<string, RecordingStop> | undefined
  let retiredRecording = 0

  function stoppedRecording(stopped: RecordingStop): void {
    const clip = recording
    if (clip?.recordingId !== stopped.recordingId) {
      if (openingRecording !== undefined && !openingRecording.has(stopped.recordingId)) openingRecording.set(stopped.recordingId, stopped)
      return
    }
    if (clip.started <= retiredRecording || clip.state !== "recording") return
    clip.state = stopped.status
    if (stopped.status === "recorded") clip.durationMs = stopped.durationMs
    publish({ kind: "recordingStopped", ticket: clip.started, recorded: stopped.status === "recorded" })
  }

  return {
    stoppedRecording,
    effect startRecording(ticket: number): RecordedClip!VoiceBridgeFailed {
      if (!registered(LOCAL_PLUGIN)) throw new VoiceBridgeFailed({ method: "startRecording", cause: "no-voice-plugin" })
      return try recordingLock.withPermits(1)(Effect.uninterruptible(effect {
        if (ticket <= retiredRecording) throw new VoiceBridgeFailed({ method: "startRecording", cause: "recording-retired" })
        const opening = new Map<string, RecordingStop>()
        openingRecording = opening
        return try ensuring(effect {
          const started = try tryPromise({
            try: () => localPlugin().startRecording({}),
            catch: (cause) => new VoiceBridgeFailed({ method: "startRecording", cause }),
          })
          if (ticket <= retiredRecording || typeof started.recordingId !== "string" || started.recordingId === "") {
            try ignore(tryPromise(() => localPlugin().cancelRecording({})))
            throw new VoiceBridgeFailed({ method: "startRecording", cause: "no-active-recording" })
          }
          const clip: DictationClip = { recordingId: started.recordingId, started: ticket, state: "recording" }
          recording = clip
          const stopped = opening.get(clip.recordingId)
          if (stopped !== undefined) stoppedRecording(stopped)
          return clip
        }, sync(() => { openingRecording = undefined }))
      }))
    },
    dictationForeground: () => registered(LOCAL_PLUGIN)
      ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().dictationForeground({})), (result) => result.available === true), () => false)
      : succeed(false),
    effect transcribe(ticket: number, _network: boolean, automatic: boolean): DictationAnswer!! {
      if (!registered(LOCAL_PLUGIN)) return { kind: "lost" }
      const clip = try recordingLock.withPermits(1)(Effect.uninterruptible(effect {
        const current = recording
        if (current === undefined || current.started > ticket || ticket <= retiredRecording) return undefined
        if (current.state === "recording") {
          const raw = tryPromise(() => localPlugin().stopRecording({})) catch () => undefined
          const stopped = Schema.decodeUnknownOption(recordedClip)(raw)
          if (current.state === "recording" && Option.isSome(stopped) && stopped.value.recordingId === current.recordingId) {
            current.state = "recorded"
            current.durationMs = stopped.value.durationMs
          }
        }
        if (current.state !== "recorded") {
          recording = undefined
          try ignore(tryPromise(() => localPlugin().cancelRecording({})))
          return undefined
        }
        return current
      }))
      if (clip === undefined || ticket <= retiredRecording || recording !== clip) return { kind: "lost" }
      const result = tryPromise({
        try: () => localPlugin().transcribeLocalRecording({ requestId: fresh(), recordingId: clip.recordingId, automatic }),
        catch: (cause): "obscured" | "failed" => asRecord(cause)?.code === "dictation-obscured" ? "obscured" : "failed",
      }) catch (kind) => kind
      return typeof result === "string" ? { kind: result, durationMs: clip.durationMs } : { kind: "recognized", text: result.text ?? "", durationMs: clip.durationMs }
    },
    effect abandon(ticket: number, isCurrent?: () => boolean!!): boolean!! {
      if (isCurrent === undefined) retiredRecording = Math.max(retiredRecording, ticket)
      if (!registered(LOCAL_PLUGIN)) return false
      return try recordingLock.withPermits(1)(Effect.uninterruptible(effect {
        if (isCurrent !== undefined && !(try isCurrent())) return false
        const clip = recording
        if (clip !== undefined && clip.started > ticket) return false
        if (clip === undefined && isCurrent === undefined) return true
        if (isCurrent === undefined) recording = undefined
        const confirmed = effect { try tryPromise(() => localPlugin().cancelRecording({})); return true } catch () => false
        if (confirmed) {
          retiredRecording = Math.max(retiredRecording, ticket)
          recording = undefined
        }
        return confirmed
      }))
    },
  }
}

function phoneReading(restoreOutput: () => boolean!!): Pick<VoiceBridge.Shape, "readAloud" | "silenceReading"> & { reading(): boolean } {
  const readings = new Map<number, { readonly id: string; readonly stopped: Deferred.Deferred<boolean> }>()
  let stoppedThrough = 0

  // spec/app/voice/output.md, "A reading waiting behind earlier audio is prepared once that audio is confirmed stopped; if it cannot be confirmed, reading aloud closes until Alpha restarts"
  effect function silenceReading(ticket: number): boolean!! {
    stoppedThrough = Math.max(stoppedThrough, ticket)
    const current = readings.get(ticket)
    if (current === undefined) return true
    const plugin = localPlugin()
    const confirmed = effect {
      try tryPromise(() => plugin.cancel({ requestId: current.id }))
      try tryPromise(() => plugin.stopPlayback({ requestId: current.id }))
      return true
    } catch () => false
    if (confirmed) {
      readings.delete(ticket)
      try Deferred.succeed(current.stopped, false)
    }
    return confirmed
  }

  // spec/app/voice/output.md, "Only the current reading's audio plays, and it ends once, as its own answer says"
  function readAloud(ticket: number, text: string | NativePageSpeech, stillCurrent?: () => boolean!!): Stream.Stream<ReadingEvent> {
    return Stream.callback<ReadingEvent>((queue) => effect {
      if (!registered(LOCAL_PLUGIN) || !(try restoreOutput()) || ticket <= stoppedThrough ||
        (stillCurrent !== undefined && !(try stillCurrent()))) {
        Queue.offerUnsafe(queue, { kind: "ready", ok: false })
        Queue.endUnsafe(queue)
        return
      }
      const plugin = localPlugin()
      const id = fresh()
      const stopped = try Deferred.make<boolean>()
      let playbackId: string | undefined
      let stoppedInBrowser = false
      let listenersReady = true
      uninterruptible {
        readings.set(ticket, { id, stopped })
        try addFinalizer(() => ignore(silenceReading(ticket)))
        for (const [event, ok] of [["playbackEnded", true], ["playbackFailed", false], ["playbackStopped", false]] as const) {
          const listener = tryPromise(() => plugin.addListener(event, (data) => {
            if (typeof data !== "object" || data === null) return
            if (typeof text !== "string" && event === "playbackStopped" && "requestId" in data && data.requestId === id) {
              stoppedInBrowser = true
            } else if (playbackId === undefined || !("playbackId" in data) || data.playbackId !== playbackId) return
            runFork(Deferred.succeed(stopped, ok))
          })) catch () => undefined
          if (listener === undefined) {
            listenersReady = false
            break
          }
          try addFinalizer(() => ignore(tryPromise(() => listener.remove())))
        }
      }
      if (!listenersReady) {
        readings.delete(ticket)
        Queue.offerUnsafe(queue, { kind: "ready", ok: false })
        Queue.endUnsafe(queue)
        return
      }
      const playing = effect {
        const prepared = try tryPromise(() => typeof text === "string"
          ? plugin.synthesizeLocal({ requestId: id, text, replace: false })
          : plugin.synthesizeLocalBrowserReading({ ...text, requestId: id, replace: false }).then((receipt) => receipt.execution === "device" ? receipt : {}))
        const playback = prepared.playbackId
        if (!playback || stoppedInBrowser || readings.get(ticket)?.id !== id || (stillCurrent !== undefined && !(try stillCurrent()))) return false
        playbackId = playback
        try tryPromise(() => plugin.play({ playbackId: playback, replace: false }))
        return true
      } catch () => false
      Queue.offerUnsafe(queue, { kind: "ready", ok: playing })
      if (playing) {
        const ok = try Deferred.await(stopped)
        if (readings.get(ticket)?.id === id) readings.delete(ticket)
        Queue.offerUnsafe(queue, { kind: "ended", ok })
      } else if (readings.get(ticket)?.id === id) {
        readings.delete(ticket)
      }
      Queue.endUnsafe(queue)
    })
  }

  return { readAloud, silenceReading, reading: () => readings.size > 0 }
}

const phoneVoiceAccess = {
  available: () => sync(() => registered(LOCAL_PLUGIN) || registered(CLOUD_STREAM_PLUGIN)),
  checkPermission: () => registered(LOCAL_PLUGIN)
    ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().checkPermissions()), (res) => parseGrant(res.microphone)), (): VoiceGrant => "unknown")
    : succeed<VoiceGrant>("granted"),
  requestPermission: () => registered(LOCAL_PLUGIN)
    ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().requestPermissions()), (res) => parseGrant(res.microphone)), (): VoiceGrant => "denied")
    : succeed<VoiceGrant>("granted"),
  streamTimings: () => registered(CLOUD_STREAM_PLUGIN)
    ? Effect.orElseSucceed(timeout(tryPromise(() => relayPlugin().cloudStreamTiming({})), RELAY_WARMUP_BOUND), (): unknown => undefined)
    : succeed<unknown>(undefined),
  holdEngine: () => registered(LOCAL_PLUGIN)
    ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().holdSpeechEngine({})), (res) => res.held === true), () => false)
    : succeed(false),
  releaseEngineHold: () => registered(LOCAL_PLUGIN)
    ? ignore(tryPromise(() => localPlugin().releaseSpeechEngineHold({})))
    : Effect.void,
  canRead: () => sync(nativeReadingAvailable),
} satisfies Pick<VoiceBridge.Shape, "available" | "checkPermission" | "requestPermission" | "streamTimings" | "holdEngine" | "releaseEngineHold" | "canRead">

interface SpeakerSession {
  active(): boolean
  local(): boolean
}

effect function phoneSpeaker() {
  const speakerLock = try Semaphore.make(1)
  let localSpeakerOwner: number | undefined

  // spec/app/voice/index.md, "Speaker mute is offered after the current speech bridge confirms gain control"
  effect function restoreLocalOutput(retiring: (owner: number) => boolean): boolean!! {
    return try speakerLock.withPermit(Effect.uninterruptible(effect {
      if (localSpeakerOwner === undefined || !retiring(localSpeakerOwner)) return true
      const restored = effect {
        try tryPromise(() => localPlugin().setSpeechOutputMuted({ muted: false }))
        return true
      } catch () => false
      if (restored) localSpeakerOwner = undefined
      return restored
    }))
  }

  effect function setLocalSpeakerMuted(session: number, muted: boolean, current: SpeakerSession): boolean!! {
    if (!registered(LOCAL_PLUGIN)) return false
    return try speakerLock.withPermit(Effect.uninterruptible(effect {
      if (!current.active() || !current.local()) return false
      if (muted) localSpeakerOwner = session
      const set = effect {
        try tryPromise(() => localPlugin().setSpeechOutputMuted({ muted }))
        return true
      } catch () => false
      if (set && !muted) localSpeakerOwner = undefined
      return set && current.active()
    }))
  }

  return { restoreLocalOutput, setLocalSpeakerMuted }
}

interface CloudVoiceSession {
  readonly session: number
  readonly stream: CloudStreamingSpeech
  readonly abort: AbortController
  capture: Awaited<ReturnType<CloudStreamingSpeech["listen"]>> | undefined
  /** Relay sessions this conversation asked to start that the relay has not refused: while there are none, nothing of it can listen or speak. */
  relayStarts: number
  /** The utterance the current capture is hearing, sent once the relay's final is followed by the long gap. */
  gap: TurnGap | undefined
}

interface CloudMicPreview {
  readonly session: number
  readonly outlet: VoicePreview | undefined
}

/** Speak `text` on `cloud`'s stream until `abort` stops it. */
const speakOn = (cloud: CloudVoiceSession, text: string, abort: AbortController, started: () => void) => tryPromise({
  try: () => cloud.stream.speak(text, abort.signal, started),
  catch: (cause) => new VoiceBridgeFailed({ method: "speakCloudSpeech", cause }),
})

interface CloudMicConfig {
  readonly currentSession: () => number
  readonly getSpeech: () => CloudVoiceSession | undefined
  readonly setSpeech: (next: CloudVoiceSession | undefined) => void
  readonly clearKey?: () => void
  readonly getPreview: () => CloudMicPreview | undefined
  readonly setPreview: (next: CloudMicPreview | undefined) => void
  readonly publish: (event: VoiceEvent) => void
  readonly checkCallInterrupt: boolean
}

/** `relay`, counting on `owner` each session it is asked to start until the relay refuses that start. */
function countedRelay(relay: CloudStreamPort, owner: () => CloudVoiceSession): CloudStreamPort {
  const counted: CloudStreamPort = {
    startCloudSpeech: (input) => {
      const started = relay.startCloudSpeech(input)
      owner().relayStarts += 1
      void started.then(undefined, () => { owner().relayStarts -= 1 })
      return started
    },
    stopCloudSpeech: (input) => relay.stopCloudSpeech(input),
    setCloudSpeechMuted: (input) => relay.setCloudSpeechMuted(input),
    speakCloudSpeech: (input) => relay.speakCloudSpeech(input),
    cancelCloudSpeech: (input) => relay.cancelCloudSpeech(input),
    addListener: (event, callback) => relay.addListener(event, callback),
  }
  const outputMuted = relay.setCloudSpeechOutputMuted
  if (outputMuted !== undefined) counted.setCloudSpeechOutputMuted = (input) => outputMuted.call(relay, input)
  return counted
}

function cloudMicController(config: CloudMicConfig) {
  const clearPreview = (session: number): void => {
    const current = config.getPreview()
    if (current?.session !== session) return
    config.setPreview(undefined)
    current.outlet?.retire()
  }
  effect function listen(
    session: number,
    credentialId: CredentialId,
    relay: CloudStreamPort,
    preview?: VoicePreview,
  ): boolean!VoiceBridgeFailed {
    const existing = config.getSpeech()
    const owner: CloudVoiceSession = existing?.session === session ? existing : {
      session,
      abort: makeAbort(),
      capture: undefined,
      relayStarts: 0,
      gap: undefined,
      stream: createCloudStreamingSpeech({
        environment: CLOUD_ENVIRONMENT,
        credentialId,
        assertCurrent: makeSessionGuard(config.currentSession, session),
        onInterim: (text) => {
          const current = config.getPreview()
          if (config.currentSession() !== session || current?.session !== session) return
          current.outlet?.show(owner.gap?.joined(text) ?? text)
        },
      }, countedRelay(relay, () => owner)),
    }
    if (config.currentSession() !== session) throw new VoiceBridgeFailed({ method: "startCloudSpeech", cause: "session-changed" })
    config.setSpeech(owner)
    clearPreview(session)
    const previewOwner: CloudMicPreview = { session, outlet: preview }
    config.setPreview(previewOwner)
    // spec/app/voice/index.md, "When the owner finishes speaking, the microphone closes, and only then is the turn sent, once and automatically": the relay's final waits out the long gap on Alpha's own clock, and speech before it ends joins the same turn (v119 45f6bed30 voice-adapter.ts:987). Unmute within the gap keeps its words and timer for the reopened capture, as v119 kept the utterance across the capture Unmute opened (voice-assistant-session.ts:612-622 and 722-735).
    const kept = owner.gap?.waiting === true ? owner.gap : undefined
    if (kept === undefined) owner.gap?.cancel()
    const context = try Effect.context<never>()
    const clock = {
      set: (run: () => void, ms: number): unknown => runFork(Effect.provideContext(Effect.andThen(sleep(ms), sync(run)), context)),
      clear: (fiber: unknown): void => { runFork(Fiber.interrupt(fiber as Fiber.Fiber<void>)) },
    }
    const gap: TurnGap = kept ?? new TurnGap((text) => {
      const shown = config.getPreview()
      if (shown?.session === session) shown.outlet?.clear()
      if (config.currentSession() === session && owner.gap === gap) config.publish({ kind: "speechEnd", session, text })
    }, clock)
    owner.gap = gap
    // spec/app/voice/index.md, "When the owner finishes speaking, the microphone closes, and only then is the turn sent, once and automatically": Mute pressed again while the microphone Unmute reopened is still opening keeps the words held on the gap, as v119's Mute kept the utterance whether or not its capture had opened (voice-assistant-session.ts:593-622).
    const unopened = (): void => { if (gap !== kept || !gap.waiting) gap.cancel() }
    const capture = onInterrupt(
      tryPromise({
        try: () => owner.stream.listen({
          signal: owner.abort.signal,
          onSpeechStart: () => {
            gap.speechStarted()
            config.publish({ kind: "speechStart", session })
          },
          onSpeechEnd: () => undefined,
          onSegment: (text) => {
            gap.segment(text)
            if (config.getPreview() !== previewOwner) return
            if (gap.held === "") preview?.clear()
            else preview?.show(gap.held)
          },
          onEnd: (cause) => {
            // spec/app/voice/index.md, "When the owner finishes speaking, the microphone closes, and only then is the turn sent, once and automatically": a capture that ends within the gap sends nothing, as v119's captureEnded did (voice-assistant-session.ts:786-797).
            gap.cancel()
            if (config.getPreview() === previewOwner) clearPreview(session)
            if (cause === undefined) {
              config.publish({ kind: "ended", session, reason: "ended" })
            } else if (config.checkCallInterrupt && interruptedByCall(cause)) {
              config.publish({ kind: "ended", session, reason: "call-active", cause })
            } else {
              const { fault, waitMs } = classifyVoiceFault(cause, true)
              const reason = refusedForFunds(cause) ? "insufficient_credits" : "error"
              config.publish({ kind: "ended", session, reason, fault, waitMs, cause })
            }
          },
        }),
        catch: (cause) => new VoiceBridgeFailed({ method: "startCloudSpeech", cause }),
      }),
      () => sync(() => {
        unopened()
        owner.abort.abort()
      }),
    ) catch effect (failure) => {
      gap.cancel()
      if (config.getPreview() === previewOwner) clearPreview(session)
      if (config.getSpeech() === owner) {
        config.setSpeech(undefined)
        config.clearKey?.()
      }
      throw failure
    }
    if (config.getSpeech() !== owner || config.currentSession() !== session) {
      owner.abort.abort()
      try ignore(tryPromise(() => capture.cancel()))
      throw new VoiceBridgeFailed({ method: "startCloudSpeech", cause: "session-changed" })
    }
    owner.capture = capture
    return capture.fullDuplex
  }
  return { clearPreview, listen }
}

/** Ask the phone to stop each of `requests`, where `undefined` is all of its speech, answering those it did not confirm stopped. */
effect function stopPlaybackOf(requests: ReadonlyArray<string | undefined>): Array<string | undefined>!! {
  if (!registered(LOCAL_PLUGIN)) return []
  const failed: Array<string | undefined> = []
  for (const requestId of requests) {
    const stopped = try (tryPromise(() => localPlugin().stopPlayback(requestId === undefined ? {} : { requestId })) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
    if (!stopped) failed.push(requestId)
  }
  return failed
}

/** Take the tracked requests of `requests` to stop, or all of the phone's speech (`undefined`) when none are tracked. */
function claimedPlayback(requests: Set<string>): Array<string | undefined> {
  const tracked: Array<string | undefined> = [...requests]
  requests.clear()
  return tracked.length === 0 ? [undefined] : tracked
}

/** Stop local TTS playback for every tracked request, or globally when none are tracked. */
effect function stopLocalPlayback(requests: Set<string>): boolean!! {
  return (try stopPlaybackOf(claimedPlayback(requests))).length === 0
}

/** Per-session sentence and acknowledgment playback with turn-scoped interruption. */
function phonePlayback(
  readActiveSession: () => number,
  readCloudStream: (session: number) => CloudStreamingSpeech | undefined,
  reading: () => boolean,
) {
  let activePlaybackSession = 0
  let activePlaybackTurn = 0
  let latestLocalRequest: string | undefined
  let cueStop: Deferred.Deferred<void> | undefined
  const cloudSpeechAborts = new Set<AbortController>()
  const localPlaybackRequests = new Set<string>()

  function abortCloudSpeech(): void {
    const aborts = [...cloudSpeechAborts]
    cloudSpeechAborts.clear()
    for (const abort of aborts) abort.abort()
  }

  effect function speakCloud(session: number, text: string, started: () => void): boolean!VoiceBridgeFailed {
    const stream = readCloudStream(session)
    if (stream === undefined) return false
    const abort = makeAbort()
    cloudSpeechAborts.add(abort)
    try ensuring(
      tryPromise({
        try: () => stream.speak(text, abort.signal, started),
        catch: (cause) => new VoiceBridgeFailed({ method: "speakCloudSpeech", cause }),
      }),
      sync(() => { cloudSpeechAborts.delete(abort) }),
    )
    return true
  }

  effect function localRequest(): string!VoiceBridgeFailed {
    if (!registered(LOCAL_PLUGIN)) throw new VoiceBridgeFailed({ method: "synthesizeLocal", cause: "no-voice-plugin" })
    const requestId = fresh()
    latestLocalRequest = requestId
    localPlaybackRequests.add(requestId)
    return requestId
  }

  effect function playSentence(session: number, turn: number, text: string, append: boolean): void!VoiceBridgeFailed {
    if (readActiveSession() !== session) return
    activePlaybackSession = session
    activePlaybackTurn = turn
    if (try speakCloud(session, text, () => undefined)) return
    const requestId = try localRequest()
    try ensuring(effect {
      const prepared = try tryPromise({
        try: () => localPlugin().synthesizeLocal({ requestId, text, append, replace: !append }),
        catch: (cause) => new VoiceBridgeFailed({ method: "synthesizeLocal", cause }),
      })
      if (readActiveSession() === session && latestLocalRequest === requestId && prepared.playbackId !== undefined && prepared.playbackId !== "") {
        const playbackId = prepared.playbackId
        try tryPromise({
          try: () => localPlugin().play({ playbackId, replace: !append }),
          catch: (cause) => new VoiceBridgeFailed({ method: "play", cause }),
        })
      }
    }, sync(() => { localPlaybackRequests.delete(requestId) }))
  }

  // spec/app/assistant/reply.md, "A spoken acknowledgment starts at once; a reply ready before it is audible drops it, and an audible one finishes before the reply, within 2.5 s": audible is the first playback the speaker reports.
  effect function playCue(session: number, turn: number, text: string, started: () => void): void!VoiceBridgeFailed {
    if (readActiveSession() !== session) return
    activePlaybackSession = session
    activePlaybackTurn = turn
    const stop = try Deferred.make<void>()
    cueStop = stop
    try ensuring(effect {
      if (try speakCloud(session, text, started)) return
      const requestId = try localRequest()
      try ensuring(
        playLocalCue(text, requestId, () => readActiveSession() === session && latestLocalRequest === requestId, started, stop),
        sync(() => { localPlaybackRequests.delete(requestId) }),
      )
    }, sync(() => { if (cueStop === stop) cueStop = undefined }))
  }

  effect function hush(turn: number): void!! {
    if (turn !== 0 && activePlaybackTurn !== 0 && activePlaybackTurn !== turn) return
    abortCloudSpeech()
    if (cueStop !== undefined) try Deferred.succeed(cueStop, undefined)
    latestLocalRequest = undefined
    try stopLocalPlayback(localPlaybackRequests)
  }

  /**
   * The stop of `session`'s speech: its first ask stops what the session plays, or all of the phone's speech where
   * nothing it plays is tracked; each later ask stops only what an earlier one could not, and waits while a reading
   * the owner started plays rather than stop that too.
   */
  function sessionStop(session: number, ownsSession: boolean): QuietStop {
    let left: ReadonlyArray<string | undefined> | undefined
    return () => effect {
      if (left === undefined) {
        const ownsPlayback = activePlaybackSession === session
        if (!ownsPlayback && !ownsSession) {
          left = []
          return true
        }
        if (ownsPlayback) {
          activePlaybackSession = 0
          activePlaybackTurn = 0
        }
        abortCloudSpeech()
        if (cueStop !== undefined) try Deferred.succeed(cueStop, undefined)
        latestLocalRequest = undefined
        left = claimedPlayback(localPlaybackRequests)
      } else if (left.includes(undefined) && reading()) {
        return false
      }
      left = try stopPlaybackOf(left)
      return left.length === 0
    }
  }

  return { playSentence, playCue, hush, sessionStop }
}

// spec/app/assistant/reply.md, "A spoken acknowledgment starts at once; a reply ready before it is audible drops it, and an audible one finishes before the reply, within 2.5 s": the phone's cue is audible once play answers, and is over at its playback's end or a stop.
effect function playLocalCue(text: string, requestId: string, current: () => boolean, started: () => void, stop: Deferred.Deferred<void>): void!VoiceBridgeFailed {
  const plugin = localPlugin()
  const ended = try Deferred.make<void>()
  const listeners: { remove(): Promise<void> }[] = []
  let playbackId: string | undefined
  try ensuring(effect {
    for (const event of ["playbackEnded", "playbackFailed", "playbackStopped"] as const) {
      const listener = tryPromise(() => plugin.addListener(event, (data) => {
        if (playbackId === undefined || typeof data !== "object" || data === null || !("playbackId" in data) || data.playbackId !== playbackId) return
        runFork(Deferred.succeed(ended, undefined))
      })) catch () => undefined
      if (listener === undefined) throw new VoiceBridgeFailed({ method: "addListener", cause: event })
      listeners.push(listener)
    }
    const prepared = try tryPromise({
      try: () => plugin.synthesizeLocal({ requestId, text, append: false, replace: true }),
      catch: (cause) => new VoiceBridgeFailed({ method: "synthesizeLocal", cause }),
    })
    if (!current() || prepared.playbackId === undefined || prepared.playbackId === "") return
    const playback = prepared.playbackId
    playbackId = playback
    try tryPromise({
      try: () => plugin.play({ playbackId: playback, replace: true }),
      catch: (cause) => new VoiceBridgeFailed({ method: "play", cause }),
    })
    if (!current()) return
    started()
    try Effect.raceFirst(Deferred.await(ended), Deferred.await(stop))
  }, effect {
    for (const listener of listeners) try ignore(tryPromise(() => listener.remove()))
  })
}

/**
 * Whether the microphone of `captureId` is off, asked once its first stop has answered: that stop already closed the
 * agent's speech session or gave up on its acknowledgment, so the phone answers this one for the microphone alone
 * (`LiveCaptureController.stop` closes no session it no longer holds, and stops the microphone again while it still runs).
 */
effect function microphoneReleased(captureId: string): boolean!! {
  const again = tryPromise(() => localPlugin().stopLiveCapture({ captureId, discard: true })) catch () => undefined
  return again?.captureId === captureId && again.serverClosed === true
}

/** Native live capture lifecycle with preview subscription and idempotent stop. */
function phoneNativeCapture(
  lifetime: Scope.Scope,
  readActiveSession: () => number,
  restoreLocalOutput: (retiring: (owner: number) => boolean) => boolean!!,
) {
  let nativeCapture: LiveCapture | undefined

  effect function stopCapture(capture: LiveCapture, discard: boolean): void!VoiceBridgeFailed {
    const opening = capture.phase === "Opening" || capture.phase === "Cancelling"
    capture.phase = opening ? "Cancelling" : "Retired"
    retireNativePreview(capture)
    if (capture.requested) {
      let observed = capture.openingStop
      const request = tryPromise({
        try: () => {
          if (!opening) return localPlugin().stopLiveCapture({ captureId: capture.captureId, discard })
          const attempt = capture.openingStop ??= localPlugin().stopLiveCapture({ captureId: capture.captureId, discard: true })
          observed = attempt
          return attempt
        },
        catch: (cause) => new VoiceBridgeFailed({ method: "stopLiveCapture", cause }),
      })
      const stopped = request catch effect (failure) => {
        if (opening && capture.openingStop === observed) capture.openingStop = undefined
        throw failure
      }
      if (stopped.captureId !== capture.captureId || !(stopped.serverClosed === true || (discard && (try microphoneReleased(capture.captureId))))) {
        if (opening && capture.openingStop === observed) capture.openingStop = undefined
        throw new VoiceBridgeFailed({ method: "stopLiveCapture", cause: "not-closed" })
      }
    }
    if (nativeCapture === capture) nativeCapture = undefined
  }

  effect function openLocal(session: number, reopen: boolean, preview?: VoicePreview): boolean!VoiceBridgeFailed!Agent {
    if (!registered(LOCAL_PLUGIN)) throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "no-voice-plugin" })
    const live = tryPromise(() => localPlugin().liveCaptureStatus({})) catch () => undefined
    if (live?.available !== true || live.nativeTransport !== true) {
      throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "resident-speech-transport-unavailable" })
    }
    if (!(try restoreLocalOutput((owner) => owner !== session))) {
      throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "speaker-reset-unconfirmed" })
    }
    if (readActiveSession() !== session) throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "session-changed" })
    if (nativeCapture !== undefined) retireNativePreview(nativeCapture)
    const capture: LiveCapture = {
      session, captureId: fresh(), preview, stopPreview: undefined, phase: "Opening",
      requested: false, openingStop: undefined, echoCancelled: false,
    }
    nativeCapture = capture
    const start = effect {
      try hearNativePreview(capture, () => nativeCapture === capture && readActiveSession() === session
        && (capture.phase === "Opening" || capture.phase === "Listening") && capture.stopPreview !== undefined, lifetime)
      if (nativeCapture !== capture || capture.phase !== "Opening" || readActiveSession() !== session) {
        throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "session-changed" })
      }
      return try tryPromise({
        try: () => {
          const requested = localPlugin().startLiveCapture({
            captureId: capture.captureId, nativeAsr: true, echoCancel: true, bargeIn: true, reopen,
          })
          capture.requested = true
          return requested
        },
        catch: (cause) => new VoiceBridgeFailed({ method: "startLiveCapture", cause }),
      })
    }
    const started = onInterrupt(start, () => Effect.ignore(stopCapture(capture, true))) catch effect (failure) => {
      retireNativePreview(capture)
      if (nativeCapture === capture && capture.phase === "Opening") nativeCapture = undefined
      throw failure
    }
    if (capture.phase !== "Opening") throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "session-changed" })
    if (started.captureId !== capture.captureId || started.nativeAsr !== true || nativeCapture !== capture || readActiveSession() !== session) {
      retireNativePreview(capture)
      try ignore(tryPromise(() => localPlugin().stopLiveCapture({ captureId: capture.captureId, discard: true })))
      if (nativeCapture === capture) nativeCapture = undefined
      throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "resident-speech-capture-refused" })
    }
    capture.echoCancelled = started.echoCancelled === true
    capture.phase = "Listening"
    return capture.echoCancelled
  }

  effect function stop(session: number, discard: boolean): void!VoiceBridgeFailed {
    const capture = nativeCapture
    if (capture?.session === session) try stopCapture(capture, discard)
  }

  function retire(): void {
    if (nativeCapture === undefined) return
    if (nativeCapture.phase === "Opening") nativeCapture.phase = "Cancelling"
    else if (nativeCapture.phase === "Listening") nativeCapture.phase = "Retired"
    retireNativePreview(nativeCapture)
  }

  return { current: () => nativeCapture, openLocal, stop, retire }
}

function dropEmptyGap(owner: CloudVoiceSession): void {
  // spec/app/voice/index.md, "When the owner finishes speaking, the microphone closes, and only then is the turn sent, once and automatically": words Mute finds waiting on the gap, or still being spoken, are still sent when the gap after them ends, as v119's setMuted finalized the speech, closed the capture and then still sent it (voice-assistant-session.ts:593-611).
  if (owner.gap !== undefined && !owner.gap.waiting) {
    owner.gap.cancel()
    owner.gap = undefined
  }
}

/** A stop of something that could go on listening or making sound, answering whether it is confirmed off. */
type QuietStop = () => boolean!!

effect function settles(run: () => Promise<unknown>): boolean!! {
  return try (tryPromise(run) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
}

/** A shut Cloud session's stops: its capture, and its relay session unless the relay never started one. */
function cloudStops(owner: CloudVoiceSession): QuietStop[] {
  const capture = owner.capture
  const stream: QuietStop = () => effect { return (try settles(() => owner.stream.stop())) || owner.relayStarts === 0 }
  return capture === undefined ? [stream] : [() => settles(() => capture.cancel()), stream]
}

/**
 * The stops of shut conversations not yet confirmed off: each is kept from before it is first asked until an ask
 * confirms it, so an ask cut short loses none, and one ask runs at a time. `settle` asks a shut's stops, `release`
 * asks again those still kept.
 */
effect function unconfirmedStops() {
  const gate = try Semaphore.make(1)
  const kept = new Set<QuietStop>()
  effect function ask(stops: ReadonlyArray<QuietStop>): boolean!! {
    let quiet = true
    for (const stop of stops) {
      if (try stop()) kept.delete(stop)
      else quiet = false
    }
    return quiet
  }
  effect function settle(stops: ReadonlyArray<QuietStop>): boolean!! {
    for (const stop of stops) kept.add(stop)
    return try Semaphore.withPermit(gate, ask(stops))
  }
  effect function release(): boolean!! {
    return try Semaphore.withPermit(gate, effect {
      try ask([...kept])
      return kept.size === 0
    })
  }
  return { settle, release }
}

function abortCloudSession(owner: CloudVoiceSession): void {
  // spec/app/voice/index.md, "When the owner finishes speaking, the microphone closes, and only then is the turn sent, once and automatically": Stop drops words still waiting on the gap, as v119's stop did (voice-assistant-session.ts:574-575).
  owner.gap?.cancel()
  owner.gap = undefined
  owner.abort.abort()
}

export const phoneVoiceBridge = Layer.effect(VoiceBridge, effect {
  const lifetime = try Effect.scope
  const { probeStatus, warmDevice, invalidateStatus, awaitWarmup } = phoneSpeechStatus()
  let prewarmFlight: Deferred.Deferred<void> | undefined
  let activeSession = 0
  let cloudSpeech: CloudVoiceSession | undefined
  let cloudKey: CredentialId | undefined
  let accountEpoch = 0
  let cloudPreview: { readonly session: number; readonly outlet: VoicePreview | undefined } | undefined
  const { restoreLocalOutput, setLocalSpeakerMuted } = try phoneSpeaker()
  const nativeCap = phoneNativeCapture(lifetime, () => activeSession, restoreLocalOutput)
  const { readAloud, silenceReading, reading } = phoneReading(() => restoreLocalOutput(() => true))
  const playback = phonePlayback(() => activeSession, (session) => (cloudSpeech?.session === session ? cloudSpeech.stream : undefined), reading)
  const unconfirmed = try unconfirmedStops()
  const eventSubscribers = new Set<(event: VoiceEvent) => void>()

  const publish = (event: VoiceEvent) => {
    for (const emit of eventSubscribers) emit(event)
  }

  effect function prewarm(network: boolean): void!! {
    if (prewarmFlight !== undefined) {
      try Deferred.await(prewarmFlight)
      return
    }
    const flight = try Deferred.make<void>()
    prewarmFlight = flight
    try ensuring(effect {
      if (network && registered(CLOUD_STREAM_PLUGIN)) {
        const relay = relayPlugin()
        const accounts = signInAccounts()
        const epoch = accountEpoch
        try Effect.forkIn(ignore(timeout(Effect.all([
          effect { const read = signedInKey(accounts) catch () => undefined; if (epoch === accountEpoch) cloudKey = read },
          ignore(tryPromise(() => relay.prewarmCloudSpeech({ environment: CLOUD_ENVIRONMENT }))),
        ], { concurrency: "unbounded" }), RELAY_WARMUP_BOUND)), lifetime)
      }
      try warmDevice()
    }, effect {
      if (prewarmFlight === flight) prewarmFlight = undefined
      try Deferred.succeed(flight, undefined)
    })
  }

  const cloudMic = cloudMicController({
    currentSession: () => activeSession,
    getSpeech: () => cloudSpeech,
    setSpeech: (next) => { cloudSpeech = next },
    clearKey: () => { cloudKey = undefined },
    getPreview: () => cloudPreview,
    setPreview: (next) => { cloudPreview = next },
    publish,
    checkCallInterrupt: true,
  })
  const clearCloudPreview = cloudMic.clearPreview

  effect function openMic(session: number, network: boolean, preview?: VoicePreview): boolean!VoiceBridgeFailed!Agent {
    const reopen = activeSession === session
    activeSession = session
    if (network && registered(CLOUD_STREAM_PLUGIN)) {
      const credentialId = cloudSpeech?.session === session ? PAGE_CREDENTIAL : (cloudKey ?? (try signedInKey(signInAccounts())))
      return try cloudMic.listen(session, credentialId, relayPlugin(), preview)
    }
    return try nativeCap.openLocal(session, reopen, preview)
  }

  effect function closeMic(session: number): void!VoiceBridgeFailed {
    clearCloudPreview(session)
    const owner = cloudSpeech
    if (owner?.session === session) {
      dropEmptyGap(owner)
      if (owner.capture !== undefined) {
        const capture = owner.capture
        owner.capture = undefined
        try tryPromise({ try: () => capture.close(), catch: (cause) => new VoiceBridgeFailed({ method: "closeCloudSpeech", cause }) })
        return
      }
    }
    try nativeCap.stop(session, false)
  }

  const awaitSpeechOutputWarmup = (session: number) => awaitWarmup(() => activeSession === session && cloudSpeech === undefined)

  effect function setSpeakerMuted(session: number, muted: boolean): boolean!! {
    if (session !== activeSession) return false
    const cloud = cloudSpeech
    if (cloud?.session === session) {
      const set = effect {
        try tryPromise(() => cloud.stream.setOutputMuted(muted))
        return activeSession === session && cloudSpeech === cloud
      } catch () => false
      return set
    }
    return try setLocalSpeakerMuted(session, muted, { active: () => activeSession === session, local: () => cloudSpeech === undefined })
  }

  effect function shut(session: number): boolean!! {
    clearCloudPreview(session)
    const ownsSession = activeSession === session
    if (ownsSession) activeSession = 0
    const stops: QuietStop[] = [playback.sessionStop(session, ownsSession)]
    const owner = cloudSpeech
    if (owner?.session === session) {
      cloudSpeech = undefined
      abortCloudSession(owner)
      stops.push(...cloudStops(owner))
    }
    if (registered(LOCAL_PLUGIN)) stops.push(() => nativeCap.stop(session, true) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
    const confirmed = try unconfirmed.settle(stops)
    if (registered(LOCAL_PLUGIN)) try restoreLocalOutput((owner) => owner === session)
    return confirmed
  }

  const { stoppedRecording, ...dictation } = try phoneDictation(publish)

  return {
    ...phoneVoiceAccess,
    prewarm,
    probeStatus,
    invalidateCache: () => sync(() => {
      invalidateStatus()
      cloudKey = undefined
    }),
    forgetAccount: () => sync(() => {
      clearCloudPreview(activeSession)
      nativeCap.retire()
      accountEpoch += 1
      cloudKey = undefined
      if (activeSession === 0) cloudSpeech = undefined
    }),
    openMic,
    closeMic,
    awaitSpeechOutputWarmup,
    playSentence: playback.playSentence,
    playCue: playback.playCue,
    setSpeakerMuted,
    hush: playback.hush,
    readAloud,
    silenceReading,
    shut,
    release: unconfirmed.release,
    events: makeNativeEvents(eventSubscribers, nativeCap.current, stoppedRecording),
    account: signedInAccount, signIns: settledSignIns(),
    ...dictation,
  }
})

// spec/app/voice/index.md, "A page served by Alpha's development server talks through that server's own Cloud speech relay, and a page that names none offers no Talk"
/**
 * A page that is no phone: Talk over the Cloud speech relay of the page's own server, where it offers one, with the
 * browser's microphone, by the same Cloud path and the same eliza client as the phone's relay (spec/app/voice/index.md,
 * "What voice asks the phone and the voice service to do"); no voice where it offers none. A page has no on-phone speech,
 * reading aloud or dictation.
 */
export const browserVoiceBridge = Layer.effect(VoiceBridge, effect {
  const base = pageSpeechBase()
  const relay = base === undefined ? undefined : pageSpeechRelay(base)
  let activeSession = 0
  let cloudSpeech: CloudVoiceSession | undefined
  let cloudPreview: CloudMicPreview | undefined
  let cloudSpeechAbort: AbortController | undefined
  let cueStop: Deferred.Deferred<void> | undefined
  const unconfirmed = try unconfirmedStops()
  const eventSubscribers = new Set<(event: VoiceEvent) => void>()
  const publish = (event: VoiceEvent) => {
    for (const emit of eventSubscribers) emit(event)
  }

  const browserMic = cloudMicController({
    currentSession: () => activeSession,
    getSpeech: () => cloudSpeech,
    setSpeech: (next) => { cloudSpeech = next },
    getPreview: () => cloudPreview,
    setPreview: (next) => { cloudPreview = next },
    publish,
    checkCallInterrupt: false,
  })
  const clearCloudPreview = browserMic.clearPreview

  effect function openMic(session: number, network: boolean, preview?: VoicePreview): boolean!VoiceBridgeFailed {
    if (relay === undefined || !network) throw new VoiceBridgeFailed({ method: "startCloudSpeech", cause: "browser-no-speech-relay" })
    activeSession = session
    return try browserMic.listen(session, PAGE_CREDENTIAL, relay, preview)
  }

  effect function closeMic(session: number): void!VoiceBridgeFailed {
    clearCloudPreview(session)
    const owner = cloudSpeech
    if (owner?.session !== session) return
    dropEmptyGap(owner)
    if (owner.capture === undefined) return
    const capture = owner.capture
    owner.capture = undefined
    try tryPromise({ try: () => capture.close(), catch: (cause) => new VoiceBridgeFailed({ method: "closeCloudSpeech", cause }) })
  }

  effect function speak(session: number, text: string, started: () => void): void!VoiceBridgeFailed {
    const cloud = cloudSpeech
    if (activeSession !== session || cloud?.session !== session) return
    const abort = makeAbort()
    cloudSpeechAbort = abort
    try speakOn(cloud, text, abort, started)
  }

  effect function setSpeakerMuted(session: number, muted: boolean): boolean!! {
    const cloud = cloudSpeech
    if (session !== activeSession || cloud?.session !== session) return false
    const set = effect {
      try tryPromise(() => cloud.stream.setOutputMuted(muted))
      return activeSession === session && cloudSpeech === cloud
    } catch () => false
    return set
  }

  effect function hush(_turn: number): void!! {
    cloudSpeechAbort?.abort()
    cloudSpeechAbort = undefined
    if (cueStop !== undefined) try Deferred.succeed(cueStop, undefined)
  }

  effect function shut(session: number): boolean!! {
    clearCloudPreview(session)
    if (activeSession === session) {
      activeSession = 0
      try hush(0)
    }
    const owner = cloudSpeech
    if (owner?.session !== session) return true
    cloudSpeech = undefined
    abortCloudSession(owner)
    return try unconfirmed.settle(cloudStops(owner))
  }

  return {
    available: () => succeed(relay !== undefined),
    checkPermission: () => Effect.orElseSucceed(tryPromise(() => pageMicrophone(false)), (): VoiceGrant => "prompt"),
    requestPermission: () => Effect.orElseSucceed(tryPromise(() => pageMicrophone(true)), (): VoiceGrant => "denied"),
    prewarm: () => Effect.void,
    streamTimings: () => succeed<unknown>(undefined),
    probeStatus: () => succeed<SpeechStatus>({ ready: false, ttsReady: false, liveCapture: false }),
    invalidateCache: () => Effect.void,
    forgetAccount: () => sync(() => { if (activeSession === 0) cloudSpeech = undefined }),
    holdEngine: () => succeed(false),
    releaseEngineHold: () => Effect.void,
    openMic,
    closeMic,
    awaitSpeechOutputWarmup: () => Effect.void,
    playSentence: (session, _turn, text) => speak(session, text, () => undefined),
    playCue: (session, _turn, text, started) => effect {
      const stop = try Deferred.make<void>()
      cueStop = stop
      try ensuring(Effect.raceFirst(speak(session, text, started), Deferred.await(stop)), sync(() => { if (cueStop === stop) cueStop = undefined }))
    },
    setSpeakerMuted,
    hush,
    canRead: () => succeed(false),
    readAloud: () => Stream.succeed<ReadingEvent>({ kind: "ready", ok: false }),
    silenceReading: () => succeed(true),
    shut,
    release: unconfirmed.release,
    events: makeNativeEvents(eventSubscribers, () => undefined, () => undefined),
    account: () => succeed<CloudSignIn>(relay === undefined ? { kind: "unknown" } : { kind: "signedIn", credential: PAGE_CREDENTIAL }),
    signIns: Stream.empty,
    startRecording: () => Effect.fail(new VoiceBridgeFailed({ method: "startRecording", cause: "browser-no-native-voice" })),
    dictationForeground: () => succeed(false),
    transcribe: () => succeed<DictationAnswer>({ kind: "lost" }),
    abandon: () => succeed(false),
  }
})
