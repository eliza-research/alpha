export type Plugins =
  | never
  | Launcher
  | SystemSettings
  | WiFi
  | CarrierSetup
  | LauncherUpdates
  | PhoneCalendar
  | PhoneReminders
  | PhoneClockAlerts
  | MessagingNotices
  | CameraPort
  | PhotosPort
  | Files
  | Location
  | Telephony
  | Calls
  | NetworkLocation
  | VoiceBridge
  | Documents
  | InboxAttachmentFiles
  | Navigation
  | TabHost

export const phonePlugins = Layer.mergeAll(
  Layer.empty,
  phoneLauncher,
  phoneSystemSettings,
  phoneWiFi,
  phoneCarrierSetup,
  phoneLauncherUpdates,
  phoneCalendar,
  phoneReminders,
  phoneClockAlerts,
  phoneMessagingNotices,
  phoneFiles,
  phoneCamera,
  phonePhotos,
  phoneLocation,
  phoneTelephony,
  phoneCalls,
  phoneNetworkLocation,
  phoneVoiceBridge,
  phoneDocuments,
  phoneInboxAttachments,
  phoneNavigation,
  phoneTabHost,
)

export const browserPlugins = Layer.mergeAll(
  Layer.empty,
  browserLauncher,
  browserSystemSettings,
  browserWiFi,
  browserCarrierSetup,
  browserLauncherUpdates,
  browserCalendar,
  browserReminders,
  browserClockAlerts,
  browserMessagingNotices,
  browserLibrary,
  browserCamera,
  browserPhotos,
  browserLocation,
  browserTelephony,
