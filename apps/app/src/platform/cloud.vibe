// spec/kit/read.md, "Story: Read from outside"; spec/app/platform/index.md, "A cloud request the phone holds back for want of a sign-in reads as the cloud's own 401"; spec/app/platform/index.md, "A mail or calendar request the phone holds back for want of its mail lease reads as the cloud's own refusal of the device key there, never as a sign-out"; spec/app/platform/index.md, "A request is refused for want of a network only when Android confirms the app's network is down"
import { createCloudClient } from "@elizaos/cloud"
import { BridgeUnavailable, CloudRefused, type CloudClient as Relay, type CloudFailure, type CloudMethod, type CloudPath, type CloudRequest, type CredentialId, SignInRefused } from "@elizaos/os-bridges"
import { type MailSignIn, cloudStatusOf, heldAnswer, leaseRefusalCode, refusedOffline, replied } from "../../gen/app__platform.effect.vibe"
import { native } from "./device.vibe"
import { type Failure, type Remote, type Wired, Refused, Unreachable, Unsent, parsed, patience, refusal, remoteAt } from "./remote.vibe"
import { CLOUD_ENVIRONMENT, signInAccounts } from "./voice.vibe"
import { WiFi, phoneWiFi } from "./wifi.vibe"

module held {
  import { cloudClient, type ElizaCloudPlugin } from "@elizaos/os-bridges"
  import { plugin as capacitorPlugin } from "./capacitor.ts"

  let made: ReturnType<typeof cloudClient> | undefined
  /** eliza's client of the plugin, made once: Capacitor registers a plugin a single time for the life of the page. @throws {never} */
  export function client(): ReturnType<typeof cloudClient> {
    return (made ??= cloudClient(capacitorPlugin<ElizaCloudPlugin>("ElizaCloud")))
  }
}
import { client } from held
export { client as cloudPlugin }

/**
 * eliza's own typed client of its cloud: the account, plans, entitlement, billing, managed Google and maps, each
 * answer decoded by eliza's schemas. An area that reads one of them calls it and restates no wire shape.
 */
export type CloudClient = ReturnType<typeof createCloudClient>

/**
 * The cloud account's API: eliza's cloud, for what the page itself asks of it. `client` is eliza's typed client; a
 * route it has no call for is read with `ask(Cloud, …)` and `attempted(Cloud, …)` of remote.vibe. The page never
 * holds the device key: the phone's `ElizaCloud` plugin adds it, and in a browser the dev server does.
 */
export interface Account extends Remote {
  readonly client: CloudClient
  readonly clientFor: (credential: CredentialId) => CloudClient | undefined
  callFor(request: HttpClientRequest.HttpClientRequest, credential: CredentialId): unknown!Failure
  callBillingFor(request: HttpClientRequest.HttpClientRequest, credential: CredentialId): unknown!Failure
}

export service Cloud: Account {}

module web {
  /** @throws {never} */
  export function answer(body: BodyInit | null, status: number, headers: Record<string, string>): Response {
    return new Response(status === 204 || status === 304 ? null : body, { status, headers })
  }
  /** The cloud's own answer of `status` to a request with no usable credential, with no body. @throws {never} */
  export function unauthorized(status: number): Response {
    return new Response(null, { status })
  }
  /** What fetch was asked for, as its parts: the body as text, bytes or a form, or `false` for one this platform cannot send. @throws {never} */
  export function asked(input: RequestInfo | URL, init?: RequestInit): {
    url: URL; method: string; headers: Record<string, string>; signal: AbortSignal | undefined
    body: { text: string } | { bytes: Uint8Array } | { form: FormData } | undefined | false
  } {
    const request = typeof input === "string" || input instanceof URL ? undefined : input
    const url = new URL(typeof input === "string" || input instanceof URL ? input : input.url)
    const sent = init?.body
    const body = sent === undefined || sent === null ? undefined
      : typeof sent === "string" ? { text: sent }
      : sent instanceof Uint8Array ? { bytes: sent }
      : sent instanceof FormData ? { form: sent }
      : false
    return {
      url,
      method: init?.method ?? request?.method ?? "GET",
      headers: Object.fromEntries(new Headers(init?.headers ?? request?.headers)),
      body,
      signal: init?.signal ?? request?.signal ?? undefined,
    }
  }
  /** Parse a JSON string body for the cloud plugin, treating empty text as no body. @throws {never} */
  export function jsonBody(text: string): { readonly ok: true; readonly value: unknown } | { readonly ok: false } {
    if (text === "") return { ok: true, value: undefined }
    try { return { ok: true, value: JSON.parse(text) as unknown } } catch { return { ok: false } }
  }
  /** Combine an optional caller signal with a bounded deadline signal. @throws {never} */
  export function boundedSignal(parent: AbortSignal | undefined, milliseconds: number): { readonly signal: AbortSignal | undefined; readonly release: () => void } {
    if (typeof AbortSignal.timeout !== "function") return { signal: parent, release: () => undefined }
    const deadline = AbortSignal.timeout(milliseconds)
    if (parent === undefined) return { signal: deadline, release: () => undefined }
    const merged = new AbortController()
    const relay = () => merged.abort(parent.aborted ? parent.reason : deadline.reason)
    if (parent.aborted) relay()
    else {
      parent.addEventListener("abort", relay, { once: true })
      deadline.addEventListener("abort", relay, { once: true })
    }
    return { signal: merged.signal, release: () => { parent.removeEventListener("abort", relay); deadline.removeEventListener("abort", relay) } }
  }
}
import { answer, asked, boundedSignal, jsonBody, unauthorized } from web
export { boundedSignal }

/** What fetch was asked for, as its parts, preserving Request method, headers and signal. */
export function cloudAsked(input: RequestInfo | URL, init?: RequestInit): {
  readonly url: URL
  readonly method: string
  readonly headers: Record<string, string>
  readonly signal: AbortSignal | undefined
  readonly body: { readonly text: string } | { readonly bytes: Uint8Array } | { readonly form: FormData } | undefined | false
} {
  return asked(input, init)
}

/** Parse a JSON string body for the cloud plugin, treating empty text as no body. */
export function cloudJsonBody(text: string): { readonly ok: true; readonly value: unknown } | { readonly ok: false } {
  return jsonBody(text)
}

/** eliza's client takes an origin and a fetch: this origin is never reached, since each platform's fetch below sends by its own way. */
const placeholder = "https://cloud.invalid"

function typed(fetch: typeof globalThis.fetch): CloudClient {
  return createCloudClient({ baseUrl: placeholder, credential: () => undefined, fetch })
}

/** fetch over `direct`, for eliza's client: the same path, query, headers and body, sent through the platform's `HttpClient`. Reads a refusal's whole body while preserving status on bodyless refusals. */
function fetching(direct: Wired): typeof globalThis.fetch {
  return (input, init) => {
    const { url, method, headers, body, signal } = asked(input, init)
    if (body === false) return Promise.reject(new TypeError("this body cannot be sent"))
    const started = HttpClientRequest.make(method as "GET")(`${url.pathname}${url.search}`, { headers })
    const request = body === undefined ? started
      : "form" in body ? HttpClientRequest.bodyFormData(started, body.form)
      : "text" in body ? HttpClientRequest.bodyText(started, body.text, headers["content-type"])
      : HttpClientRequest.bodyUint8Array(started, body.bytes, headers["content-type"])
    return runPromise(effect {
      const opened = try direct.open(request)
      const response = opened.status >= 400 ? try opened.text : Stream.toReadableStream(opened.body)
      return answer(response, opened.status, { ...opened.headers })
    }, { signal })
  }
}

/** The cloud over HTTP at `base`: in a browser the page's own `/cloud`, which the dev server answers, adding the device key. */
export function cloudAt(base: string) {
  return Layer.effect(Cloud, effect {
    const direct = try remoteAt(base)
    return { call: direct.call, events: direct.events, client: typed(fetching(direct)),
      clientFor: () => undefined,
      callFor: () => Effect.fail(new Unsent({ cause: "A browser has no device credential" })),
      callBillingFor: () => Effect.fail(new Unsent({ cause: "A browser has no account session" })) }
  })
}

/** The plugin's refusals that say the request never left the phone (`definitions/cloud.ts`, `CloudFailure`): the rest may have reached the cloud. */
const kept: ReadonlyArray<CloudFailure> = [
  "no-origin", "not-listed", "body-too-large", "header-refused", "not-configured",
  "unknown-environment", "invalid-request", "name-in-use", "link-refused", "no-browser",
]

/** The plugin's refusals that hold a request back for an account that is signed out or must sign in again. */
const forSignIn: ReadonlyArray<CloudFailure> = ["sign-in-required", "reauth-required"]

const heldForSignIn = (cause: unknown): boolean => cause instanceof CloudRefused && forSignIn.includes(cause.failure)

/** The plugin held a mail or calendar request back for want of the phone's mail lease: the owner is still signed in. */
const heldForLease = (cause: unknown): boolean => cause instanceof CloudRefused && cause.failure === "mail-lease-upgrade-required"

/** The cloud's own refusal of the device key on a mail route, as Alpha reads a request held back for the lease. */
const leaseRefusal = heldAnswer("HeldForMailLease")

function undelivered(cause: unknown): Failure {
  if (heldForSignIn(cause)) {
    const reason = cause instanceof CloudRefused && cause.failure === "reauth-required" ? "reauth_required" : undefined
    return refusal(cloudStatusOf(true, 0), undefined, reason)
  }
  if (heldForLease(cause)) return new Refused({ status: leaseRefusal.status, reason: leaseRefusal.reason })
  return cause instanceof BridgeUnavailable || (cause instanceof CloudRefused && kept.includes(cause.failure)) ? new Unsent({ cause }) : new Unreachable({ cause })
}

/** Nothing, where Android has not said the phone's network is down; otherwise the request never leaves the phone. */
effect function networked(wifi: WiFi.Shape): void!Unsent {
  const read = try wifi.connectivity()
  const network = Option.isNone(read) ? "NetUnknown" : read.value.online ? "NetOnline" : "NetOffline"
  if (refusedOffline(network)) throw new Unsent({ cause: "Android says the phone has no network" })
}

/** Whether Android has said the phone's network is down. */
effect function offline(wifi: WiFi.Shape): boolean!! {
  return effect { try networked(wifi); return false } catch () => true
}

const methods: ReadonlyArray<string> = ["GET", "POST", "PATCH", "DELETE"] satisfies ReadonlyArray<CloudMethod>
const ours = (headers: Readonly<Record<string, string>>) => Object.fromEntries(Object.entries(headers).filter(([name]) => name !== "content-type" && name !== "content-length"))

/** What the plugin is asked: it sends only to the deployment's origin, a route of its list, with the headers that route admits, under the device key it alone holds. */
function relayed(method: string, path: string, query: Readonly<Record<string, string>>, headers: Readonly<Record<string, string>>, body: unknown): CloudRequest | undefined {
  if (!methods.includes(method)) return undefined
  return { method: method as CloudMethod, path: path as CloudPath, query, headers: ours(headers), ...(body === undefined ? {} : { body }) }
}

const relayTimeoutMs = 10_000

function singleValuedQuery(params: URLSearchParams): Record<string, string> | undefined {
  const query: Record<string, string> = {}
  for (const [key, value] of params.entries()) {
    if (Object.hasOwn(query, key)) return undefined
    query[key] = value
  }
  return query
}

/** Send the owner’s reviewed request through the phone’s device-key custody. */
function plugged(relay: Relay, wifi: WiFi.Shape): Omit<Account, "client" | "clientFor"> {
  effect function send(request: HttpClientRequest.HttpClientRequest, binding: Pick<CloudRequest, "expectedCredentialId" | "expectedSessionCredentialId">): unknown!Failure {
    if (request.body._tag !== "Empty" && request.body._tag !== "Uint8Array") {
      throw new Unsent({ cause: "the phone relays only JSON to the cloud" })
    }
    const text = request.body._tag === "Uint8Array" ? new TextDecoder().decode(request.body.body) : ""
    const body = text === "" ? undefined : parsed(text) catch effect (cause) => { throw new Unsent({ cause }) }
    const query = singleValuedQuery(new URLSearchParams(UrlParams.toString(request.urlParams)))
    if (query === undefined) throw new Unsent({ cause: "duplicate query parameters cannot be relayed" })
    const headers = Object.fromEntries(Object.entries(request.headers).filter((one): one is [string, string] => typeof one[1] === "string"))
    const sent = relayed(request.method, request.url, query, headers, body)
    if (sent === undefined) throw new Unsent({ cause: `the phone relays no ${request.method} to the cloud` })
    try networked(wifi)
    const reply = timeout(tryPromise({
      try: (signal) => relay.request({ ...sent, ...binding, signal }),
      catch: (cause) => binding.expectedSessionCredentialId !== undefined && cause instanceof CloudRefused && cause.failure === "reauth-required"
        ? refusal(heldAnswer("HeldForBillingReauth").status, undefined)
        : undelivered(cause),
    }), patience) catch effect (cause) => match (cause) {
      when Unsent: throw cause;
      when Refused: throw cause;
      default: throw new Unreachable({ cause });
    }
    if (!replied(reply.status)) throw refusal(reply.status, reply.retryAfter, undefined, new TextDecoder().decode(reply.body))
    return try parsed(new TextDecoder().decode(reply.body))
  }
  return {
    call: (request) => send(request, {}),
    callFor: (request, expectedCredentialId) => send(request, { expectedCredentialId }),
    callBillingFor: (request, expectedSessionCredentialId) => send(request, { expectedSessionCredentialId }),
    events: () => Stream.fail(new Unsent({ cause: "the phone's cloud plugin streams nothing" })),
  }
}

/** fetch over the plugin, for eliza's client. An account that must sign in answers 401, as the cloud itself would; a phone Android says is offline, and any other refusal, is a failed fetch. */
function relaying(relay: Relay, wifi: WiFi.Shape, expectedCredentialId?: CredentialId): typeof globalThis.fetch {
  return async (input, init) => {
    const { url, method, headers, body, signal } = asked(input, init)
    const query = singleValuedQuery(url.searchParams)
    if (query === undefined) throw new TypeError("duplicate query parameters cannot be relayed")
    const decoded = body === undefined ? { ok: true as const, value: undefined }
      : body !== false && "text" in body ? jsonBody(body.text)
      : body !== false && "bytes" in body ? jsonBody(new TextDecoder().decode(body.bytes))
      : { ok: false as const }
    const sent = decoded.ok ? relayed(method, url.pathname, query, headers, decoded.value) : undefined
    if (sent === undefined) throw new TypeError("the phone relays only JSON to the cloud")
    if (await runPromise(offline(wifi))) throw new TypeError("the phone has no network")
    const deadline = boundedSignal(signal, relayTimeoutMs)
    try {
      const reply = await relay.request({
        ...sent,
        ...(deadline.signal === undefined ? {} : { signal: deadline.signal }),
        ...(expectedCredentialId === undefined ? {} : { expectedCredentialId }),
      })
      const head = { etag: reply.etag, "content-type": reply.contentType, "retry-after": reply.retryAfter }
      return answer(reply.body as Uint8Array<ArrayBuffer>, reply.status, Object.fromEntries(Object.entries(head).filter((one): one is [string, string] => one[1] !== undefined)))
    } catch (cause) {
      if (heldForSignIn(cause)) return unauthorized(cloudStatusOf(true, 0))
      if (heldForLease(cause)) return answer(JSON.stringify({ error: leaseRefusalCode, reason: leaseRefusal.reason }), leaseRefusal.status, { "content-type": "application/json" })
      throw new TypeError("the cloud request failed", { cause })
    } finally {
      deadline.release()
    }
  }
}

effect function openStripe(url: string, host: "checkout.stripe.com" | "invoice.stripe.com"): boolean!! {
  const target = Effect.try(() => new URL(url)) catch () => undefined
  if (target === undefined || target.origin !== "https://" + host || target.username || target.password
    || (host === "invoice.stripe.com" && !target.pathname.startsWith("/i/"))) return false
  return effect {
    try tryPromise(() => client().openExternal({ url, environment: CLOUD_ENVIRONMENT }))
    return true
  } catch () => false
}

/** Stripe pages must be the exact checkout or invoice the authenticated Cloud answered. */
export const openCloudCheckout = (url: string) => openStripe(url, "checkout.stripe.com")
export const openCloudInvoice = (url: string) => openStripe(url, "invoice.stripe.com")

/** Open the Google consent page returned by the authenticated Cloud. */
export effect function openGoogleAuthorization(url: URL): boolean!! {
  return effect {
    try tryPromise(() => client().openExternal({ url: url.href, environment: CLOUD_ENVIRONMENT }))
    return true
  } catch () => false
}

/**
 * The cloud on the phone, through the `ElizaCloud` plugin of eliza's Android package: eliza's `cloudClient()` of
 * `@elizaos/os-bridges`, sent only while Android has not said the phone is offline.
 */
export const relayedCloud = Layer.provide(Layer.effect(Cloud, effect {
  const wifi = try WiFi
  const relay = client()
  return { ...plugged(relay, wifi), client: typed(relaying(relay, wifi)), clientFor: (credential: CredentialId) => typed(relaying(relay, wifi, credential)) }
}), phoneWiFi)

// spec/app/platform/index.md, "The owner's tap on a mail sign-in control starts the phone's one more sign-in for mail where the phone wants it, then reads again once"
/**
 * What the phone answers the owner's tap on a mail sign-in control: eliza's `upgradeMailLease`, which the phone starts
 * only where it holds mail back for the lease, and refuses as `Rejected` anywhere else. A browser keeps its usual
 * sign-in route directly. A phone with no sign-in plugin also keeps the usual route.
 */
export effect function mailSignIn(): MailSignIn!! {
  if (!native()) return "MailSignInNotWanted"
  return effect {
    const receipt = try tryPromise({ try: () => signInAccounts().upgradeMailLease({ environment: CLOUD_ENVIRONMENT }), catch: (cause) => new MailSignInUnasked({ cause }) })
    return receipt.verdict.kind === "SignedInAs" ? "SignedInForMail" : "MailSignInEnded"
  } catch (failed) => (failed.cause instanceof SignInRefused && failed.cause.code !== "Rejected" ? "MailSignInEnded" : "MailSignInNotWanted")
}

/** The phone's sign-in did not take the tap: it refused, or there is no sign-in to ask. */
error MailSignInUnasked { cause: unknown }
