// spec/kit/read.md, "Story: Read from outside"; spec/app/platform/index.md, "A refusal carries a wait only when the other side answered 429 with a whole number of seconds, at most a day"; spec/app/platform/index.md, "Only a 2xx answer is the reply; every other status is a refusal"
import { replied, waitAdvised } from "../../gen/app__platform.effect.vibe"
import { type Failure, type Listening, type Opened, type Unsent, Garbled, Refused, Unreachable, parsed, patience, refusal, sse } from "./remote.vibe"

module web {
  const sha256K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  ]

  function sha256Fallback(data: Uint8Array): Uint8Array {
    const bitLen = data.length * 8
    const paddedLen = Math.ceil((data.length + 9) / 64) * 64
    const padded = new Uint8Array(paddedLen)
    padded.set(data)
    padded[data.length] = 0x80
    const view = new DataView(padded.buffer)
    view.setUint32(paddedLen - 8, Math.floor(bitLen / 0x100000000), false)
    view.setUint32(paddedLen - 4, bitLen >>> 0, false)
    let h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a
    let h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19
    const w = new Uint32Array(64)
    const rotr = (x: number, n: number) => (x >>> n) | (x << (32 - n))
    for (let offset = 0; offset < paddedLen; offset += 64) {
      for (let i = 0; i < 16; i++) w[i] = view.getUint32(offset + i * 4, false)
      for (let i = 16; i < 64; i++) {
        const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3)
        const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10)
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0
      }
      let a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7
      for (let i = 0; i < 64; i++) {
        const s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        const ch = (e & f) ^ (~e & g)
        const temp1 = (h + s1 + ch + sha256K[i] + w[i]) >>> 0
        const s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        const maj = (a & b) ^ (a & c) ^ (b & c)
        const temp2 = (s0 + maj) >>> 0
        h = g; g = f; f = e; e = (d + temp1) >>> 0
        d = c; c = b; b = a; a = (temp1 + temp2) >>> 0
      }
      h0 = (h0 + a) >>> 0; h1 = (h1 + b) >>> 0; h2 = (h2 + c) >>> 0; h3 = (h3 + d) >>> 0
      h4 = (h4 + e) >>> 0; h5 = (h5 + f) >>> 0; h6 = (h6 + g) >>> 0; h7 = (h7 + h) >>> 0
    }
    const out = new Uint8Array(32)
    const outView = new DataView(out.buffer)
    ;[h0, h1, h2, h3, h4, h5, h6, h7].forEach((val, idx) => outView.setUint32(idx * 4, val, false))
    return out
  }

  function toBase64Url(bytes: Uint8Array): string {
    let binary = ""
    for (const byte of bytes) binary += String.fromCharCode(byte)
    return btoa(binary).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "")
  }

  /** Cryptographically random URL-safe base64 string of `byteLength` bytes. @throws {never} */
  export function randomBase64Url(byteLength: number): string {
    const buf = new Uint8Array(byteLength)
    crypto.getRandomValues(buf)
    return toBase64Url(buf)
  }

  /** SHA-256 base64url digest of `verifier` for OAuth2 PKCE S256, falling back to software SHA-256 when `crypto.subtle` is unavailable. */
  export async function sha256Base64Url(verifier: string): Promise<string> {
    const encoded = new TextEncoder().encode(verifier)
    if (typeof crypto !== "undefined" && crypto.subtle !== undefined) {
      try {
        const digest = await crypto.subtle.digest("SHA-256", encoded)
        return toBase64Url(new Uint8Array(digest))
      } catch {
        return toBase64Url(sha256Fallback(encoded))
      }
    }
    return toBase64Url(sha256Fallback(encoded))
  }

  /** Join `base`, `path`, and defined query parameters into one URL string without double slashes. @throws {never} */
  export function buildUrl(base: string, path: string, params: Readonly<Record<string, string | undefined>>): string {
    const trimmedBase = base.endsWith("/") ? base.slice(0, -1) : base
    const normalizedPath = path.startsWith("/") ? path : `/${path}`
    const search = new URLSearchParams()
    for (const [key, value] of Object.entries(params)) {
      if (value !== undefined && value !== "") search.set(key, value)
    }
    const query = search.toString()
    return query === "" ? `${trimmedBase}${normalizedPath}` : `${trimmedBase}${normalizedPath}?${query}`
  }
}
import { buildUrl, randomBase64Url, sha256Base64Url } from web

/** Supported first-class user-account messaging providers. */
export type ProviderName = "slack" | "telegram"

/** Provider rejected a call for rate limiting (`429 Retry-After` or `FLOOD_WAIT_<N>`). */
export error RateLimited { provider: ProviderName; retryAfter?: number; code: string }

/** User session or OAuth token is missing, invalid, expired, or revoked (`401` / `token_revoked` / `AUTH_KEY_UNREGISTERED`). */
export error AuthRevoked { provider: ProviderName; code: string; rejected?: Redacted.Redacted<string> }

/** Authenticated user lacks permission for the requested action (`403` / `CHAT_WRITE_FORBIDDEN` / `cant_update_message`). */
export error Forbidden { provider: ProviderName; code: string }

/** Client or provider rejected a bot or app token where only user-account authentication is permitted. */
export error BotTokenRejected { provider: ProviderName; reason: string }

/** Provider returned a structured domain-level error code. */
export error ProviderError { provider: ProviderName; code: string; status: number }

/** Unified failure union across transport, decoding, auth, rate-limiting, permissions, and provider errors. */
export type MessagingFailure = Failure | RateLimited | AuthRevoked | Forbidden | BotTokenRejected | ProviderError

/** The versioned vault record scopes each grant to its owner and messaging account. */
export schema SavedGrant {
  readonly owner: string
  readonly key: string
  readonly access: string
  readonly refresh?: string
  readonly expiresAt?: number
  readonly clientId?: string
  readonly rotation?: { readonly id: string; readonly until: number }
  readonly workspace?: { readonly teamId: string; readonly name: string; readonly ownerUserId: string; readonly brokered?: boolean; readonly authorizationId?: string }
}

/** The same grant metadata with tokens redacted until they reach the vault or provider. */
export type StoredSecret = Omit<SavedGrant, "owner" | "key" | "access" | "refresh"> & {
  readonly accessToken: Redacted.Redacted<string>
  readonly refreshToken?: Redacted.Redacted<string>
}

/** Isolated secret session store for messaging accounts; secrets stay Redacted in platform memory or native secure storage. */
export interface SessionStore {
  owner(): (string | undefined)!!
  get(key: string, expectedOwner?: string): Option.Option<StoredSecret>!!
  set(key: string, secret: StoredSecret, expectedOwner?: string): boolean!!
  exchange(key: string, expected: StoredSecret, next: StoredSecret | undefined, expectedOwner?: string): boolean!!
  delete(key: string, expectedOwner?: string): boolean!!
  keys(): ReadonlyArray<string>!!
}

/** Platform service holding messaging user tokens isolated from renderer state and KeyValueStore persistence. */
export service MessagingSessions: SessionStore {}

/** Wrap raw user-account tokens into a `Redacted` session secret record. */
export function secretOf(accessToken: string, refreshToken?: string, expiresAt?: number): StoredSecret {
  return {
    accessToken: Redacted.make(accessToken),
    ...(refreshToken === undefined ? {} : { refreshToken: Redacted.make(refreshToken) }),
    ...(expiresAt === undefined ? {} : { expiresAt }),
  }
}

/** Extract the raw access token at the outbound HTTP boundary only. */
export function tokenValue(secret: StoredSecret): string {
  return Redacted.value(secret.accessToken)
}

/** Extract the raw refresh token at the outbound HTTP boundary only. */
export function refreshTokenValue(secret: StoredSecret): string | undefined {
  return secret.refreshToken === undefined ? undefined : Redacted.value(secret.refreshToken)
}

/** Both a renewed grant and a new refresh reservation invalidate an earlier comparison. */
export function sameCredential(left: StoredSecret, right: StoredSecret): boolean {
  return tokenValue(left) === tokenValue(right) && refreshTokenValue(left) === refreshTokenValue(right)
    && left.rotation?.id === right.rotation?.id && left.workspace?.authorizationId === right.workspace?.authorizationId
}

/** Isolated in-memory `SessionStore` whose contents never enter `KeyValueStore` or serialized machine state. */
export function createSessionStore(): SessionStore {
  const entries = new Map<string, StoredSecret>()
  const owner = randomBase64Url(24)
  return {
    owner: () => succeed(owner),
    get: (key: string, expectedOwner?: string) => sync(() => {
      const found = expectedOwner === undefined || expectedOwner === owner ? entries.get(key) : undefined
      return found === undefined ? Option.none() : Option.some(found)
    }),
    set: (key: string, secret: StoredSecret, expectedOwner?: string) => sync(() => {
      if (expectedOwner !== undefined && expectedOwner !== owner) return false
      entries.set(key, secret)
      return true
    }),
    exchange: (key: string, expected: StoredSecret, next: StoredSecret | undefined, expectedOwner?: string) => sync(() => {
      if (expectedOwner !== undefined && expectedOwner !== owner) return false
      const previous = entries.get(key)
      if (!previous || !sameCredential(previous, expected)) return false
      if (next === undefined) entries.delete(key)
      else entries.set(key, next)
      return true
    }),
    delete: (key: string, expectedOwner?: string) => sync(() => {
      if (expectedOwner !== undefined && expectedOwner !== owner) return false
      entries.delete(key)
      return true
    }),
    keys: () => sync(() => Array.from(entries.keys())),
  }
}

/** Default `MessagingSessions` layer backed by an isolated in-memory secret map. */
export const messagingSessions = Layer.sync(MessagingSessions, createSessionStore)

/** Nonsecret identity for a notification bound to the current owner and messaging account. */
export effect function noticeScope(parts: readonly string[]): string!! {
  return try promise(() => sha256Base64Url(JSON.stringify(["alpha-messaging-notice", ...parts])))
}

/** OAuth2 PKCE S256 verifier/challenge pair. */
export interface PkcePair {
  readonly verifier: string
  readonly challenge: string
  readonly method: "S256"
}

/** Generate a fresh OAuth2 PKCE S256 verifier and challenge pair. */
export effect function createPkcePair(): PkcePair!! {
  const verifier = randomBase64Url(32)
  const challenge = try promise(() => sha256Base64Url(verifier))
  return { verifier, challenge, method: "S256" }
}

/** Generate a fresh URL-safe OAuth2 CSRF `state` token. */
export function randomState(): string {
  return randomBase64Url(24)
}

/** Build a URL from `base`, `path`, and optional query parameters. */
export function joinBaseUrl(base: string, path: string, params: Readonly<Record<string, string | undefined>>): string {
  return buildUrl(base, path, params)
}

/** Omit `undefined` values from an object before JSON encoding. */
export function compactRecord(input: Readonly<Record<string, unknown>>): Record<string, unknown> {
  return Object.fromEntries(Object.entries(input).filter(([, value]) => value !== undefined))
}

/** Convert defined primitive query parameters into string entries for `HttpClientRequest`. */
export function stringParams(params: Readonly<Record<string, string | number | boolean | undefined>>): Record<string, string> {
  const out: Record<string, string> = {}
  for (const [key, value] of Object.entries(params)) {
    if (value !== undefined) out[key] = String(value)
  }
  return out
}

/** Attach an `Authorization: Bearer` header to `request`. */
export function bearerRequest(request: HttpClientRequest.HttpClientRequest, token: string): HttpClientRequest.HttpClientRequest {
  return HttpClientRequest.bearerToken(request, token)
}

/** Attach an `Idempotency-Key` header when `idempotencyKey` is non-empty. */
export function idempotentRequest(request: HttpClientRequest.HttpClientRequest, idempotencyKey?: string): HttpClientRequest.HttpClientRequest {
  return idempotencyKey !== undefined && idempotencyKey !== ""
    ? HttpClientRequest.setHeader(request, "idempotency-key", idempotencyKey)
    : request
}

/** Build a JSON POST request with optional Bearer token and idempotency key. */
export function jsonPost(
  path: string,
  body: Readonly<Record<string, unknown>>,
  token?: string,
  idempotencyKey?: string,
): HttpClientRequest.HttpClientRequest {
  const base = HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(path), compactRecord(body))
  const withAuth = token === undefined ? base : bearerRequest(base, token)
  return idempotentRequest(withAuth, idempotencyKey)
}

/** Build a GET request with query parameters and optional Bearer token. */
export function queryGet(
  path: string,
  params: Readonly<Record<string, string | number | boolean | undefined>>,
  token?: string,
): HttpClientRequest.HttpClientRequest {
  const base = HttpClientRequest.get(path, { urlParams: stringParams(params) })
  return token === undefined ? base : bearerRequest(base, token)
}

/** Bound an advised wait duration in whole seconds by the platform's `waitAdvised` rule (at most 86400s). */
export function boundWaitSeconds(seconds: number): number | undefined {
  return waitAdvised(429, Number.isSafeInteger(seconds), seconds) ? seconds : undefined
}

/** Parse a `Retry-After` integer header value in seconds, returning `undefined` when missing, non-numeric, or outside `waitAdvised` bounds. */
export function parseRetryAfter(header: string | undefined): number | undefined {
  if (header === undefined) return undefined
  const trimmed = header.trim()
  if (!/^\d+$/.test(trimmed)) return undefined
  return boundWaitSeconds(Number(trimmed))
}

/** Decode an untrusted JSON payload using `schema`, failing with `Garbled` on mismatch. */
export effect function decodeWith<A>(schema: Schema.Decoder<A>, value: unknown): A!Garbled {
  return Schema.decodeUnknownEffect(schema)(value) catch effect (cause) => { throw new Garbled({ cause }) }
}

/** Translate transport-level `Refused` statuses (`429`, `401`, `403`) into typed messaging failures. */
export function mapHttpFailure(provider: ProviderName, failure: Failure): MessagingFailure {
  return match (failure) {
    when Refused: failure.status === 429
      ? new RateLimited({ provider, ...(failure.wait === undefined ? {} : { retryAfter: failure.wait }), code: "rate_limited" })
      : failure.status === 401
        ? new AuthRevoked({ provider, code: "unauthorized" })
        : failure.status === 403
          ? new Forbidden({ provider, code: "forbidden" })
          : failure;
    default: failure;
  }
}

export interface MessagingWire {
  open(request: HttpClientRequest.HttpClientRequest): Opened!(Unsent | Unreachable)
}

/** Decoded HTTP response with status, headers, and parsed JSON body. */
export interface OpenedJson {
  readonly status: number
  readonly headers: Readonly<Record<string, string>>
  readonly body: unknown
}

/** Open an HTTP request via `wired` and read + parse its JSON body within `patience`. */
export effect function openJson(wired: MessagingWire, request: HttpClientRequest.HttpClientRequest): OpenedJson!(Unsent | Unreachable | Garbled) {
  const opened = try wired.open(request)
  const text = timeout(opened.text, patience) catch effect (cause) => { throw new Unreachable({ cause }) }
  const body = try parsed(text)
  return { status: opened.status, headers: opened.headers, body }
}

/** Execute a JSON request through `wired`, routing non-2xx responses to `onErrorStatus` and 2xx responses to `decodeOk`. */
export effect function executeJson<A>(
  wired: MessagingWire,
  request: HttpClientRequest.HttpClientRequest,
  onErrorStatus: (opened: OpenedJson) => MessagingFailure,
  decodeOk: (opened: OpenedJson) => A!MessagingFailure,
): A!MessagingFailure {
  const opened = try openJson(wired, request)
  if (!replied(opened.status)) throw onErrorStatus(opened)
  return try decodeOk(opened)
}

/** Open an authenticated SSE stream via `wired`, translating non-2xx or JSON error responses into typed `MessagingFailure`s. */
export function openEventStream<A>(
  wired: MessagingWire,
  provider: ProviderName,
  request: HttpClientRequest.HttpClientRequest,
  schema: Schema.Decoder<A>,
  onErrorBody: (status: number, body: unknown, retryAfter: string | undefined) => MessagingFailure,
  listening?: Listening,
): Stream.Stream<A, MessagingFailure> {
  return Stream.unwrap(effect {
    const opened = try wired.open(request)
    const retryAfter = opened.headers["retry-after"]
    const contentType = opened.headers["content-type"] ?? ""
    if (!replied(opened.status) || contentType.includes("application/json")) {
      const text = timeout(opened.text, patience) catch effect (cause) => { throw new Unreachable({ cause }) }
      const body = parsed(text) catch () => undefined
      throw onErrorBody(opened.status, body, retryAfter)
    }
    return sse(opened.body, listening)
      |> Stream.mapError(%, (failure) => mapHttpFailure(provider, failure))
      |> Stream.mapEffect(%, (data) => decodeWith(schema, data))
  })
}

/** Map a non-2xx HTTP status with no structured error body into a `MessagingFailure`. */
export function fallbackStatusError(provider: ProviderName, status: number, retryAfter: string | undefined): MessagingFailure {
  return mapHttpFailure(provider, refusal(status, retryAfter))
}
