// spec/kit/read.md, "Story: Read from outside"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Install, install, type Time, timeOver } from "../runtime/index.vibe"
import { type Agent, agentAt, relayedAgent } from "./agent.vibe"
import { type Cloud, cloudAt, relayedCloud } from "./cloud.vibe"
import { allowsTestOrigin, browserCloudOrigin, cloudApiOrigin } from "./build.ts"
import { Device, browserDevice, phoneDevice } from "./device.vibe"
import { browserMessagingNotices } from "./messaging-notices.vibe"
import { browserVoiceBridge } from "./voice.vibe"
import { phoneMessagingSessions } from "./messaging-sessions.vibe"
import { type MessagingSessions, messagingSessions } from "./messaging.vibe"
import { type Plugins, browserPlugins, phonePlugins } from "./plugins.vibe"
import { sharedStore } from "./sharedStore.vibe"
import { browserSlackHttp, nativeSlackHttp } from "./slack-oauth.vibe"
import { type Slack, slackAt } from "./slack.vibe"
import { personalTelegram } from "./telegram-mtproto.vibe"
import { type Telegram, telegramAt } from "./telegram.vibe"
import { type Vault, browserVault, relayedVault } from "./vault.vibe"

module web {
  /** Probe `localStorage` without throwing in restricted or sandboxed browser contexts. @throws {never} */
  export function probeStorage(): Storage | undefined {
    try {
      const candidate = globalThis.localStorage
      if (candidate === undefined) return undefined
      void candidate.length
      return candidate
    } catch {
      return undefined
    }
  }
}
import { probeStorage } from web

/** Optional overrides for Slack, Telegram, and isolated messaging session layers. */
export interface MessagingLayers {
  readonly slack?: Layer.Layer<Slack>
  readonly telegram?: Layer.Layer<Telegram>
  readonly sessions?: Layer.Layer<MessagingSessions>
}

/** Every service of the world outside Alpha. Areas reach the world only through these. */
export type Platform = KeyValueStore.KeyValueStore | Time | Install | Agent | Cloud | Device | Vault | Plugins | MessagingSessions | Slack | Telegram

/** Alpha's time and its installation's name, which every platform has: over the store, and over the phone that says when the page woke. */
export const grounded = Layer.merge(install, Layer.unwrap(effect { return timeOver((try Device).visible) }))

const store = Layer.unwrap(sync(() => {
  const available = probeStorage()
  return available === undefined ? KeyValueStore.layerMemory : KeyValueStore.layerStorage(() => available)
}))

function messagingLayers(overrides?: MessagingLayers) {
  return Layer.mergeAll(
    overrides?.sessions ?? messagingSessions,
    overrides?.slack ?? Layer.provide(slackAt("https://slack.com", cloudApiOrigin), nativeSlackHttp),
    overrides?.telegram ?? personalTelegram,
  )
}

/** The phone: each service through eliza's client of its Capacitor plugin, with the agent's token and the cloud's key kept in native code; the plugins' services may tell the time. */
export function phonePlatform(messaging?: MessagingLayers): Layer.Layer<Platform> {
  return Layer.provideMerge(phonePlugins, Layer.provideMerge(grounded, Layer.provideMerge(Layer.mergeAll(phoneDevice, relayedVault, relayedAgent, relayedCloud, messagingLayers({ ...messaging, sessions: messaging?.sessions ?? Layer.provide(phoneMessagingSessions, relayedVault) })), sharedStore(store))))
}

/** A page that is no phone: `agent` and `cloud` as they are reached from it, optional messaging layers, and no image, plugins or secrets. */
export function pagePlatform(agent: Layer.Layer<Agent>, cloud: Layer.Layer<Cloud>, messaging?: MessagingLayers): Layer.Layer<Platform> {
  return Layer.provideMerge(grounded, Layer.provideMerge(Layer.mergeAll(browserDevice, browserVault, agent, cloud, browserPlugins, messagingLayers(messaging)), store))
}

/** The Slack client shared by the browser app and its hosted workspace page. */
function browserSlack(origin: string) {
  return Layer.provide(allowsTestOrigin() ? slackAt(`${origin}/slack`, `${origin}/slack`, "browser") : slackAt("https://slack.com", browserCloudOrigin(origin), "browser"), browserSlackHttp)
}

/** The hosted Slack page uses its browser tab as the session owner. */
export function hostedSlackPlatform(origin: string) {
  return Layer.provideMerge(Layer.mergeAll(grounded, browserVoiceBridge, browserMessagingNotices, messagingSessions, browserSlack(origin)), Layer.provideMerge(browserDevice, store))
}

/** A browser page: the agent, cloud, Slack, and Telegram at the page's own `/agent`, `/cloud`, `/slack`, and `/telegram`, which the dev server answers. */
export function browserPlatform(origin: string): Layer.Layer<Platform> {
  return pagePlatform(
    Layer.provide(agentAt(`${origin}/agent`), FetchHttpClient.layer),
    Layer.provide(cloudAt(`${origin}/cloud`), FetchHttpClient.layer),
    {
      slack: browserSlack(origin),
      telegram: allowsTestOrigin() ? Layer.provide(telegramAt(`${origin}/telegram`), FetchHttpClient.layer) : personalTelegram,
    },
  )
}
