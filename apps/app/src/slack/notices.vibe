// spec/app/slack/notices.md, "Story: Hear about Slack DMs, mentions and thread replies per workspace"
import { slackNoticeTarget } from "./notice-targets.vibe"
import { MessagingNotices } from "../platform/index.vibe"
import type { MessagingSessions } from "../platform/index.vibe"
import { type SlackEventEnvelope, type SlackMessage, RateLimited, Slack } from "../platform/index.vibe"
import { type Job, answer, contained, reacting, run, stop } from "../runtime/index.vibe"
import {
  SlackLedger,
  channelTitleOf,
  convKindOf,
  handleSlackFailure,
  targetId,
  withWorkspaceToken,
  messageSenderName,
} from "./ledger.vibe"
import * as Notices from "../../gen/app__slack__notices.effect.vibe"
import type { Effect as Out, Event, Incoming, Target } from "../../gen/app__slack__notices.effect.vibe"
import * as Auth from "../../gen/app__slack__auth.effect.vibe"
import type * as Conversation from "../../gen/app__slack__conversation.effect.vibe"
import type * as Workspaces from "../../gen/app__slack.effect.vibe"

const emptyIncoming: Incoming = {
  channel: 0,
  threadTs: 0,
  ts: 0,
  kind: "PublicChannel",
  isOwn: false,
  mentioned: false,
  inThread: false,
}

const pendingIncoming = new Map<number, Incoming[]>()

function enqueueIncoming(workspace: number, incoming: Incoming) {
  const list = pendingIncoming.get(workspace) ?? []
  list.push(incoming)
  pendingIncoming.set(workspace, list)
}

function dequeueIncoming(workspace: number): Incoming | undefined {
  const list = pendingIncoming.get(workspace)
  if (!list || list.length === 0) return undefined
  const first = list.shift()
  if (list.length === 0) pendingIncoming.delete(workspace)
  return first
}

effect function waitAndPoll(workspace: number): void!!Notices.Machine {
  const machine = try Notices.Machine
  try Stream.runHead(Stream.filter(machine.changes, (s) => Notices.canPoll(s, workspace) || !Notices.watching(s, workspace)))
  const current = try machine.get()
  if (Notices.canPoll(current, workspace)) {
    try contained(machine.send({ type: "poll", workspace }), "Slack notices poll")
  }
}

effect function handleLiveEnvelope(
  workspace: number,
  envelope: SlackEventEnvelope,
): void!!(Auth.Machine | Conversation.Machine | Notices.Machine | SlackLedger) {
  const ledger = try SlackLedger
  const meta = ledger.workspaceMeta(workspace)
  if (!meta || envelope.team_id !== meta.teamId) return
  const payload = envelope.event
  if (payload.type === "tokens_revoked") {
    try contained((try Auth.Machine).send({ type: "workspaceRevoked", workspace }), "Slack SSE tokens revoked")
    return
  }
  if (payload.type === "channel_marked") {
    const chNum = ledger.channelNum(workspace, payload.channel)
    ledger.setChannelRead(workspace, chNum, payload.ts)
    return
  }
  if (payload.type === "reaction_added" || payload.type === "reaction_removed") {
    const chNum = ledger.channelNum(workspace, payload.item.channel)
    ledger.applyReaction(workspace, chNum, payload.item.ts, payload.reaction, payload.user, payload.type === "reaction_added")
    return
  }
  if (payload.type !== "message") return
  if (payload.subtype === "message_changed" && payload.message) {
    const chNum = ledger.channelNum(workspace, payload.channel)
    ledger.updateMessageText(workspace, chNum, payload.message.ts, payload.message.text)
    return
  }
  if (payload.subtype === "message_deleted" && payload.deleted_ts) {
    const chNum = ledger.channelNum(workspace, payload.channel)
    ledger.removeMessage(workspace, chNum, payload.deleted_ts)
    return
  }
  if (payload.user === undefined || payload.text === undefined) return
  const msg: SlackMessage = {
    type: "message",
    ts: payload.ts,
    user: payload.user,
    text: payload.text,
    thread_ts: payload.thread_ts,
    reply_broadcast: payload.reply_broadcast,
  }
  const front = (try (try Notices.Machine).get()).front
  const chNum = ledger.channelNum(workspace, payload.channel)
  const isOwn = payload.user === meta.ownerUserId
  const parent = payload.thread_ts && payload.thread_ts !== payload.ts ? ledger.tsNum(workspace, chNum, payload.thread_ts) : 0
  const isFront = front.workspace === workspace && front.channel === chNum && front.threadTs === parent
  const saved = ledger.upsertMessage(workspace, payload.channel, msg, !isOwn && !isFront)
  const channel = ledger.channelOf(workspace, saved.channel)
  const kind = channel ? convKindOf(channel) : "PublicChannel"
  const mentioned = payload.text.includes(`<@${meta.ownerUserId}>`)
  const inThread = payload.thread_ts !== undefined && payload.thread_ts !== payload.ts &&
    (ledger.hasParticipatedThread(workspace, payload.channel, payload.thread_ts) || mentioned)
  enqueueIncoming(workspace, {
    channel: saved.channel,
    threadTs: saved.threadTs,
    ts: saved.ts,
    kind,
    isOwn,
    mentioned,
    inThread,
  })
  try waitAndPoll(workspace)
}

effect function readWorkspaceEvents(workspace: number, cursor: number | undefined) {
  const slack = try Slack
  return try withWorkspaceToken(workspace, (token) => slack.readEvents(token, cursor))
}

effect function watchWorkspace(
  workspace: number,
): void!!(Slack | SlackLedger | MessagingSessions | Auth.Machine | Conversation.Machine | Notices.Machine) {
  const ledger = try SlackLedger
  const grant = ledger.workspaceMeta(workspace)
  if (!grant?.brokered) return
  let cursor: number | undefined
  while (ledger.workspaceMeta(workspace) === grant) {
    const page = readWorkspaceEvents(workspace, cursor) catch (failure) => failure
    if (page === undefined || ledger.workspaceMeta(workspace) !== grant) return
    if (!("events" in page)) {
      const disposition = try handleSlackFailure(workspace, page)
      if (disposition === "Revoked") return
      const seconds = page instanceof RateLimited ? Math.max(1, page.retryAfter ?? 5) : 5
      try sleep(seconds * 1000)
      continue
    }
    const advanced = cursor !== undefined && page.cursor > cursor
    if (cursor === undefined) try waitAndPoll(workspace)
    else if (advanced) {
      for (const envelope of page.events) try handleLiveEnvelope(workspace, envelope)
    }
    cursor = page.cursor
    if (!advanced) try sleep("5 seconds")
  }
}

/** Change delivery of Alpha's live notices for this connected workspace and channel. */
export effect function muteSlackNotices(workspace: number, channel: number, muted: boolean): boolean!!(Notices.Machine | SlackLedger) {
  const notices = try Notices.Machine
  const ledger = try SlackLedger
  const state = try notices.get()
  if (!Notices.watching(state, workspace) || !ledger.channelOf(workspace, channel)) return false
  if (Notices.canMuteChannelChanged(state, channel, muted))
    try contained(notices.send({ type: "muteChannelChanged", channel, isMuted: muted }), "Slack local notification mute")
  ledger.setChannelMuted(workspace, channel, muted)
  return true
}

effect function pollWorkspace(ticket: number, workspace: number): Event!!SlackLedger {
  const ledger = try SlackLedger
  const point = ledger.nextWatermarkPoint(workspace)
  const incoming = dequeueIncoming(workspace) ?? emptyIncoming
  return { type: "polled", ticket, ok: true, point, incoming }
}

effect function postSlackNotice(target: Target, ts: number): void!!(SlackLedger | MessagingNotices | MessagingSessions | Notices.Machine) {
  const destination = try slackNoticeTarget(target)
  if (!destination) return
  const ledger = try SlackLedger
  const meta = ledger.workspaceMeta(target.workspace)
  const channel = ledger.channelOf(target.workspace, target.channel)
  const users = ledger.usersOf(target.workspace)
  const tsStr = ledger.tsStr(target.workspace, target.channel, ts)
  const list = target.threadTs > 0
    ? ledger.threadMessagesOf(target.workspace, target.channel, target.threadTs)
    : ledger.channelMessagesOf(target.workspace, target.channel)
  const msg = tsStr ? list.find((m) => m.ts === tsStr) : list.at(-1)
  const channelName = channel ? channelTitleOf(channel, users, meta?.ownerUserId ?? "") : `Channel ${target.channel}`
  const title = meta ? `${meta.name} · ${channelName}` : channelName
  const sender = msg ? messageSenderName(users, msg) : "Slack"
  const body = msg ? `${sender}: ${msg.text}` : "New Slack message"
  const notices = try Notices.Machine
  const current = effect {
    const stillUp = (try notices.get()).up.some((item) => item.ts === ts && targetId(item.target) === targetId(target))
    return stillUp && (try slackNoticeTarget(target))?.scope === destination.scope
  }
  if (!(try current)) return
  const host = try MessagingNotices
  if (host.native && !(try host.post(destination, title, body))) return
  if (!(try current)) {
    try host.withdraw(destination)
    return
  }
  ledger.putNotice({
    destination,
    key: targetId(target),
    workspace: target.workspace,
    channel: target.channel,
    threadTs: target.threadTs,
    timestamp: tsStr ?? "",
    title,
    body,
  })
}

function carry(
  fx: Out,
): Job<Event, Slack | SlackLedger | MessagingSessions | MessagingNotices | Auth.Machine | Workspaces.Machine | Conversation.Machine | Notices.Machine, []> {
  return match (fx) {
    when { tag: "ScheduleWorkspace", let workspace }:
      run(`slack-sse-${workspace}`, watchWorkspace(workspace));
    when { tag: "UnscheduleWorkspace", let workspace }:
      stop(`slack-sse-${workspace}`);
    when { tag: "PollWorkspace", let ticket, let workspace }:
      answer(`slack-poll-${ticket}`, pollWorkspace(ticket, workspace), { type: "polled", ticket, ok: false, point: 0, incoming: emptyIncoming });
    when { tag: "PostNotice", let target, let ts }:
      run(`slack-notice-${targetId(target)}`, postSlackNotice(target, ts));
    when { tag: "WithdrawTarget", let target }:
      run(`slack-withdraw-target-${targetId(target)}`, effect {
        const destination = try slackNoticeTarget(target)
        if (destination) try (try MessagingNotices).withdraw(destination)
        ;(try SlackLedger).removeTargetNotice(target)
      });
    when { tag: "WithdrawWorkspace", let workspace }:
      run(`slack-withdraw-ws-${workspace}`, sync(() => { pendingIncoming.delete(workspace) }));
    when { tag: "WithdrawAll" }:
      run("slack-withdraw-all", effect {
        try (try MessagingNotices).withdraw({ provider: "slack" })
        ;(try SlackLedger).clearAllNotices()
      });
  }
}

/** Slack per-workspace live-sync and notification machine layer. */
export const slackNotices = reacting(Notices, {
  open: [{ type: "restart" }],
  carry,
})
