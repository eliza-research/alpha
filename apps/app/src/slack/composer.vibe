// spec/app/slack/composer.md, "Story: Draft and send Slack messages and thread replies safely"
import type * as Auth from "../../gen/app__slack__auth.effect.vibe"
import * as Composer from "../../gen/app__slack__composer.effect.vibe"
import type { Actor, Effect as Out, Event, TargetKey } from "../../gen/app__slack__composer.effect.vibe"
import type { MessagingSessions } from "../platform/index.vibe"
import { Unreachable } from "../platform/index.vibe"
import { Slack } from "../platform/index.vibe"
import { Attempts } from "../runtime/index.vibe"
import { type Job, answer, contained, due, reacting, run, started, together, untimed } from "../runtime/index.vibe"
import { SlackLedger, handleSlackFailure, withWorkspaceToken } from "./ledger.vibe"

effect function recordSend(id: number, target: TargetKey): Event!!SlackLedger {
  const ledger = try SlackLedger
  const text = (ledger.stagedAlphaDraft(target) ?? ledger.draftText(target)).trim()
  if (text === "") return { type: "sendRecorded", id, ok: false }
  ledger.recordSendPayload(id, target, text)
  return { type: "sendRecorded", id, ok: true }
}

effect function dispatchSend(
  id: number,
  target: TargetKey,
  broadcast: boolean,
): Event!!(Attempts | Slack | SlackLedger | MessagingSessions | Auth.Machine) {
  const slack = try Slack
  const ledger = try SlackLedger
  const attempts = try Attempts
  const channelId = ledger.channelId(target.workspace, target.channel)
  const recorded = ledger.sendPayload(id)
  if (channelId === undefined || recorded === undefined) {
    return { type: "sendAnswered", id, confirmed: false, known: true }
  }
  const threadTs = target.threadTs > 0 ? ledger.tsStr(target.workspace, target.channel, target.threadTs) : undefined
  const idempotencyKey = try attempts.key(id)
  const resp = withWorkspaceToken(target.workspace, (token) => slack.postMessage(
    token,
    {
      channel: channelId,
      text: recorded.text,
      threadTs,
      replyBroadcast: threadTs !== undefined && broadcast ? true : undefined,
    },
    idempotencyKey,
  )) catch (failure) => failure
  if (resp === undefined) return { type: "sendAnswered", id, confirmed: false, known: true }
  if (!("ok" in resp)) {
    try handleSlackFailure(target.workspace, resp)
    return { type: "sendAnswered", id, confirmed: false, known: !(resp instanceof Unreachable) }
  }
  ledger.setRateLimitNotice(undefined)
  ledger.upsertMessage(target.workspace, channelId, resp.message, false)
  ledger.setDraftText(target, "")
  ledger.setStagedAlphaDraft(target, undefined)
  ledger.clearSendPayload(id)
  return { type: "sendAnswered", id, confirmed: true, known: true }
}

effect function readBackSend(
  ticket: number,
  id: number,
  target: TargetKey,
): Event!!(Slack | SlackLedger | MessagingSessions | Auth.Machine) {
  const slack = try Slack
  const ledger = try SlackLedger
  const channelId = ledger.channelId(target.workspace, target.channel)
  const recorded = ledger.sendPayload(id)
  const ownerId = ledger.workspaceMeta(target.workspace)?.ownerUserId ?? ""
  if (channelId === undefined || recorded === undefined) {
    return { type: "readBackAnswered", ticket, ok: true, wasSent: false }
  }
  const threadStr = target.threadTs > 0 ? ledger.tsStr(target.workspace, target.channel, target.threadTs) : undefined
  const page = withWorkspaceToken(target.workspace, (token) => threadStr !== undefined
    ? slack.replies(token, channelId, threadStr, { limit: 20 })
    : slack.history(token, channelId, { limit: 20 })) catch (failure) => failure
  if (page === undefined) return { type: "readBackAnswered", ticket, ok: true, wasSent: false }
  if (!("ok" in page)) {
    try handleSlackFailure(target.workspace, page)
    return { type: "readBackAnswered", ticket, ok: false, wasSent: false }
  }
  const wasSent = page.messages.some((msg) => msg.user === ownerId && msg.text === recorded.text)
  if (wasSent) {
    ledger.setDraftText(target, "")
    ledger.setStagedAlphaDraft(target, undefined)
    ledger.clearSendPayload(id)
  }
  return { type: "readBackAnswered", ticket, ok: true, wasSent }
}

function carry(
  fx: Out,
): Job<Event, Slack | SlackLedger | MessagingSessions | Auth.Machine, [by: Actor]> {
  return match (fx) {
    when { tag: "SaveDraft" }:
      answer("slack-save-draft", Effect.succeed({ type: "draftSaved" } as const), { type: "draftSaved" }, "Device");
    when { tag: "DropDraft", let target }:
      run("slack-drop-draft", effect {
        const ledger = try SlackLedger
        ledger.setDraftText(target, "")
        ledger.setStagedAlphaDraft(target, undefined)
      }, "Device");
    when { tag: "RecordSend", let id, let target }:
      answer(`slack-record-${id}`, recordSend(id, target), { type: "sendRecorded", id, ok: false }, "Device");
    when { tag: "DispatchSend", let id, let target, let broadcast }:
      answer(`slack-dispatch-${id}`, dispatchSend(id, target, broadcast), { type: "sendAnswered", id, confirmed: false, known: false }, "Device");
    when { tag: "ReadBackSend", let ticket, let id, let target }:
      answer(`slack-readback-${ticket}`, readBackSend(ticket, id, target), { type: "readBackAnswered", ticket, ok: false, wasSent: false }, "Device");
  }
}

const draftSaver = started(effect {
  const composer = try Composer.Machine
  try Stream.runForEach(composer.changes, effect (state) => {
    if (Composer.canSaveDraft(state, "Device")) {
      try contained(composer.send({ type: "saveDraft" }, "Device"), "Slack auto save draft")
    }
  })
}, "Slack draft saver")

/** Slack per-`(workspace, channel, threadTs)` composer machine layer with 1-step Alpha undo and idempotent sends. */
export const slackComposer = together(
  reacting(Composer, {
    carry,
    timers: (state) => (state.alphaUndo.holding === "Held"
      ? [due(`slack-undo-${state.alphaUndo.until}`, state.alphaUndo.until, { type: "releaseUndo", now: untimed } as const, "Device" as const)]
      : []),
  }),
  draftSaver,
)
