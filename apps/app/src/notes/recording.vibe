// spec/app/notes/recording.md, "Story: Record a voice note"; spec/app/notes/recording.md, "Story: Discard a recording"; spec/app/notes/recording.md, "Story: Pick up a recording a crash cut off"; spec/app/notes/microphone.md, "Story: Allow the microphone for a voice note"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Rec from "../../gen/app__notes__recording.effect.vibe"
import * as Mic from "../../gen/app__notes__microphone.effect.vibe"
import { Machine as Notes, readyForNew } from "../../gen/app__notes.effect.vibe"
import { Machine as Editor, waiting } from "../../gen/app__notes__editor.effect.vibe"
import { Machine as Voice, silent } from "../../gen/app__notes__voice.effect.vibe"
import { Machine as Link } from "../../gen/app__notes__linkNote.effect.vibe"
import { Machine as Trash } from "../../gen/app__notes__trash.effect.vibe"
import type { Actor } from "../../gen/app__notes__note.effect.vibe"
import { Machine as Calls } from "../../gen/app__phone__call.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Device } from "../platform/index.vibe"
import type { Agent } from "../platform/index.vibe"
import { NoteStore } from "../platform/index.vibe"
import { NoteDevice, type Tape, ownerDigest, noteDevice } from "../platform/index.vibe"
import { ownerAt } from "../platform/index.vibe"
import { Attempts } from "../runtime/index.vibe"
import { type Job, answer, following, reacting, run, started, together } from "../runtime/index.vibe"
import { createShelf } from "../runtime/index.vibe"
import { NoteContent, audioIdOf, numberOf } from "./content.vibe"

const phone: Actor = "Phone"
const takesKey = "alpha/notes/takes@1"

const TakeEntry = Schema.Struct({ owner: Schema.Int, take: Schema.Int, recordingId: Schema.NonEmptyString })
const TakeTable = Schema.fromJsonString(Schema.Array(TakeEntry))

/** Durable `take -> recordingId` map so crash recovery and lookup never depend on 52-bit hashes or `currentTape()`. */
service TakeRegistry {
  bind(owner: number, take: number, recordingId: string): void!!
  recordingFor(owner: number, take: number): (string | undefined)!!
  takeFor(owner: number, recordingId: string, minimum: number): number!!
  forget(owner: number, take: number): void!!
}

const takeRegistry = Layer.effect(TakeRegistry, effect {
  const kv = try KeyValueStore.KeyValueStore
  const readAll = effect {
    const raw = kv.get(takesKey) catch () => undefined
    if (raw === undefined) return [] as Array<typeof TakeEntry.Type>
    const decoded = Schema.decodeUnknownOption(TakeTable)(raw)
    return Option.isSome(decoded) ? [...decoded.value] : [] as Array<typeof TakeEntry.Type>
  }
  let entries = try readAll
  const persist = effect {
    try ignore(kv.set(takesKey, JSON.stringify(entries.slice(-32))))
  }
  return {
    effect bind(owner: number, take: number, recordingId: string) {
      entries = [...entries.filter((e) => !(e.owner === owner && (e.take === take || e.recordingId === recordingId))), { owner, take, recordingId }]
      try persist
    },
    recordingFor: (owner: number, take: number) => sync(() => entries.find((e) => e.owner === owner && e.take === take)?.recordingId),
    effect takeFor(owner: number, recordingId: string, minimum: number) {
      const existing = entries.find((e) => e.owner === owner && e.recordingId === recordingId)
      if (existing !== undefined) return existing.take
      const maxTake = entries.filter((e) => e.owner === owner).reduce((max, e) => Math.max(max, e.take), 0)
      const next = Math.max(minimum, maxTake + 1)
      entries = [...entries, { owner, take: next, recordingId }]
      try persist
      return next
    },
    effect forget(owner: number, take: number) {
      entries = entries.filter((e) => !(e.owner === owner && e.take === take))
      try persist
    },
  }
})

export const levelCount = 44
type Meter = { readonly owner: number; readonly take: number; readonly seconds: number; readonly levels: readonly number[] }

export service RecordingDisplay {
  readonly snapshot: () => Meter
  readonly subscribe: (listener: () => void) => () => void
  tell(owner: number, take: number, durationMs: number, peak?: number): void!!
}

const emptyMeter: Meter = { owner: 0, take: 0, seconds: 0, levels: [] }

const display = Layer.effect(RecordingDisplay, effect {
  const shelf = createShelf<Meter>(emptyMeter, { reset: () => emptyMeter })
  let lastDuration = -1
  try Effect.addFinalizer(() => sync(() => { lastDuration = -1; shelf.reset() }))
  return {
    snapshot: shelf.snapshot,
    subscribe: shelf.subscribe,
    tell: (owner: number, take: number, durationMs: number, peak?: number) => sync(() => {
      const shown = shelf.get()
      const same = shown.owner === owner && shown.take === take
      if (!same) lastDuration = -1
      if (durationMs <= lastDuration) return
      lastDuration = durationMs
      const previous = same ? shown.levels : []
      const levels = peak === undefined ? previous : [...previous, peak].slice(-levelCount)
      const seconds = Math.trunc(durationMs / 1000)
      if (same && shown.seconds === seconds && shown.levels === levels) return
      shelf.set({ owner, take, seconds, levels })
    }),
  }
})

type Scope = Rec.Machine | Mic.Machine | Notes | Editor | Voice | Link | Trash | Shell | Device | NoteDevice | NoteContent | NoteStore | Agent | TakeRegistry

effect function currentTape(expectedOwner?: number): (Tape | undefined)!!(NoteDevice | Agent) {
  const device = try NoteDevice
  const own = ownerAt() catch () => ""
  if (own === "" || (expectedOwner !== undefined && numberOf("owner", own) !== expectedOwner)) return undefined
  const fingerprint = try promise(() => ownerDigest(own))
  const tape = device.status(fingerprint) catch () => undefined
  return tape?.binding?.ownerDigest === fingerprint ? tape : undefined
}

/** Live admission facts for recording, computed from microphone permission, device, shell visibility, and playback. */
effect function room(): Rec.Admission!!(NoteDevice | Device | Shell | Voice) {
  const device = try NoteDevice
  const front = (try (try Device).showing()) && showing(try (try Shell).get(), "Notes")
  return { allowed: (try device.permission()) === "Granted", free: device.available, front, silent: silent(try (try Voice).get()) }
}

effect function covered(): boolean!!(Editor | Link | Voice | Trash) {
  const editor = try (try Editor).get()
  return editor.showing || waiting(editor) || (try (try Link).get()).showing || (try (try Voice).get()).showing || (try (try Trash).get()).showing
}

effect function start(folder: number): boolean!!Scope {
  const recorder = try Rec.Machine
  const list = try (try Notes).get()
  const admission = try room()
  const outside = try covered()
  const canStart = Rec.canStart(try recorder.get(), admission, readyForNew(list), folder, outside, "Owner")
  if (!canStart) return false
  return effect {
    try recorder.send({ type: "start", room: admission, available: readyForNew(list), folder, covered: outside }, "Owner")
    return true
  } catch () => false
}

/** The owner's Record button, whether it can start or needs to ask Android first. */
export const record = effect {
  const notes = try Notes
  const before = try notes.get()
  const device = try NoteDevice
  const mic = try Mic.Machine
  const grant = try device.permission()
  const list = try notes.get()
  if (list.owner !== before.owner || list.filter !== before.filter || (try mic.get()).owner !== list.owner
    || !(try (try Device).showing()) || !showing(try (try Shell).get(), "Notes")) return
  try ignore(mic.send({ type: "reported", grant }, phone))
  if (grant === "Granted") {
    try start(list.filter)
    return
  }
  const state = try mic.get()
  const available = readyForNew(list)
  if (device.onWeb && grant === "Denied") {
    if (!Rec.unfinished(try (try Rec.Machine).get())) {
      try ignore(mic.send({ type: "showBrowserDenial", available, covered: try covered() }, "Owner"))
    }
  } else if (!device.onWeb && Mic.canOpenSettings(state, "Owner")) {
    try ignore(mic.send({ type: "openSettings" }, "Owner"))
  } else {
    try ignore(mic.send({ type: "ask", available, folder: list.filter, covered: try covered(), browser: device.onWeb }, "Owner"))
  }
}

effect function samples(tape: Tape, owner?: string): void!!(Rec.Machine | NoteContent) {
  const capture = try Rec.Machine
  let current = try capture.get()
  if (tape.recordingId === undefined || current.take === 0 || current.capture <= 0) return
  if (owner !== undefined && numberOf("owner", owner) !== current.owner) return
  const cut = tape.segments ?? []
  const pending = Math.max(0, (tape.durationMs ?? 0) - cut.reduce((sum, one) => sum + one.durationMs, 0))
  for (let index = current.kept; index < cut.length; index += 1) {
    const elapsed = Math.max(1, Math.min(Rec.segmentLimit, Math.ceil((cut[index]?.durationMs ?? 0) / 1000)))
    const difference = elapsed - current.unsaved
    if (difference > 0 && current.phase === "Recording") {
      try ignore(capture.send({ type: "tick", capture: current.capture, seconds: difference, level: 0 }, phone))
      current = try capture.get()
    }
    if (current.capture === 0) break
    const kept = current.unsaved > 0
      ? (current.phase === "Stopping" && index === cut.length - 1 ? current.unsaved : Math.min(current.unsaved, elapsed))
      : 0
    if (kept <= 0 && current.phase === "Recording") break
    try ignore(capture.send({ type: "segmentKept", capture: current.capture, segment: index + 1, seconds: kept, ok: true }, phone))
    current = try capture.get()
  }
  const seconds = Math.ceil(pending / 1000) - current.unsaved
  if (current.phase === "Recording" && seconds > 0 && current.capture > 0) {
    try ignore(capture.send({ type: "tick", capture: current.capture, seconds, level: Math.round((tape.peak ?? 0) * 10) }, phone))
  }
}

/** Before ending or pausing, sample the tail that Android has heard so even a short note is retained. */
export effect function control(kind: "pause" | "resume" | "stop", take: number): void!!Scope {
  const recorder = try Rec.Machine
  if ((try recorder.get()).take !== take) return
  const tape = try currentTape()
  const current = try recorder.get()
  if (current.take !== take) return
  if (tape !== undefined) try samples(tape)
  if (kind === "resume") try ignore(recorder.send({ type: "resume", take, room: try room() }, "Owner"))
  else try ignore(recorder.send({ type: kind, take }, "Owner"))
}

effect function capture(fx: Extract<Rec.Effect, { readonly tag: "Captures" }>): void!!Scope {
  const recorder = try Rec.Machine
  const state = try recorder.get()
  const identity = ownerAt() catch () => ""
  if (identity === "" || state.take !== fx.take || state.capture !== fx.capture || numberOf("owner", identity) !== state.owner) return
  const device = try NoteDevice
  const takes = try TakeRegistry
  const folderId = (try (try NoteContent).collection()).folderByNumber.get(state.folder)?.id
  const mappedId = try takes.recordingFor(state.owner, fx.take)
  const existing = try currentTape()
  const resumingOwned = mappedId !== undefined && existing?.recordingId === mappedId
  const overtaken = (try recorder.get()).phase !== "Recording"
  const taken = !resumingOwned
    ? (device.start(try promise(() => ownerDigest(identity)), folderId) catch () => undefined)
    : existing.state === "recording" || overtaken ? existing
    : (device.command(mappedId, "Resume") catch () => undefined)
  if (taken?.recordingId !== undefined) try takes.bind(state.owner, fx.take, taken.recordingId)
  if (taken === undefined) try ignore(recorder.send({ type: "broke", capture: fx.capture }, phone))
}

effect function command(fx: Extract<Rec.Effect, { readonly tag: "Tells" }>): void!!Scope {
  const tape = try currentTape()
  if (tape === undefined || tape.recordingId === undefined) return
  const id = tape.recordingId
  const state = tape.state
  const device = try NoteDevice
  const moved = fx.command === "Pause" && state === "paused" || fx.command === "Resume" && state === "recording" || fx.command === "End" && state === "stopped"
    ? tape : device.command(id, fx.command) catch () => undefined
  const recorder = try Rec.Machine
  if (moved === undefined) try ignore(recorder.send({ type: "broke", capture: fx.capture }, phone))
  else {
    try samples(moved)
    if (fx.command === "End" && (moved.segments?.length ?? 0) === 0) try ignore(device.discard(id))
  }
}

effect function commitRecording(fx: Extract<Rec.Effect, { readonly tag: "Finishes" }>): Rec.Event!!Scope {
  const failed: Rec.Event = { type: "finished", ticket: fx.ticket, ok: false, known: true, note: 0 }
  const lost: Rec.Event = { ...failed, known: false }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== fx.owner) return failed
  const device = try NoteDevice
  const takes = try TakeRegistry
  const mappedId = try takes.recordingFor(fx.owner, fx.take)
  let tape = try currentTape()
  const id = tape?.recordingId ?? mappedId
  if (id === undefined) return failed
  if (tape !== undefined && tape.recordingId === id && (tape.state === "recording" || tape.state === "paused")) {
    const ended = device.command(id, "End") catch () => undefined
    if (ended?.recordingId !== id || ended.state !== "stopped") return failed
    tape = ended
  }
  const segments = tape?.recordingId === id ? (tape.segments ?? []) : []
  const store = try NoteStore
  const collection = try (try NoteContent).collection()
  const folder = collection.folderByNumber.get(fx.folder)
  const have = store.read() catch () => undefined
  if (have === undefined) return lost
  const capture = have.notes.find((note) => note.format?.kind === "voice" && audioIdOf(note) === id)
  if (capture === undefined && segments.length === 0) return failed
  const made = capture === undefined ? (store.create({
    content: "Voice note",
    format: { kind: "voice", data: { recordingId: id, audio: { audioId: id, durationMs: tape?.durationMs ?? 0 }, segments: segments.map((part) => ({ durationMs: part.durationMs })), ...(folder === undefined ? {} : { folderId: folder.id }) } },
    creationId: id,
  }) catch () => undefined)?.note : capture
  if (made === undefined) return lost
  const saved = device.retain(id, made.id) catch () => undefined
  if (saved === undefined || saved.audioId !== id || saved.noteId !== made.id) return lost
  try ignore((try Notes).send({ type: "storeChanged" }, phone))
  return { type: "finished", ticket: fx.ticket, ok: true, known: true, note: numberOf("note", made.id) }
}

effect function findRecording(fx: Extract<Rec.Effect, { readonly tag: "Looks" }>): Rec.Event!!Scope {
  const failed: Rec.Event = { type: "noteFound", ticket: fx.ticket, ok: false, note: 0 }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== fx.owner) return failed
  const takes = try TakeRegistry
  const tape = try currentTape()
  const recording = (try takes.recordingFor(fx.owner, fx.take)) ?? tape?.recordingId
  if (recording === undefined) return failed
  const snapshot = (try NoteStore).read() catch () => undefined
  if (snapshot === undefined) return failed
  const note = snapshot.notes.find((one) => one.format?.kind === "voice" && audioIdOf(one) === recording)
  if (note === undefined) return { ...failed, ok: true }
  const device = try NoteDevice
  const held = device.describe(recording) catch () => undefined
  const kept = held?.noteId === note.id ? held : device.retain(recording, note.id) catch () => undefined
  if (kept === undefined || kept.noteId !== note.id || kept.audioId !== recording) return failed
  try ignore((try Notes).send({ type: "storeChanged" }, phone))
  return { ...failed, ok: true, note: numberOf("note", note.id) }
}

schema DiscardReceipt { readonly owner: number; readonly take: number; readonly recordingId?: string }
const DiscardValue = Schema.fromJsonString(DiscardReceipt)

effect function discardKey(ticket: number): string!!Attempts {
  return `alpha/recording/discard/${try (try Attempts).key(ticket)}`
}

function receiptOf(raw: string | undefined): DiscardReceipt | undefined {
  return raw === undefined ? undefined : Option.getOrUndefined(Schema.decodeUnknownOption(DiscardValue)(raw))
}

effect function writeDiscard(fx: Extract<Rec.Effect, { readonly tag: "WritesDown" }>): Rec.Event!!(Scope | Attempts | KeyValueStore.KeyValueStore) {
  const failure: Rec.Event = { type: "writtenDown", ticket: fx.ticket, ok: false }
  const key = try discardKey(fx.ticket)
  const store = try KeyValueStore.KeyValueStore
  const raw = store.get(key) catch () => undefined
  const existing = receiptOf(raw)
  if (raw !== undefined && (existing?.owner !== fx.owner || existing.take !== fx.take)) return failure
  if (existing?.recordingId) return { ...failure, ok: true }

  const tape = try currentTape(fx.owner)
  const id = tape?.recordingId
  const state = try (try Rec.Machine).get()
  if (!id || state.phase !== "Discarding" || state.owner !== fx.owner || state.take !== fx.take || state.erasing.id !== fx.ticket) return failure
  if (tape.state === "recording" || tape.state === "paused") {
    const stopped = (try NoteDevice).command(id, "End") catch () => undefined
    if (stopped?.recordingId !== id || stopped.state !== "stopped") return failure
  }
  const saved = effect { try store.set(key, JSON.stringify({ owner: fx.owner, take: fx.take, recordingId: id })); return true } catch () => false
  return { ...failure, ok: saved }
}

effect function eraseRecording(fx: Extract<Rec.Effect, { readonly tag: "Erases" }>): Rec.Event!!(Scope | Attempts | KeyValueStore.KeyValueStore) {
  const missing: Rec.Event = { type: "erased", ticket: fx.ticket, ok: false, known: true }
  const key = try discardKey(fx.ticket)
  const receipt = receiptOf((try KeyValueStore.KeyValueStore).get(key) catch () => undefined)
  if (receipt?.owner !== fx.owner || receipt.take !== fx.take || !receipt.recordingId) return missing
  const recordingId = receipt.recordingId
  const tape = try currentTape(fx.owner)
  if (tape?.recordingId !== recordingId) return missing
  return effect {
    try (try NoteDevice).discard(recordingId)
    try (try TakeRegistry).forget(fx.owner, fx.take)
    return { ...missing, ok: true }
  } catch () => ({ ...missing, known: false })
}

function carry(fx: Rec.Effect): Job<Rec.Event, Scope | KeyValueStore.KeyValueStore, [Actor]> {
  return match (fx) {
    when { tag: "Captures" }: run("capture", capture(fx), phone);
    when { tag: "Tells" }: run("command", command(fx), phone);
    when { tag: "Finishes" }: answer(`finish ${fx.ticket}`, commitRecording(fx), { type: "finished", ticket: fx.ticket, ok: false, known: false, note: 0 }, phone);
    when { tag: "Looks" }: answer("lookup", findRecording(fx), { type: "noteFound", ticket: fx.ticket, ok: false, note: 0 }, phone);
    when { tag: "WritesDown" }: answer("write discard", writeDiscard(fx), { type: "writtenDown", ticket: fx.ticket, ok: false }, phone);
    when { tag: "Erases" }: answer("erase", eraseRecording(fx), { type: "erased", ticket: fx.ticket, ok: false, known: false }, phone);
  }
}

function microphone(fx: Mic.Effect): Job<Mic.Event, Scope, [Actor]> {
  return match (fx) {
    when { tag: "AsksMicrophone" }: answer("microphone", effect {
      const device = try NoteDevice
      const grant = try device.request()
      const ready = grant === "Granted" && (try room()).front && !(try covered())
      return { type: "answered", grant, ready, browser: device.onWeb } satisfies Mic.Event
    }, { type: "answered", grant: "Unasked", ready: false, browser: false }, phone);
    when { tag: "Records" }: run("record", start(fx.folder), phone);
    when { tag: "OpensSettings" }: run("settings", effect { try (try NoteDevice).settings() }, phone);
  }
}

/** The tape remembered by Android, reconnected only after binding it to the current agent owner. */
export effect function ownerRecords(owner: number): void!!Scope {
  const recorder = try Rec.Machine
  const mic = try Mic.Machine
  const takes = try TakeRegistry
  try ignore(mic.send({ type: "ownerChanged", owner }, phone))
  try ignore(recorder.send({ type: "ownerChanged", owner }, phone))
  if (owner === 0) { try (try NoteDevice).retire(); return }
  try ignore(mic.send({ type: "reported", grant: try (try NoteDevice).permission() }, phone))
  const tape = try currentTape()
  const prior = try recorder.get()
  const count = tape?.segments?.length ?? 0
  if (tape !== undefined && tape.recordingId !== undefined && count > 0 && prior.phase === "Idle") {
    const take = try takes.takeFor(owner, tape.recordingId, prior.issued + 1)
    try ignore(recorder.send({ type: "takeFound", take, segments: count, intact: true, handed: tape.canonicalSavePending === true }, phone))
  }
  try ignore(recorder.send({ type: "resumeDiscard" }, phone))
}

/** Clear the phone's recording once `Rec.Machine` holds it as a kept voice note, also when Alpha stopped before clearing it, so the next Start finds no recording open. */
const cleanupKept = started(effect {
  const recorder = try Rec.Machine
  const device = try NoteDevice
  const takes = try TakeRegistry
  try Stream.runForEach(recorder.changes, effect (state) => {
    if (state.phase !== "Kept" || state.note <= 0 || state.take <= 0) return
    const id = try takes.recordingFor(state.owner, state.take)
    if (id === undefined) return
    try ignore(device.discard(id))
    try takes.forget(state.owner, state.take)
  })
}, "clear the phone's kept Notes recording")

const updates = started(effect {
  const device = try NoteDevice
  if (!device.available) return
  const recorder = try Rec.Machine
  const takes = try TakeRegistry
  const devicePage = try Device
  const shell = try Shell
  const shown = try RecordingDisplay
  const digests = new Map<string, string>()
  const digestOf = effect (identity: string) => {
    const cached = digests.get(identity)
    if (cached !== undefined) return cached
    const computed = try promise(() => ownerDigest(identity))
    digests.set(identity, computed)
    return computed
  }
  const project = effect (tape: Tape) => {
    const identity = ownerAt() catch () => ""
    if (identity === "" || tape.binding?.ownerDigest !== (try digestOf(identity))) return undefined
    const before = try recorder.get()
    const owner = numberOf("owner", identity)
    if (before.owner === owner && before.take !== 0 && tape.recordingId !== undefined) {
      const peak = tape.state === "recording" && tape.peak !== undefined ? Math.max(0, Math.min(1, tape.peak)) : undefined
      try shown.tell(owner, before.take, tape.durationMs ?? 0, peak)
    }
    return identity
  }
  const apart = (tape: Tape, phase: Rec.Phase) => tape.state === "paused" && phase === "Recording" || tape.state === "recording" && phase === "Paused"
  /**
   * The tape as the phone last reported it while the recorder agreed with it. A pause or resume is followed only when the
   * phone made it, never from a report older than Alpha's own command, and one the rules refused, such as a Resume made over
   * Home, is followed once Notes is in front again. A recording cut off holds no capture of Alpha's, so it follows the phone
   * as it is, as v119's adopt did.
   */
  let agreed: Tape | undefined
  const report = effect (tape: Tape) => {
    const owner = try project(tape)
    if (owner === undefined) return
    const moved = agreed !== undefined && agreed.recordingId === tape.recordingId && agreed.state !== tape.state
    try samples(tape, owner)
    const state = try recorder.get()
    if (tape.state === "stopped" && (state.phase === "Recording" || state.phase === "Paused")) {
      if (tape.stopReason === "user" || tape.stopReason === "done") try ignore(recorder.send({ type: "stop", take: state.take }, "Owner"))
      else try ignore(recorder.send({ type: "broke", capture: state.capture }, phone))
      return
    }
    const mapped = try takes.recordingFor(state.owner, state.take)
    const owned = tape.recordingId !== undefined && tape.recordingId === mapped
    if (owned && moved && tape.state === "paused" && state.phase === "Recording") {
      try ignore(recorder.send({ type: "phonePaused", take: state.take }, phone))
    } else if (owned && (moved || state.recovered) && tape.state === "recording" && state.phase === "Paused") {
      try ignore(recorder.send({ type: "phoneResumed", take: state.take, room: try room() }, phone))
    }
    if (!apart(tape, (try recorder.get()).phase) && (mapped === undefined || tape.recordingId === mapped)) agreed = tape
  }
  const read = effect { return device.status() catch () => undefined }
  const answered = (tape: Tape | undefined): tape is Tape => tape !== undefined
  const poll = Stream.fromEffectSchedule(read, Schedule.spaced("1 second"))
  const playing = Stream.changes(Stream.map(recorder.changes, (state) => state.phase === "Recording" || state.phase === "Stopping"))
  const ticks = Stream.switchMap(playing, (polling) => polling ? Stream.filter(poll, answered) : Stream.empty)
  const visibility = Stream.concat(Stream.fromEffect(devicePage.showing()), devicePage.visible)
  const inFront = (phase: Rec.Phase) => Stream.changes(Stream.map(Stream.zipLatestAll(recorder.changes, shell.changes, visibility),
    ([state, place, visible]) => state.phase === phase && visible && showing(place, "Notes")))
  const amplitudes = Stream.filter(Stream.fromEffectSchedule(read, Schedule.spaced("120 millis")),
    (tape): tape is Tape => tape?.state === "recording")
  const meters = Stream.switchMap(inFront("Recording"), (on) => on ? amplitudes : Stream.empty)
  const looks = Stream.switchMap(inFront("Paused"), (on) => on ? Stream.filter(Stream.fromEffect(read), answered) : Stream.empty)
  const opened = Stream.merge(device.openAsked, Stream.as(Stream.filter(devicePage.visible, (front) => front), undefined))
  const reopen = effect () => {
    if (try device.consumeOpen()) try ignore(shell.send({ type: "openView", view: "Notes" }))
  }
  try reopen()
  const initial = try currentTape()
  if (initial !== undefined && initial.recordingId !== undefined) {
    const state = try recorder.get()
    const mapped = try takes.recordingFor(state.owner, state.take)
    if (!apart(initial, state.phase) && (mapped === undefined || initial.recordingId === mapped)) agreed = initial
  }
  try Effect.all([
    Stream.runForEach(opened, reopen),
    Stream.runForEach(Stream.merge(device.changed, Stream.merge(ticks, looks)), report),
    Stream.runForEach(meters, project),
  ], { concurrency: "unbounded" })
}, "watch the phone’s Notes recorder")

const calls = following(Calls, (state) => state.calls.length > 0, Rec.Machine,
  (active): Rec.Event => ({ type: active ? "callStarted" : "callEnded" }), phone)

function storedMicrophone(key: string, start?: Mic.Microphone) {
  return Layer.unwrap(effect {
    const store = try KeyValueStore.KeyValueStore
    const readable = {
      ...store,
      effect get(name: string) {
        const raw = try store.get(name)
        if (name !== key) return raw
        const saved = Option.getOrUndefined(Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Unknown))(raw))
        if (typeof saved !== "object" || saved === null || Array.isArray(saved) || "browserDenied" in saved) return raw
        const previous = Mic.decodeState({ ...saved, browserDenied: false }) catch () => undefined
        return previous === undefined ? raw : JSON.stringify(previous)
      },
    }
    return Layer.provide(Mic.stored(key, start), Layer.succeed(KeyValueStore.KeyValueStore, readable))
  })
}

export const recording = Layer.provideMerge(together(
  reacting(Rec, { keep: 1, open: effect {
    const tape = try currentTape()
    return [{ type: "restart", intact: tape !== undefined, found: tape?.segments?.length ?? 0, going: tape?.state === "recording" }, phone] as const
  }, carry }),
  reacting({ ...Mic, stored: storedMicrophone }, { keep: 1, open: [{ type: "restart" }, phone], carry: microphone }),
  cleanupKept,
  updates,
  calls,
), Layer.mergeAll(noteDevice, display, takeRegistry))
