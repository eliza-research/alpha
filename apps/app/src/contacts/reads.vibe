// spec/app/contacts/agent.md, "Story: Let the agent read what I have open"; spec/app/messages/composer.md, "The agent's draft goes into the open conversation's draft only while it is empty, and never sends"
import { NOT_DISPATCHED, type DeviceOperation, type OperationResultOf, readResult } from "@elizaos/agent"
import { normalizePhoneNumber, type VoicemailId } from "@elizaos/os-bridges"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Machine as ContactsMachine } from "../../gen/app__contacts.effect.vibe"
import { type Opened, readOf, senderSaid } from "../../gen/app__contacts__agent.effect.vibe"
import { Machine as MessagesMachine } from "../../gen/app__messages.effect.vibe"
import { Machine as ComposerMachine } from "../../gen/app__messages__composer.effect.vibe"
import { Machine as PhoneMachine } from "../../gen/app__phone.effect.vibe"
import { Machine as VoicemailMachine, removing as removingVoicemail } from "../../gen/app__phone__voicemail.effect.vibe"
import { type Telephony, readAddressBook, telephony } from "../platform/index.vibe"
import { Device } from "../platform/index.vibe"
import { contained } from "../runtime/index.vibe"
import { Drafts, offerMessageDraft } from "../messages/composer.vibe"
import { Conversations, Inbox, titleOf } from "../messages/messages.vibe"
import { Dialer, prefilled } from "../comms/index.vibe"
import { Callers, Voicemails } from "../comms/index.vibe"
import { Rows } from "./contacts.vibe"

/** What the agent reads, opens or drafts on the phone, answered at once from what is open, and never a call, a send or a write. */
export type Reading = Extract<DeviceOperation, { type: "sms_latest_sender" | "messages_read_selected" | "voicemail_read_selected" | "contact_read_selected" | "phone_keypad" | "contact_show" | "sms_reply_selected" | "sms_compose" }>

/** How far what the agent reads is open: nothing, open and not yet read, or open as the phone last read it. */
const openedAs = (open: boolean, read: boolean): Opened => (!open ? "NothingOpen" : read ? "OpenRead" : "OpenUnread")

/** The answer for `operation` as eliza's schema reads it; an answer the schema refuses is the phone's word that it cannot. */
function checked(operation: Reading, raw: unknown, unavailable: unknown): unknown {
  return readResult(operation, raw) ?? readResult(operation, unavailable)
}

// spec/app/contacts/agent.md, "The agent reads only the conversation, voicemail or contact open on screen, as the phone last read it"
effect function thread(): unknown!!(MessagesMachine | Inbox | Conversations | Shell | Device) {
  const state = try (try MessagesMachine).get()
  const shell = try (try Shell).get()
  const open = state.front && state.pane === "Conversation" && state.thread > 0 && shell.trail.at(-1) === "Messages" && (try (try Device).showing())
  if (readOf(openedAs(open, state.page.status === "Loaded")) === "NoneSelected") return { kind: "messages-read", status: "none-selected" }
  const held = try (try Inbox).get()
  const conversation = try (try Conversations).get(state.thread)
  const rows = held.messages.flatMap((row) => ("incomplete" in row ? [] : [{ direction: row.direction === "incoming" ? "in" : "out", date: row.date, body: row.body.slice(0, 1600) }]))
  const tail = [...rows].sort((a, b) => a.date - b.date).slice(-20)
  const participant = Option.isSome(conversation) && conversation.value.addresses.length > 0 ? titleOf(conversation.value.addresses, held.names).slice(0, 128) : null
  return { kind: "messages-read", status: "read", participant, messages: tail, truncated: rows.length > tail.length }
}

// spec/app/contacts/agent.md, "The agent reads only the conversation, voicemail or contact open on screen, as the phone last read it"
type VoicemailDetail = Extract<OperationResultOf<"voicemail_read_selected">, { readonly status: "read" }>
const voicemailRead = { type: "voicemail_read_selected" } as const

export type VoicemailReadContext = Device | Shell | PhoneMachine | VoicemailMachine | Voicemails

/** The exact expanded item and the cached content which was visible when the owner asked. */
export interface VoicemailTarget {
  readonly id: VoicemailId
  readonly list: number
  readonly opening: number
  readonly transcript: number
  readonly witness: string | undefined
  readonly result: VoicemailDetail
}

function boundedWords(text: string, limit: number): string {
  return text.slice(0, limit).replace(/[\uD800-\uDBFF]$/u, "")
}

export effect function selectedVoicemail(): (VoicemailTarget | undefined)!!VoicemailReadContext {
  const device = try Device
  if (!(try device.capabilities()).image || !(try device.showing()) || !showing(try (try Shell).get(), "Phone")) return undefined
  const phone = try (try PhoneMachine).get()
  const state = try (try VoicemailMachine).get()
  if (!phone.front || phone.tab !== "Voicemail" || !state.front || !state.open || state.list.status !== "Loaded"
    || state.confirming || removingVoicemail(state)) return undefined
  const held = try (try Voicemails).get()
  const row = held.rows.find((one) => one.id === held.open)
  if (row === undefined) return undefined
  const known = row.cachedName?.trim() ?? ""
  const caller = known === "" || normalizePhoneNumber(known) !== null ? null : boundedWords(known, 128)
  const recorded = { kind: "voicemail-read", status: "read", caller, date: row.date, durationSeconds: row.durationSeconds } as const
  const carrier = state.carrierText ? row.carrierTranscript ?? "" : ""
  const local = state.transcript.status === "Loaded" ? held.transcript : ""
  const text = boundedWords(carrier || local, 8000)
  const transcriptState = state.transcript.status === "Loading" || state.audio.status === "Loading" ? "pending"
    : state.transcript.status === "Failed" ? "failed" : "unavailable"
  const result = readResult<"voicemail_read_selected">(voicemailRead, text !== ""
    ? { ...recorded, transcriptState: "ready", engine: carrier !== "" ? "carrier" : "device", transcript: text }
    : { ...recorded, transcriptState, engine: null, transcript: null })
  return result?.status === "read" ? { id: row.id, list: state.list.ticket, opening: state.audio.ticket, transcript: state.transcript.ticket, witness: row.deletionWitness, result } : undefined
}

export function sameVoicemail(one: VoicemailTarget | undefined, other: VoicemailTarget | undefined): boolean {
  return one !== undefined && other !== undefined && one.id === other.id && one.list === other.list && one.opening === other.opening
    && one.transcript === other.transcript && one.witness === other.witness && JSON.stringify(one.result) === JSON.stringify(other.result)
}

/** Share only the same visible cached voicemail, under the current explicit review. */
export effect function shareSelectedVoicemail(target: VoicemailTarget | undefined, current: () => Promise<boolean>): unknown!!VoicemailReadContext {
  if (target === undefined || !(tryPromise(current) catch () => false) || !sameVoicemail(target, try selectedVoicemail())) {
    return { kind: "refused", code: NOT_DISPATCHED }
  }
  return { kind: "applied", result: target.result }
}

// spec/app/contacts/agent.md, "The agent reads only the conversation, voicemail or contact open on screen, as the phone last read it"
effect function contact(): unknown!!(ContactsMachine | Rows | Shell | Device) {
  const state = try (try ContactsMachine).get()
  const shell = try (try Shell).get()
  const card = (try (try Rows).get()).card
  const open = state.front && state.opened && state.form === "Shut" && shell.trail.at(-1) === "Contacts" && (try (try Device).showing())
  if (readOf(openedAs(open, state.card.status === "Loaded" && card?.id === state.contact)) === "NoneSelected" || card === undefined) return { kind: "contact-read", status: "none-selected" }
  const values = (all: ReadonlyArray<string>) => all.map((one) => one.trim()).filter((one) => one !== "").slice(0, 32)
  return {
    kind: "contact-read", status: "read",
    contact: { displayName: card.displayName.trim() === "" ? null : card.displayName.trim().slice(0, 128), phoneNumbers: values(card.phoneNumbers.map((one) => one.number)), emailAddresses: values(card.emailAddresses.map((one) => one.address)) },
  }
}

// spec/app/contacts/agent.md, "The latest text's sender is named by its number alone, and the whole number only where the agent asked for it"
effect function sender(whole: boolean): unknown!!Telephony {
  const found = telephony("latestIncomingSender", (c) => c.messages.latestIncomingSender(whole)) catch () => undefined
  const said = senderSaid(found !== undefined, found !== undefined && found.status !== "empty", found?.status === "found", whole)
  switch (said) {
    case "ReadFailed": return { kind: "sms-latest-sender", status: "unavailable" }
    case "NoText": return { kind: "sms-latest-sender", status: "empty" }
    case "NotANumber": return { kind: "sms-latest-sender", status: "sender-unavailable" }
    case "WholeNumber":
    case "LastFour": return { kind: "sms-latest-sender", ...found }
  }
}

export type LatestSenderRead = Extract<DeviceOperation, { type: "sms_latest_sender" }>

/** Only the disclosure the reviewed sender operation permits. */
export function latestSenderResult(operation: LatestSenderRead, raw: unknown) {
  const result = readResult<"sms_latest_sender">(operation, raw)
  if (result === undefined || result.status === "unavailable") return undefined
  return result.status !== "found" || ("address" in result) === ("includeAddress" in operation) ? result : undefined
}

// spec/app/contacts/agent.md, "The latest text's sender is named by its number alone, and the whole number only where the agent asked for it"
/** Android finds the latest sender when the owner approves this read. */
export effect function shareLatestSender(operation: LatestSenderRead, current: () => Promise<boolean>): unknown!!(Device | Telephony) {
  const refused = { kind: "refused", code: NOT_DISPATCHED } as const
  const device = try Device
  if (!(try device.capabilities()).image || !(try device.showing()) || !(tryPromise(current) catch () => false)) return refused
  const result = latestSenderResult(operation, try sender("includeAddress" in operation))
  if (result === undefined || !(tryPromise(current) catch () => false) || !(try device.showing())) return refused
  return { kind: "applied", result }
}

/** The keypad, opened filled in with `number` where there is one: nothing is dialed. */
effect function keypad(number: string | undefined): unknown!!(Dialer | PhoneMachine | Shell) {
  const phone = try PhoneMachine
  const handed = number === undefined ? undefined : prefilled(number)
  if (number !== undefined && handed === undefined) return { kind: "phone-keypad", status: "unavailable" }
  if (handed !== undefined) {
    try (try Dialer).set({ digits: handed.digits })
    try ignore(phone.send(handed.event))
  }
  try contained((try Shell).send({ type: "openView", view: "Phone" }), "the agent's keypad")
  if (handed === undefined) {
    const front = try Effect.timeoutOption(Stream.runHead(Stream.filter(phone.changes, (s) => s.front)), "3 seconds")
    if (Option.isNone(front) || Option.isNone(front.value)) return { kind: "phone-keypad", status: "unavailable" }
    try ignore(phone.send({ type: "pickTab", tab: "Keypad" }))
  }
  return { kind: "phone-keypad", status: "opened" }
}

/** Contacts, opened on `query`: the agent learns only whether a contact matched. */
effect function shown(query: string): unknown!!(Telephony | Rows | ContactsMachine | Shell) {
  const unavailable = { kind: "contact-show", status: "unavailable" }
  const access = readAddressBook("open contacts", (c) => c.open()) catch () => undefined
  if (access === undefined || !access.readable) return unavailable
  const shell = try Shell
  try contained(shell.send({ type: "openView", view: "Contacts" }), "the agent's search")
  if ((try shell.get()).trail.at(-1) !== "Contacts") return unavailable
  const machine = try ContactsMachine
  const current = try Effect.timeoutOption(Stream.runHead(Stream.filter(machine.changes, (s) => s.front && (s.list.status === "Loaded" || s.list.status === "Failed"))), "8 seconds")
  if (Option.isNone(current) || Option.isNone(current.value) || current.value.value.form !== "Shut") return unavailable
  if (current.value.value.opened) try ignore(machine.send({ type: "closeContact" }))
  if (current.value.value.chip !== "Everyone") try ignore(machine.send({ type: "pick", chip: "Everyone" }))
  try (try Rows).set({ sought: query })
  const search = machine.send({ type: "search", typed: true }) catch () => undefined
  if (search === undefined) return unavailable
  const ticket = search.state.list.ticket
  const answer = try Effect.timeoutOption(Stream.runHead(Stream.filter(machine.changes, (s) => !s.front ||
    s.list.ticket > ticket || (s.list.ticket === ticket && s.list.status !== "Loading"))), "8 seconds")
  if (Option.isNone(answer) || Option.isNone(answer.value)) return unavailable
  const currentAnswer = answer.value.value
  if (!currentAnswer.front || currentAnswer.list.ticket !== ticket || currentAnswer.list.status !== "Loaded") return unavailable
  return { kind: "contact-show", status: currentAnswer.rows > 0 ? "shown" : "not-found" }
}

// spec/app/messages/composer.md, "The agent's draft goes into the open conversation's draft only while it is empty, and never sends"
/** `body` as Alpha's draft in the conversation open on screen, or, with `number`, in that number's conversation, which Messages opens first. */
effect function drafted(body: string, number: string | undefined): ("drafted" | "none-selected" | "occupied" | "unavailable")!!(ComposerMachine | MessagesMachine | Drafts | Callers | Conversations) {
  const composer = try ComposerMachine
  if (number !== undefined) {
    const thread = try (try Conversations).of({ id: "", addresses: [number] })
    try (try Callers).message(number)
    const messages = try (try MessagesMachine).get()
    if (messages.pane !== "Conversation" || messages.thread !== thread) return "unavailable"
    const opened = try Effect.timeoutOption(Stream.runHead(Stream.filter(composer.changes, (s) => s.thread === thread)), "3 seconds")
    if (Option.isNone(opened) || Option.isNone(opened.value)) return "unavailable"
  }
  const state = try composer.get()
  if (state.thread === 0) return "none-selected"
  if (state.slot.author !== "Nobody") return "occupied"
  if ((try (try Drafts).text(state.thread)) !== "") return "occupied"
  if (!(try offerMessageDraft(state.thread, body))) return "unavailable"
  return (try composer.get()).slot.author === "AlphaWrote" ? "drafted" : "occupied"
}

/** The phone's answer to the agent's read, opening or draft, as eliza's schema for it reads it. Nothing it does calls, sends or writes. */
export effect function answerReading(operation: Reading): unknown!!(Telephony | MessagesMachine | Inbox | Conversations | VoicemailMachine | Voicemails | ContactsMachine | Rows | Dialer | PhoneMachine | Shell | ComposerMachine | Drafts | Callers | Device) {
  switch (operation.type) {
    case "messages_read_selected": return checked(operation, try thread(), { kind: "messages-read", status: "unavailable" })
    case "voicemail_read_selected": return (try selectedVoicemail())?.result ?? { kind: "voicemail-read", status: "none-selected" }
    case "contact_read_selected": return checked(operation, try contact(), { kind: "contact-read", status: "unavailable" })
    case "sms_latest_sender": return checked(operation, try sender("includeAddress" in operation && operation.includeAddress === true), { kind: "sms-latest-sender", status: "unavailable" })
    case "phone_keypad": return checked(operation, try keypad(operation.number), { kind: "phone-keypad", status: "unavailable" })
    case "contact_show": return checked(operation, try shown(operation.query), { kind: "contact-show", status: "unavailable" })
    case "sms_reply_selected": return checked(operation, { kind: "sms-reply", status: try drafted(operation.body, undefined) }, { kind: "sms-reply", status: "unavailable" })
    case "sms_compose": {
      const number = "target" in operation && operation.target.kind === "number" ? operation.target.number : undefined
      const status = try drafted(operation.body, number)
      return checked(operation, { kind: "sms-compose", status: status === "drafted" ? "drafted" : status === "none-selected" ? "not-found" : "unavailable" }, { kind: "sms-compose", status: "unavailable" })
    }
  }
}
