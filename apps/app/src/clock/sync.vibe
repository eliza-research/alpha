// spec/app/clock/alarms.md, "Syncing from the resident agent admits only valid, unique, bounded alarm lists"; spec/app/clock/timers.md, "Reopening after a restart finishes elapsed running timers and updates live remaining times"; spec/app/clock/world.md, "Syncing from the resident agent admits only valid, unique, bounded city lists"
import type { ClockAlarmRecord, ClockSnapshot, ClockTimerRecord, WorldCityRecord } from "@repo/launcher-records"
import type * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as ClockView from "../../gen/app__clock.effect.vibe"
import * as Alarms from "../../gen/app__clock__alarms.effect.vibe"
import type { Alarm } from "../../gen/app__clock__alarms.effect.vibe"
import * as Timers from "../../gen/app__clock__timers.effect.vibe"
import type { Timer } from "../../gen/app__clock__timers.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as World from "../../gen/app__clock__world.effect.vibe"
import { Agent, Device, PhoneClockAlerts, ask, launchSiblingApp } from "../platform/index.vibe"
import { contained, started, together, Time } from "../runtime/index.vibe"
import { alarms, persistClockMeta } from "./alarms.vibe"
import { alert } from "./alert.vibe"
import { currentSurface } from "../surface.ts"
import { deviceClock } from "./device.vibe"
import { cityById, findCityMatch } from "./cities.ts"
import { clockView } from "./clock.vibe"
import {
  type AlarmMeta,
  type ClockMetaState,
  type ClockRecordsStore,
  type TimerMeta,
  normalizeSound,
} from "./records.ts"
import { ClockRecords, ClockSyncState, ClockTicks, type SyncCoordinator, activeClockRecords, activeSyncCoordinator, confirmClockSnapshot, clockRecordsLayer, clockSyncStateLayer, clockTicksLayer } from "./shelf.vibe"
import { residentClockTick } from "./ticker.vibe"
import { nextAlarmFireAt } from "./time.ts"
import { timers } from "./timers.vibe"
import { worldClock } from "./world.vibe"

schema AlarmRecordSchema {
  readonly id: string
  readonly hour: number
  readonly minute: number
  readonly daysMask: number
  readonly label: string
  readonly sound: string
  readonly vibrate: boolean
  readonly enabled: boolean
  readonly snoozeMinutes: number
  readonly phase: "idle" | "ringing" | "snoozed"
  readonly fireAtMs: number | null
  readonly snoozeUntilMs: number | null
  readonly missed: boolean
  readonly revision: number
  readonly updatedAtMs: number
}

schema TimerRecordSchema {
  readonly id: string
  readonly label: string
  readonly durationMs: number
  readonly remainingMs: number
  readonly status: "ready" | "running" | "paused" | "ringing"
  readonly startedAtMs: number | null
  readonly endAtMs: number | null
  readonly ringStartedAtMs: number | null
  readonly revision: number
  readonly updatedAtMs: number
}

schema WorldCitySchema {
  readonly id: string
  readonly city: string
  readonly region: string
  readonly timeZone: string
  readonly order: number
}

schema ClockSnapshotSchema {
  readonly version: number
  readonly updatedAtMs: number
  readonly alarms: AlarmRecordSchema[]
  readonly timers: TimerRecordSchema[]
  readonly world: WorldCitySchema[]
  readonly deletedAlarmIds: string[]
  readonly deletedTimerIds: string[]
}

function syncFingerprint(
  alarmState: Alarms.Alarms,
  timerState: Timers.Timers,
  worldState: World.WorldClock,
  meta: ClockMetaState,
): string {
  return JSON.stringify({
    alarms: alarmState.items,
    timers: timerState.items,
    world: worldState.cities,
    alarmMeta: [...meta.alarms.entries()].sort((a, b) => a[0] - b[0]),
    timerMeta: [...meta.timers.entries()].sort((a, b) => a[0] - b[0]),
    deletedAlarmIds: [...meta.deletedAlarmIds].sort(),
    deletedTimerIds: [...meta.deletedTimerIds].sort(),
  })
}

function parseNumericSuffix(remoteId: string, fallback: number): number {
  const match = /^(?:alarm|timer)-([1-9]\d*)$/.exec(remoteId)
  if (!match) return fallback
  const parsed = Number(match[1])
  return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : fallback
}

function finiteNonNegative(value: number | null | undefined, fallback = 0): number {
  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? Math.floor(value) : fallback
}

function toWireAlarm(records: ClockRecordsStore, item: Alarm): ClockAlarmRecord {
  const meta = records.alarm(item.id)
  return {
    id: meta.remoteId,
    hour: item.hour,
    minute: item.minute,
    daysMask: item.daysMask,
    label: meta.label,
    sound: meta.sound,
    vibrate: item.vibrate,
    enabled: item.enabled,
    snoozeMinutes: item.snoozeMinutes,
    phase: item.phase === "Ringing" ? "ringing" : item.phase === "Snoozed" ? "snoozed" : "idle",
    fireAtMs: item.fireAt > 0 ? item.fireAt : null,
    snoozeUntilMs: item.snoozeUntil > 0 ? item.snoozeUntil : null,
    missed: item.missed,
    revision: item.revision,
    updatedAtMs: meta.updatedAtMs,
  }
}

function toWireTimer(records: ClockRecordsStore, item: Timer): ClockTimerRecord {
  const meta = records.timer(item.id)
  return {
    id: meta.remoteId,
    label: meta.label,
    durationMs: item.durationMs,
    remainingMs: item.remainingMs,
    status: item.status === "Running" ? "running" : item.status === "Paused" ? "paused" : item.status === "Ringing" ? "ringing" : "ready",
    startedAtMs: item.startedAt > 0 ? item.startedAt : null,
    endAtMs: item.endAt > 0 ? item.endAt : null,
    ringStartedAtMs: item.ringStartedAt > 0 ? item.ringStartedAt : null,
    revision: item.revision,
    updatedAtMs: meta.updatedAtMs,
  }
}

function toWireWorld(cities: readonly number[]): WorldCityRecord[] {
  const out: WorldCityRecord[] = []
  cities.forEach((cityId, index) => {
    const entry = cityById(cityId)
    if (entry !== undefined) {
      out.push({ id: `city-${entry.id}`, city: entry.city, region: entry.region, timeZone: entry.timeZone, order: index })
    }
  })
  return out
}

function fromWireAlarm(record: AlarmRecordSchema, localId: number, now: number): Alarm | undefined {
  if (!Number.isFinite(record.hour) || !Number.isFinite(record.minute) || !Number.isFinite(record.daysMask) || !Number.isFinite(record.snoozeMinutes)) {
    return undefined
  }
  const hour = Math.min(23, Math.max(0, Math.floor(record.hour)))
  const minute = Math.min(59, Math.max(0, Math.floor(record.minute)))
  const daysMask = Math.min(127, Math.max(0, Math.floor(record.daysMask)))
  const snoozeMinutes = Math.min(Alarms.maxSnooze, Math.max(Alarms.minSnooze, Math.floor(record.snoozeMinutes)))
  const enabled = record.enabled
  const phase: Alarm["phase"] = !enabled ? "Idle" : record.phase === "ringing" ? "Ringing" : record.phase === "snoozed" ? "Snoozed" : "Idle"
  const rawFireAt = finiteNonNegative(record.fireAtMs, 0)
  const fireAt = enabled ? (rawFireAt > 0 ? rawFireAt : nextAlarmFireAt(hour, minute, daysMask, now)) : 0
  const rawSnooze = finiteNonNegative(record.snoozeUntilMs, 0)
  const snoozeUntil = phase === "Snoozed" ? (rawSnooze > 0 ? rawSnooze : now + snoozeMinutes * 60_000) : 0
  return {
    id: localId,
    hour,
    minute,
    daysMask,
    enabled,
    snoozeMinutes,
    vibrate: record.vibrate,
    phase,
    fireAt,
    snoozeUntil,
    missed: record.missed,
    revision: finiteNonNegative(record.revision, 0),
  }
}

function fromWireTimer(record: TimerRecordSchema, localId: number, now: number): Timer | undefined {
  if (!Number.isFinite(record.durationMs) || record.durationMs <= 0) return undefined
  const durationMs = Math.min(Timers.maxDurationMs, Math.max(1000, Math.floor(record.durationMs)))
  const revision = finiteNonNegative(record.revision, 0)
  const status: Timer["status"] = record.status === "running" ? "Running" : record.status === "paused" ? "Paused" : record.status === "ringing" ? "Ringing" : "Ready"
  if (status === "Ringing") {
    const ringStartedAt = finiteNonNegative(record.ringStartedAtMs, now)
    return { id: localId, durationMs, remainingMs: 0, status: "Ringing", startedAt: 0, endAt: 0, ringStartedAt, revision }
  }
  if (status === "Running") {
    const startedAt = finiteNonNegative(record.startedAtMs, now)
    const fallbackRem = Number.isFinite(record.remainingMs) && record.remainingMs > 0 ? Math.floor(record.remainingMs) : durationMs
    const rawEndAt = typeof record.endAtMs === "number" && Number.isFinite(record.endAtMs) && record.endAtMs > startedAt
      ? Math.floor(record.endAtMs)
      : startedAt + Math.max(1000, fallbackRem)
    if (now >= rawEndAt) {
      return { id: localId, durationMs, remainingMs: 0, status: "Ringing", startedAt: 0, endAt: 0, ringStartedAt: now, revision }
    }
    return { id: localId, durationMs, remainingMs: Math.max(1, rawEndAt - now), status: "Running", startedAt, endAt: rawEndAt, ringStartedAt: 0, revision }
  }
  if (status === "Paused") {
    const remainingMs = Number.isFinite(record.remainingMs) && record.remainingMs > 0 ? Math.floor(record.remainingMs) : durationMs
    return { id: localId, durationMs, remainingMs: Math.max(1, remainingMs), status: "Paused", startedAt: 0, endAt: 0, ringStartedAt: 0, revision }
  }
  return { id: localId, durationMs, remainingMs: durationMs, status: "Ready", startedAt: 0, endAt: 0, ringStartedAt: 0, revision }
}

effect function pushClockSnapshotLocked(
  coordinator: SyncCoordinator,
  records: ClockRecordsStore,
): boolean!!(Agent | Alarms.Machine | Timers.Machine | World.Machine | Time | KeyValueStore.KeyValueStore) {
  const now = try (try Time).now()
  const alarmState = try (try Alarms.Machine).get()
  const timerState = try (try Timers.Machine).get()
  const worldState = try (try World.Machine).get()
  const meta = records.snapshot()
  const seqBefore = meta.localSeq
  const nextVersion = meta.version + 1
  const payload: ClockSnapshot = {
    version: nextVersion,
    updatedAtMs: now,
    alarms: alarmState.items.map((item) => toWireAlarm(records, item)),
    timers: timerState.items.map((item) => toWireTimer(records, item)),
    world: toWireWorld(worldState.cities),
    deletedAlarmIds: [...meta.deletedAlarmIds],
    deletedTimerIds: [...meta.deletedTimerIds],
  }
  const request = HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.put("/api/alpha/clock"), payload)
  const answered = ask(Agent, request, ClockSnapshotSchema) catch () => undefined
  if (answered === undefined) return false
  if (Number.isFinite(answered.version) && answered.version >= 0) {
    records.setVersion(Math.floor(answered.version))
  }
  records.clearDirty(seqBefore)
  try persistClockMeta()
  coordinator.setLastSynced(syncFingerprint(alarmState, timerState, worldState, records.snapshot()))
  try confirmClockSnapshot()
  return true
}

function admitRemoteRecord(
  id: string,
  seenRemoteIds: Set<string>,
  remoteDeleted: ReadonlySet<string>,
  localDeleted: ReadonlySet<string>,
): boolean {
  if (id === "" || seenRemoteIds.has(id) || remoteDeleted.has(id) || localDeleted.has(id)) return false
  seenRemoteIds.add(id)
  return true
}

function mergeAlarms(
  remote: ClockSnapshotSchema,
  currentAlarms: Alarms.Alarms,
  metaSnap: ClockMetaState,
  now: number,
): { readonly nextAlarms: Alarm[]; readonly nextAlarmIssued: number; readonly nextAlarmMeta: Map<number, AlarmMeta>; readonly nextDeletedAlarms: string[] } {
  const existingAlarmByRemote = new Map<string, number>()
  for (const [id, meta] of metaSnap.alarms) existingAlarmByRemote.set(meta.remoteId, id)
  let nextAlarmIssued = currentAlarms.issued
  const nextAlarms: Alarm[] = []
  const usedAlarmIds = new Set<number>()
  const nextAlarmMeta = new Map<number, AlarmMeta>()
  const seenRemoteIds = new Set<string>()
  const remoteDeleted = new Set(remote.deletedAlarmIds)
  const localDeleted = new Set(metaSnap.deletedAlarmIds)

  for (const record of remote.alarms) {
    if (!admitRemoteRecord(record.id, seenRemoteIds, remoteDeleted, localDeleted)) continue

    const existingLocalId = existingAlarmByRemote.get(record.id)
    const localItem = existingLocalId !== undefined ? currentAlarms.items.find((item) => item.id === existingLocalId) : undefined
    const localMeta = existingLocalId !== undefined ? metaSnap.alarms.get(existingLocalId) : undefined
    const remoteUpdated = finiteNonNegative(record.updatedAtMs, 0)

    let localId = existingLocalId ?? parseNumericSuffix(record.id, nextAlarmIssued + 1)
    while (usedAlarmIds.has(localId) || localId <= 0) {
      nextAlarmIssued += 1
      localId = nextAlarmIssued
    }
    if (localId > nextAlarmIssued) nextAlarmIssued = localId

    if (metaSnap.dirty && localItem !== undefined && localMeta !== undefined && localMeta.updatedAtMs > remoteUpdated) {
      if (nextAlarms.length < Alarms.maxAlarms) {
        usedAlarmIds.add(localId)
        nextAlarms.push({ ...localItem, id: localId })
        nextAlarmMeta.set(localId, localMeta)
      }
      continue
    }

    const parsed = fromWireAlarm(record, localId, now)
    if (parsed !== undefined && nextAlarms.length < Alarms.maxAlarms) {
      usedAlarmIds.add(localId)
      nextAlarms.push(parsed)
      nextAlarmMeta.set(localId, {
        label: record.label,
        sound: normalizeSound(record.sound),
        remoteId: record.id,
        updatedAtMs: remoteUpdated,
      })
    }
  }

  if (metaSnap.dirty) {
    for (const item of currentAlarms.items) {
      const localMeta = metaSnap.alarms.get(item.id) ?? { label: "", sound: "radar", remoteId: `alarm-${item.id}`, updatedAtMs: 0 }
      if (seenRemoteIds.has(localMeta.remoteId) || remoteDeleted.has(localMeta.remoteId) || localDeleted.has(localMeta.remoteId)) continue
      if (nextAlarms.length >= Alarms.maxAlarms) break
      let localId = item.id
      while (usedAlarmIds.has(localId) || localId <= 0) {
        nextAlarmIssued += 1
        localId = nextAlarmIssued
      }
      if (localId > nextAlarmIssued) nextAlarmIssued = localId
      usedAlarmIds.add(localId)
      nextAlarms.push({ ...item, id: localId })
      nextAlarmMeta.set(localId, localMeta)
    }
  }

  const nextDeletedAlarms = [...new Set([...metaSnap.deletedAlarmIds, ...remote.deletedAlarmIds])]

  return { nextAlarms, nextAlarmIssued, nextAlarmMeta, nextDeletedAlarms }
}

function mergeTimers(
  remote: ClockSnapshotSchema,
  currentTimers: Timers.Timers,
  metaSnap: ClockMetaState,
  now: number,
): { readonly nextTimers: Timer[]; readonly nextTimerIssued: number; readonly nextTimerMeta: Map<number, TimerMeta>; readonly nextDeletedTimers: string[] } {
  const existingTimerByRemote = new Map<string, number>()
  for (const [id, meta] of metaSnap.timers) existingTimerByRemote.set(meta.remoteId, id)
  let nextTimerIssued = currentTimers.issued
  const nextTimers: Timer[] = []
  const usedTimerIds = new Set<number>()
  const nextTimerMeta = new Map<number, TimerMeta>()
  const seenRemoteIds = new Set<string>()
  const remoteDeleted = new Set(remote.deletedTimerIds)
  const localDeleted = new Set(metaSnap.deletedTimerIds)

  for (const record of remote.timers) {
    if (!admitRemoteRecord(record.id, seenRemoteIds, remoteDeleted, localDeleted)) continue

    const existingLocalId = existingTimerByRemote.get(record.id)
    const localItem = existingLocalId !== undefined ? currentTimers.items.find((item) => item.id === existingLocalId) : undefined
    const localMeta = existingLocalId !== undefined ? metaSnap.timers.get(existingLocalId) : undefined
    const remoteUpdated = finiteNonNegative(record.updatedAtMs, 0)

    let localId = existingLocalId ?? parseNumericSuffix(record.id, nextTimerIssued + 1)
    while (usedTimerIds.has(localId) || localId <= 0) {
      nextTimerIssued += 1
      localId = nextTimerIssued
    }
    if (localId > nextTimerIssued) nextTimerIssued = localId

    if (metaSnap.dirty && localItem !== undefined && localMeta !== undefined && localMeta.updatedAtMs > remoteUpdated) {
      if (nextTimers.length < Timers.maxTimers) {
        usedTimerIds.add(localId)
        nextTimers.push({ ...localItem, id: localId })
        nextTimerMeta.set(localId, localMeta)
      }
      continue
    }

    const parsed = fromWireTimer(record, localId, now)
    if (parsed !== undefined && nextTimers.length < Timers.maxTimers) {
      usedTimerIds.add(localId)
      nextTimers.push(parsed)
      nextTimerMeta.set(localId, {
        label: record.label,
        remoteId: record.id,
        updatedAtMs: remoteUpdated,
      })
    }
  }

  if (metaSnap.dirty) {
    for (const item of currentTimers.items) {
      const localMeta = metaSnap.timers.get(item.id) ?? { label: "", remoteId: `timer-${item.id}`, updatedAtMs: 0 }
      if (seenRemoteIds.has(localMeta.remoteId) || remoteDeleted.has(localMeta.remoteId) || localDeleted.has(localMeta.remoteId)) continue
      if (nextTimers.length >= Timers.maxTimers) break
      let localId = item.id
      while (usedTimerIds.has(localId) || localId <= 0) {
        nextTimerIssued += 1
        localId = nextTimerIssued
      }
      if (localId > nextTimerIssued) nextTimerIssued = localId
      usedTimerIds.add(localId)
      nextTimers.push({ ...item, id: localId })
      nextTimerMeta.set(localId, localMeta)
    }
  }

  const nextDeletedTimers = [...new Set([...metaSnap.deletedTimerIds, ...remote.deletedTimerIds])]

  return { nextTimers, nextTimerIssued, nextTimerMeta, nextDeletedTimers }
}

/** Pull the canonical Clock snapshot from the resident agent and reconcile it into local Clock machines. */
export effect function syncClockNow(): boolean!!(Agent | Alarms.Machine | Timers.Machine | World.Machine | Time | KeyValueStore.KeyValueStore) {
  const coordinator = try activeSyncCoordinator()
  const records = try activeClockRecords()
  return try Semaphore.withPermit(coordinator.lock, effect {
    const remote = ask(Agent, HttpClientRequest.get("/api/alpha/clock"), ClockSnapshotSchema) catch () => undefined
    if (remote === undefined) return false
    const alarmMachine = try Alarms.Machine
    const timerMachine = try Timers.Machine
    const worldMachine = try World.Machine
    const currentAlarms = try alarmMachine.get()
    const currentTimers = try timerMachine.get()
    const currentWorld = try worldMachine.get()
    const metaSnap = records.snapshot()
    const remoteVersion = finiteNonNegative(remote.version, 0)
    const remoteEmpty = remoteVersion === 0 && remote.alarms.length === 0 && remote.timers.length === 0 && remote.world.length === 0

    if (remoteVersion < metaSnap.version || (metaSnap.dirty && remoteVersion <= metaSnap.version)) {
      return try pushClockSnapshotLocked(coordinator, records)
    }
    if (remoteEmpty && metaSnap.version === 0 && !metaSnap.dirty) {
      coordinator.setLastSynced(syncFingerprint(currentAlarms, currentTimers, currentWorld, metaSnap))
      try confirmClockSnapshot()
      return true
    }

    const now = try (try Time).now()
    const mergedAlarms = mergeAlarms(remote, currentAlarms, metaSnap, now)
    const mergedTimers = mergeTimers(remote, currentTimers, metaSnap, now)

    const sortedWorld = [...remote.world].sort((a, b) => a.order - b.order)
    const nextCities: number[] = []
    for (const city of sortedWorld) {
      const matched = findCityMatch(city.timeZone, city.city)
      if (matched !== undefined && !nextCities.includes(matched.id) && nextCities.length < World.maxCities) {
        nextCities.push(matched.id)
      }
    }
    if (metaSnap.dirty) {
      for (const cityId of currentWorld.cities) {
        if (!nextCities.includes(cityId) && nextCities.length < World.maxCities) {
          nextCities.push(cityId)
        }
      }
    }

    const alarmsApplied = try contained(
      alarmMachine.send({ type: "applySync", synced: mergedAlarms.nextAlarms, nextIssued: mergedAlarms.nextAlarmIssued }),
      "applying synced alarms",
    )
    const timersApplied = try contained(
      timerMachine.send({ type: "applySync", synced: mergedTimers.nextTimers, nextIssued: mergedTimers.nextTimerIssued }),
      "applying synced timers",
    )
    const worldApplied = try contained(
      worldMachine.send({ type: "applySync", synced: nextCities }),
      "applying synced world cities",
    )

    records.replaceAll({
      alarms: alarmsApplied ? mergedAlarms.nextAlarmMeta : metaSnap.alarms,
      timers: timersApplied ? mergedTimers.nextTimerMeta : metaSnap.timers,
      deletedAlarmIds: alarmsApplied ? mergedAlarms.nextDeletedAlarms : metaSnap.deletedAlarmIds,
      deletedTimerIds: timersApplied ? mergedTimers.nextDeletedTimers : metaSnap.deletedTimerIds,
      version: alarmsApplied && timersApplied && worldApplied ? Math.max(metaSnap.version, remoteVersion) : metaSnap.version,
      dirty: metaSnap.dirty,
    })

    const afterAlarms = try alarmMachine.get()
    const afterTimers = try timerMachine.get()
    const afterWorld = try worldMachine.get()
    if (metaSnap.dirty) {
      try persistClockMeta()
      return try pushClockSnapshotLocked(coordinator, records)
    }
    coordinator.setLastSynced(syncFingerprint(afterAlarms, afterTimers, afterWorld, records.snapshot()))
    try persistClockMeta()
    if (alarmsApplied && timersApplied && worldApplied) try confirmClockSnapshot()
    return alarmsApplied && timersApplied && worldApplied
  })
}

const syncOnBootAndForeground = started(effect {
  try syncClockNow()
  try Stream.runForEach(Stream.filter((try Device).visible, (shown) => shown), () => syncClockNow())
}, "syncing Clock from agent on boot and resume")

const pushOnLocalMutation = started(effect {
  const coordinator = try activeSyncCoordinator()
  const records = try activeClockRecords()
  const alarmMachine = try Alarms.Machine
  const timerMachine = try Timers.Machine
  const worldMachine = try World.Machine
  const updates = Stream.mergeAll(
    [
      Stream.map(Stream.drop(alarmMachine.changes, 1), () => undefined),
      Stream.map(Stream.drop(timerMachine.changes, 1), () => undefined),
      Stream.map(Stream.drop(worldMachine.changes, 1), () => undefined),
    ],
    { concurrency: "unbounded" },
  )
  try Stream.runForEach(updates, effect () => {
    try Semaphore.withPermit(coordinator.lock, effect {
      const alarmState = try alarmMachine.get()
      const timerState = try timerMachine.get()
      const worldState = try worldMachine.get()
      const currentKey = syncFingerprint(alarmState, timerState, worldState, records.snapshot())
      if (currentKey === coordinator.lastSynced()) return
      if (!records.snapshot().dirty) {
        records.markDirty()
        try persistClockMeta()
      }
      try pushClockSnapshotLocked(coordinator, records)
    })
  })
}, "pushing Clock mutations to agent")

const openInstalledClock = started(effect {
  if (currentSurface().mode !== "monolith" || !(try PhoneClockAlerts).present) return
  const shell = Context.getOption(try Effect.context<never>(), Shell.Machine)
  if (Option.isNone(shell)) return
  const host = try PhoneClockAlerts
  const device = try Device
  const { store: records, notificationRoute } = try ClockRecords
  const shown = Stream.changesWith(shell.value.changes, (a, b) => a.trail.at(-1) === b.trail.at(-1))
  try Stream.runForEach(shown, effect (state) => {
    if (state.trail.at(-1) !== "Clock" || state.route === (try Ref.get(notificationRoute)) || !(try device.showing()) || (try host.pendingTap()) !== undefined) return
    if (records.snapshot().dirty && !(try syncClockNow())) return
    const current = (where: Shell.Shell) => where.route === state.route && where.trail.at(-1) === "Clock"
    if (current(try shell.value.get()) && (try launchSiblingApp("Clock"))) {
      try contained(shell.value.send({ type: "goBack" }, current), "returning to the launcher after opening the standalone Clock")
    }
  })
}, "using the installed Clock app")

const clockSync = together(syncOnBootAndForeground, pushOnLocalMutation)

/** Resident Clock machines and services, ready for a single-line mount in `apps/app/src/resident.vibe`. */
export const clockResident = together(
  clockRecordsLayer,
  clockTicksLayer,
  clockSyncStateLayer,
  alarms,
  timers,
  worldClock,
  clockView,
  alert,
  deviceClock,
  openInstalledClock,
  residentClockTick,
  clockSync,
)

/** Reuse the resident Clock machines when already mounted in `resident.vibe`, or build them locally if mounted standalone. */
export const ensureClockResident = Layer.unwrap(effect {
  const ctx = try Effect.context<never>()
  const existingAlarms = Context.getOption(ctx, Alarms.Machine)
  const existingTimers = Context.getOption(ctx, Timers.Machine)
  const existingWorld = Context.getOption(ctx, World.Machine)
  const existingView = Context.getOption(ctx, ClockView.Machine)
  const existingRecords = Context.getOption(ctx, ClockRecords)
  const existingTicks = Context.getOption(ctx, ClockTicks)
  const existingSync = Context.getOption(ctx, ClockSyncState)
  if (
    Option.isSome(existingAlarms)
    && Option.isSome(existingTimers)
    && Option.isSome(existingWorld)
    && Option.isSome(existingView)
    && Option.isSome(existingRecords)
    && Option.isSome(existingTicks)
    && Option.isSome(existingSync)
  ) {
    return together(
      Layer.succeed(Alarms.Machine, existingAlarms.value),
      Layer.succeed(Timers.Machine, existingTimers.value),
      Layer.succeed(World.Machine, existingWorld.value),
      Layer.succeed(ClockView.Machine, existingView.value),
      Layer.succeed(ClockRecords, existingRecords.value),
      Layer.succeed(ClockTicks, existingTicks.value),
      Layer.succeed(ClockSyncState, existingSync.value),
    )
  }
  return clockResident
})

/** Service union provided by `clockResident` for overlays, Home cards, and the Clock view. */
export type ClockResident =
  | Alarms.Machine
  | Timers.Machine
  | World.Machine
  | ClockView.Machine
  | ClockRecords
  | ClockTicks
  | ClockSyncState
  | Time
  | KeyValueStore.KeyValueStore
  | Agent
