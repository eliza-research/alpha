// spec/app/clock/alarms.md, "Story: Manage my alarms"; spec/app/clock/alarms.md, "Story: Ring, snooze, dismiss, and recover alarms"
import type { ClockSound } from "@repo/launcher-records"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Alarms from "../../gen/app__clock__alarms.effect.vibe"
import type { Alarm, Event } from "../../gen/app__clock__alarms.effect.vibe"
import type * as Toasts from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, offer, withdraw } from "../notices/index.vibe"
import { clockRecordId } from "../platform/index.vibe"
import { contained, due, reacting, started, together, untimed } from "../runtime/index.vibe"
import { Time } from "../runtime/index.vibe"
import { activeClockRecords, metaStoreKey } from "./shelf.vibe"
import { nextAlarmFireAt } from "./time.ts"

const undoArea = "clock-alarms"

/** Persist Clock's external label/sound metadata to KeyValueStore. */
export effect function persistClockMeta(): void!!KeyValueStore.KeyValueStore {
  const records = try activeClockRecords()
  try ignore((try KeyValueStore.KeyValueStore).set(metaStoreKey, records.serialize()))
}

/** Input fields for creating or updating an alarm. */
export interface AlarmDraft {
  readonly hour: number
  readonly minute: number
  readonly daysMask: number
  readonly label: string
  readonly sound: ClockSound
  readonly snoozeMinutes: number
  readonly vibrate: boolean
}

function alarmTimers(state: Alarms.Alarms) {
  const deadlines = []
  for (const item of state.items) {
    if (item.enabled && item.phase !== "Ringing") {
      const target = Alarms.dueAtOf(item)
      if (target > 0) deadlines.push(due<Event, []>(`ring ${item.id}`, target, { type: "trigger", id: item.id, now: untimed }))
    }
  }
  if (state.hasHidden && state.undo.holding === "Held") {
    deadlines.push(due<Event, []>("commitDelete", state.undo.until, { type: "commitDelete", now: untimed }))
  }
  return deadlines
}

/** Create a new enabled alarm, persist its label/sound metadata, and arm its next ring deadline. */
export effect function createAlarm(draft: AlarmDraft): number!!(Alarms.Machine | Time | KeyValueStore.KeyValueStore) {
  const machine = try Alarms.Machine
  const records = try activeClockRecords()
  const now = try (try Time).now()
  const before = try machine.get()
  const nextId = before.issued + 1
  const fireAt = nextAlarmFireAt(draft.hour, draft.minute, draft.daysMask, now)
  const hadPrior = records.snapshot().alarms.has(nextId)
  const prior = records.alarm(nextId)
  const unique = clockRecordId()
  if (unique === undefined) return 0
  records.setAlarm(nextId, { label: draft.label.trim(), sound: draft.sound, remoteId: `alarm-${unique}`, updatedAtMs: now })
  const sent = try contained(
    machine.send({
      type: "create",
      hour: draft.hour,
      minute: draft.minute,
      daysMask: draft.daysMask,
      snoozeMinutes: draft.snoozeMinutes,
      vibrate: draft.vibrate,
      fireAt,
    }),
    "creating an alarm",
  )
  if (!sent) {
    if (hadPrior) records.setAlarm(nextId, prior)
    else records.deleteAlarm(nextId)
    return 0
  }
  records.markDirty()
  try persistClockMeta()
  return nextId
}

effect function loadAlarm(id: number): { readonly machine: Context.Service.Shape<typeof Alarms.Machine>; readonly now: number; readonly current: Alarm | undefined }!!(Alarms.Machine | Time) {
  const machine = try Alarms.Machine
  const now = try (try Time).now()
  const current = (try machine.get()).items.find((item) => item.id === id)
  return { machine, now, current }
}

/** Update an existing alarm's schedule and metadata. */
export effect function updateAlarm(id: number, draft: AlarmDraft): boolean!!(Alarms.Machine | Time | KeyValueStore.KeyValueStore) {
  const { machine, now, current } = try loadAlarm(id)
  if (current === undefined) return false
  const records = try activeClockRecords()
  const fireAt = current.enabled ? nextAlarmFireAt(draft.hour, draft.minute, draft.daysMask, now) : 0
  const hadPrior = records.snapshot().alarms.has(id)
  const prior = records.alarm(id)
  records.setAlarm(id, { label: draft.label.trim(), sound: draft.sound, updatedAtMs: now })
  const sent = try contained(
    machine.send({
      type: "update",
      id,
      hour: draft.hour,
      minute: draft.minute,
      daysMask: draft.daysMask,
      snoozeMinutes: draft.snoozeMinutes,
      vibrate: draft.vibrate,
      fireAt,
    }),
    "updating an alarm",
  )
  if (!sent) {
    if (hadPrior) records.setAlarm(id, prior)
    else records.deleteAlarm(id)
    return false
  }
  records.markDirty()
  try persistClockMeta()
  return true
}

/** Enable or disable an alarm, computing its next fire time when enabling. */
export effect function toggleAlarm(id: number, enabled: boolean): boolean!!(Alarms.Machine | Time | KeyValueStore.KeyValueStore) {
  const { machine, now, current } = try loadAlarm(id)
  if (current === undefined) return false
  const records = try activeClockRecords()
  const fireAt = enabled ? nextAlarmFireAt(current.hour, current.minute, current.daysMask, now) : 0
  const hadPrior = records.snapshot().alarms.has(id)
  const prior = records.alarm(id)
  records.setAlarm(id, { updatedAtMs: now })
  const sent = try contained(machine.send({ type: "toggle", id, on: enabled, fireAt }), "toggling an alarm")
  if (!sent) {
    if (hadPrior) records.setAlarm(id, prior)
    else records.deleteAlarm(id)
    return false
  }
  records.markDirty()
  try persistClockMeta()
  return true
}

/** Delete an alarm with a five-second Undo toast. */
export effect function deleteAlarmWithUndo(id: number): boolean!!(Alarms.Machine | Time | KeyValueStore.KeyValueStore | Said | Toasts.Machine) {
  const machine = try Alarms.Machine
  const records = try activeClockRecords()
  const now = try (try Time).now()
  const before = try machine.get()
  records.markAlarmDeleted(id)
  const sent = try contained(machine.send({ type: "requestDelete", id, now: untimed }), "deleting an alarm")
  if (!sent) {
    records.unmarkAlarmDeleted(id)
    return false
  }
  if (before.hasHidden) try withdraw(undoArea, before.hidden.id)
  records.markDirty()
  try persistClockMeta()
  const store = try KeyValueStore.KeyValueStore
  const undo = effect {
    const hadPrior = records.snapshot().alarms.has(id)
    const prior = records.alarm(id)
    records.unmarkAlarmDeleted(id)
    records.setAlarm(id, { updatedAtMs: now + 1 })
    const undone = try contained(machine.send({ type: "undoDelete", now: untimed }), "undoing an alarm deletion")
    if (undone) {
      records.markDirty()
      try ignore(store.set(metaStoreKey, records.serialize()))
    } else {
      if (hadPrior) records.setAlarm(id, prior)
      else records.deleteAlarm(id)
      records.markAlarmDeleted(id)
    }
  }
  const label = records.alarm(id).label
  const message = label !== "" ? `Deleted “${label}”` : "Alarm deleted"
  try offer(message, undoArea, id, undo)
  return true
}

/** Snooze a ringing alarm for its configured snooze duration. */
export effect function snoozeAlarm(id: number): boolean!!(Alarms.Machine | Time | KeyValueStore.KeyValueStore) {
  const machine = try Alarms.Machine
  const records = try activeClockRecords()
  const now = try (try Time).now()
  const sent = try contained(machine.send({ type: "snooze", id, now: untimed }), "snoozing an alarm")
  if (!sent) return false
  records.setAlarm(id, { updatedAtMs: now })
  records.markDirty()
  try persistClockMeta()
  return true
}

/** Dismiss a ringing or snoozed alarm, disabling one-off alarms and advancing repeating alarms. */
export effect function dismissAlarm(id: number): boolean!!(Alarms.Machine | Time | KeyValueStore.KeyValueStore) {
  const { machine, now, current } = try loadAlarm(id)
  if (current === undefined) return false
  const records = try activeClockRecords()
  const nextFireAt = current.daysMask > 0 ? nextAlarmFireAt(current.hour, current.minute, current.daysMask, now) : 0
  const sent = try contained(machine.send({ type: "dismiss", id, nextFireAt, now: untimed }), "dismissing an alarm")
  if (!sent) return false
  records.setAlarm(id, { updatedAtMs: now })
  records.markDirty()
  try persistClockMeta()
  return true
}

/** Clear the missed indicator on an alarm. */
export effect function ackMissedAlarm(id: number): boolean!!(Alarms.Machine | KeyValueStore.KeyValueStore) {
  const records = try activeClockRecords()
  const sent = try contained((try Alarms.Machine).send({ type: "ackMissed", id }), "acknowledging a missed alarm")
  if (sent) {
    records.markDirty()
    try persistClockMeta()
  }
  return sent
}

/** Return the earliest upcoming enabled alarm and its due instant, or undefined when none is armed. */
export function nextUpcomingAlarm(items: readonly Alarm[]): { readonly alarm: Alarm; readonly at: number } | undefined {
  let best: { readonly alarm: Alarm; readonly at: number } | undefined
  for (const item of items) {
    if (!item.enabled || item.phase === "Ringing") continue
    const at = Alarms.dueAtOf(item)
    if (at <= 0) continue
    if (best === undefined || at < best.at) best = { alarm: item, at }
  }
  return best
}

const autoSilenceWatch = started(Effect.scoped(effect {
  const machine = try Alarms.Machine
  const time = try Time
  const fibers = try FiberMap.make<number>()
  const armed = new Map<number, number>()

  effect function silenceWhenDue(id: number, fireAt: number): void!! {
    try time.until(fireAt + Alarms.ringTimeout)
    for (let attempt = 0; attempt < 2; attempt += 1) {
      const now = try time.now()
      const latest = (try machine.get()).items.find((item) => item.id === id)
      if (latest === undefined || latest.phase !== "Ringing") return
      const nextFireAt = latest.daysMask > 0 ? nextAlarmFireAt(latest.hour, latest.minute, latest.daysMask, now) : 0
      const sent = try contained(
        machine.send({ type: "autoSilence", id, nextFireAt, now: untimed }),
        `auto-silencing alarm ${id}`,
      )
      if (sent) return
    }
  }

  try Stream.runForEach(machine.changes, effect (state) => {
    const ringing = new Map<number, Alarm>()
    for (const item of state.items) {
      if (item.phase === "Ringing") ringing.set(item.id, item)
    }
    for (const [id, armedFireAt] of [...armed.entries()]) {
      const current = ringing.get(id)
      if (current === undefined || current.fireAt !== armedFireAt) {
        armed.delete(id)
        const existing = FiberMap.getUnsafe(fibers, id)
        if (Option.isSome(existing)) existing.value.interruptUnsafe()
      }
    }
    for (const [id, item] of ringing) {
      if (armed.get(id) === item.fireAt && Option.isSome(FiberMap.getUnsafe(fibers, id))) continue
      armed.set(id, item.fireAt)
      try FiberMap.run(fibers, id, silenceWhenDue(id, item.fireAt))
    }
  })
}), "auto-silencing ringing alarms")

const rescheduleUnarmed = started(effect {
  const machine = try Alarms.Machine
  const time = try Time
  try Stream.runForEach(machine.changes, effect (state) => {
    for (const item of state.items) {
      if (!item.enabled || item.daysMask <= 0 || item.phase !== "Idle" || item.fireAt !== 0) continue
      const now = try time.now()
      const nextFireAt = nextAlarmFireAt(item.hour, item.minute, item.daysMask, now)
      try contained(
        machine.send({ type: "reschedule", id: item.id, nextFireAt, now: untimed }),
        `rescheduling repeating alarm ${item.id}`,
      )
    }
  })
}, "rescheduling repeating alarms after reopen")

const withdrawCommitted = started(effect {
  const machine = try Alarms.Machine
  let hiddenId = 0
  try Stream.runForEach(machine.changes, effect (state) => {
    if (state.hasHidden) {
      hiddenId = state.hidden.id
      return
    }
    if (hiddenId > 0) {
      const id = hiddenId
      hiddenId = 0
      try withdraw(undoArea, id)
    }
  })
}, "withdrawing Clock deletion Undo toast")

const keptAlarms = reacting(Alarms, {
  keep: 1,
  open: [{ type: "reopen", now: untimed }],
  timers: alarmTimers,
})

/** Resident alarms machine with persistent state, deadline timers, auto-silence, reopen rescheduling, and Undo toast cleanup. */
export const alarms = together(keptAlarms, autoSilenceWatch, rescheduleUnarmed, withdrawCommitted)
