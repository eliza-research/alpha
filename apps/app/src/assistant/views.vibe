// spec/app/assistant/index.md, "Story: Let Alpha open what it is talking about"; spec/app/browser/index.md, "Story: Let the agent open a page"; spec/app/assistant/context.md, "A spoken turn carries what a typed turn sent at that moment would, the view claim included"
import type { TurnResult } from "@elizaos/agent"
import * as Conversation from "../../gen/app__assistant.effect.vibe"
import { screenViews } from "../../gen/app__assistant.effect.vibe"
import { resent } from "../../gen/app__assistant__context.effect.vibe"
import type { Machine as ConversationMachine } from "../../gen/app__assistant.effect.vibe"
import { type Detent, Machine as Shell, type View, parseEvent } from "../../gen/app__shell.effect.vibe"
import { opensWithoutCard } from "../../gen/app__browser.effect.vibe"
import * as Prefs from "../../gen/app__settings__preferences.effect.vibe"
import { readOperation } from "@elizaos/agent"
import { Agent, AgentPages, type AgentPage, ask, dismissOverlayHost, openAppViaOverlayAndWait } from "../platform/index.vibe"
import { agentOpen, mayAgentOpen } from "../notes/agent.vibe"
import { contained, started } from "../runtime/index.vibe"
import { currentSurface } from "../surface.ts"

module web {
  /** A fresh id for this page as a renderer of the agent's views. @throws {never} */
  export function renderer(): string {
    return crypto.randomUUID()
  }
}
import { renderer } from web

/** The renderer, installation and view a prepared navigation is bound to, as eliza's agent hands it back. */
schema Binding {
  readonly requestId: string
  readonly clientId: string
  readonly viewId: string
  readonly viewType: "gui"
  readonly installationId: string
}

/** A view the agent prepared for this screen in a turn's completed action. */
schema Handoff {
  readonly subview?: string
  readonly navigationBinding: Binding
}

schema Prepared { readonly values: Handoff }
/** A page eliza's BROWSER_OPEN asked the screen `clientId` to open: at once when `atOnce`, else for the owner's Open. */
schema PageAsked { readonly actionName: "BROWSER_OPEN"; readonly mode: "open"; readonly operation: Schema.Unknown; readonly clientId: string; readonly atOnce?: boolean }
const pageAskedOf = Schema.decodeUnknownOption(PageAsked)
const Claimed = Schema.Struct({ claimId: Schema.String, target: Schema.optionalKey(Schema.Struct({ kind: Schema.Literal("saved-note"), noteId: Schema.String })) })
schema Answered { readonly ok: boolean }
const preparedOf = Schema.decodeUnknownOption(Prepared)

/** A view prepared in answer to the owner's request numbered `asked`. */
export interface Held {
  readonly asked: number
  readonly handoff: Handoff
}

/** A page the agent asked to open for the owner's request numbered `asked`. */
export interface PageHeld {
  readonly asked: number
  readonly page: AgentPage
}

type TypedHeld = Held | PageHeld | { readonly asked: number; readonly continueFiles: Effect.Effect<void> } | { readonly asked: number; readonly openAsked: Effect.Effect<void> }

/** Where an agent's view goes: Home, or one of Alpha's apps. */
type Place = View | "Home"

interface SpokenView {
  readonly held: Held | PageHeld
  readonly current: Effect.Effect<boolean>
  readonly front: (place: Place, inside: boolean) => Effect.Effect<boolean>
  readonly completed: Deferred.Deferred<void>
}

/** The id the launch declares Home by (spec/agent/index.md, "The launch names Home and every Alpha app but Notes and Browser as a view the agent may show, by the id the phone opens it by"). */
const homeViewId = "home"

/** The place an agent's view id names: Home by its id, else the app of the same name, compared without its case, as the shell's own events name views. */
function viewPlace(viewId: string): Place | undefined {
  if (viewId.toLowerCase() === homeViewId) return "Home"
  const opened = parseEvent({ type: "openView", view: `${viewId.charAt(0).toUpperCase()}${viewId.slice(1).toLowerCase()}` })
  return opened?.type === "openView" ? opened.view : undefined
}

// spec/app/shell/index.md, "Agent navigation shows an admitted app or Home, lowering Ask Alpha only where it would hide it"
/** Whether a handoff opens a saved note: a page inside Notes, which keeps a sheet and lowers the full screen. */
function savedNote(handoff: Handoff): boolean {
  return handoff.subview === "saved-note-v1"
}

/** The place a handoff names, if Alpha has it: a saved note only in Notes. */
function placeFor(handoff: Handoff): Place | undefined {
  const place = viewPlace(handoff.navigationBinding.viewId)
  return handoff.subview === "saved-note-v1" && place !== "Notes" ? undefined : place
}

/**
 * This screen as a renderer of the agent's views: the owner's requests, numbered as they are sent, typed or spoken,
 * and the view a typed turn's reply prepared, held by its turn until the reply is complete.
 */
export service Views {
  readonly clientId: string
  begin(): number!!
  current(): number!!
  hold(ticket: number, held: TypedHeld): void!!
  take(ticket: number): Option.Option<TypedHeld>!!
  spoken(held: Held | PageHeld, current: Effect.Effect<boolean>, front: (place: Place, inside: boolean) => Effect.Effect<boolean>): void!!
  /** The ids of the views this screen can show now: Home and every app the shell has here. */
  shown(): readonly string[]!!
  readonly heard: Queue.Dequeue<SpokenView>
}

// spec/app/assistant/index.md, "A turn tells the agent the views this screen can show, so a reply never promises one it cannot open"
/** The ids the agent declares the views of a shell that is or is not an image, and does or does not admit Contacts, by. */
export function screenViewIds(image: boolean, contacts: boolean): readonly string[] {
  return [homeViewId, ...screenViews(image, contacts).map((view) => view.toLowerCase())]
}

export const handoffs = Layer.effect(Views, effect {
  const clientId = renderer()
  const shell = try Shell
  const heard = try Queue.unbounded<SpokenView>()
  let latest = 0
  let typed: { readonly ticket: number; readonly held: TypedHeld } | undefined
  return {
    clientId,
    heard,
    begin: () => sync(() => {
      latest += 1
      typed = undefined
      return latest
    }),
    current: () => sync(() => latest),
    shown: effect () => {
      const now = try shell.get()
      return screenViewIds(now.image, now.contacts)
    },
    hold: (ticket: number, held: TypedHeld) => sync(() => { if (held.asked === latest) typed = { ticket, held } }),
    take: (ticket: number) => sync(() => {
      if (typed?.ticket !== ticket) return Option.none()
      const found = typed.held
      typed = undefined
      return Option.some(found)
    }),
    spoken: effect (held: Held | PageHeld, current: Effect.Effect<boolean>, front: (place: Place, inside: boolean) => Effect.Effect<boolean>) => {
      const completed = try Deferred.make<void>()
      try Queue.offer(heard, { held, current, front, completed })
      try Deferred.await(completed)
    },
  }
})

// spec/app/assistant/context.md, "A turn an agent refuses whole for a direct-request mode it does not know is sent once more without it"
/** Whether the agent refused a turn that asked `direct` whole for its voice view context, as one older than the mode does, so it goes once more without it. */
export function resendWithoutMode(result: TurnResult | undefined, direct: boolean): boolean {
  return resent(result?.kind !== "NotAccepted" ? "TurnAccepted" : result.refusal?.code === "VOICE_UI_CONTEXT_INVALID" ? "ContextRefused" : "OtherRefusal", direct)
}

/** The direct Files requests a turn asks for: with the review cards a typed turn shows, or with none, as a spoken turn has. */
export type DirectFilesMode = "direct-files-v1" | "direct-files-only-v1"

// spec/app/assistant/context.md, "A spoken turn carries what a typed turn sent at that moment would, the view claim included"; spec/app/assistant/index.md, "A turn tells the agent the views this screen can show, so a reply never promises one it cannot open"
/** What a turn told of the screen adds so the agent may hand back a view to open on it: views as completed actions, this screen, the views it can show, and its saved-note editor. */
export function delivery(clientId: string, shown: readonly string[], directFiles?: DirectFilesMode) {
  return {
    viewDelivery: "completed-action" as const,
    viewClientId: clientId,
    voiceUi: { viewDelivery: "completed-action" as const, uiClientId: clientId, uiNotesEditor: "saved-note-v1" as const, uiViews: [...shown],
      ...(directFiles === undefined ? {} : { agentActionMode: directFiles }) },
  }
}

/** The last view the reply's actions prepared for this screen, if any. */
export function preparedIn(results: ReadonlyArray<{ readonly action: string; readonly data: unknown }>, clientId: string): Handoff | undefined {
  const found = results.filter((result) => result.action === "VIEWS").map((result) => Option.getOrUndefined(preparedOf(result.data))?.values).at(-1)
  return found?.navigationBinding.clientId === clientId ? found : undefined
}

/** The page this screen was asked to open: eliza's typed open of the reply's last `BROWSER_OPEN` that opened one, and whether it opens at once, if any. */
export function pageIn(results: ReadonlyArray<{ readonly action: string; readonly data: unknown }>, clientId: string): AgentPage | undefined {
  return results.flatMap((result): AgentPage[] => {
    const asked = result.action === "BROWSER_OPEN" ? Option.getOrUndefined(pageAskedOf(result.data)) : undefined
    const operation = asked?.clientId === clientId ? readOperation(asked.operation)?.operation : undefined
    return asked !== undefined && operation?.type === "browser_navigate" ? [{ operation, atOnce: asked.atOnce === true }] : []
  }).at(-1)
}

// spec/app/browser/index.md, "A page the owner's whole message asked for opens at once, typed or spoken, and any other page waits for the owner's Open"
/** Whether a page the owner's whole message asked for may open with no card: the phone read and settled the owner's preferences, and Ask before Alpha acts is off. */
export function opensAtOnce(prefs: Prefs.Preferences): boolean {
  return Prefs.free(prefs) && opensWithoutCard(true, Prefs.asksBeforeActing(prefs, "WebAction"))
}

/** `page` as it may open now: at once only while the owner lets Alpha act on the web without asking, else on the Browser's card. */
effect function asAllowed(page: AgentPage): AgentPage!!Prefs.Machine {
  if (!page.atOnce || opensAtOnce(try (try Prefs.Machine).get())) return page
  return { ...page, atOnce: false }
}

/** Open `place` for the reply of `ticket`, once, as the conversation allows; whether it opened. `inside` opens a page inside the view, as a saved note is: a sheet stays and the full screen lowers. */
effect function navigated(ticket: number, place: Place, inside = false): boolean!!Conversation.Machine {
  const conversation = try Conversation.Machine
  if (place === "Home") {
    if (!Conversation.canNavigateHome(try conversation.get(), ticket)) return false
    if (!(try contained(conversation.send({ type: "navigateHome", ticket }), "returning Home for a reply"))) return false
  } else {
    if (!Conversation.canNavigate(try conversation.get(), ticket, place, inside)) return false
    if (!(try contained(conversation.send({ type: "navigate", ticket, view: place, inside }), "opening the view a reply prepared"))) return false
  }
  return try navigationEnded(conversation, ticket)
}

// spec/app/assistant/index.md, "An explicit Files continuation opens only from the same app trail and Ask Alpha panel"
export effect function navigateFilesForReply(conversation: ConversationMachine.Shape, ticket: number, source: View[], panel: Detent, route: number): boolean!! {
  if (!Conversation.canNavigateFiles(try conversation.get(), ticket, source, panel, route)) return false
  if (!(try contained(conversation.send({ type: "navigateFiles", ticket, source, panel, route }), "opening Files for a reply"))) return false
  return try navigationEnded(conversation, ticket)
}

effect function navigationEnded(conversation: ConversationMachine.Shape, ticket: number): boolean!! {
  const ended = try Stream.runHead(Stream.filter(conversation.changes, (c) => c.opening.id !== ticket || c.opening.outcome !== "Sent"))
  return Option.isSome(ended) && ended.value.opening.id === ticket && ended.value.opening.outcome === "Confirmed"
}

export const voiceViews: ReadonlyArray<View> = [
  "Phone", "Messages", "Inbox", "Telegram", "Slack", "Calendar", "Clock", "Reminders", "Browser", "Camera", "Photos", "Maps", "Notes", "Contacts", "Files", "Workflows", "Wallet", "Settings",
]

export function placeOf(view: View | undefined): number {
  if (view === undefined) return 1
  const at = voiceViews.indexOf(view)
  return at >= 0 ? at + 2 : 1
}

export function viewOfPlace(place: number): View | undefined {
  return place >= 2 ? voiceViews[place - 2] : undefined
}

/**
 * Open the saved note `noteId` for the owner's request `asked`: only if Notes would let the agent open it as it is
 * now, Notes is brought to the front by `front`, and then opened there. Whether the view switched and the note opened;
 * nothing is opened behind a screen that did not switch.
 */
effect function openNamed<R>(noteId: string, asked: number, front: boolean!!R) {
  const views = try Views
  const sensitive = (try (try Conversation.Machine).get()).context.sensitive
  if (!(try mayAgentOpen(noteId, { turn: asked, current: try views.current(), sensitive }))) return { switched: false, opened: false }
  if (!(try front)) return { switched: false, opened: false }
  return { switched: true, opened: try agentOpen(noteId, { turn: asked, current: try views.current(), sensitive }) }
}

function confirmedNoteOpen(resultJson: string | undefined): boolean {
  if (resultJson === undefined || resultJson.length === 0) return false
  try {
    const parsed = JSON.parse(resultJson) as { readonly opened?: unknown; readonly shown?: unknown }
    return parsed.opened === true || parsed.shown !== undefined
  } catch {
    return false
  }
}

/**
 * Carry out `held`: claim it once, bring its place to the front as `front` does, open a saved note in Notes'
 * editor, and tell the agent whether the view switched and, for a note, that it is shown. Nothing is said on screen.
 */
effect function carriedOut<R>(held: Held, front: boolean!!R) {
  const binding = held.handoff.navigationBinding
  const saved = held.handoff.subview === "saved-note-v1"
  const claim = ask(Agent, HttpClientRequest.post("/api/views/interact-claim") |> HttpClientRequest.bodyJsonUnsafe(%, { ...binding, ...(saved ? { targetProtocol: "saved-note-v1" } : {}) }), Claimed) catch () => undefined
  if (claim === undefined) return
  const target = claim.target
  let done: { readonly switched: boolean; readonly opened: boolean }
  if (currentSurface().mode === "overlay") {
    const place = placeFor(held.handoff)
    if (place === "Home") {
      try dismissOverlayHost()
      done = { switched: true, opened: false }
    } else if (place === undefined || (saved && target === undefined)) {
      done = { switched: false, opened: false }
    } else {
      const payload = JSON.stringify({
        view: place,
        ...(held.handoff.subview === undefined ? {} : { subview: held.handoff.subview }),
        ...(target === undefined ? {} : { target }),
      })
      const receipt = try openAppViaOverlayAndWait(`alpha://${place.toLowerCase()}/`, claim.claimId, payload)
      done = { switched: receipt.switched, opened: saved && receipt.switched && confirmedNoteOpen(receipt.resultJson) }
    }
  } else {
    done = !saved ? { switched: try front, opened: false }
      : target === undefined ? { switched: false, opened: false }
      : try openNamed(target.noteId, held.asked, front)
  }
  const result = { switched: done.switched, ...(done.opened && target !== undefined ? { shown: target } : {}) }
  try ignore(ask(Agent, HttpClientRequest.post("/api/views/interact-result") |> HttpClientRequest.bodyJsonUnsafe(%, { ...binding, claimId: claim.claimId, success: done.switched, result }), Answered))
}

// spec/app/assistant/index.md, "A complete reply may open one view, once, while the screen it was asked from still shows"; spec/app/assistant/index.md, "A complete reply may take the owner Home, once, as it may open a view"; spec/app/browser/index.md, "A page the owner's whole message asked for opens at once, typed or spoken, and any other page waits for the owner's Open"; spec/app/notes/index.md, "The agent opens the one note the owner named, as the list last read it, once for the owner's current request, and is told whether it opened"
/** Carry out the view the complete reply of `ticket` prepared for this screen, if Alpha has that view or it is Home. */
effect function openPrepared(ticket: number) {
  const views = try Views
  const held = try views.take(ticket)
  if (Option.isNone(held) || held.value.asked !== (try views.current())) return
  if ("continueFiles" in held.value) return try held.value.continueFiles
  if ("openAsked" in held.value) return try held.value.openAsked
  if ("page" in held.value) {
    const allowed = try asAllowed(held.value.page)
    if (try navigated(ticket, "Browser", !allowed.atOnce)) try (try AgentPages).open(allowed, Effect.map(views.current(), (now) => now === held.value.asked))
    return
  }
  const place = placeFor(held.value.handoff)
  if (place !== undefined) try carriedOut(held.value, navigated(ticket, place, savedNote(held.value.handoff)))
}

// spec/app/assistant/index.md, "A complete reply may open one view, once, while the screen it was asked from still shows"
/** Each typed reply that completes has what it prepared for this screen carried out once, to its end, whatever the turn does next. */
export const carried = started(effect {
  const conversation = try Conversation.Machine
  const complete = Stream.filter(conversation.changes, (c) => c.turn.reply === "Complete")
  try Stream.runForEach(Stream.changesWith(complete, (a, b) => a.turn.send.id === b.turn.send.id), (c) => contained(openPrepared(c.turn.send.id), "opening what a reply prepared"))
}, "opening what a reply prepared")

// spec/app/assistant/context.md, "A spoken turn carries what a typed turn sent at that moment would, the view claim included"
/** Carry out the completed reply's prepared view, or show the page it asked for on the Browser's card, through the spoken turn's own navigation claim. */
export const carriedAloud = started(effect {
  const views = try Views
  try Stream.runForEach(Stream.fromQueue(views.heard), (work) => Effect.ensuring(effect {
    const held = work.held
    if (held.asked !== (try views.current()) || !(try work.current)) return
    if ("page" in held) {
      const allowed = try asAllowed(held.page)
      if (try work.front("Browser", !allowed.atOnce)) try (try AgentPages).open(allowed, Effect.map(views.current(), (now) => now === held.asked))
      return
    }
    const place = placeFor(held.handoff)
    if (place === undefined) return
    try contained(carriedOut(held, work.front(place, savedNote(held.handoff))), "opening what a spoken reply prepared")
  }, asVoid(Deferred.succeed(work.completed, undefined))))
}, "opening what a spoken reply prepared")
