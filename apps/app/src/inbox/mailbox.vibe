// spec/app/inbox/index.md, "Story: See my mail"
import { CloudError } from "@elizaos/cloud"
import { type SecondFactor, type SignInAttempt, type SignInReceipt, signInCode } from "@elizaos/os-bridges"
import { gmailConsentCapabilities, protocolFailure } from "@elizaos/plugin-inbox-client"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Inbox from "../../gen/app__inbox.effect.vibe"
import { Machine as Drafts } from "../../gen/app__inbox__drafts.effect.vibe"
import * as Sending from "../../gen/app__inbox__sending.effect.vibe"
import type { Effect as Out, Event, Folder } from "../../gen/app__inbox.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Time } from "../runtime/index.vibe"
import { waiting } from "../home/waiting.vibe"
import { civilDay } from "../calendar/time.ts"
import { fromAreas } from "../home/cards.vibe"
import { Device, native } from "../platform/index.vibe"
import { CLOUD_ENVIRONMENT, openGoogleAuthorization, signInAccounts } from "../platform/index.vibe"
import { afterMailSignIn, leaseRefusalReason } from "../../gen/app__platform.effect.vibe"
import { Cloud, mailSignIn } from "../platform/index.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, say } from "../notices/index.vibe"
import { type Job, Whole, answer, contained, createShelf, migratedStore, reacting, started, stream, together, untimed } from "../runtime/index.vibe"
import { InboxAhead, aheadKey, prefetch } from "./ahead.vibe"
import type { GmailAuthorizationWindow } from "./authorization.vibe"
import { Mail, asked, connections, failureOf, mail, page } from "./gmail.vibe"
import { provider } from "./provider.vibe"
import { savedBodies } from "./saved-bodies.vibe"

const owner = "alpha/inbox/owner"
type Owner = { readonly stamp: string; readonly saved: string | undefined }
type MailSession = Cloud | Mail | Inbox.Machine | KeyValueStore.KeyValueStore
type MailConsent = Cloud | Mail | Inbox.Machine | Drafts | Sending.Machine | Shell | Toasts | Said
type ConsentIntent = { readonly kind: "Connect"; readonly route: number }
  | { readonly kind: "Send"; readonly route: number; readonly account: number; readonly draft: number; readonly session: number }

/** Each new owner session, including a different owner who is already signed in. */
export const ownerChanges = Stream.unwrap(effect {
  const list = try Inbox.Machine
  const ledger = try Mail
  const owners = Stream.map(list.changes, (state) => `${ledger.generation()}/${state.signedIn}`)
  return Stream.drop(Stream.changes(owners), 1)
})

// spec/app/inbox/index.md, "The answer names the connected accounts, their credentials and grants; the account chosen stays selected while it is connected, else the one account that may be read, else none and the owner chooses"; spec/app/inbox/index.md, "A check the phone holds back for want of the mail lease keeps the session and everything kept, and asks for one more sign-in"
effect function checked(ticket: number): Event!!MailSession {
  const list = try Inbox.Machine
  const ledger = try Mail
  const lost: Event = { type: "accountsAnswered", ticket, ok: false, connected: [] }
  if (!ledger.ownerConfirmed()) return lost
  const generation = ledger.generation()
  const reply = effect { return { accounts: try connections() } }
    catch (cause) => ({ signedOut: protocolFailure(cause)?.status === 401, held: protocolFailure(cause)?.reason === leaseRefusalReason })
  if (ledger.generation() !== generation || !Inbox.canAccountsAnswered(try list.get(), ticket)) return lost
  if ("signedOut" in reply) {
    if (reply.held) return { type: "accountsHeld", ticket }
    if (reply.signedOut) {
      try ledger.forget()
      try ignore((try KeyValueStore.KeyValueStore).remove(owner))
      return { type: "sessionChanged", signedIn: false }
    }
    return { type: "accountsAnswered", ticket, ok: false, connected: [] }
  }
  return { type: "accountsAnswered", ticket, ok: true, connected: [...(try ledger.connected(reply.accounts))] }
}

const failed = (ticket: number, failure: Inbox.Failure): Event => ({
  type: "listed", ticket, ok: false, failure, found: 0, following: 0, shifted: false, spamTrash: false, unread: 0, now: untimed,
})

// spec/app/inbox/index.md, "Only the newest read's answer is shown, and only while reading is allowed"
effect function read(ticket: number, account: number, folder: Folder, query: string, cursor: number): (Event | undefined)!!(Cloud | Mail | Inbox.Machine | InboxAhead) {
  const ledger = try Mail
  const list = try Inbox.Machine
  const before = try list.get()
  const credential = Inbox.linkOf(before.connected, account).credential
  const generation = ledger.generation(account)
  const matches = (state: Inbox.Mailbox) => Inbox.canListed(state, ticket, 0, 0) && state.selected.account === account &&
    state.selected.folder === folder && state.selected.query === query && Inbox.linkOf(state.connected, account).credential === credential
  if (!matches(before)) return undefined
  const token = cursor === 0 ? undefined : ledger.token(cursor)
  const prepared = token === undefined ? undefined : try (try InboxAhead).page.take(aheadKey(before, ledger, ticket - 1), token)
  const result = prepared ?? (page(account, folder, query, cursor, before.searchable) catch (cause) => failed(ticket, failureOf(cause)))
  if (!matches(try list.get()) || ledger.generation(account) !== generation) return undefined
  if ("type" in result) return result
  const staged = ledger.stage(ticket, { account, folder, query }, credential, cursor === 0, result)
  return { type: "listed", ticket, ok: true, failure: "Fine", ...staged, spamTrash: result.supportsSpamTrash, now: untimed }
}

function carry(fx: Out): Job<Event, Cloud | Mail | Inbox.Machine | InboxAhead | KeyValueStore.KeyValueStore, []> {
  return match (fx) {
    when { tag: "ReadAccounts", let ticket }: answer("accounts", checked(ticket), { type: "accountsAnswered", ticket, ok: false, connected: [] });
    when { tag: "ReadList", let ticket, let account, let folder, let query, let cursor }:
      stream("list", Stream.filter(Stream.fromEffect(read(ticket, account, folder, query, cursor)), (event): event is Event => event !== undefined), failed(ticket, "Unreachable"));
  }
}

// spec/app/inbox/index.md, "A restart keeps the selection, the list kept for it and its credential, whether Spam and Trash can be searched, and the count as no longer fresh, and forgets the rest"
/** A list kept before the search field was part of it, brought in with the field closed so its saved list is not lost. */
effect function listRecord(raw: string | undefined): (string | undefined)!! {
  if (raw === undefined) return undefined
  const fields = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown)))(raw) catch () => undefined
  if (fields === undefined || "searching" in fields) return raw
  const migrated = Inbox.decodeState({ ...fields, searching: false }) catch () => undefined
  return migrated === undefined ? raw : JSON.stringify(migrated)
}

function stored(key: string, start = Inbox.initial) {
  return Layer.provide(Inbox.stored(key, start), migratedStore(key, listRecord))
}

const kept = reacting({ ...Inbox, stored }, { keep: 1, open: [{ type: "restart" }], carry })

/** The phone can still identify its previously signed-in owner when Cloud cannot be reached. */
effect function deviceOwner() {
  const device = timeout(tryPromise(() => signInAccounts().status({ environment: CLOUD_ENVIRONMENT })), "5 seconds") catch () => undefined
  const owner = device?.account
  if (owner?.kind === "signedOut") return null
  if (owner?.kind !== "signedIn" || !owner.userId || !owner.organizationId || !owner.credentialId ||
    owner.keyExpiresAt <= (try Clock.currentTimeMillis)) return undefined
  return owner
}

/** The owner's current scope, a confirmed sign-out or mismatch, or an unanswered check. */
effect function currentOwner(): (Owner | null | undefined)!!Cloud {
  const { client } = try Cloud
  const phone = native()
  const cloudCheck = effect {
    return asked((signal) => client.account({ signal }))
      catch (failed) => (failed.cause instanceof CloudError && failed.cause.failure.tag === "CloudCredentialInvalid" ? null : undefined)
  }
  const { cloud, device } = try all({
    cloud: cloudCheck,
    device: phone ? deviceOwner() : succeed(undefined),
  }, { concurrency: "unbounded" })
  if (cloud === null || device === null) return null
  if (device !== undefined && cloud !== undefined &&
    (cloud.id !== device.userId || cloud.organization_id !== device.organizationId)) return null
  const organization = cloud?.organization_id ?? device?.organizationId
  const user = cloud?.id ?? device?.userId
  if (!organization || !user) return undefined
  const saved = device !== undefined ? JSON.stringify([organization, user, device.credentialId])
    : phone ? undefined : JSON.stringify([organization, user])
  return { stamp: JSON.stringify([2, CLOUD_ENVIRONMENT, organization, user]), saved }
}

// spec/app/inbox/index.md, "A new cloud session starts from nothing, and checks the accounts only once signed in"
effect function recheck(): void!!MailSession {
  const store = try KeyValueStore.KeyValueStore
  const machine = try Inbox.Machine
  const ledger = try Mail
  const generation = ledger.generation()
  const who = try currentOwner()
  if (ledger.generation() !== generation) return
  if (who === undefined) {
    if (native()) ledger.concealSaved()
    if ((try machine.get()).signedIn) try contained(machine.send({ type: "checkAccess" }), "checking Gmail access")
    return
  }
  const before = (store.get(owner) catch () => undefined) ?? ""
  const stamp = who?.stamp ?? ""
  const changed = stamp !== before
  const retired = changed ? try ledger.forget() : generation
  if (ledger.generation() !== retired) return
  if (changed) try ignore(store.set(owner, stamp))
  if (who !== null) try ledger.confirmOwner(who.saved)
  if (ledger.generation() !== retired) return
  const signedIn = who !== null
  if (changed || (try machine.get()).signedIn !== signedIn) {
    try contained(machine.send({ type: "sessionChanged", signedIn }), "the cloud session")
  } else if (signedIn) try contained(machine.send({ type: "checkAccess" }), "checking Gmail access")
}

// spec/app/platform/index.md, "The owner's tap on a mail sign-in control starts the phone's one more sign-in for mail where the phone wants it, then reads again once"
/** The owner's tap on Connect Eliza Cloud or Reconnect: the phone's sign-in for mail where it wants one, then one more check; `usual` where it wants none. */
effect function signInForMail(usual: () => void): void!!(Cloud | Mail | Inbox.Machine | KeyValueStore.KeyValueStore) {
  const next = afterMailSignIn(try mailSignIn())
  if (next === "ReadAgain") try recheck()
  else if (next === "AsAlways") usual()
}

/** Owner confirmation state when the phone requires a fresh account session before opening Google OAuth consent. */
export type MailReauthState =
  | { readonly kind: "Idle" }
  | { readonly kind: "Starting"; readonly email: string }
  | { readonly kind: "EnterCode"; readonly email: string; readonly expiresAt: number; readonly error?: string; readonly busy?: boolean }
  | { readonly kind: "UseFactor"; readonly email: string; readonly factors: readonly SecondFactor[]; readonly expiresAt: number; readonly smsSent: boolean; readonly error?: string; readonly busy?: boolean }

interface PendingMailConsent {
  readonly intent: ConsentIntent
  readonly account: number
  readonly capabilities: ReadonlyArray<string>
  readonly owner: Owner
  readonly generation: number
  readonly email: string
  readonly attempt: SignInAttempt
  readonly expiresAt: number
}

type ConnectOutcome = "Opened" | "ReauthRequired" | "Failed"

effect function consentActive(intent: ConsentIntent, account: number, generation: number): boolean!!MailConsent {
  const view = try (try Shell).get()
  const list = try (try Inbox.Machine).get()
  const ledger = try Mail
  if (view.route !== intent.route || !showing(view, "Inbox") || !list.signedIn || list.failure === "LeaseNeeded" ||
    !ledger.ownerConfirmed() || ledger.generation() !== generation) return false
  if (intent.kind === "Connect") return list.selected.account === account && !Inbox.readable(list)
  const draft = try (try Drafts).get()
  return draft.open && draft.letter.id === intent.draft && draft.letter.account === account && draft.session === intent.session &&
    Sending.canTurnOnSending(try (try Sending.Machine).get(), Inbox.accessOf(list, account), account)
}

effect function openGoogleConsent(
  capabilities: ReadonlyArray<string>,
  owner: Owner,
  active: boolean!!MailConsent,
  popup: GmailAuthorizationWindow,
): ConnectOutcome!!MailConsent {
  const client = provider(try Cloud)
  const reply = effect {
    return { ok: true as const, authUrl: (try client.gmailConnect(capabilities)).authUrl }
  } catch (cause) => ({
    ok: false as const,
    reauth: protocolFailure(cause)?.status === 401 && protocolFailure(cause)?.reason === "reauth_required",
  })
  if (!reply.ok) return reply.reauth ? "ReauthRequired" : "Failed"
  const current = try currentOwner()
  if (current?.stamp !== owner.stamp || current.saved !== owner.saved || !(try active)) return "Failed"
  const url = Effect.try(() => new URL(reply.authUrl)) catch () => undefined
  if (url === undefined || url.origin !== "https://accounts.google.com" || url.pathname !== "/o/oauth2/v2/auth" ||
    url.username !== "" || url.password !== "") return "Failed"
  return (try popup.open(url)) ? "Opened" : "Failed"
}

/** Inbox's sign-in for mail, for the list's own controls to ask. */
export service MailSignIn {
  /** The owner tapped Connect Eliza Cloud or Reconnect, whose action is otherwise `usual`. */
  signIn(usual: () => void): void!!
  retry(): void!!
  consent(intent: ConsentIntent, popup: GmailAuthorizationWindow | undefined): void!!
  reauthSnapshot(): MailReauthState
  subscribeReauth(listener: () => void): () => void
  verifyReauth(typed: string, factor?: SecondFactor): void!!
  sendReauthSms(): void!!
  resendReauth(): void!!
  cancelReauth(): void!!
}

const signIns = Layer.effect(MailSignIn, effect {
  const whole = try Whole
  const opening = try Semaphore.make(1)
  const reauthShelf = createShelf<MailReauthState>({ kind: "Idle" })
  let pending: PendingMailConsent | undefined
  let reauthEpoch = 0

  effect function retireAttempt(): void!! {
    const previous = pending
    pending = undefined
    if (previous !== undefined) try ignore(tryPromise(() => signInAccounts().cancel({ attempt: previous.attempt })))
  }

  effect function clearReauth(): void!! {
    reauthEpoch += 1
    try retireAttempt()
    reauthShelf.set({ kind: "Idle" })
  }

  effect function startEmailReauth(
    meta: Omit<PendingMailConsent, "attempt" | "expiresAt">,
    active: boolean!!MailConsent,
  ): ("Confirmed" | "Waiting" | "Stale" | "Unavailable")!!MailConsent {
    const started = reauthEpoch
    try retireAttempt()
    reauthShelf.set({ kind: "Starting", email: meta.email })
    const receipt = tryPromise(() => signInAccounts().reauthenticate({ environment: CLOUD_ENVIRONMENT, method: "email", email: meta.email })) catch () => undefined
    if (receipt === undefined) {
      if (reauthEpoch === started) reauthShelf.set({ kind: "Idle" })
      return "Unavailable"
    }
    if (reauthEpoch !== started || !(try active)) {
      try ignore(tryPromise(() => signInAccounts().cancel({ attempt: receipt.attempt })))
      return "Stale"
    }
    if (receipt.verdict.kind === "AccountConfirmed") {
      reauthShelf.set({ kind: "Idle" })
      return "Confirmed"
    }
    if (receipt.verdict.kind !== "CodeOnItsWay") {
      reauthShelf.set({ kind: "Idle" })
      return "Unavailable"
    }
    pending = { ...meta, attempt: receipt.attempt, expiresAt: receipt.verdict.expiresAt }
    reauthShelf.set({ kind: "EnterCode", email: meta.email, expiresAt: receipt.verdict.expiresAt })
    return "Waiting"
  }

  // spec/app/inbox/index.md, "The owner authorizes Gmail in Google and Inbox checks access on return"
  effect function authorize(intent: ConsentIntent, popup: GmailAuthorizationWindow | undefined): boolean!!MailConsent {
    const mailbox = try Inbox.Machine
    const ledger = try Mail
    const operations = try Sending.Machine
    const account = intent.kind === "Send" ? intent.account : (try mailbox.get()).selected.account
    const generation = ledger.generation()
    const active = consentActive(intent, account, generation)
    if (!(try active)) return false
    if (popup === undefined) {
      try say("Allow pop-ups to connect Gmail", true)
      return false
    }
    const started = effect {
      if (intent.kind === "Send") {
        const access = Inbox.accessOf(try mailbox.get(), account)
        const moved = try operations.send({ type: "turnOnSending", access, account }, "Owner")
        if (!moved.out.some((emitted) => emitted.tag === "OpenGoogleAccess" && emitted.account === account)) return false
      }
      const owner = try currentOwner()
      if (owner?.saved === undefined || !(try active)) return false
      const client = provider(try Cloud)
      const connection = ledger.connection(account)
      const held = connection === undefined ? [] : (try client.gmailAccounts()).find((item) => item.connectionId === connection)?.grantedCapabilities ?? []
      if (!(try active)) return false
      const capabilities = [
        ...gmailConsentCapabilities(intent.kind === "Send" ? "send" : "modify", held),
        ...held.filter((name) => name.startsWith("google.calendar.")),
      ]
      const first = try openGoogleConsent(capabilities, owner, active, popup)
      if (first === "Opened") return true
      if (first !== "ReauthRequired" || !native()) return false
      const readiness = (tryPromise(() => signInAccounts().status({ environment: CLOUD_ENVIRONMENT })) catch () => undefined)?.readiness
      if (readiness?.google) {
        const googleReceipt = tryPromise(() => signInAccounts().reauthenticate({ environment: CLOUD_ENVIRONMENT, method: "google" })) catch () => undefined
        if (googleReceipt?.verdict.kind === "AccountConfirmed") {
          return (try openGoogleConsent(capabilities, owner, active, popup)) === "Opened"
        }
        if (googleReceipt?.verdict.kind === "Ended" && googleReceipt.verdict.problem === "Cancelled") return true
      }
      if (!readiness?.email) return false
      const cloud = try Cloud
      const profile = asked((signal) => cloud.client.account({ signal })) catch () => undefined
      const email = profile?.email?.trim()
      if (!email || !(try active)) return false
      const begun = try startEmailReauth({ intent, account, capabilities, owner, generation, email }, active)
      if (begun === "Waiting" || begun === "Stale") return true
      if (begun === "Confirmed") return (try openGoogleConsent(capabilities, owner, active, popup)) === "Opened"
      return false
    } catch () => false
    if (!started && (try active)) try say("Gmail authorization could not be opened", true)
    return started
  }

  effect function verify(typed: string, factor?: SecondFactor): void!!MailConsent {
    const current = pending
    const started = reauthEpoch
    if (current === undefined) return
    const active = consentActive(current.intent, current.account, current.generation)
    if ((try Clock.currentTimeMillis) >= current.expiresAt || !(try active)) {
      const stillHere = try active
      try clearReauth()
      if (stillHere) try say("Gmail authorization could not be opened", true)
      return
    }
    const setReauthForm = (error: string | undefined, busy: boolean) => {
      reauthShelf.update((state) => (state.kind === "EnterCode" || state.kind === "UseFactor" ? { ...state, error, busy } : state))
    }
    const code = signInCode(typed)
    if (Option.isNone(code)) {
      setReauthForm("Check the code and try again.", false)
      return
    }
    setReauthForm(undefined, true)
    const receipt: SignInReceipt | undefined = tryPromise(() => signInAccounts().verify({
      attempt: current.attempt, code: code.value, ...(factor === undefined ? {} : { factor }),
    })) catch () => undefined
    if (reauthEpoch !== started || pending !== current || !(try active)) return
    if (receipt?.attempt !== current.attempt) {
      try clearReauth()
      try say("Gmail authorization could not be opened", true)
      return
    }
    const reply = receipt.verdict
    if (reply.kind === "FactorAsked") {
      pending = { ...current, expiresAt: reply.expiresAt }
      reauthShelf.set({ kind: "UseFactor", email: current.email, factors: reply.factors, expiresAt: reply.expiresAt, smsSent: false })
      return
    }
    if (reply.kind === "TryAgain") {
      setReauthForm("Check the code and try again.", false)
      return
    }
    pending = undefined
    reauthShelf.set({ kind: "Idle" })
    if (reply.kind !== "AccountConfirmed") {
      try say("Gmail authorization could not be opened", true)
      return
    }
    const opened = try openGoogleConsent(current.capabilities, current.owner, active, { open: openGoogleAuthorization, close: () => succeed(undefined) })
    if (opened !== "Opened" && (try active)) try say("Gmail authorization could not be opened", true)
  }

  effect function sendSms(): void!!MailConsent {
    const current = pending
    const started = reauthEpoch
    if (current === undefined || reauthShelf.get().kind !== "UseFactor") return
    const active = consentActive(current.intent, current.account, current.generation)
    if ((try Clock.currentTimeMillis) >= current.expiresAt || !(try active)) {
      try clearReauth()
      return
    }
    reauthShelf.update((state) => (state.kind === "UseFactor" ? { ...state, busy: true, error: undefined } : state))
    const sent = tryPromise(() => signInAccounts().sendFactorCode({ attempt: current.attempt })) catch () => undefined
    if (reauthEpoch !== started || pending !== current || !(try active)) return
    reauthShelf.update((state) => (state.kind === "UseFactor"
      ? { ...state, busy: false, smsSent: sent === current.attempt || state.smsSent, ...(sent === current.attempt ? {} : { error: "Couldn’t send a text message." }) }
      : state))
  }

  effect function resend(): void!!MailConsent {
    const current = pending
    if (current === undefined) return
    const active = consentActive(current.intent, current.account, current.generation)
    const begun = try startEmailReauth(current, active)
    if (begun === "Confirmed") {
      const opened = try openGoogleConsent(current.capabilities, current.owner, active, { open: openGoogleAuthorization, close: () => succeed(undefined) })
      if (opened !== "Opened" && (try active)) try say("Gmail authorization could not be opened", true)
    } else if (begun === "Unavailable" && (try active)) {
      try say("Gmail authorization could not be opened", true)
    }
  }

  try Effect.forkScoped(flatMap(whole.context, (context) => Effect.provideContext(effect {
    const shell = try Shell
    const left = Stream.filter(Stream.changes(Stream.map(shell.changes, (state) => showing(state, "Inbox"))), (shown) => !shown)
    try Stream.runDrain(Stream.merge(Stream.mapEffect(left, () => clearReauth()), Stream.mapEffect(ownerChanges, () => clearReauth())))
  }, context as Context.Context<Shell | Inbox.Machine | Mail>)))

  try Effect.addFinalizer(() => clearReauth())

  return {
    signIn: (usual: () => void) => flatMap(whole.context, (context) => Effect.provideContext(signInForMail(usual), context as Context.Context<MailSession>)),
    retry: () => flatMap(whole.context, (context) => Effect.provideContext(recheck(), context as Context.Context<MailSession>)),
    effect consent(intent: ConsentIntent, popup: GmailAuthorizationWindow | undefined) {
      const context = try whole.context
      const work = Effect.provideContext(authorize(intent, popup), context as Context.Context<MailConsent>)
      const opened = try opening.withPermitsIfAvailable(1)(work)
      if (!Option.getOrElse(opened, () => false) && popup !== undefined) try popup.close()
    },
    reauthSnapshot: reauthShelf.snapshot,
    subscribeReauth: reauthShelf.subscribe,
    verifyReauth: (typed: string, factor?: SecondFactor) => flatMap(whole.context, (context) => opening.withPermits(1)(Effect.provideContext(verify(typed, factor), context as Context.Context<MailConsent>))),
    sendReauthSms: () => flatMap(whole.context, (context) => opening.withPermits(1)(Effect.provideContext(sendSms(), context as Context.Context<MailConsent>))),
    resendReauth: () => flatMap(whole.context, (context) => opening.withPermits(1)(Effect.provideContext(resend(), context as Context.Context<MailConsent>))),
    cancelReauth: clearReauth,
  }
})

// spec/app/inbox/index.md, "Opening Inbox, and every change to Google access, checks the accounts again, even while a check is out"
const session = started(effect {
  const shell = try Shell
  const device = try Device
  const opened = Stream.filter(Stream.changes(Stream.map(shell.changes, (state) => showing(state, "Inbox"))), (shown) => shown)
  const resumed = Stream.filter(device.visible, (shown) => shown)
  const checks = Stream.merge(Stream.concat(Stream.succeed(true), opened), resumed)
  try Stream.runDrain(Stream.switchMap(checks, () => Stream.fromEffectDrain(recheck())))
}, "the cloud session")

// spec/app/inbox/index.md, "Back from a search shows its folder without the search, before Back leaves Inbox"
/** Leaving Inbox closes a search field with nothing searched, so the next visit opens on the folder. */
const leaving = started(effect {
  const shell = try Shell
  const list = try Inbox.Machine
  const left = Stream.filter(Stream.changes(Stream.map(shell.changes, (state) => showing(state, "Inbox"))), (shown) => !shown)
  try Stream.runForEach(left, effect () => {
    const state = try list.get()
    if (state.searching && state.selected.query === "") try contained(list.send({ type: "closeSearch" }), "closing the empty Inbox search")
  })
}, "closing an empty Inbox search on leaving")

// spec/app/inbox/index.md, "Attention says whether the owner is signed out, has no account, is being checked, or has a count of unread messages, fresh or no longer fresh, or could not be read"
/** What Home's Inbox tile says waits: the unread messages of the first page, counted, and nothing else of the mail. */
function waitingOf(said: Inbox.Attention): string | undefined {
  if ((said.standing !== "Ready" && said.standing !== "Stale") || said.unread < 1) return undefined
  return `${said.unread}${said.more ? "+" : ""} unread`
}

/** When Inbox read its page, as Home's mail card says it: the time today, else the day and the time. */
function whenRead(at: number, now: number): string {
  const time = new Date(at).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })
  return civilDay(at) === civilDay(now) ? time : `${new Date(at).toLocaleDateString([], { weekday: "short", month: "short", day: "numeric" })} ${time}`
}

const home = started(effect {
  const list = try Inbox.Machine
  const ledger = try Mail
  const sending = try Sending.Machine
  const time = try Time
  let previous = ""
  try Stream.runForEach(Stream.zipLatest(list.changes, sending.changes), effect ([state, changing]) => {
    try ledger.accept(state)
    const unread = Inbox.attention(ledger.ownerConfirmed() ? state : Inbox.initial)
    waiting.tell("Inbox", waitingOf(unread))
    const connected = Inbox.readable(state) && (unread.standing === "Ready" || unread.standing === "Stale")
    const held = new Set(Sending.aside(changing))
    const rows = connected ? ledger.incoming(state).filter(({ message, card }) => card.isUnread && !held.has(message)).slice(0, 2).map(({ card }) => ({
      title: card.subject || "No subject",
      detail: card.from.replace(/<[^>]*>/u, "").replace(/"/gu, "").trim() || card.from,
    })) : []
    const now = try time.now()
    const card = { connected, unread: unread.unread, rows, current: unread.standing === "Ready" && civilDay(unread.at) === civilDay(now) }
    const read = unread.at > 0 ? whenRead(unread.at, now) : ""
    // spec/app/home/cards.md, "The mail card shows the unread count, senders and subjects only, never a message body; marked not up to date when Inbox's page is not, and not drawn without an account or a row"
    const failed = state.failure !== "Fine" || state.list.status === "Failed" || state.accounts.status === "Failed"
    const pending = state.list.status === "Loading"
    const status = !connected ? "" : pending ? "Updating email…"
      : failed ? `Open to retry${read === "" ? "" : ` · last updated ${read}`}`
      : [unread.more ? "Recent email" : ledger.email(state.selected.account), read === "" ? "" : `Updated ${read}`].filter((part) => part !== "").join(" · ")
    const written = JSON.stringify([card, unread.more, status])
    if (written !== previous) {
      previous = written
      fromAreas.mail(card, unread.more, status)
    }
  })
}, "telling Home")

/** Gmail's list, from launch: kept across restarts, read through the owner's cloud, and checked again each time Inbox opens. */
export const mailbox = together(Layer.provideMerge(kept, Layer.provide(mail, savedBodies)), session, leaving, home, signIns, prefetch)
