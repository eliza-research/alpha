package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

runtime_resource_overlay {
    name: "AlphaWebViewConfigOverlay",
    manifest: "manifests/AlphaWebViewConfigOverlay.xml",
    resource_dirs: ["overlay/frameworks/base/core/res/res"],
    product_specific: true,
    certificate: "platform",
    sdk_version: "current",
}

prebuilt_etc {
    name: "AlphaPlayInstallerPrivappPermissions",
    src: "privapp-permissions-alpha-play.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    product_specific: true,
}

android_app {
    name: "AlphaPlayInstaller",
    manifest: "installer/AndroidManifest.xml",
    srcs: ["installer/src/**/*.java"],
    privileged: true,
    product_specific: true,
    certificate: "platform",
    sdk_version: "system_current",
    required: ["AlphaPlayInstallerPrivappPermissions"],
}
