<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.alphacompute.playinstaller">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="37"/>
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.DELETE_PACKAGES"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>
    <queries>
        <package android:name="ai.alphacompute.alphaphone"/>
        <package android:name="com.google.android.gsf"/>
        <package android:name="com.google.android.gms"/>
        <package android:name="com.android.vending"/>
    </queries>
    <application
        android:allowBackup="false"
        android:directBootAware="false"
        android:usesCleartextTraffic="false">
        <service
            android:name="ai.alphacompute.playinstaller.AlphaPlayInstallerService"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.alphacompute.playinstaller.ACTION_INSTALL_SANDBOXED_PLAY"/>
            </intent-filter>
        </service>
    </application>
</manifest>
