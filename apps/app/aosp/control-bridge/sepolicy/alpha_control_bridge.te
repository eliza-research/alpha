type alpha_control_bridge, domain, coredomain;
app_domain(alpha_control_bridge)

type alpha_control_bridge_data_file, file_type, data_file_type, core_data_file_type, app_data_file_type;
allow alpha_control_bridge alpha_control_bridge_data_file:dir create_dir_perms;
allow alpha_control_bridge alpha_control_bridge_data_file:file create_file_perms;

binder_use(alpha_control_bridge)

allow alpha_control_bridge {
    accessibility_service
    activity_service
    content_service
    display_service
    input_service
    package_service
    power_service
    settings_service
    surfaceflinger_service
    trust_service
    user_service
    window_service
}:service_manager find;

neverallow alpha_control_bridge self:{ tcp_socket udp_socket rawip_socket icmp_socket packet_socket } {
    create connect bind listen accept
};
