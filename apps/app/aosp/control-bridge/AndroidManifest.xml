<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.alphacompute.controlbridge">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="37"/>
    <uses-permission android:name="android.permission.INJECT_EVENTS"/>
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER"/>
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <queries>
        <package android:name="ai.alphacompute.alphaphone"/>
    </queries>
    <application
        android:allowBackup="false"
        android:directBootAware="false"
        android:usesCleartextTraffic="false">
        <service
            android:name="ai.alphacompute.control.AlphaControlBridgeService"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.alphacompute.control.ACTION_CONTROL_BRIDGE"/>
            </intent-filter>
        </service>
    </application>
</manifest>
