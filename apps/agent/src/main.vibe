// spec/agent/index.md, "Story: Build the pack only from the pinned eliza"; spec/agent/index.md, "Story: Run Alpha's agent on the phone"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { readBundleManifest } from "@elizaos/agent-host"
import { decodeLaunchDocument, defineRoutes } from "@elizaos/agent"
import { deployment } from "@repo/deployment"
import { packWorkerDir, packagedWorkflowWorker, pinnedCheckout, pinnedPack } from "@repo/eliza-harness"
import {
  type Environment, type Manifest, browserNotesCleanup, browserNotesTranscription, browserNotesTranscriptionLimit, bundledPlugins, calendarEdits, characterAdmitted, cloudModel, controlLeaseLimit, controlLeasePath, controlStopLimit, controlStopPath, corePlugins, entryCarried, gmailChanges, googleAdmitted,
  hostedPlugins, inputAdmitted, localEmbeddings, localLlmActivatePath, localLlmControlLimit, localLlmDeletePath, localLlmModePath, nativeControlInterrupt, nativeControlInterruptLimit, nativeControlObserve, nativeControlObserveLimit, nativeControlReceipt, nativeControlReceiptLimit, nativeDigestAck, nativeDigestAckLimit, nativeDigestQueries, nativeDigestScope, nativeNotesCleanup, nativeNotesCleanupLimit, nativeRoutes, nativeRoutesAdmitted, nativeSpeechRoutes, notesTrashDays, packAdmitted, packEntry, packedFor, packedPlugins, pageQueries, persistMemory, personalDetailSwap,
  launchViews, policyAdmitted, privacyAdmitted, productPluginName, proposalsAdmitted, refusedActions, routeListAdmitted, secretSwap, viewPlugins, viewsAdmitted, walletGetsKey, walletSettings,
} from "../gen/agent.effect.vibe"

module node {
  import path from "node:path"
  import type { buildAgentBundle } from "@elizaos/agent-host"
  import { pathToFileURL } from "node:url"
  import { isDeepStrictEqual } from "node:util"

  /** @throws {never} */
  export const sameRules = (left: unknown, right: unknown): boolean => isDeepStrictEqual(left, right)

  /** The words after the script on the command line. @throws {never} */
  export function words(): string[] {
    return process.argv.slice(2)
  }

  /** `apps/agent`, whether run from `src/` or `dist/src/`. @throws {never} */
  export function root(here: string): string {
    const parent = path.resolve(here, "..")
    return path.basename(parent) === "dist" ? path.dirname(parent) : parent
  }

  /** eliza's bundle builder of the clone at `dir`: the entry it ships imports that clone's agent, so the builder must be the same tree's. */
  export function builderOf(dir: string): Promise<{ buildAgentBundle: typeof buildAgentBundle }> {
    return import(pathToFileURL(`${dir}/packages/agent-host/dist/src/bundle/build.js`).href) as Promise<{ buildAgentBundle: typeof buildAgentBundle }>
  }
}
import { builderOf, root, sameRules, words } from node

/** What makes the pack unfit to ship, in words a maker can act on. */
export error Refused { message: string }

const environments: Readonly<Record<string, Environment>> = { local: "Local", staging: "Staging", production: "Production" }

schema QueryRule {
  key: string
  accepts: { kind: "any" } | { kind: "pattern"; pattern: string } | { kind: "pinned"; value: string }
}
schema RouteLine {
  method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE"; path: string; stream?: boolean; query?: QueryRule[]; maxBodyBytes?: number
}
schema Character { name: string; system: string; bio: string[] }
schema Policy { schema: 1; actions: { allowed: string[]; refused: Record<string, string> }; plugins: { load: string[]; product?: string } }
schema Notice { channel: string; title: string; text: string }
schema Service { service: string; hostContextRevision: 1; notification: { channel: string; title: string; text: string; failure: Notice } }
schema View { id: string; label: string; path: string; aliases?: string[] }
schema Model { backend: "cloud"; cloudBaseUrl: string; smallModel: string; largeModel: string; imageModel: string }
schema Host {
  schema: 1; service: string; hostContextRevision: 1; notification: { channel: string; title: string; text: string; failure: Notice }; routes: RouteLine[]; nativeRoutes: RouteLine[]; model: Model
  embeddings: "none" | "local"; persistMemory: boolean; callerRole: "owner" | "user"; views: View[]; privacy: { secretSwap: boolean; piiSwap: boolean }
  google: { gmailChanges: boolean; calendarEdits: boolean }
}

/** The export each hosted package builds its module with, as `runAgentCli`'s `hostModules` takes it. */
const localSpeechModule = "@elizaos/plugin-local-inference"
const walletModuleName = "@elizaos/plugin-wallet"
/** The bundled plugin whose `init` the entry wraps with `startedLater`. */
const workflowPluginName = "@elizaos/plugin-workflow"
const hostedExports: Readonly<Record<string, string>> = {
  "@elizaos/plugin-notes": "notesModuleWith",
  [walletModuleName]: "walletModule",
  [localSpeechModule]: "localInferenceModule",
}

/** Alpha's own packages: only the pack entry and the Alpha product plugin may be carried. */
const alphaOwned = (name: string) => name.startsWith("@repo/") || name.startsWith("@alphacompute/") || name === productPluginName

/**
 * The runtime services the entry gives the plugins (spec/agent/index.md, "The pack's entry gives the workflow plugin the
 * enrolled phone's steps and Maps its saved places"): `workflow-device`, each step offered to the enrolled phone through
 * eliza's device-action requests and aborted on stop, and Maps' saved places, one file per owner under the agent's state
 * directory, written only against the revision it read, through an atomic rename, one write at a time.
 *
 * The workflow plugin reads its `workflow-worker` and `workflow-device` services once, in its `init`, but the pinned
 * eliza starts every service only after the runtime has initialized, so that read always found neither: the engine said
 * `unavailable` with a pinned worker and the device steps were never offered. `startedLater` lets that `init` see each
 * of the two services that is registered (the worker only when the launch pins one) as an object that waits for the
 * started service on each call. A service that is not registered stays absent. This belongs upstream in
 * `@elizaos/plugin-workflow`, which should look its services up when it uses them.
 */
const hostServices = [
  'import { workflowDeviceOffer } from "../../packages/agent-host/dist/src/device-actions/workflow-offer.js"',
  'import { Service } from "@elizaos/core"',
  'import { WORKFLOW_DEVICE_SERVICE } from "@elizaos/plugin-workflow"',
  'import { registerMapsSavedPlaces } from "@elizaos/plugin-maps"',
  'import { MapsFailure } from "@elizaos/plugin-maps-client"',
  'import { createHash, randomUUID } from "node:crypto"',
  'import { mkdir, readFile, rename, writeFile } from "node:fs/promises"',
  'import path from "node:path"',
  "",
  "const savesLimit = 256 * 1024",
  "const failed = (message) => new MapsFailure({ code: \"storage\", message })",
  "",
  "async function readSaves(file) {",
  "  let text",
  "  try { text = await readFile(file, \"utf8\") } catch (error) { if (error?.code === \"ENOENT\") return undefined; throw error }",
  "  const { revision, text: saved } = JSON.parse(text)",
  "  if (!Number.isSafeInteger(revision) || revision < 0 || typeof saved !== \"string\") throw new Error(\"Saved places are damaged\")",
  "  return { revision, text: saved }",
  "}",
  "",
  "function savedPlaceFiles(root) {",
  "  let queue = Promise.resolve()",
  "  const serial = (work) => { const next = queue.then(work, work); queue = next.catch(() => undefined); return next }",
  "  const fileOf = (owner) => path.join(root, `${createHash(\"sha256\").update(owner, \"utf8\").digest(\"hex\")}.json`)",
  "  return {",
  "    read: (owner) => Effect.tryPromise({ try: () => serial(() => readSaves(fileOf(owner))), catch: () => failed(\"Saved places could not be read.\") }),",
  "    write: (owner, expectedRevision, text) => Effect.tryPromise({",
  "      try: () => serial(async () => {",
  "        if (Buffer.byteLength(text, \"utf8\") > savesLimit) return false",
  "        await mkdir(root, { recursive: true, mode: 0o700 })",
  "        const file = fileOf(owner)",
  "        const current = await readSaves(file)",
  "        if (current?.revision !== expectedRevision) return false",
  "        const staged = `${file}.${randomUUID()}.part`",
  "        await writeFile(staged, JSON.stringify({ revision: (current?.revision ?? 0) + 1, text }), { mode: 0o600, flag: \"wx\" })",
  "        await rename(staged, file)",
  "        return true",
  "      }),",
  "      catch: () => failed(\"Saved places could not be written.\"),",
  "    }),",
  "  }",
  "}",
  "",
  "class WorkflowDevice extends Service {",
  "  static serviceType = WORKFLOW_DEVICE_SERVICE",
  '  capabilityDescription = "Reviewed workflow steps on the enrolled Alpha phone"',
  "  stopping = new AbortController()",
  "  static async start(runtime) { return new WorkflowDevice(runtime) }",
  "  constructor(runtime) { super(runtime); this.offer = workflowDeviceOffer(runtime) }",
  "  enrollment() { return this.offer.enrollment() }",
  "  perform(binding, target, operation) { return this.offer.perform(binding, target, operation, this.stopping.signal) }",
  "  async stop() { this.stopping.abort() }",
  "}",
  "",
  "const runtimeServices = ({ stateDirectory }) => [",
  "  WorkflowDevice,",
  "  class MapsSavedPlaces extends Service {",
  '    static serviceType = "maps-saved-places"',
  '    capabilityDescription = "The owner\'s saved places, kept under the agent\'s state"',
  "    static async start(runtime) { return new MapsSavedPlaces(runtime) }",
  "    constructor(runtime) { super(runtime); registerMapsSavedPlaces(runtime, savedPlaceFiles(path.join(stateDirectory, \"maps\", \"saved-places\"))) }",
  "    async stop() {}",
  "  },",
  "]",
  "",
  "const lateServices = { \"workflow-worker\": [\"spawnWorker\"], [WORKFLOW_DEVICE_SERVICE]: [\"enrollment\", \"perform\"] }",
  "",
  "function startedLater(plugin) {",
  "  if (plugin?.init === undefined) return plugin",
  "  return { ...plugin, init: async (config, runtime) => {",
  "    const own = Object.hasOwn(runtime, \"getService\")",
  "    const previous = runtime.getService",
  "    const registered = new Set(runtime.getRegisteredServiceTypes())",
  "    runtime.getService = function (name) {",
  "      const found = previous.call(this, name)",
  "      const methods = lateServices[name]",
  "      if (found != null || methods === undefined || !registered.has(name)) return found",
  "      const started = () => runtime.getServiceLoadPromise(name)",
  "      return Object.fromEntries(methods.map((method) => [method, (...args) => started().then((service) => service[method](...args))]))",
  "    }",
  "    try { return await plugin.init(config, runtime) } finally { if (own) runtime.getService = previous; else delete runtime.getService }",
  "  } }",
  "}",
]

/**
 * The pack's entry: eliza's agent command started with each bundled plugin, each hosted package's module, the Alpha product plugin, and the entry's runtime services.
 * The command is imported from agent-host's own CLI module, as eliza's bundle entry does: the package's root also exports the bundle
 * builder, which would carry Vite into the bundle. Take the Android inference export from its owning module for the
 * same reason: the OS root includes build tooling. The entry sits at `.alpha/pack-entry-<worktree>/entry.js` inside the pack's clone.
 */
export function entrySource(bundled: readonly string[], hosted: readonly { name: string; module: string }[], product: { name: string; module: string }): string {
  const allHosted = [...hosted, product]
  const includesSpeech = hosted.some(({ name }) => name === localSpeechModule)
  const localScope = nativeSpeechRoutes.find(({ method }) => method === "Get")?.path ?? ""
  return [
    'import { existsSync } from "node:fs"',
    'import { dirname, join } from "node:path"',
    'import { fileURLToPath, pathToFileURL } from "node:url"',
    `import { runAgentCli } from "../../packages/agent-host/dist/src/cli.js"`,
    'import { startStore as openEarlierPGlite } from "../../packages/agent-host/dist/src/storage/migrate.js"',
    'import { Effect } from "effect"',
    ...(includesSpeech ? [
      'import { androidInferenceEngine } from "../../packages/os/dist/src/inference/index.js"',
    ] : []),
    ...bundled.map((name, index) => `import * as plugin${index} from ${JSON.stringify(name)}`),
    ...allHosted.map(({ name, module }, index) => `import { ${module} as host${index}${name === product.name ? ", makeNativeNotesCleanup, notesTranscriptionRoutes" : name === localSpeechModule ? ", localInferenceProvider" : ""} } from ${JSON.stringify(name)}`),
    ...hostServices,
    `const notesCleanup = makeNativeNotesCleanup(${JSON.stringify(nativeNotesCleanup)})`,
    'const earlierVectorPath = join(dirname(fileURLToPath(import.meta.url)), "vector.tar.gz")',
    'const earlierVectorExtension = { name: "pgvector", setup: async (_pg, emscriptenOpts) => ({ emscriptenOpts, bundlePath: pathToFileURL(earlierVectorPath) }) }',
    'const openEarlierStore = (image) => openEarlierPGlite({ loadDataDir: image, ...(existsSync(earlierVectorPath) ? { extensions: { vector: earlierVectorExtension } } : {}) })',
    "",
    ...(includesSpeech ? [
      'const speechEngine = (context) => {',
      '  const socket = context.launch.environment?.ALPHA_LOCAL_SPEECH_SOCKET ?? context.launch.environment?.ALPHA_BROWSER_NOTES_SPEECH_SOCKET',
      '  return socket === undefined ? undefined : androidInferenceEngine(socket)',
      '}',
      'const browserNoteRoutes = (context) => {',
      '  const engine = speechEngine(context)',
      '  return notesTranscriptionRoutes(context, localInferenceProvider, async (signal) =>',
      '    engine !== undefined && (await Effect.runPromise(engine.speechReady(), { signal })).transcription === true)',
      '}',
      `const nativeSpeechScope = (context) => ({ method: "GET", path: ${JSON.stringify(localScope)}, handler: async ({ signal }) => {`,
      '  const localMode = context.launch.environment?.ALPHA_AI_MODE === "local" || context.launch.model.backend === "none"',
      '  const account = context.launch.account ?? (localMode ? { userId: "local", organizationId: "device" } : undefined)',
      '  const engine = context.launch.environment?.ALPHA_LOCAL_SPEECH_SOCKET === undefined ? undefined : speechEngine(context)',
      '  if (account === undefined || engine === undefined) return { status: 503, body: { error: "LOCAL_SPEECH_UNAVAILABLE" } }',
      '  try {',
      '    const ready = await Effect.runPromise(engine.speechReady(), { signal })',
      '    if (ready?.transcription !== true) return { status: 503, body: { error: "LOCAL_SPEECH_UNAVAILABLE" } }',
      '    return { status: 200, body: { epoch: context.epoch, userId: account.userId, organizationId: account.organizationId } }',
      '  } catch {',
      '    return { status: 503, body: { error: "LOCAL_SPEECH_UNAVAILABLE" } }',
      '  }',
      '} })',
    ] : []),
    `const nativeRuntimeScope = (context) => ({ method: "GET", path: ${JSON.stringify(nativeDigestScope)}, handler: () => {`,
    '  const localMode = context.launch.environment?.ALPHA_AI_MODE === "local" || context.launch.model.backend === "none"',
    '  const account = context.launch.account ?? (localMode ? { userId: "local", organizationId: "device" } : undefined)',
    '  if (account === undefined) return { status: 503, body: { error: "RESIDENT_ACCOUNT_UNAVAILABLE" } }',
    '  return { status: 200, body: { epoch: context.epoch, agentId: context.runtime.agentId, userId: account.userId, organizationId: account.organizationId } }',
    '} })',
    "runAgentCli({",
    "  runtimeServices,",
    "  bundled: [",
    ...bundled.map((name, index) => {
      const plugin = `plugin${index}.default ?? plugin${index}.plugin`
      return `    { packageName: ${JSON.stringify(name)}, plugin: ${name === workflowPluginName ? `startedLater(${plugin})` : plugin} },`
    }),
    ...allHosted.map(({ name }) => `    { packageName: ${JSON.stringify(name)}, plugin: undefined },`),
    "  ],",
    `  productPlugin: ${JSON.stringify(product.name)},`,
    `  hostModules: new Map([${allHosted.map(({ name }, index) => {
      let factory = `host${index}`
      if (name === "@elizaos/plugin-notes") factory = `(context) => { context.runtime.setSetting("ELIZA_NOTES_TRASH_RETENTION_DAYS", ${JSON.stringify(notesTrashDays)}); return host${index}({ verifyRecordingCleanup: notesCleanup.verifyRecordingCleanup })(context); }`
      if (name === walletModuleName) {
        const settings = JSON.stringify(walletSettings.map(({ setting, held }) => [setting, held]))
        const keyed = walletGetsKey(true) ? "context" : "{ ...context, storageKey: undefined }"
        factory = `(context) => { for (const [setting, held] of ${settings}) context.runtime.setSetting(setting, held); return host${index}(${keyed}); }`
      }
      if (name === localSpeechModule) {
        const named = JSON.stringify(localSpeechModule)
        factory = `(context) => { const engine = speechEngine(context); return engine === undefined
          ? Effect.succeed({ name: ${named}, plugin: { name: ${named}, description: "On-device speech unavailable" } })
          : host${index}(engine)(context) }`
      }
      if (name === product.name) {
        const privateRoutes = includesSpeech ? "nativeSpeechScope(context), nativeRuntimeScope(context), ...browserNoteRoutes(context)" : "nativeRuntimeScope(context)"
        factory = `(context) => Effect.map(host${index}({ openLegacyStore: openEarlierStore })(context), (module) => ({
          ...module, plugin: { ...module.plugin, routes: [...(module.plugin.routes ?? []), ${privateRoutes}, notesCleanup.route(context), notesCleanup.browserRoute(context, ${JSON.stringify(browserNotesCleanup)}, ${nativeNotesCleanupLimit})] }
        }))`
      }
      return `[${JSON.stringify(name)}, ${factory}]`
    }).join(", ")}]),`,
    "})",
    "",
  ].join("\n")
}

/** Where the pack is written: the bundle as `buildAgentBundle` publishes it, and the three files eliza's agent service reads beside it. */
function places() {
  const app = root(import.meta.dirname)
  return { app, data: `${app}/host`, bundle: `${app}/dist/bundle`, host: `${app}/dist/host` }
}

effect function text(file: string) {
  const fs = try FileSystem.FileSystem
  return fs.readFileString(file) catch effect () => { throw new Refused({ message: `${file} cannot be read` }) }
}

effect function decoded<A>(file: string, schema: Schema.Decoder<A>) {
  const read = try text(file)
  return Schema.decodeUnknownEffect(Schema.fromJsonString(schema))(read) catch effect (cause) => {
    throw new Refused({ message: `${file} is not what it should be: ${String(cause)}` })
  }
}

/** The route list, one JSON route per line, as eliza's route gate and the host file take it. */
effect function routeLines(file: string) {
  const read = try text(file)
  const routes: RouteLine[] = []
  for (const line of read.split("\n").filter((each) => each.trim() !== "")) {
    routes.push(Schema.decodeUnknownEffect(Schema.fromJsonString(RouteLine))(line) catch effect () => { throw new Refused({ message: `${file}: ${line} is not a route` }) })
  }
  return routes
}

const spelled = { GET: "Get", POST: "Post", PUT: "Put", PATCH: "Patch", DELETE: "Delete" } as const
const onWire = { Get: "GET", Post: "POST", Put: "PUT", Patch: "PATCH", Delete: "DELETE" } as const

function queries(route: RouteLine, native = false) {
  return (native ? nativeDigestQueries : pageQueries).filter(({ method, path }) => method === spelled[route.method] && path === route.path)
    .map(({ key, kind, value, example }): { rule: QueryRule; example: string } => ({
      example,
      rule: {
        key,
        accepts: kind === "AnyQuery" ? { kind: "any" }
          : kind === "PatternQuery" ? { kind: "pattern", pattern: value } : { kind: "pinned", value },
      },
    }))
}

function routeBodyLimit(route: RouteLine, native: boolean): number | undefined {
  if (route.method !== "POST") return undefined
  if (!native) {
    if (route.path === browserNotesTranscription) return browserNotesTranscriptionLimit
    if (route.path === controlLeasePath) return controlLeaseLimit
    if (route.path === controlStopPath) return controlStopLimit
    if (route.path === localLlmModePath || route.path === localLlmActivatePath || route.path === localLlmDeletePath) return localLlmControlLimit
    return route.path === browserNotesCleanup ? nativeNotesCleanupLimit : undefined
  }
  if (route.path === nativeDigestAck) return nativeDigestAckLimit
  if (route.path === nativeControlObserve) return nativeControlObserveLimit
  if (route.path === nativeControlReceipt) return nativeControlReceiptLimit
  if (route.path === nativeControlInterrupt) return nativeControlInterruptLimit
  return route.path === nativeNotesCleanup ? nativeNotesCleanupLimit : undefined
}

/** Refuse a route list unless it matches its channel's policy and eliza admits each route. */
effect function admitRoutes(routes: readonly RouteLine[], native = false) {
  const described = routes.map((route) => ({ method: spelled[route.method], path: route.path, stream: route.stream === true }))
  if (!(native ? nativeRoutesAdmitted(described) : routeListAdmitted(described))) {
    throw new Refused({ message: native ? "the phone's private native route list is not exact" : "the route list is not exactly the routes the page's platform services call (spec/agent/index.md)" })
  }
  const gate = defineRoutes(routes)
  for (const route of routes) {
    const expected = queries(route, native)
    if (route.maxBodyBytes !== routeBodyLimit(route, native) || !sameRules(route.query ?? [], expected.map(({ rule }) => rule))) {
      throw new Refused({ message: `the request rules do not match ${route.method} ${route.path} (spec/agent/index.md)` })
    }
    const path = route.path.replace(/\{[a-zA-Z]+\}/g, "x")
    const parameters = expected.map(({ rule, example }) => `${rule.key}=${encodeURIComponent(example)}`).join("&")
    const target = parameters === "" ? path : `${path}?${parameters}`
    const admission = gate.admit({ method: route.method, target, streamed: route.stream === true, body: undefined })
    if (admission.tag !== "Admitted") throw new Refused({ message: `eliza's route gate does not admit ${route.method} ${route.path}` })
  }
}

/** The manifest of the bundle written at `bundle`, read back by eliza for the bundle's own bytes, if the pinned eliza and Alpha's rules admit it. */
effect function admittedManifest(bundle: string, pin: string) {
  const manifest = try tryPromise({ try: () => readBundleManifest(bundle), catch: () => new Refused({ message: `${bundle} holds no manifest readable for its own bytes` }) })
  const facts: Manifest = {
    sourceCommit: manifest.sourceCommit, node: manifest.node, localInference: manifest.localInference,
    plugins: [...manifest.plugins], productPlugin: manifest.productPlugin ?? "", workerPinned: manifest.workflowWorkerSha256 !== undefined, actions: manifest.actions.map(({ name }) => name),
  }
  if (!packAdmitted(facts, pin)) {
    throw new Refused({ message: `the bundle is not the pinned eliza's (${pin}) for Node 26 with local speech, the plugins ${packedPlugins.join(", ")}, product plugin ${productPluginName}, a pinned workflow worker and every allowed action: ${JSON.stringify(facts)}` })
  }
  const names = manifest.packages.map(({ name }) => name)
  const foreign = names.filter((name) => !inputAdmitted(name, alphaOwned(name)))
  if (foreign.length > 0 || !entryCarried(names)) {
    throw new Refused({ message: `the bundle must carry the pinned eliza's packages plus ${packEntry} and ${productPluginName} alone of Alpha's: it carries ${foreign.join(", ") || `missing ${packEntry}/${productPluginName}`}` })
  }
  return manifest
}

/** The host files at `host`, if they say what the spec decides and eliza's agent reads the launch the phone writes from them. */
effect function admittedHost(host: string, registered: readonly string[]) {
  const character = try decoded(`${host}/character.json`, Character)
  if (!characterAdmitted(character.name, character.system.trim())) throw new Refused({ message: "the character is not Alpha with a system prompt" })
  const policy = try decoded(`${host}/policy.json`, Policy)
  if (!policyAdmitted(policy.actions.allowed, Object.keys(policy.actions.refused), policy.plugins.load, policy.plugins.product ?? "", [...registered])) {
    throw new Refused({ message: `the policy must allow the spec's actions, refuse ${refusedActions([...registered]).join(", ")}, load the pack's plugins and modules in order, and name product ${productPluginName}` })
  }
  if (!proposalsAdmitted(policy.plugins.load, policy.actions.allowed)) throw new Refused({ message: "the policy must load eliza's device-action modules and allow a proposal" })
  const written = try decoded(`${host}/host.json`, Host)
  try admitRoutes(written.routes)
  try admitRoutes(written.nativeRoutes, true)
  if (!privacyAdmitted(written.privacy.secretSwap, written.privacy.piiSwap)) throw new Refused({ message: "the launch must ask eliza's privacy service to swap secrets and personal details" })
  if (!googleAdmitted(written.google.gmailChanges, written.google.calendarEdits)) throw new Refused({ message: "the launch consents to Gmail changes or calendar edits the spec does not" })
  const hostedOrigins: string[] = []
  for (const name of ["staging", "production"] as const) {
    const row = deployment(name) catch effect () => { throw new Refused({ message: `${name} is not a row of packages/deployment/deployments.json` }) }
    if (row.kind === "hosted") hostedOrigins.push(row.cloud)
  }
  if (written.model.backend !== "cloud" || written.model.smallModel !== cloudModel || written.model.largeModel !== cloudModel || !hostedOrigins.includes(written.model.cloudBaseUrl)) {
    throw new Refused({ message: `the launch model must target a hosted deployment with ${cloudModel}` })
  }
  const expectedEmbeddings = localEmbeddings ? "local" : "none"
  if (written.embeddings !== expectedEmbeddings) throw new Refused({ message: `the launch embeddings must be ${expectedEmbeddings}` })
  if (written.persistMemory !== persistMemory) throw new Refused({ message: `the launch persistMemory must be ${String(persistMemory)}` })
  if (written.callerRole !== "owner") throw new Refused({ message: "the launch callerRole must be owner" })
  if (!viewsAdmitted(written.views.map(({ id, label, path, aliases }) => ({ id, label, path, aliases: aliases ?? [] })))) {
    throw new Refused({ message: "the launch must name Home and every Alpha app but Notes and Browser as a view, in the phone's order (spec/agent/index.md)" })
  }
  const document = JSON.stringify({
    schema: 1, character, policy: { actions: { allowed: policy.actions.allowed }, plugins: policy.plugins },
    model: written.model, embeddings: written.embeddings, persistMemory: written.persistMemory, callerRole: written.callerRole,
    hostContextRevision: written.hostContextRevision, views: written.views, privacy: written.privacy, google: written.google,
    account: { userId: "the owner signed in on the phone", organizationId: "their organization" },
  })
  decodeLaunchDocument(document) catch effect () => { throw new Refused({ message: "eliza's agent would refuse the launch the phone writes from these files" }) }
  return written
}

/** The pinned eliza checkout, built. */
effect function pinned() {
  return pinnedCheckout() catch effect () => { throw new Refused({ message: "the pinned eliza is not built: run pnpm eliza" }) }
}

/** Build eliza's agent bundle at the pin for `name`'s cloud, and write the host files beside it. */
effect function build(name: string) {
  const environment = environments[name]
  if (environment === undefined) throw new Refused({ message: `no environment ${name}: local, staging or production` })
  if (!packedFor(environment)) throw new Refused({ message: "the local cloud has no fixed origin: a journey launches the pack against its own" })
  const where = deployment(name) catch effect () => { throw new Refused({ message: `${name} is not a row of packages/deployment/deployments.json` }) }
  if (where.kind !== "hosted") throw new Refused({ message: `${name} has no deployed cloud` })
  const at = places()
  const hosted = hostedPlugins.map((name) => ({ name, module: hostedExports[name] ?? "" }))
  const unbuilt = hosted.filter(({ module }) => module === "")
  if (unbuilt.length > 0) throw new Refused({ message: `no module export is known for ${unbuilt.map(({ name }) => name).join(", ")}` })
  const product = { name: productPluginName, module: "alphaAppsModuleWith" }
  const pack = pinnedPack(packedPlugins, entrySource(bundledPlugins, hosted, product), { name: productPluginName, dir: `${at.app}/dist/src/plugins` }) catch effect (cause) => {
    throw new Refused({ message: `the pack's clone of the pinned eliza could not be prepared: ${cause.reason}` })
  }
  const builder = try tryPromise({ try: () => builderOf(pack.dir), catch: () => new Refused({ message: `${pack.dir} holds no built bundle builder` }) })
  try tryPromise({
    try: () => builder.buildAgentBundle({
      plugins: packedPlugins, productPlugin: productPluginName, profiles: { core: corePlugins, views: viewPlugins, aospOnly: [], optional: [] },
      entry: pack.entry, outDir: at.bundle, sourceCommit: pack.commit, sourceRoot: pack.dir,
    }),
    catch: (cause) => new Refused({ message: `eliza refused to build the bundle: ${String(cause)} ${cause instanceof Error && "detail" in cause ? String(cause.detail) : ""}` }),
  })
  const workflow = pack.packages.get(workflowPluginName)
  if (workflow === undefined) throw new Refused({ message: `the bundle needs ${workflowPluginName}` })
  const fs = try FileSystem.FileSystem
  try fs.remove(packWorkerDir, { recursive: true, force: true })
  try fs.copy(`${workflow}/dist`, packWorkerDir)
  try fs.makeDirectory(at.host, { recursive: true })
  for (const file of ["character.json", "policy.json"]) try fs.copyFile(`${at.data}/${file}`, `${at.host}/${file}`)
  const service = try decoded(`${at.data}/service.json`, Service)
  const routes = (try routeLines(`${at.data}/routes.jsonl`)).map((route) => {
    const query = queries(route).map(({ rule }) => rule)
    return query.length === 0 ? route : { ...route, query }
  })
  const native = nativeRoutes.map(({ method, path, stream }): RouteLine => {
    const route = { method: onWire[method], path, stream }
    const query = queries(route, true).map(({ rule }) => rule)
    const maxBodyBytes = routeBodyLimit(route, true)
    return {
      ...route,
      ...(query.length === 0 ? {} : { query }),
      ...(maxBodyBytes === undefined ? {} : { maxBodyBytes }),
    }
  })
  const host: Host = {
    schema: 1, service: service.service, hostContextRevision: service.hostContextRevision, notification: service.notification, routes, nativeRoutes: native,
    model: { backend: "cloud", cloudBaseUrl: where.cloud, smallModel: cloudModel, largeModel: cloudModel, imageModel: "" },
    embeddings: localEmbeddings ? "local" : "none", persistMemory, callerRole: "owner",
    views: launchViews.map(({ id, label, path, aliases }) => aliases.length === 0 ? { id, label, path } : { id, label, path, aliases: [...aliases] }),
    privacy: { secretSwap, piiSwap: personalDetailSwap },
    google: { gmailChanges, calendarEdits },
  }
  try fs.writeFileString(`${at.host}/host.json`, `${JSON.stringify(host, null, 2)}\n`)
  try check()
}

/** Read the pack back, refuse it where a rule is broken, and print what it is. */
effect function check() {
  const pin = try pinned()
  const at = places()
  const manifest = try admittedManifest(at.bundle, pin.commit)
  const worker = try Effect.try({ try: packagedWorkflowWorker, catch: (cause) => new Refused({ message: `the packaged workflow worker could not be read: ${String(cause)}` }) })
  if (worker.sha256 !== manifest.workflowWorkerSha256) throw new Refused({ message: "the packaged workflow worker differs from the bundle's pin" })
  const host = try admittedHost(at.host, manifest.actions.map(({ name }) => name))
  const fs = try FileSystem.FileSystem
  const files = try fs.readDirectory(at.bundle)
  let bytes = 0
  for (const file of files) bytes += Number((try fs.stat(`${at.bundle}/${file}`)).size)
  try Console.log([
    `bundle ${at.bundle}: ${files.length} files, ${bytes} bytes, agent.mjs sha256 ${manifest.bundleSha256}`,
    `sourceCommit ${manifest.sourceCommit}, node ${manifest.node}, schemaVersion ${manifest.schemaVersion}, localInference ${manifest.localInference}`,
    `plugins [${manifest.plugins.join(", ")}], packages ${manifest.packages.length}, workflow worker ${manifest.workflowWorkerSha256 ?? "none"}`,
    `actions ${manifest.actions.map(({ name }) => name).join(", ")}`,
    `model ${JSON.stringify(host.model)}`,
    "routes admitted:",
    ...host.routes.map((route) => `  ${route.method} ${route.path}${route.stream === true ? " (stream)" : ""}`),
  ].join("\n"))
}

effect function main() {
  const [command, flag, value, ...rest] = words()
  if (command === "build" && flag === "--env" && value !== undefined && rest.length === 0) return try build(value)
  if (command === "check" && flag === undefined) return try check()
  throw new Refused({ message: "usage: main.js build --env <staging|production> | main.js check" })
}

NodeRuntime.runMain(Effect.provide(main(), NodeServices.layer))
