// spec/agent/index.md, "Story: Run Alpha's agent on the phone"
// eslint-disable-next-line @typescript-eslint/consistent-type-imports -- ConversationRecord is the schema `schema Created` decodes with, a value the projection ESLint reads does not show
import { ConversationRecord, TurnController, createRuntimeJsonClient, defineRoutes } from "@elizaos/agent"
import { describe, expect, it } from "@effect/vitest"
import { CleanupReceipt } from "@elizaos/plugin-notes-client"
import { packagedWorkflowWorker } from "@repo/eliza-harness"
import {
  calendarEdits, configurationExit, coreActions, entryCarried, gmailChanges, googleAdmitted, launchViews, loadList, packedPlugins, productPluginName, proposalsAdmitted, refusedActions,
  serviceAvailable, viewsAdmitted, workerAdmitted,
} from "../gen/agent.effect.vibe"
import { type Running, call, hostFile, launchFor, listed, manifest, pinnedWorker, policy, ready, socketBridge, startPhoneAgent, startRun, taskStorageKey } from "./phone.ts"

type Run = Awaited<ReturnType<typeof startRun>>

/** The pack's agent started over `state` as the phone starts it, ready, and stopped when the scope ends. */
function phoneAgent(run: Run, state: string) {
  return acquireRelease(
    promise(async () => {
      const running = startPhoneAgent(await launchFor(run.cloud, run.key, state), state, run.cloud, run.key)
      await ready(running)
      return running
    }),
    (running) => promise(() => running.stop()),
  )
}

const client = (running: Running) => createRuntimeJsonClient({ bridge: () => socketBridge(running), startupTimeoutMs: 120_000, pollMs: 100, requestTimeoutMs: 60_000 })

/** A route of the conversation the run opened, or of its room. */
const conversational = (route: string) => route.startsWith("/api/conversations/") || route.startsWith("/api/turns/")

/** A route naming the scheduled task or the trigger the run saved, whose module answers a record it does not hold exactly as the agent answers a route nothing serves. */
const namesHeldRecord = (route: string) => route.startsWith("/api/scheduled-tasks/{id}") || route.startsWith("/api/triggers/{id}")

/** A route naming a record the run does not hold: an event, a workflow, an alarm, a reminder or a proposal. */
const namesUnheldRecord = (route: string) => /\{[a-zA-Z]+\}/.test(route) && !conversational(route) && !namesHeldRecord(route)

/** A concrete path that probes route admission without targeting an existing record outside the test conversation. */
const filled = (route: string, conversation: ConversationRecord, taskId: string, triggerId: string) => {
  const id = route.startsWith("/api/scheduled-tasks/") ? taskId : route.startsWith("/api/triggers/") ? triggerId : conversation.id
  const path = route
    .replace("{id}", id)
    .replace("{roomId}", conversation.roomId)
    .replace("{eventId}", "no-such-event")
    .replace("{nodeId}", "review")
    .replace("{iteration}", "0")
    .replace("{mutationId}", conversation.id)
    .replace("{submissionId}", conversation.id)
  return path === "/api/scheduled-tasks" ? `${path}?ownerVisibleOnly=1` : path
}

/** The agent's own answer to a route no module or plugin serves. */
const unserved = { status: 404, body: { error: "not_found" } }
const answerOf = (status: number, body: string) => {
  try { return { status, body: JSON.parse(body) as unknown } } catch { return { status, body } }
}

/** The collection a route naming one record by `{id}` belongs to, as `/api/triggers` for `/api/triggers/{id}`. */
const collectionOf = (path: string) => /^(\/api\/[^{]+)\/\{id\}/.exec(path)?.[1]
const ofListedCollection = (path: string) => {
  const collection = collectionOf(path)
  return collection !== undefined && listed().some((route) => route.path === collection)
}
const isUnserved = (answer: { status: number; body: unknown }) =>
  answer.status === unserved.status && JSON.stringify(answer.body) === JSON.stringify(unserved.body)

/**
 * What a listed route answered, as the check expects it: a stream opened and sent something; a route naming a record
 * the run does not hold answered as its plugin or module, not as the agent's own unserved route; any other route was
 * found, or belongs to a listed collection whose module answers a missing record with the same not-found body.
 */
const served = (route: { path: string; stream?: boolean }, answer: { status: number; body: unknown }) =>
  route.stream === true ? answer.status === 200 && typeof answer.body === "number" && answer.body > 0
    : namesUnheldRecord(route.path) ? !isUnserved(answer)
    : answer.status !== 404 || ofListedCollection(route.path)

schema Created { conversation: ConversationRecord }
schema Listed { conversations: { id: string }[] }
schema History { messages: { id: string; timestamp: Schema.Int }[] }
error MissingHistoryMessages { expected: number; received: number }
schema Replied { fullText: string }
schema Interacted { success: boolean; result: { state?: { notes: { title: string; body: string }[] } } }
schema Approvals { approvals: Schema.Unknown[] }
schema WorkflowStatus { status: string; hostedNativeSourceProtocol?: number }
schema Operation { id: string; available: boolean }
schema Catalog { palette: { kind: string; operations: Operation[] }[] }
schema ResidentScope { userId: string; organizationId: string; agentId: string; epoch: Schema.Int }
const Receipts = Schema.Array(CleanupReceipt)
schema CleanupQueue { success: boolean; data: Receipts }
schema VoiceCreated { success: boolean; result: { data: { note: { id: string } }; state: { revision: Schema.Int } } }
schema NoteRevision { success: boolean; data: { revision: Schema.Int } }
schema CleanupStatus { status: string }
schema RouteTasks { tasks: { taskId: string; promptInstructions: string }[] }
schema SavedTrigger { trigger: { id: string } }

describe("Build the pack only from the pinned eliza", () => {
  // spec/agent/index.md, "A pack is admitted only when its manifest names the pinned commit, Node 26, the local speech module, the plugins it carries, the Alpha product plugin, a pinned workflow worker and every allowed action"
  // spec/agent/index.md, "Every package the bundle carries is the pinned eliza's, except the pack's entry and Alpha's product plugin"
  // spec/agent/index.md, "Only Android's native speech transport can call the resident recognizer"
  // spec/agent/index.md, "The agent may run the actions the old phone's agent ran plus Alpha's Clock, Reminders and Device Control actions, and every other action the bundle registers is listed as refused with its reason"
  // spec/agent/index.md, "The pack carries the plugins the old phone's agent loaded, under the pinned eliza's names, and the launch loads them with the agent's own modules the old agent had"
  // spec/agent/index.md, "A proposed device step goes through eliza's device-action module, and the phone says which steps it takes"
  // spec/agent/index.md, "The launch names Home and every Alpha app but Notes and Browser as a view the agent may show, by the id the phone opens it by"
  // spec/agent/index.md, "The agent changes the owner's mail and calendar through Google only where the launch consents, and the pack's host file consents to neither"
  // spec/agent/index.md, "Only Android's native control executor can post UI observations, poll queued operations, submit receipts, or fire native interrupts"
  it("Build the pack only from the pinned eliza", () => {
    const built = manifest()
    const registered = built.actions.map(({ name }) => name)
    const { actions, plugins } = policy()
    const host = hostFile()
    expect({ plugins: [...built.plugins].sort(), productPlugin: built.productPlugin, localInference: built.localInference, worker: /^[a-f0-9]{64}$/.test(built.workflowWorkerSha256 ?? "") })
      .toEqual({ plugins: [...packedPlugins].sort(), productPlugin: productPluginName, localInference: true, worker: true })
    const native = listed("nativeRoutes")
    expect(native).toEqual([
      { method: "GET", path: "/api/alpha-speech/scope", stream: false },
      { method: "POST", path: "/api/asr/local-inference/live", stream: false },
      { method: "GET", path: "/api/alpha-runtime/scope", stream: false },
      { method: "GET", path: "/api/workflow/status", stream: false },
      { method: "GET", path: "/api/workflow/hosted/results", stream: false,
        query: [{ key: "clientId", accepts: { kind: "pattern", pattern: "[A-Za-z0-9][A-Za-z0-9_-]{0,127}" } }] },
      { method: "POST", path: "/api/workflow/hosted/results/ack", stream: false, maxBodyBytes: 1024 },
      { method: "POST", path: "/api/alpha-runtime/notes-recording-cleanup", stream: false, maxBodyBytes: 2048 },
      { method: "POST", path: "/api/alpha-control/observe", stream: false, maxBodyBytes: 1572864 },
      { method: "GET", path: "/api/alpha-control/next", stream: false },
      { method: "POST", path: "/api/alpha-control/receipt", stream: false, maxBodyBytes: 65536 },
      { method: "POST", path: "/api/alpha-control/interrupt", stream: false, maxBodyBytes: 2048 },
    ])
    expect(listed().some(({ path }) => ["/api/alpha-speech/scope", "/api/asr/local-inference/live", "/api/alpha-runtime/scope", "/api/alpha-runtime/notes-recording-cleanup", "/api/notes/trash/recordings/complete", "/api/alpha-control/observe", "/api/alpha-control/next", "/api/alpha-control/receipt", "/api/alpha-control/interrupt"].includes(path))).toBe(false)
    expect(plugins.product).toBe(productPluginName)
    expect(entryCarried(built.packages.map(({ name }) => name))).toBe(true)
    expect(built.packages.filter(({ name }) => name.startsWith("@repo/") || name.startsWith("@alphacompute/") || name === productPluginName).map(({ name }) => name).sort())
      .toEqual(["@repo/agent-pack-entry", productPluginName].sort())
    expect(Object.keys(actions.refused).sort()).toEqual(refusedActions(registered).sort())
    expect(Object.keys(actions.refused)).toContain("CALCULATE")
    expect({ loaded: plugins.load, proposals: proposalsAdmitted(plugins.load, actions.allowed) }).toEqual({ loaded: loadList, proposals: true })
    expect({ google: googleAdmitted(host.google.gmailChanges, host.google.calendarEdits), consented: host.google }).toEqual({ google: true, consented: { gmailChanges, calendarEdits } })
    expect(viewsAdmitted(host.views.map(({ id, label, path, aliases }) => ({ id, label, path, aliases: aliases ?? [] })))).toBe(true)
    expect(coreActions.every((name) => actions.allowed.includes(name))).toBe(true)
    expect(Object.values(actions.refused).every((reason) => reason.trim() !== "")).toBe(true)
    expect(workerAdmitted(packagedWorkflowWorker().sha256, built.workflowWorkerSha256 ?? "")).toBe(true)
    const gate = defineRoutes(listed())
    const admitted = (target: string) => gate.admit({ method: "GET", target, streamed: false, body: undefined }).tag === "Admitted"
    expect([
      "/api/notifications?nativeTransport=true",
      "/api/notifications?nativeTransport=true&nativeEpoch=00000000-0000-0000-0000-000000000000&afterSequence=1&throughSequence=5",
      "/api/notifications?category=workflow&limit=50",
    ].map(admitted)).toEqual([true, true, false])
  })
})

describe("Run Alpha's agent on the phone", () => {
  // spec/agent/index.md, "The page reaches exactly the routes its platform services call, and nothing else"
  // spec/agent/index.md, "The agent keeps its memory across restarts, without embeddings"
  // spec/agent/index.md, "The agent swaps the owner's secrets and personal details out of what it sends the cloud"
  // spec/agent/index.md, "The launch names the pack's pinned workflow worker, and the agent refuses any other with its configuration code"
  // spec/agent/index.md, "The pack carries the plugins the old phone's agent loaded, under the pinned eliza's names, and the launch loads them with the agent's own modules the old agent had"
  // spec/agent/index.md, "A proposed device step goes through eliza's device-action module, and the phone says which steps it takes"
  // spec/agent/index.md, "The launch names Home and every Alpha app but Notes and Browser as a view the agent may show, by the id the phone opens it by"
  it.live("Run Alpha's agent on the phone", () => scoped(effect {
    const run = try acquireRelease(promise(() => startRun()), (started) => promise(() => started.stop()))
    const phone = try Effect.try(() => run.place("phone"))
    const conversation = try scoped(effect {
      const first = try phoneAgent(run, phone)
      const runtime = client(first)
      const controller = new TurnController(runtime)
      const { conversation: opened } = try Schema.decodeUnknownEffect(Created)(try promise(() => runtime.request("/api/conversations", { title: "Ask Alpha" })))
      try promise(() => controller.bind(opened))
      const result = try promise(() => controller.send({ text: "Remember the word heron." }, { stream: { onPreview: () => {} } }))
      try Effect.try(() => expect(result.kind === "Replied" ? result.reply.text : result.kind).toContain("You said: Remember the word heron."))
      // spec/agent/index.md, "The page names the query values each gated route can receive"
      const history = `/api/conversations/${opened.id}/messages`
      const latest = try promise(() => call(first, "GET", history))
      const { messages } = try Schema.decodeUnknownEffect(Schema.fromJsonString(History))(latest.body)
      const anchor = messages.at(-1)
      const prior = messages.at(-2)
      if (anchor === undefined || prior === undefined) throw new MissingHistoryMessages({ expected: 2, received: messages.length })
      const id = encodeURIComponent(anchor.id)
      const centered = `${history}?around=${id}`
      const cursor = `${history}?before=${anchor.timestamp}&beforeId=${id}`
      const older = `${cursor}&limit=1`
      try Effect.try(() => {
        const gate = defineRoutes(listed())
        const admitted = (target: string) => gate.admit({ method: "GET", target, streamed: false, body: undefined }).tag === "Admitted"
        expect([history, centered, older, `${older}&beforeId=${id}`, `${cursor}&limit=2`, `${history}?before=01&beforeId=${id}&limit=1`].map(admitted))
          .toEqual([true, true, true, false, false, false])
      })
      const near = try promise(() => call(first, "GET", centered))
      const edge = try promise(() => call(first, "GET", older))
      const nearPage = try Schema.decodeUnknownEffect(Schema.fromJsonString(History))(near.body)
      const edgePage = try Schema.decodeUnknownEffect(Schema.fromJsonString(History))(edge.body)
      try Effect.try(() => expect([
        latest.status, near.status, edge.status, nearPage.messages.some((message) => message.id === anchor.id), edgePage.messages.map(({ id }) => id),
      ]).toEqual([200, 200, 200, true, [prior.id]]))

      const createdAlarm = try promise(() => call(first, "POST", "/api/alpha/clock/alarms", { hour: 7, minute: 30, label: "Wake up" }))
      const createdReminder = try promise(() => call(first, "POST", "/api/alpha/reminders/items", { title: "Buy heron seed", dueDate: "2026-11-25" }))
      const title = "Route admission check"
      const routine = try promise(() => call(first, "POST", "/api/personal-assistant/routines", { title, idempotencyKey: "route-admission", times: ["14:20"] }))
      const listing = try promise(() => call(first, "GET", "/api/scheduled-tasks?ownerVisibleOnly=1"))
      const saved = try Schema.decodeUnknownEffect(Schema.fromJsonString(RouteTasks))(listing.body)
      const task = saved.tasks.find((one) => one.promptInstructions === title)
      const queued = try promise(() => call(first, "POST", "/api/triggers", {
        kind: "prompt", displayName: title, instructions: "Review the receipt", timezone: "UTC",
        triggerType: "event", eventKind: "MESSAGE_SENT", wakeMode: "inject_now", enabled: false,
      }))
      const { trigger } = try Schema.decodeUnknownEffect(Schema.fromJsonString(SavedTrigger))(queued.body)
      try Effect.try(() => expect({ alarm: createdAlarm.status, reminder: createdReminder.status, routine: routine.status, task: task !== undefined, trigger: queued.status }).toEqual({ alarm: 201, reminder: 201, routine: 201, task: true, trigger: 201 }))
      const taskId = task?.taskId ?? ""
      const unanswered: { method: string; route: string; answer: { status: number; body: unknown } }[] = []
      for (const route of try Effect.try(() => listed())) {
        const target = filled(route.path, opened, taskId, trigger.id)
        const answer = route.stream === true
          ? try promise(async () => {
            const streamed = await runtime.stream(target, { text: "Again." })
            const chunks: Uint8Array[] = []
            for await (const chunk of streamed.body) chunks.push(chunk)
            return { status: streamed.status, body: chunks.length as unknown }
          })
          : try promise(async () => {
            const body = route.method === "GET" || route.method === "DELETE" ? undefined
              : target.endsWith("/messages") ? { text: "Again." }
              : route.path === "/api/triggers/{id}/execute" || route.path === "/api/scheduled-tasks/{id}/fire" ? { probe: true } : {}
            const replied = await call(first, route.method, target, body)
            return answerOf(replied.status, replied.body)
          })
        if (!served(route, answer)) unanswered.push({ method: route.method, route: route.path, answer })
      }
      try Effect.try(() => expect(unanswered).toEqual([]))
      const created = try promise(() => call(first, "POST", "/api/notes/interact", { capability: "create-note", params: { content: "Heron food on Thursday" } }))
      const notes = try promise(() => call(first, "POST", "/api/notes/interact", { capability: "get-notes", params: {} }))
      const read = try Schema.decodeUnknownEffect(Schema.fromJsonString(Interacted))(notes.body)
      try Effect.try(() => expect({ created: created.status, notes: read.result.state?.notes.map(({ title, body }) => body === "" ? title : `${title}\n${body}`) })
        .toEqual({ created: 200, notes: ["Heron food on Thursday"] }))
      const shown: Record<string, number> = {}
      for (const id of ["notes", "browser", ...launchViews.map((view) => view.id)]) {
        const prepared = try promise(() => call(first, "POST", `/api/views/${id}/navigate`, {
          clientId: `journey-${id}`, delivery: "completed-action", prepareOnly: true, viewType: "gui", completedActionHandoffId: `open-${id}`,
        }))
        shown[id] = prepared.status
      }
      try Effect.try(() => expect(shown).toEqual(Object.fromEntries(["notes", "browser", ...launchViews.map((view) => view.id)].map((id) => [id, 200]))))
      // spec/agent/index.md, "Only the phone's native channel can verify that a reviewed recording was erased"
      const audioId = "retained-voice-at-home"
      const captured = try promise(() => call(first, "POST", "/api/notes/interact", {
        capability: "create-note", params: { content: "Recording to erase", color: "yellow", forceNew: true,
          format: { kind: "voice", data: { recordingId: audioId, audio: { audioId, durationMs: 3000 } } } },
      }))
      const { result: voice } = try Schema.decodeUnknownEffect(Schema.fromJsonString(VoiceCreated))(captured.body)
      const noteId = voice.data.note.id
      const movedToTrash = try promise(() => call(first, "POST", "/api/notes/interact", {
        capability: "delete-note", params: { id: noteId, expectedRevision: voice.state.revision },
      }))
      const state = try promise(() => call(first, "GET", "/api/notes/state"))
      const { data: { revision } } = try Schema.decodeUnknownEffect(Schema.fromJsonString(NoteRevision))(state.body)
      const erased = try promise(() => call(first, "POST", "/api/notes/trash/erase", { scope: "all", expectedRevision: revision }))
      const pendingRecordings = () => call(first, "GET", "/api/notes/trash/recordings")
      const beforePurge = try promise(pendingRecordings)
      const { data: [receipt] } = try Schema.decodeUnknownEffect(Schema.fromJsonString(CleanupQueue))(beforePurge.body)
      try Effect.try(() => expect({ status: [captured.status, movedToTrash.status, erased.status], ids: [receipt?.noteId, receipt?.audioId] })
        .toEqual({ status: [200, 200, 200], ids: [noteId, audioId] }))
      const answerScope = try promise(() => call(first, "GET", "/api/alpha-runtime/scope"))
      const scope = try Schema.decodeUnknownEffect(Schema.fromJsonString(ResidentScope))(answerScope.body)
      const cleanup = "/api/alpha-runtime/notes-recording-cleanup"
      const wrongEpoch = try promise(() => call(first, "POST", cleanup, { phase: "prepare", receipt, scope: { ...scope, epoch: scope.epoch - 1 } }))
      const prepared = try promise(() => call(first, "POST", cleanup, { phase: "prepare", receipt, scope }))
      const readyToErase = try Schema.decodeUnknownEffect(Schema.fromJsonString(CleanupStatus))(prepared.body)
      const proven = try promise(() => call(first, "POST", cleanup, { phase: "confirm", receipt, scope }))
      const confirmed = try Schema.decodeUnknownEffect(Schema.fromJsonString(CleanupStatus))(proven.body)
      const afterPurge = try promise(pendingRecordings)
      const { data: remaining } = try Schema.decodeUnknownEffect(Schema.fromJsonString(CleanupQueue))(afterPurge.body)
      try Effect.try(() => expect({ statuses: [wrongEpoch.status, prepared.status, proven.status], receipts: [readyToErase.status, confirmed.status], remaining })
        .toEqual({ statuses: [403, 200, 200], receipts: ["pending", "confirmed"], remaining: [] }))
      const proposals = try promise(() => call(first, "GET", "/api/approvals"))
      const pending = try Schema.decodeUnknownEffect(Schema.fromJsonString(Approvals))(proposals.body)
      try Effect.try(() => expect({ status: proposals.status, approvals: pending.approvals }).toEqual({ status: 200, approvals: [] }))
      return opened
    })
    const second = try phoneAgent(run, phone)
    const kept = try promise(() => call(second, "GET", "/api/conversations"))
    const known = try Schema.decodeUnknownEffect(Schema.fromJsonString(Listed))(kept.body)
    const answer = try promise(() => call(second, "POST", `/api/conversations/${conversation.id}/messages`, { text: "Which word?" }))
    const { fullText } = try Schema.decodeUnknownEffect(Schema.fromJsonString(Replied))(answer.body)
    const keptClock = try promise(() => call(second, "GET", "/api/alpha/clock"))
    const keptReminders = try promise(() => call(second, "GET", "/api/alpha/reminders"))
    try Effect.try(() => expect({ kept: known.conversations.some(({ id }) => id === conversation.id), status: answer.status, clockStatus: keptClock.status, remindersStatus: keptReminders.status })
      .toEqual({ kept: true, status: 200, clockStatus: 200, remindersStatus: 200 }))
    try Effect.try(() => {
      expect(fullText).toContain("You said: Which word?")
      expect(keptClock.body).toContain("Wake up")
      expect(keptReminders.body).toContain("Buy heron seed")
    })
    const refused = try Effect.try(() => run.place("refused"))
    const worker = { workflowWorker: { ...(try promise(() => pinnedWorker())), sha256: "0".repeat(64) } }
    const launch = try promise(() => launchFor(run.cloud, run.key, refused, worker))
    const code = try promise(() => startPhoneAgent(launch, refused, run.cloud, run.key).exited)
    try Effect.try(() => expect(code).toBe(configurationExit))
  }), 900_000)
})

schema WalletStanding { custody: string; canHold: boolean; accounts: Schema.Unknown[] }
schema TaskStorage { taskStorage: string }

describe("Make the wallet on the signed-in phone", () => {
  // spec/agent/index.md, "The wallet can be made only on a launch with the signed-in account's storage key"; spec/agent/index.md, "The wallet runs on Sepolia and Solana's devnet until its keys can be backed up"
  it.live("Only an owner with a storage key can make a wallet, once, on the two test networks", () => scoped(effect {
    const run = try acquireRelease(promise(() => startRun()), (started) => promise(() => started.stop()))
    const phone = try Effect.try(() => run.place("wallet"))
    const standing = (body: string) => Schema.decodeUnknownEffect(Schema.fromJsonString(WalletStanding))(body)
    try scoped(effect {
      const keyless = try phoneAgent(run, phone)
      const before = try promise(() => call(keyless, "GET", "/api/wallet"))
      const refused = try promise(() => call(keyless, "POST", "/api/wallet", {}))
      const held = try standing(before.body)
      try Effect.try(() => expect([before.status, held, refused.status]).toEqual([200, { custody: "none", canHold: false, accounts: [] }, 409]))
    })
    const keyed = try acquireRelease(
      promise(async () => {
        const running = startPhoneAgent(await launchFor(run.cloud, run.key, phone), phone, run.cloud, run.key, taskStorageKey())
        await ready(running)
        return running
      }),
      (running) => promise(() => running.stop()),
    )
    const before = try promise(() => call(keyed, "GET", "/api/wallet"))
    const made = try promise(() => call(keyed, "POST", "/api/wallet", {}))
    const after = try promise(() => call(keyed, "GET", "/api/wallet"))
    const storage = try promise(() => call(keyed, "GET", "/api/tasks/storage"))
    const empty = try standing(before.body)
    const created = try standing(made.body)
    const current = try standing(after.body)
    const again = try promise(() => call(keyed, "POST", "/api/wallet", {}))
    const repeated = try standing(again.body)
    const tasks = try Schema.decodeUnknownEffect(Schema.fromJsonString(TaskStorage))(storage.body)
    try Effect.try(() => {
      expect([before.status, made.status, after.status, again.status, storage.status, tasks.taskStorage]).toEqual([200, 200, 200, 200, 200, "ok"])
      expect(empty).toEqual({ custody: "none", canHold: true, accounts: [] })
      expect(created).toMatchObject({ custody: "ready", canHold: true, accounts: [
        { family: "evm", chainId: "11155111", connected: true, address: expect.stringMatching(/^0x[0-9a-fA-F]{40}$/) },
        { family: "solana", chainId: "EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG", connected: true, address: expect.stringMatching(/^[1-9A-HJ-NP-Za-km-z]{32,44}$/) },
      ] })
      expect([current, repeated]).toEqual([created, created])
    })
  }), 300_000)
})

describe("Give the plugins the phone's device services, and say plainly which it cannot give yet", () => {
  // spec/agent/index.md, "The pack's entry gives the workflow plugin the enrolled phone's steps and Maps its saved places"
  // spec/agent/index.md, "The native digest sources the phone does not give its plugins yet are named, and nothing in the pack fakes them"
  it.live("Give the plugins the phone's device services, and say plainly which it cannot give yet", () => scoped(effect {
    const run = try acquireRelease(promise(() => startRun()), (started) => promise(() => started.stop()))
    const agent = try phoneAgent(run, try Effect.try(() => run.place("phone")))
    const workflows = try promise(() => call(agent, "GET", "/api/workflow/status"))
    const engine = try Schema.decodeUnknownEffect(Schema.fromJsonString(WorkflowStatus))(workflows.body)
    const offered = try promise(() => call(agent, "GET", "/api/workflow/phone/catalog"))
    const catalog = try Schema.decodeUnknownEffect(Schema.fromJsonString(Catalog))(offered.body)
    const calendarRange = catalog.palette.flatMap(({ operations }) => operations).find(({ id }) => id === "calendar_range")
    try Effect.try(() => expect({ status: workflows.status, engine: engine.status, native: engine.hostedNativeSourceProtocol !== undefined, catalog: offered.status, deviceStep: calendarRange?.available })
      .toEqual({ status: 200, engine: "ready", native: serviceAvailable("workflow-native-digests"), catalog: 200, deviceStep: serviceAvailable("workflow-device") }))
  }), 300_000)
})
