{
  "name": "@repo/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "eliza-harness --ready && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && vibelang -p tsconfig.build.json && node -e \"fs.cpSync('.cache/public-pages', 'dist/pages', { recursive: true })\"",
    "typecheck": "eliza-harness --ready && vibelang --noEmit -p .",
    "test": "(cd ../.. && node vibestack/spec.ts tasks @repo/cloud#build:pages) && vitest run",
    "build:pages": "eliza-harness --ready && node pack-pages.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@elizaos/cloud": "link:../../.eliza/packages/cloud",
    "@elizaos/cloud-worker": "link:../../.eliza/packages/cloud-worker",
    "@repo/deployment": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@repo/eliza-harness": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.164.0"
  }
}
