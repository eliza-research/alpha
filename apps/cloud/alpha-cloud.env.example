# Alpha Cloud env file template: names only, no values.
#
# Copy it OUTSIDE the checkout, one per environment, and make it private:
#   mkdir -p ~/.config/alpha-cloud && cp apps/cloud/alpha-cloud.env.example ~/.config/alpha-cloud/staging.env
#   chmod 600 ~/.config/alpha-cloud/staging.env
# Fill in the provider values below. Then run
#   pnpm cloud secrets --environment staging --env-file ~/.config/alpha-cloud/staging.env
# which adds every internal secret (CLOUD_DIGEST_KEY, CLOUD_SEALING_KEY, CLOUD_ENTITLEMENT_KEY,
# EMAIL_CODE_SECRET, GOOGLE_CONNECT_TOKEN_KEY) once, prints the entitlement public key for the
# operator inputs and reports anything still missing. The tool refuses a file inside the checkout or
# readable by others. Never commit a filled-in copy. The public values (database identity, Terms and
# Privacy, entitlement public key, Google client ids, Stripe price ids, speech voices) go in the
# completed copy of apps/cloud/profile/candidate.example.json, not here.

# The environment's Postgres database (direct connection, TLS)
DATABASE_URL=

# AI inference and voice
CEREBRAS_API_KEY=
CARTESIA_API_KEY=

# Google: sign-in client, Gmail/Calendar connector client (may be the same client), Maps
GOOGLE_CLIENT_SECRET=
GOOGLE_CONNECT_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# Stripe (test keys for staging, live keys for production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# optional:
STRIPE_PUBLISHABLE_KEY=
SLACK_CLIENT_ID=
SLACK_APP_ID=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
TELEGRAM_API_ID=
