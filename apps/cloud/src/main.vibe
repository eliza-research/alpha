// spec/cloud/index.md, "Story: Know which cloud the app talks to"; spec/cloud/index.md, "Story: Register Alpha's app with the cloud"; spec/cloud/index.md, "Story: Operate Alpha's own cloud"; spec/cloud/index.md, "Story: Reach my account's services from the app"; spec/cloud/provisioning.md, "The steps run in one order, the same for staging and production, each one command"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { deployment } from "@repo/deployment"
import { assetLinksNameAlpha, type Hosts } from "../gen/cloud.effect.vibe"
import { commandOf, taskAt, total } from "../gen/cloud__provisioning.effect.vibe"
import { assetLinks, entryOf, loopbackOnly, profileNamed, registrationAt, stagingSeed } from "./alpha.vibe"
import { operate } from "./commands.vibe"
import { hostedClouds, hostedProfileProblems } from "./hosted.vibe"
import { tableProblems } from "./routes.vibe"

module node {
  /** @throws {never} */
  export function commandLine(): ReadonlyArray<string> {
    return process.argv.slice(2)
  }
  /** Finish an unsuccessful readiness check after writing its JSON report. @throws {never} */
  export function markUnready(): void { process.exitCode = 1 }
}
import { commandLine, markUnready } from node

/** What `check` found wrong, one line each. */
export error CheckFailed { problems: ReadonlyArray<string> }

/** The hosted deployments and Alpha's native client registration on each App Link host. */
function environments(hosts: Readonly<Record<"staging" | "production", Hosts>>) {
  return ([["staging", "Staging"], ["production", "Production"]] as const).map(([name, environment]) => ({
    name, environment, cloud: hosts[name], registration: registrationAt(environment, hosts[name].appLinkHost),
  }))
}

/** Checks the hosted profile and asset links, the local profile and seed, and the cloud route table. */
effect function check() {
  const problems: string[] = []
  const local = try deployment("local")
  if (local.kind !== "local") throw new CheckFailed({ problems: ["@repo/deployment names local a hosted cloud"] })
  const localSettings = (try profileNamed(local.profile)).environments[local.profile]
  if (!loopbackOnly(localSettings)) problems.push(`the local cloud's ${local.profile} profile names an adapter or provider off this computer`)
  const localRegistration = registrationAt("Staging", localSettings.web.replace(/^https:\/\//, ""))
  if (JSON.stringify(stagingSeed.clients) !== JSON.stringify([entryOf(localRegistration)])) problems.push("seed/staging.json differs from Alpha's local staging registration")
  try Console.log(`local: the ${local.profile} profile, on this computer only`)
  const profile = try profileNamed("candidate")
  const hosts = try hostedClouds()
  problems.push(...hostedProfileProblems(profile, hosts))
  for (const { name, environment, cloud, registration } of environments(hosts)) {
    const statements = try assetLinks(registration, cloud.cloud)
    if (!assetLinksNameAlpha(statements, environment)) problems.push(`${name}: the asset links do not name Alpha's package with the ${name} signers alone`)
    try Console.log(`${name}: ${cloud.cloud}, App Links on ${cloud.appLinkHost}; asset links ${JSON.stringify(statements)}`)
  }
  problems.push(...tableProblems().map((problem) => `the cloud route table: ${problem}`))
  if (problems.length > 0) throw new CheckFailed({ problems })
  try Console.log("Alpha's profiles, seed, registrations and cloud route table keep every rule of spec/cloud/index.md")
}

/** What the operator of Alpha Cloud enters for Alpha's app: one registration file per environment, applied by the steps of provisioning in order. Nothing is sent anywhere. */
effect function registration() {
  for (const { name, registration } of environments(try hostedClouds())) {
    try Console.log(`# ${name}: elizaos-cloud client apply --file <this file> --environment ${name}`)
    try Console.log(JSON.stringify({ environment: name, clients: [entryOf(registration)] }, null, 2))
  }
  try Console.log("# the operator's steps, each read back before the next (spec/cloud/provisioning.md)")
  for (let index = 0; index < total; index += 1) try Console.log(`${index + 1}. ${commandOf(taskAt(index))}`)
}

effect function main() {
  const [command, ...rest] = commandLine()
  if (command === "check") return try check()
  if (command === "registration") return try registration()
  const output = effect { return JSON.stringify(try operate(command, rest), null, 2) } catch effect (failure) => {
    if (failure._tag !== "NotReady") throw failure
    try sync(markUnready)
    return failure.report
  }
  try Console.log(output)
}

if (import.meta.main) NodeRuntime.runMain(Effect.provide(main(), NodeServices.layer))
