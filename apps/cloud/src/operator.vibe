// spec/cloud/rollout.md, "Story: Deploy an environment without reading a secret into the repository"; spec/cloud/rollout.md, "Story: Keep every secret private and fitting its environment"; spec/cloud/provisioning.md, "Story: Bring a deployment up, one confirmed step at a time"
import { parseProfile, type CloudEnvironment, type CloudProfile, type EnvironmentProfile } from "@elizaos/cloud"
import { ChildProcess } from "effect/process"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import type { Hosts } from "../gen/cloud.effect.vibe"
import { Machine, machine, paymentKeyFits, secretsFileAccepted } from "../gen/cloud__rollout.effect.vibe"
import apiTemplate from "../wrangler/api.template.json" with { type: "json" }
import edgeTemplate from "../wrangler/edge.template.json" with { type: "json" }
import { entryOf, registrationAt } from "./alpha.vibe"
import { hostedClouds, hostedProfileProblems, type HostedCloudUnknown } from "./hosted.vibe"
import { reconcileResources } from "./cloudflare.vibe"
import { base64urlBytes, canonicalUnpaddedHexKey, canonicalUnpaddedSealingKey, entitlementKey, entitlementPublicKey, entitlementPublicKeyMatches, hexKey, isEntitlementKey, isExampleEntitlementPublicKey, isHexKey, randomKey, sealingKey, sealingKeyBytes } from "./keys.ts"
import { PROFILE_ASSET } from "./profile-asset.ts"
import { assetsDirectory, leakedElizaHost, renderEnvironment, type CloudResources } from "./wrangler.vibe"

schema CloudResourcesSchema {
  workerName: string
  accountId: string
  zone: string
  hyperdriveId: string
}

schema ResourcesFileSchema {
  production: CloudResourcesSchema
  staging: CloudResourcesSchema
}

/** A step of the operator's command could not be carried out; the message says which and why, and holds no secret. */
export error OperatorFailed { problem: string, message?: string }

/** The secrets each environment's operator supplies. */
const providedSecrets = ["DATABASE_URL", "GOOGLE_CLIENT_SECRET", "GOOGLE_CONNECT_CLIENT_SECRET", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "CEREBRAS_API_KEY", "CARTESIA_API_KEY", "GOOGLE_MAPS_API_KEY"]
/** The secrets the operator command generates once and keeps in the secrets file; it never rotates one. */
const internalSecrets = ["CLOUD_DIGEST_KEY", "CLOUD_SEALING_KEY", "CLOUD_ENTITLEMENT_KEY", "EMAIL_CODE_SECRET", "GOOGLE_CONNECT_TOKEN_KEY"]
/** The API Worker's secrets, each by the secrets file entry it is read from. */
const workerSecretSource: Readonly<Record<string, string>> = {
  CLOUD_DIGEST_KEY: "CLOUD_DIGEST_KEY", CLOUD_SEALING_KEY: "CLOUD_SEALING_KEY", CLOUD_ENTITLEMENT_KEY: "CLOUD_ENTITLEMENT_KEY",
  EMAIL_CODE_SECRET: "EMAIL_CODE_SECRET", GOOGLE_CLIENT_SECRET: "GOOGLE_CLIENT_SECRET",
  GOOGLE_CONNECT_CLIENT_SECRET: "GOOGLE_CONNECT_CLIENT_SECRET", GOOGLE_CONNECT_TOKEN_KEY: "GOOGLE_CONNECT_TOKEN_KEY",
  STRIPE_SECRET_KEY: "STRIPE_SECRET_KEY", STRIPE_WEBHOOK_SECRET: "STRIPE_WEBHOOK_SECRET",
  CEREBRAS_API_KEY: "CEREBRAS_API_KEY", CARTESIA_API_KEY: "CARTESIA_API_KEY",
  GOOGLE_MAPS_API_KEY: "GOOGLE_MAPS_API_KEY", SLACK_CLIENT_ID: "SLACK_CLIENT_ID", SLACK_APP_ID: "SLACK_APP_ID",
  SLACK_APP_TOKEN: "SLACK_APP_TOKEN", SLACK_SIGNING_SECRET: "SLACK_SIGNING_SECRET", TELEGRAM_API_ID: "TELEGRAM_API_ID",
}

/** This package's directory, run from `src/` or from `dist/src/`. */
export effect function packageDirectory() {
  const path = try Path.Path
  const here = path.fromFileUrl(new URL("..", import.meta.url)) catch effect () => { throw new OperatorFailed({ problem: "this package's directory cannot be found" }) }
  return path.basename(here) === "dist" ? path.dirname(here) : here
}

/** The NAME=value lines of a secrets file, quotes removed. */
function parseSecrets(text: string): Record<string, string> {
  const values: Record<string, string> = {}
  for (const line of text.split("\n")) {
    const match = /^\s*([A-Z][A-Z0-9_]*)\s*=\s*(.*?)\s*$/.exec(line)
    if (match) values[match[1]] = /^(['"]).*\1$/.test(match[2]) ? match[2].slice(1, -1) : match[2]
  }
  return values
}

/** Resolve `target` through any symlinks, including dangling ones, so containment checks cannot be bypassed. */
effect function canonicalPath(target: string, depth = 0): string!OperatorFailed!(FileSystem.FileSystem | Path.Path) {
  if (depth > 16) throw new OperatorFailed({ problem: `${target} contains too many symbolic links` })
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const resolved = path.resolve(target)
  const real = (fs.realPath(resolved) catch () => undefined)
  if (real !== undefined) return real
  const linked = (fs.readLink(resolved) catch () => undefined)
  if (linked !== undefined) return try canonicalPath(path.resolve(path.dirname(resolved), linked), depth + 1)
  const parent = path.dirname(resolved)
  if (parent === resolved) return resolved
  return path.join(try canonicalPath(parent, depth + 1), path.basename(resolved))
}

/** The secrets file at `file`, refused inside the checkout or readable by anyone but its owner; nothing yet when it does not exist. */
export effect function readSecrets(file: string): Record<string, string>!OperatorFailed!(FileSystem.FileSystem | Path.Path) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const resolved = path.resolve(file)
  const canonical = try canonicalPath(resolved)
  const checkout = try canonicalPath(path.resolve(try packageDirectory(), "../.."))
  const exists = (fs.exists(canonical) catch () => false)
  const info = exists ? (fs.stat(canonical) catch effect () => { throw new OperatorFailed({ problem: `cannot read ${resolved}` }) }) : undefined
  if (info !== undefined && info.type !== "File") throw new OperatorFailed({ problem: `${resolved} must be a regular file` })
  const mode = info?.mode ?? 0o600
  const insideCheckout = canonical === checkout || canonical.startsWith(checkout + path.sep)
  if (!secretsFileAccepted(insideCheckout, (mode & 0o077) !== 0))
    throw new OperatorFailed({ problem: `${resolved} must lie outside the checkout and be readable by its owner alone (chmod 600)` })
  if (!exists) return {}
  return parseSecrets((fs.readFileString(canonical) catch effect () => { throw new OperatorFailed({ problem: `cannot read ${resolved}` }) }))
}

effect function writeSecrets(file: string, values: Readonly<Record<string, string>>): void!OperatorFailed!(FileSystem.FileSystem | Path.Path) {
  if (Object.values(values).some((value) => /[\r\n]/.test(value))) throw new OperatorFailed({ problem: "a secret cannot span lines" })
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const resolved = try canonicalPath(file)
  const text = Object.entries(values).map(([name, value]) => `${name}=${value}`).join("\n") + "\n"
  const staged = path.join(path.dirname(resolved), `.${path.basename(resolved)}.${hexKey().slice(0, 16)}.tmp`)
  fs.writeFileString(staged, text, { mode: 0o600 }) catch effect () => { throw new OperatorFailed({ problem: `cannot write ${resolved}` }) }
  fs.chmod(staged, 0o600) catch effect () => {
    fs.remove(staged, { force: true }) catch () => undefined
    throw new OperatorFailed({ problem: `cannot make ${resolved} private` })
  }
  fs.rename(staged, resolved) catch effect () => {
    fs.remove(staged, { force: true }) catch () => undefined
    throw new OperatorFailed({ problem: `cannot replace ${resolved}` })
  }
}

/** Every internal secret that is absent, generated; those present are kept as they are. */
export function generated(values: Readonly<Record<string, string>>): Record<string, string> {
  const next = { ...values }
  for (const name of internalSecrets) {
    if (next[name]) continue
    next[name] = name === "CLOUD_ENTITLEMENT_KEY" ? entitlementKey()
      : name === "CLOUD_SEALING_KEY" ? sealingKey()
      : name === "GOOGLE_CONNECT_TOKEN_KEY" ? hexKey()
      : randomKey()
  }
  return next
}

/** Why the secrets cannot serve `environment`: a missing value, a key of the wrong Stripe mode, a malformed one, or a deployed Eliza Cloud host. */
export function secretProblems(values: Readonly<Record<string, string>>, environment: CloudEnvironment): ReadonlyArray<string> {
  const problems = [...providedSecrets, ...internalSecrets].filter((name) => !values[name]).map((name) => `${name} is missing`)
  const stripe = values.STRIPE_SECRET_KEY
  if (stripe && (!/^(sk|rk)_(live|test)_/.test(stripe) || !paymentKeyFits(environment === "production", /^(sk|rk)_live_/.test(stripe))))
    problems.push(environment === "production" ? "STRIPE_SECRET_KEY must be a live key in production" : "STRIPE_SECRET_KEY must be a test key in staging")
  if (values.DATABASE_URL && !/^postgres(ql)?:\/\//.test(values.DATABASE_URL)) problems.push("DATABASE_URL must be a postgres:// URL")
  if (values.CLOUD_ENTITLEMENT_KEY && !isEntitlementKey(values.CLOUD_ENTITLEMENT_KEY)) problems.push("CLOUD_ENTITLEMENT_KEY must be a PKCS #8 EC P-256 private key")
  if (values.CLOUD_SEALING_KEY && sealingKeyBytes(values.CLOUD_SEALING_KEY) !== 32) problems.push("CLOUD_SEALING_KEY must hold exactly 32 base64 bytes")
  if (values.GOOGLE_CONNECT_TOKEN_KEY && !isHexKey(values.GOOGLE_CONNECT_TOKEN_KEY)) problems.push("GOOGLE_CONNECT_TOKEN_KEY must be 64 hex characters")
  for (const name of ["CLOUD_DIGEST_KEY", "EMAIL_CODE_SECRET"] as const) if (values[name] && base64urlBytes(values[name]) < 32) problems.push(`${name} must hold at least 32 bytes`)
  for (const [name, value] of Object.entries(values)) if (leakedElizaHost(value) !== undefined) problems.push(`${name} names a deployed Eliza Cloud host`)
  return problems
}

/** The API Worker's secrets, by the name the Worker reads. */
export function workerSecrets(values: Readonly<Record<string, string>>): Record<string, string> {
  return Object.fromEntries(Object.entries(workerSecretSource).map(([name, source]) => [name, values[source] ?? ""]).filter(([, value]) => value !== ""))
}

/**
 * Converts the two earlier 43-character unpadded base64url internal keys created before the
 * strict base64 and 64-hex checks into their canonical encodings for staging alone, preserving
 * the exact 32 key bytes. Production and every other secret pass through unchanged.
 */
export function stagingCompatibleSecrets(values: Readonly<Record<string, string>>, environment: CloudEnvironment): Record<string, string> {
  if (environment !== "staging") return { ...values }
  const next = { ...values }
  const convertedSealing = next.CLOUD_SEALING_KEY ? canonicalUnpaddedSealingKey(next.CLOUD_SEALING_KEY) : undefined
  if (convertedSealing !== undefined) next.CLOUD_SEALING_KEY = convertedSealing
  const convertedGoogle = next.GOOGLE_CONNECT_TOKEN_KEY ? canonicalUnpaddedHexKey(next.GOOGLE_CONNECT_TOKEN_KEY) : undefined
  if (convertedGoogle !== undefined) next.GOOGLE_CONNECT_TOKEN_KEY = convertedGoogle
  return next
}

/** The secrets of `file` read under the rollout's rules: generated once unless frozen, written back, and refused unless complete. */
export effect function settledSecrets(file: string, environment: CloudEnvironment) {
  const rollout = try Machine
  const values = stagingCompatibleSecrets(try readSecrets(file), environment)
  const internalMissing = internalSecrets.some((name) => !values[name])
  const provided = secretProblems(generated(values), environment)
  const read = try rollout.send({ type: "readSecrets", internalMissing, providedFit: provided.length === 0 })
  const settled = read.generated ? generated(values) : values
  if (read.generated) try writeSecrets(file, settled)
  if (read.vault !== "Complete") {
    const problem = secretProblems(settled, environment).join("\n")
    throw new OperatorFailed({ problem, message: problem })
  }
  const signingKey = settled.CLOUD_ENTITLEMENT_KEY ?? ""
  const publicKey = Effect.try(() => entitlementPublicKey(signingKey)) catch effect () => { throw new OperatorFailed({ problem: "CLOUD_ENTITLEMENT_KEY is not a PKCS #8 P-256 key" }) }
  return { values: settled, entitlementPublicKey: publicKey }
}

/** The command's exit, with its output passed through to the operator; a nonzero exit fails as `label`. */
effect function run(label: string, command: string, args: ReadonlyArray<string>, cwd: string, env: Readonly<Record<string, string>> = {}): void!OperatorFailed!ChildProcessSpawner {
  const spawner = try ChildProcessSpawner
  const code: number = (spawner.exitCode(ChildProcess.make(command, [...args], { cwd, env: { ...env }, extendEnv: true, stdin: "ignore", stdout: "inherit", stderr: "inherit" })) catch effect () => {
    throw new OperatorFailed({ problem: `${label} could not start` })
  })
  if (code !== 0) throw new OperatorFailed({ problem: `${label} failed (exit ${code})` })
}

/** eliza's operator command, `elizaos-cloud`, with the secrets in its environment and never in its arguments. */
export effect function elizaosCloud(args: ReadonlyArray<string>, values: Readonly<Record<string, string>>) {
  const path = try Path.Path
  const directory = try packageDirectory()
  try run(`elizaos-cloud ${args.slice(0, 2).join(" ")}`, "node", [path.join(directory, "node_modules/@elizaos/cloud-worker/dist/src/main.js"), ...args], directory, values)
}

/** Wrangler in this package, in the account the resources record. */
export effect function wrangler(args: ReadonlyArray<string>, accountId?: string) {
  const path = try Path.Path
  const directory = try packageDirectory()
  const executable = try canonicalPath(path.join(directory, "node_modules/.bin/wrangler"))
  try run(`wrangler ${args.slice(0, 2).join(" ")}`, executable, args, directory, { WRANGLER_SEND_METRICS: "false", ...(accountId === undefined ? {} : { CLOUDFLARE_ACCOUNT_ID: accountId }) })
}

/** A directory of this run only its owner reads, gone with the scope. */
export effect function privateDirectory() {
  const fs = try FileSystem.FileSystem
  const directory = try fs.makeTempDirectoryScoped({ prefix: "alpha-cloud-" })
  try fs.chmod(directory, 0o700)
  return directory
}

/** The JSON a file holds, refused when it is missing or not JSON. */
effect function readJson(file: string): unknown!OperatorFailed!FileSystem.FileSystem {
  const fs = try FileSystem.FileSystem
  const text = fs.readFileString(file) catch effect () => { throw new OperatorFailed({ problem: `cannot read ${file}` }) }
  return try Effect.try({ try: () => JSON.parse(text) as unknown, catch: () => new OperatorFailed({ problem: `${file} is not JSON` }) })
}

/** The profile disagrees with Alpha Cloud's hosts or another rule of its deployment. */
export error CandidateRefused { problems: ReadonlyArray<string>, message: string }

const priorCartesiaTemplateRealtimeUrl = "wss://api.cartesia.ai/stt/websocket"
const canonicalCartesiaRealtimeOrigin = "wss://api.cartesia.ai"

/**
 * Formats a `parseProfile` refusal using field paths or static deployment-rule text alone,
 * never echoing raw profile values.
 */
function profileParseMessage(file: string, problem: string): string {
  if (problem.startsWith("the profile breaks a deployment rule:")) return `${file}: ${problem}`
  const paths = [...problem.matchAll(/at (\[[^\n]+\])/g)].map((match) => match[1])
  if (paths.length > 0) return `${file}: invalid profile field ${paths.join(", ")}`
  return `${file}: profile schema validation failed`
}

/**
 * Normalizes the earlier `candidate.example.json` Cartesia speech `realtimeUrl`
 * (`wss://api.cartesia.ai/stt/websocket`) to its WebSocket origin (`wss://api.cartesia.ai`)
 * in memory for staging alone, across both environment blocks validated by
 * `hostedProfileProblems`. Production and every other URL pass through unchanged.
 */
export function stagingCompatibleProfile(profile: CloudProfile, environment?: CloudEnvironment): CloudProfile {
  if (environment !== "staging") return profile
  const normalizeEnvironment = (settings: EnvironmentProfile): EnvironmentProfile => {
    if (settings.speech?.realtimeUrl !== priorCartesiaTemplateRealtimeUrl) return settings
    return { ...settings, speech: { ...settings.speech, realtimeUrl: canonicalCartesiaRealtimeOrigin } }
  }
  const production = normalizeEnvironment(profile.environments.production)
  const staging = normalizeEnvironment(profile.environments.staging)
  if (production === profile.environments.production && staging === profile.environments.staging) return profile
  return { ...profile, environments: { production, staging } }
}

/** The completed profile of Alpha's own cloud in `file`, accepted by eliza and keeping its deployment rules. */
export effect function profiled(file: string, environment?: CloudEnvironment): { readonly profile: CloudProfile; readonly hosts: Record<CloudEnvironment, Hosts> }!(OperatorFailed | HostedCloudUnknown | CandidateRefused)!(FileSystem.FileSystem | Path.Path) {
  const parsed = parseProfile(try readJson(file)) catch effect (refusal) => {
    const problem = profileParseMessage(file, refusal.problem)
    throw new OperatorFailed({ problem, message: problem })
  }
  const profile = stagingCompatibleProfile(parsed, environment)
  const hosts = try hostedClouds()
  const problems = hostedProfileProblems(profile, hosts)
  if (problems.length > 0) throw new CandidateRefused({ problems, message: problems.join("\n") })
  return { profile, hosts }
}

/** Alpha's registration of `environment` on the profile's App Link host. */
export function registrationOn(profile: CloudProfile, environment: CloudEnvironment) {
  return registrationAt(environment === "production" ? "Production" : "Staging", profile.environments[environment].web.replace(/^https:\/\//, ""))
}

/** `apps/cloud/resources.json`, or the file `override` names. */
export effect function resourcesOf(override?: string): Readonly<Record<CloudEnvironment, CloudResources>>!OperatorFailed!(FileSystem.FileSystem | Path.Path) {
  const path = try Path.Path
  const target = override ?? path.join(try packageDirectory(), "resources.json")
  const raw = try readJson(target)
  return Schema.decodeUnknownEffect(ResourcesFileSchema)(raw) catch effect () => {
    throw new OperatorFailed({ problem: `${target} is not a valid resources.json` })
  }
}

const siblingOf = (environment: CloudEnvironment): CloudEnvironment => environment === "production" ? "staging" : "production"

/** Checks, and with `creating` completes, an environment's Cloudflare resources against what `resources.json` records. */
export effect function reconciled(environment: CloudEnvironment, resources: Readonly<Record<CloudEnvironment, CloudResources>>, databaseUrl: string | undefined, creating: boolean) {
  const hosts = (try hostedClouds())[environment]
  const accountId = (Config.withDefault(Config.String("CLOUDFLARE_ACCOUNT_ID"), "") catch () => "")
  const token = (Config.withDefault(Config.String("CLOUDFLARE_API_TOKEN"), "") catch () => "")
  return try reconcileResources({
    ids: resources[environment], sibling: resources[siblingOf(environment)],
    apiHost: new URL(hosts.cloud).host, webHost: hosts.appLinkHost, databaseUrl, creating,
    accountId: accountId === "" ? undefined : accountId, token,
  })
}

/** Records one environment's verified resources, unless the file changed since it was read. */
export effect function recordResources(file: string, environment: CloudEnvironment, expected: CloudResources, verified: CloudResources) {
  const fs = try FileSystem.FileSystem
  const current = try resourcesOf(file)
  if (JSON.stringify(current[environment]) === JSON.stringify(verified)) return
  if (JSON.stringify(current[environment]) !== JSON.stringify(expected)) throw new OperatorFailed({ problem: `resources.json changed for ${environment}; run provision again` })
  const staged = `${file}.${environment}.${hexKey().slice(0, 12)}.next`
  fs.writeFileString(staged, JSON.stringify({ ...current, [environment]: verified }, null, 2) + "\n") catch effect () => { throw new OperatorFailed({ problem: `cannot write ${staged}` }) }
  fs.rename(staged, file) catch effect () => {
    fs.remove(staged, { force: true }) catch () => undefined
    throw new OperatorFailed({ problem: `cannot replace ${file}` })
  }
}

/** Both Workers of one environment, rendered into `out`: their Wrangler files, and the API Worker's assets, eliza's pages and the profile. */
export effect function renderInto(out: string, profile: CloudProfile, environment: CloudEnvironment, resources: CloudResources) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try packageDirectory()
  const assets = path.join(out, assetsDirectory(environment))
  const paths = { apiMain: path.join(directory, "dist/src/worker.js"), edgeMain: path.join(directory, "dist/src/edge.js"), assets }
  const rendered = try renderEnvironment({ api: apiTemplate, edge: edgeTemplate }, profile, environment, resources, registrationOn(profile, environment), paths)
  const pages = path.join(directory, "dist/pages")
  if (!((fs.exists(pages) catch () => false))) throw new OperatorFailed({ problem: `${pages} is missing: build @repo/cloud first` })
  try fs.makeDirectory(out, { recursive: true })
  try fs.remove(assets, { recursive: true, force: true })
  try fs.copy(pages, assets)
  const profileFile = path.join(assets, PROFILE_ASSET)
  try fs.makeDirectory(path.dirname(profileFile), { recursive: true })
  try fs.writeFileString(profileFile, rendered.profile)
  const api = path.join(out, `wrangler.${environment}.json`)
  const edge = path.join(out, `wrangler.edge.${environment}.json`)
  try fs.writeFileString(api, JSON.stringify(rendered.api, null, 2) + "\n")
  try fs.writeFileString(edge, JSON.stringify(rendered.edge, null, 2) + "\n")
  return { api, edge, assets, profile: profileFile }
}

/** Which Workers a deploy puts on Cloudflare. */
export type Component = "api" | "edge" | "all"

/**
 * One rollout of an environment: its secrets read under the frozen rule, its resources checked, both Workers rendered
 * into a private directory, then the API Worker deployed with its secrets and the web host after it. The rollout's
 * machine refuses each step whose checks have not all passed.
 */
export effect function deploy(at: { readonly environment: CloudEnvironment; readonly profile: string; readonly secrets: string; readonly component: Component; readonly resources?: string }) {
  return try scoped(effect {
    provide machine() {
      const rollout = try Machine
      try rollout.send({ type: "freeze" })
      const { values, entitlementPublicKey: derivedKey } = try settledSecrets(at.secrets, at.environment)
      const { profile } = try profiled(at.profile, at.environment)
      const entitlement = profile.environments[at.environment].entitlement
      if (isExampleEntitlementPublicKey(derivedKey) || entitlement.publicKeys.some(isExampleEntitlementPublicKey)) {
        throw new OperatorFailed({ problem: "the profile still holds the example placeholder entitlement public key" })
      }
      if (!entitlementPublicKeyMatches(values.CLOUD_ENTITLEMENT_KEY ?? "", entitlement.publicKeys, entitlement.keyId)) {
        throw new OperatorFailed({ problem: `CLOUD_ENTITLEMENT_KEY does not match entitlement.publicKeys[${entitlement.keyId}] in ${at.profile}` })
      }
      const resources = try resourcesOf(at.resources)
      const verified = reconciled(at.environment, resources, values.DATABASE_URL, false) catch effect (refused) => {
        try rollout.send({ type: "checkResources", recorded: false })
        throw refused
      }
      try rollout.send({ type: "checkResources", recorded: true })
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const directory = try privateDirectory()
      const rendered = try renderInto(directory, profile, at.environment, verified)
      try rollout.send({ type: "render" })
      if (at.component !== "edge") {
        const secretsFile = path.join(directory, "secrets.json")
        try fs.writeFileString(secretsFile, JSON.stringify(workerSecrets(values)), { mode: 0o600 })
        try wrangler(["deploy", "--config", rendered.api, "--secrets-file", secretsFile], verified.accountId)
        try rollout.send({ type: "deployApi" })
      }
      if (at.component !== "api") {
        try wrangler(["deploy", "--config", rendered.edge], verified.accountId)
        try rollout.send({ type: "deployEdge" })
      }
      return { environment: at.environment, deployed: at.component }
    }
  })
}

/** Writes the registration eliza's `client apply --file` takes, and the profile, into `directory`. */
export effect function registrationInto(directory: string, profile: CloudProfile, environment: CloudEnvironment) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const registration = registrationOn(profile, environment)
  const profileFile = path.join(directory, "profile.json")
  const file = path.join(directory, `registration.${environment}.json`)
  try fs.writeFileString(profileFile, JSON.stringify(profile, null, 2) + "\n", { mode: 0o600 })
  try fs.writeFileString(file, JSON.stringify({ environment, clients: [entryOf(registration)] }, null, 2) + "\n", { mode: 0o600 })
  return { profileFile, file, clientId: registration.clientId }
}
