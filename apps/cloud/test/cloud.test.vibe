module node {
  import { pathOf, readCloudError, routesByName, type EnvironmentProfile } from "@elizaos/cloud"
  import { createHash, createHmac, generateKeyPairSync, randomBytes } from "node:crypto"
  import http from "node:http"
  import type { AddressInfo } from "node:net"
  import { runInNewContext } from "node:vm"

  export const receiverEnv = {
    SLACK_APP_ID: "A01ALPHA", SLACK_APP_TOKEN: "xapp-local-receiver", SLACK_CLIENT_ID: "123.456",
    SLACK_SIGNING_SECRET: "c".repeat(32), WEB_ORIGIN: "https://cloud.alpha.test",
  }
  /** The network port targets only the Slack provider fixture. @throws {never} */
  export function providerAt(origin: string): typeof fetch {
    return async (input, init) => {
      const url = new URL(input instanceof Request ? input.url : input)
      if (url.origin !== "https://slack.com" || !url.pathname.startsWith("/api/") || url.searchParams.has("token")) throw new Error("unexpected provider destination")
      return fetch(origin + url.pathname + url.search, init)
    }
  }
  export async function limitAuthorizations(origin: string) {
    const response = await fetch(origin + "/__control/fault", { method: "POST", headers: {"Content-Type": "application/json"},
      body: JSON.stringify({path: "/api/apps.event.authorizations.list", status: 429, retryAfter: 2, remaining: 1}) })
    if (!response.ok) throw new Error("could not configure Slack rate limit")
  }
  export async function consentCode(origin: string, team: string, redirectUri: string) {
    const verifier = random()
    const fields = new URLSearchParams({ client_id: receiverEnv.SLACK_CLIENT_ID, redirect_uri: redirectUri,
      state: random(), code_challenge: challengeOf(verifier), code_challenge_method: "S256", team, decision: "allow" })
    const answer = await fetch(origin + "/oauth/v2/authorize", { method: "POST", body: fields, redirect: "manual" })
    const code = new URL(answer.headers.get("location") ?? "").searchParams.get("code")
    if (!code) throw new Error("provider did not authorize grant")
    return new URLSearchParams({ client_id: receiverEnv.SLACK_CLIENT_ID, redirect_uri: redirectUri, code_verifier: verifier, code })
  }
  /** Fixed origin and test-owned request fields. @throws {never} */
  export function relayRequest(path: string, body: string, headers: Record<string,string> = {}): Request {
    return new Request("https://api.alpha.test/api/slack/" + path, { method: "POST", body, headers })
  }
  /** Sign one fixture using the local provider secret. @throws {never} */
  export function signedEvent(payload: unknown, milliseconds: number, secret = receiverEnv.SLACK_SIGNING_SECRET): Request {
    const timestamp = String(Math.floor(milliseconds / 1000))
    const body = JSON.stringify(payload)
    const signature = createHmac("sha256", secret).update("v0:" + timestamp + ":" + body).digest("hex")
    return relayRequest("events", body, { "X-Slack-Request-Timestamp": timestamp, "X-Slack-Signature": "v0="+signature })
  }
  /** The paid plans a billing profile binds to provider prices: Plus always, Pro only where the deployment sells it. */
  type Plans = NonNullable<EnvironmentProfile["billing"]>["plans"]

  /** A valid PKCS #8 DER private key on P-384 (not P-256), to verify entitlement key validation rejects wrong curves. @throws {never} */
  export function p384Key(): string {
    return generateKeyPairSync("ec", { namedCurve: "P-384" }).privateKey.export({ type: "pkcs8", format: "der" }).toString("base64")
  }

  /** An oversized 64-byte base64 key, invalid for AES-256-GCM sealing. @throws {never} */
  export function oversizedKey(): string {
    return Buffer.alloc(64, 1).toString("base64")
  }

  /** Sends the device key to the session-only portal and reads the actual refusal. */
  export async function portalAnswer(local: string, credential: string) {
    const route = routesByName.portal
    const answer = await fetch(`${local}${pathOf(route)}`, { method: "POST", headers: { authorization: `Bearer ${credential}` } })
    return { status: answer.status, failure: answer.ok ? undefined : (await readCloudError(answer)).failure }
  }

  /**
   * The payment provider's catalog, read only: what the cloud checks before it serves billing. Payments cost money and
   * cannot be undone, so the local cloud reads this one; its amounts are eliza's plans (`.eliza/spec/cloud/billing/plans.md`).
   * @throws {never}
   */
  export function catalog(plans: Plans): Promise<{ origin: string; close: () => Promise<void> }> {
    const cents = { plus_monthly: 3_000, pro_monthly: 10_000 }
    const monthly = { interval: "month", interval_count: 1, usage_type: "licensed", trial_period_days: null }
    const listed = new Map<string, object>()
    for (const [plan, binding] of Object.entries(plans) as [keyof Plans, Plans[keyof Plans]][]) {
      if (binding === undefined) continue
      const { priceId, productId } = binding
      listed.set(`/v1/products/${productId}`, { object: "product", id: productId, livemode: false, active: true })
      listed.set(`/v1/prices/${priceId}`, {
        object: "price", id: priceId, product: productId, unit_amount: cents[plan], currency: "usd", recurring: monthly,
        type: "recurring", billing_scheme: "per_unit", transform_quantity: null, livemode: false, active: true,
      })
    }
    const server = http.createServer((request, response) => {
      const found = listed.get(request.url ?? "")
      response.writeHead(found === undefined ? 404 : 200, { "content-type": "application/json" }).end(JSON.stringify(found ?? { error: { type: "invalid_request_error" } }))
    })
    const close = () => new Promise<void>((closed) => { server.close(() => closed()); server.closeAllConnections() })
    return new Promise((done) => server.listen(0, "127.0.0.1", () => done({ origin: `http://127.0.0.1:${(server.address() as AddressInfo).port}`, close })))
  }

  /** Fresh random text, as a device makes for a state or a verifier. @throws {never} */
  export function random(): string {
    return randomBytes(32).toString("base64url")
  }

  /** The S256 challenge of `verifier`. @throws {never} */
  export function challengeOf(verifier: string): string {
    return createHash("sha256").update(verifier, "ascii").digest("base64url")
  }

  /** What the return page's markup holds: its inline scripts, its policy by directive, whether it sends a referrer, and the elements that would load or submit anything. @throws {never} */
  export function returnPageParts(html: string) {
    const scripts = [...html.matchAll(/<script([^>]*)>([\s\S]*?)<\/script>/g)].map((found) => ({ attributes: (found[1] ?? "").trim(), text: found[2] ?? "" }))
    const policies = [...html.matchAll(/<meta http-equiv="Content-Security-Policy" content="([^"]*)">/g)].map((found) => found[1] ?? "")
    const policy = Object.fromEntries((policies[0] ?? "").split(";").map((part) => part.trim().split(/\s+/)).map(([name, ...sources]) => [name ?? "", sources]))
    return {
      scripts, policies: policies.length, policy,
      hashes: scripts.map((script) => `'sha256-${createHash("sha256").update(script.text, "utf8").digest("base64")}'`),
      noReferrer: /<meta name="referrer" content="no-referrer">/.test(html),
      loads: [...html.matchAll(/<(?:link|img|iframe|form|object|embed|audio|video|source)\b/gi)].length,
    }
  }

  /** Runs the return page's script at `href`: the address it leaves, its message, and the link it offers, if any. @throws {never} */
  export function returnPageAt(script: string, href: string) {
    const url = new URL(href)
    const shown = { message: "checking", link: undefined as string | undefined }
    const message = { set textContent(text: string) { shown.message = text } }
    const link = { set href(target: string) { shown.link = target }, set hidden(_hidden: boolean) {} }
    const location = { get search() { return url.search }, get pathname() { return url.pathname }, get href() { return url.href } }
    const history = { replaceState: (_state: unknown, _title: string, target: string) => { url.href = new URL(target, url).href } }
    const document = { getElementById: (id: string) => (id === "message" ? message : id === "return" ? link : null) }
    runInNewContext(script, { location, history, document, URL, URLSearchParams })
    return { address: url.href, ...shown }
  }
}
import { consentCode, limitAuthorizations, providerAt, receiverEnv, relayRequest, signedEvent, catalog, challengeOf, oversizedKey, p384Key, portalAnswer, random, returnPageAt, returnPageParts } from node

/** The cloud stopped, or said nothing of serving, before its deadline. */
error NotServing { output: string }

/** `@repo/deployment` names an environment Alpha registers with a local cloud. */
error NotHosted { name: string }

/** A gate's answer was not what Alpha needs. */
error GateRefused { gate: Gate; answer: string }

const owner = "owner@alpha.test"
const alpha = stagingSeed.clients[0]

/**
 * eliza's own cloud command from the pinned checkout, in a cleared environment (only PATH and HOME), under Alpha's staging
 * profile and seed, over a PGlite directory of the run, on a port the system gives it: what it serves at, once it says so.
 */
effect function serving(cloud: string, run: string) {
  const spawner = try ChildProcessSpawner
  const environment = { PATH: try Config.String("PATH"), HOME: try Config.String("HOME") }
  const child = try spawner.spawn(ChildProcess.make("node", [
    "--no-warnings", `--env-file=${run}/secrets.env`, "dist/src/main.js", "serve", "--profile", `${run}/profile.json`, "--environment", "staging",
    "--store", `pglite:${run}/cloud.pglite`, "--seed", `${run}/seed.json`, "--port", "0", "--host", "127.0.0.1",
  ], { cwd: cloud, env: environment, stdin: "ignore" }))
  const output = try Ref.make("")
  const origin = try Deferred.make<string>()
  try fork.scoped (child.all |> Stream.decodeText(%) |> Stream.runForEach(%, (text) => effect {
    try Ref.update(output, (before) => before + text)
    const said = /url: '(http:\/\/127\.0\.0\.1:\d+)'/.exec(try Ref.get(output))
    if (said !== null) try Deferred.succeed(origin, said[1] ?? "")
  }))
  const stopped = effect {
    try child.exitCode
    throw new NotServing({ output: try Ref.get(output) })
  }
  const served = effect {
    return timeout(Deferred.await(origin), "180 seconds") catch effect () => { throw new NotServing({ output: try Ref.get(output) }) }
  }
  return try raceFirst(served, stopped)
}

/** Each gate of the local check, in order: what it asks the cloud, and what Alpha needs it to answer. */
effect function gatesOf(local: string, name: string) {
  const at = (route: string, body?: unknown, credential?: string) => tryPromise({
    try: () => said<Record<string, unknown>>(`${local}${route}`, { body, headers: credential === undefined ? {} : { authorization: `Bearer ${credential}` }, within: 20_000 }),
    catch: (cause) => new GateRefused({ gate: "Health", answer: String(cause) }),
  })
  const held = { session: "", key: "" }
  const binding = { clientId: alpha.clientId, environment: "staging", redirectUri: alpha.signInReturn }
  return (gate: Gate) => effect {
    const refuse = (answer: unknown) => new GateRefused({ gate, answer: JSON.stringify(answer) })
    switch (gate) {
      case "Health": {
        const answer = try at("/api/health")
        if (answer.status !== "ok") throw refuse(answer)
        return
      }
      case "ServiceDocument": {
        const answer = try at("/api/public/service")
        if ((answer.service as { name?: string } | undefined)?.name !== name) throw refuse(answer)
        return
      }
      case "SignInMethods": {
        const answer = try at("/api/v1/auth/methods")
        if (answer.email !== true) throw refuse(answer)
        return
      }
      case "AssetLinks": {
        const answer = try at("/.well-known/assetlinks.json")
        if (!assetLinksNameAlpha(try statementsIn(answer), "Staging")) throw refuse(answer)
        return
      }
      case "EmailedCode": {
        const verifier = random()
        try at("/api/v1/auth/email/code/send", { email: owner, clientId: alpha.clientId, codeChallenge: challengeOf(verifier), codeChallengeMethod: "S256" })
        const mail = try at(`/api/test/inbox/${encodeURIComponent(owner)}`)
        const code = /\b(\d{6})\b/.exec(String(mail.text))?.[1]
        if (code === undefined) throw refuse(mail)
        const signed = try at("/api/v1/auth/email/code/verify", { email: owner, code, clientId: alpha.clientId, codeVerifier: verifier })
        if (signed.status !== "signed_in" || typeof signed.accessToken !== "string") throw refuse(signed)
        held.session = signed.accessToken
        return
      }
      case "DeviceKey": {
        const [verifier, state] = [random(), random()]
        const granted = try at("/api/v1/app-auth/connect", { ...binding, state, flow: "mobile_pkce", codeChallengeMethod: "S256", codeChallenge: challengeOf(verifier) }, held.session)
        const redeemed = { ...binding, state, code: granted.code, codeVerifier: verifier }
        const minted = try at("/api/v1/app-auth/mobile/token", { ...redeemed, grantType: "authorization_code" })
        const acknowledged = try at("/api/v1/app-auth/mobile/ack", { ...redeemed, credentialId: minted.credentialId, secret: minted.secret })
        if (acknowledged.status !== "acknowledged" || typeof minted.secret !== "string") throw refuse(acknowledged)
        held.key = minted.secret
        return
      }
      case "KeyedReads": {
        const client = createCloudClient({ baseUrl: local, credential: () => held.key })
        const read = try tryPromise({
          try: async () => ({ account: await client.account(), entitlement: await client.entitlement(), plans: await client.plans() }),
          catch: (cause) => refuse(String(cause)),
        })
        if (read.account.email !== owner || read.entitlement === "" || read.plans.map((plan) => plan.key).join() !== "plus_monthly,pro_monthly") throw refuse(read)
        return
      }
      case "BillingRefused": {
        const answer = try tryPromise({ try: () => portalAnswer(local, held.key), catch: (cause) => refuse(String(cause)) })
        if (answer.status !== 401 || answer.failure?.tag !== "CloudCredentialInvalid") throw refuse(answer)
        return
      }
    }
  }
}

describe(`Check Alpha's contract on my computer (spec/cloud/local.md, "Story: Check Alpha's contract on my computer")`, () => {
  it.live("refuses a profile off this computer, then serves Alpha's staging profile through every gate in order", () => effect {
    const files = try FileSystem.FileSystem
    const cloud = try Effect.try(() => prepared().cloud)
    const profile = try profileNamed("staging")
    const settings = profile.environments.staging
    const prices = try acquireRelease(tryPromise(() => catalog(settings.billing!.plans)), (opened) => promise(() => opened.close()))
    const run = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-" })
    const local = { ...settings, billing: { ...settings.billing!, apiUrl: prices.origin } }
    try files.writeFileString(`${run}/profile.json`, JSON.stringify({ ...profile, environments: { ...profile.environments, staging: local } }))
    const registration = registrationAt("Staging", new URL(settings.web).hostname)
    try holds(() => assert.deepStrictEqual(stagingSeed.clients, [entryOf(registration)]))
    try files.writeFileString(`${run}/seed.json`, JSON.stringify(stagingSeed))
    const fixture = try files.readFileString(`${cloud}/test/fixtures/secrets.env`)
    try files.writeFileString(`${run}/secrets.env`, `${fixture}\nSTRIPE_SECRET_KEY=sk_test_local\nSTRIPE_WEBHOOK_SECRET=whsec_local\n`)
    provide machine() {
      const check = try Machine
      // spec/cloud/local.md, "The local cloud starts only for a profile whose database, mail, text messages and providers are all on this computer, and stops with every part together"
      const hosted = (try profileNamed("candidate")).environments.staging
      const refused = check.send({ type: "start", loopback: loopbackOnly(hosted) }) catch (failure) => failure._tag
      try Effect.try(() => assert.strictEqual(refused, "Rejected"))
      try check.send({ type: "start", loopback: loopbackOnly(local) })
      const origin = try serving(cloud, run)
      // spec/cloud/local.md, "Each gate is tried only after every gate before it passed; a failed gate ends the check"
      const pass = try gatesOf(origin, settings.name)
      try check.send({ type: "beginCheck" })
      const failures: string[] = []
      for (let index = 0; index < gates && (try check.get()).checking; index += 1) {
        const ended = try exit(timeout(pass(gateAt(index)), "60 seconds"))
        if (Exit.isFailure(ended)) failures.push(`${gateAt(index)}: ${Cause.pretty(ended.cause)}`)
        try check.send({ type: "gate", ok: Exit.isSuccess(ended) })
      }
      const { passed, failed } = try check.get()
      try Effect.try(() => assert.deepStrictEqual({ passed, failed, failures }, { passed: gates, failed: false, failures: [] }))
      try check.send({ type: "stop" })
    }
  } |> scoped(%) |> Effect.provide(%, NodeServices.layer), 600_000)
})

const holds = (assertion: () => void) => Effect.try(assertion)

describe(`Alpha Cloud at its hosted origins (spec/cloud/index.md, "Story: Operate Alpha's own cloud")`, () => {
  it.effect("accepts the hosted profile at Alpha Cloud's hosts with Alpha's services, sender and model, and refuses one that strays", () => effect {
    const hosts = try hostedClouds()
    const profile = try profileNamed("candidate")
    try holds(() => assert.deepStrictEqual(hostedProfileProblems(profile, hosts), []))
    const production = profile.environments.production
    const [model] = production.inference!.models
    const strayed: typeof profile = { ...profile, environments: { ...profile.environments, production: {
      ...production, capabilities: production.capabilities.filter((capability) => capability !== "maps"),
      mailSender: "sign-in@mail.alphacompute.invalid",
      inference: { ...production.inference!, models: [{ ...model, defaultMaxTokens: 4096 }] },
    } } }
    try holds(() => assert.deepStrictEqual(hostedProfileProblems(strayed, hosts).map((problem) => problem.split(":")[0]), ["production", "production", "production"]))
    const staging = profile.environments.staging
    try holds(() => assert.deepStrictEqual(hostedProfileProblems({
      ...profile, environments: { ...profile.environments, staging: {
        ...staging, speech: { ...staging.speech!, realtimeUrl: "wss://api.cartesia.ai/stt/websocket" },
      } },
    }, hosts), ["staging: speech realtimeUrl must be a wss origin without an endpoint path"]))
    const alternatives: ReadonlyArray<typeof staging.mail> = [{ kind: "binding", binding: "OTHER_EMAIL" }, { kind: "https", url: "https://email.example.com/messages", apiKeyEnv: "OTHER_EMAIL_KEY" }]
    try holds(() => assert.deepStrictEqual(alternatives.map((mail) => hostedProfileProblems({
      ...profile, environments: { ...profile.environments, staging: { ...staging, mail } },
    }, hosts)), alternatives.map(() => ["staging: the profile must use Alpha's own Cloudflare email binding and sender"])))
    const colliding = { ...hosts, staging: { ...hosts.staging, appLinkHost: new URL(hosts.production.cloud).hostname } }
    try holds(() => assert.deepStrictEqual(hostedProfileProblems(profile, colliding), [
      "production and staging share an API or App Link hostname",
      "staging: the profile's API or web host differs from @repo/deployment",
    ]))
    const shipped = (profiled("profile/staging.json") catch (failure) => failure._tag === "CandidateRefused" ? failure.message : failure._tag)
    try holds(() => assert.match(String(shipped), /staging: the profile's API or web host differs from @repo\/deployment/))
  } |> Effect.provide(%, NodeServices.layer))
})

describe(`Alpha's screens reach the cloud through eliza's policy (spec/cloud/index.md, "Story: Reach my account's services from the app")`, () => {
  it.effect("loads every route of Alpha's table, refuses a sign-in or fresh-session route, and covers eliza's managed Gmail client", () => effect {
    try holds(() => assert.deepStrictEqual(tableProblems(), []))
    const [group] = elizaCloudRoutes
    try holds(() => assert.deepStrictEqual(group?.routes.find((route) => route.path === "/api/v1/maps/geocode"), { method: "POST", path: "/api/v1/maps/geocode" }))
    try holds(() => assert.deepStrictEqual(group?.routes.find((route) => route.path === "/api/v1/eliza/google/status"), { method: "GET", path: "/api/v1/eliza/google/status", query: [{ key: "side", accepts: { kind: "any" } }, { key: "grantId", accepts: { kind: "any" } }] }))
    const refused = tableProblems([
      { verb: "Get", path: "/api/public/service", query: [] },
      { verb: "Post", path: "/api/v1/subscriptions/cancel", query: [] },
      { verb: "Get", path: "/api/v1/nowhere", query: [] },
    ])
    try holds(() => assert.deepStrictEqual(refused, [
      "GET /api/public/service: belongs to sign-in",
      "POST /api/v1/subscriptions/cancel: needs a fresh or stepped-up session",
      "GET /api/v1/nowhere: matches 0 of eliza's device routes",
    ]))
    const files = try FileSystem.FileSystem
    const client = try files.readFileString(`${(try Effect.try(() => prepared())).root}/packages/plugin-inbox-client/src/client/index.vibe`)
    const google = "/api/v1/eliza/google"
    const sent = [...client.matchAll(/`\$\{(google|inbox)\}([^`?]*)(?:\?\$\{query\((\{[^`]*?\})\)\})?`/gs)].filter((found) => found[0] !== "`${google}/gmail/inbox-v1`").map((found) => ({
      path: (found[1] === "google" ? google : `${google}/gmail/inbox-v1`) + found[2].replace(/\$\{encodeURIComponent\(\w+\)\}/g, "{}"),
      keys: [...new Set([...(found[3] ?? "").matchAll(/(?:^|[{,])\s*([A-Za-z]+)(?=\s*[:,}])/g)].map((key) => key[1]))].sort(),
    }))
    const listed = (group?.routes ?? []).map((route) => ({ path: route.path.replace(/\{\w+\}/g, "{}"), keys: ((route as { readonly query?: ReadonlyArray<{ readonly key: string }> }).query ?? []).map((rule) => rule.key).sort() }))
    try holds(() => assert.ok(sent.length >= 13, `found ${sent.length} paths of the managed Gmail client`))
    try holds(() => assert.deepStrictEqual(sent.filter((want) => !listed.some((have) => have.path === want.path && have.keys.join() === want.keys.join())), []))
  } |> Effect.provide(%, NodeServices.layer))
})

const templates = { api: apiTemplate, edge: edgeTemplate }
const paths = { apiMain: "../dist/src/worker.js", edgeMain: "../dist/src/edge.js", assets: "./assets.production" }

describe(`Alpha's own cloud is rendered only when provisioned (spec/cloud/rollout.md, "Story: Render a deployment only when it is provisioned")`, () => {
  it.effect("renders both Workers of a provisioned environment on Alpha Cloud's hosts, refuses a placeholder resource, and catches a shipped Eliza Cloud host", () => effect {
    const profile = try profileNamed("candidate")
    const registration = registrationOn(profile, "production")
    const rendered = try renderEnvironment(templates, profile, "production", resources.production, registration, paths)
    const api = rendered.api as { name: string; routes: ReadonlyArray<{ pattern: string }>; vars: Record<string, string>; send_email: unknown }
    const edge = rendered.edge as { routes: ReadonlyArray<{ pattern: string }>; services: ReadonlyArray<{ service: string }>; vars: Record<string, string> }
    try holds(() => assert.deepStrictEqual([api.routes[0]?.pattern, edge.routes[0]?.pattern, edge.services[0]?.service], ["api.alphaphone.dev", "cloud.alphaphone.dev", api.name]))
    // spec/cloud/rollout.md, "The API Worker's bindings repeat its profile's origins and database, and its registry is Alpha's registration of that environment"
    const settings = profile.environments.production
    const registry = try Effect.try(() => JSON.parse(api.vars.NATIVE_CLIENT_REGISTRY ?? "[]") as unknown)
    try holds(() => assert.deepStrictEqual(
      [api.vars.PUBLIC_API_ORIGIN, api.vars.WEB_ORIGIN, api.vars.CLOUD_IDENTITY_DIGEST, api.vars.GOOGLE_CLIENT_ID, api.vars.GOOGLE_CONNECT_CLIENT_ID, registry, api.vars.CLOUD_PROFILE_SHA256, api.vars.CLOUD_PROFILE],
      [settings.api, settings.web, settings.databaseIdentity, settings.google?.clientId, settings.google?.serverClientId, [{ ...entryOf(registration), environment: "production", enabled: true }], sha256Hex(rendered.profile), undefined]))
    try holds(() => assert.deepStrictEqual(edge.vars, { CLOUD_ENVIRONMENT: "production", PUBLIC_API_ORIGIN: settings.api, WEB_ORIGIN: settings.web }))
    // spec/cloud/index.md, "Alpha's own cloud uses Cloudflare to mail sign-in codes from its own address"
    try holds(() => assert.deepStrictEqual([api.send_email, api.vars.EMAIL_FROM, "send_email" in edge], [
      [{ name: "SIGN_IN_EMAIL", allowed_sender_addresses: ["noreply@auth.alphaphone.dev"] }], "noreply@auth.alphaphone.dev", false,
    ]))
    try holds(() => assert.ok(!JSON.stringify(rendered).includes('STRIPE_SECRET_KEY":')))
    try holds(() => assert.deepStrictEqual(problemsRendering(profile, "staging", resources.staging), ["DatabaseUnprovisioned"]))
    const staging = (renderEnvironment(templates, profile, "staging", resources.staging, registrationOn(profile, "staging"), paths) catch (failure) => failure._tag)
    try holds(() => assert.strictEqual(staging, "RenderRefused"))
    try holds(() => assert.deepStrictEqual([leakedElizaHost("https://api.eliza.app/x"), leakedElizaHost("https://api.alphaphone.dev")], ["api.eliza.app", undefined]))
  })
})

describe(`The API Worker serves one reviewed profile (spec/cloud/rollout.md, "Story: Serve one reviewed profile from the API Worker")`, () => {
  it.effect(`serves only the profile its assets hold under the pinned digest, and asks the caller to retry otherwise (spec/cloud/rollout.md, "The API Worker serves only while the profile in its assets is the text its pinned digest names, and otherwise asks the caller to retry")`, () => effect {
    const profile = JSON.stringify({ version: 1, name: "Alpha Cloud" })
    const holding = (text: string | undefined) => ({ fetch: (request: Request) => Promise.resolve(new URL(request.url).pathname === `/${PROFILE_ASSET}` && text !== undefined ? new EdgeResponse(text) : new EdgeResponse("Not Found", { status: 404 })) })
    const read = (text: string | undefined, pinned: string) => tryPromise(() => readProfileAsset(holding(text), pinned))
    const reads = [try read(profile, sha256Hex(profile)), try read(`${profile} `, sha256Hex(profile)), try read(undefined, sha256Hex(profile)), try read(profile, "")]
    try holds(() => assert.deepStrictEqual(reads, [profile, undefined, undefined, undefined]))
    const env = { CLOUD_PROFILE_SHA256: sha256Hex(profile), ASSETS: holding(undefined) } as unknown as Parameters<typeof alphaCloudWorker.fetch>[1]
    const answer = try tryPromise(() => alphaCloudWorker.fetch(new EdgeRequest("https://api.alphaphone.dev/api/health"), env))
    try holds(() => assert.deepStrictEqual([answer.status, answer.headers.get("retry-after")], [503, "30"]))
    const registration = new EdgeRequest("https://api.alphaphone.dev/.well-known/alpha-slack")
    const origin = "https://cloud.alphaphone.dev"
    const apiOrigin = "https://api.alphaphone.dev"
    const browserAssets = new Map([
      ["/alpha-slack-assets/opener", '<script type="module" src="/alpha-slack-assets/assets/slack-example.js"></script>'],
      ["/alpha-slack-assets/return", '<script type="module" src="/alpha-slack-assets/assets/alpha-slack-return-example.js"></script>'],
    ])
    const ready = { ...env, WEB_ORIGIN: origin, PUBLIC_API_ORIGIN: apiOrigin, ASSETS: { fetch: (request: Request) => {
      const path = new URL(request.url).pathname
      const document = browserAssets.get(path)
      if (document !== undefined) return Promise.resolve(new EdgeResponse(document))
      if (path === "/alpha-slack-assets/assets/slack-example.js" || path === "/alpha-slack-assets/assets/alpha-slack-return-example.js")
        return Promise.resolve(new EdgeResponse("export {};", { headers: { "Content-Type": "text/javascript" } }))
      return holding(profile).fetch(request)
    } } }
    const telegram = new EdgeRequest("https://api.alphaphone.dev/.well-known/alpha-telegram")
    const absentTelegram = try tryPromise(() => alphaCloudWorker.fetch(telegram, ready))
    const registeredTelegram = try tryPromise(() => alphaCloudWorker.fetch(telegram, { ...ready, TELEGRAM_API_ID: "2147483647" }))
    const telegramInfo = try tryPromise(() => registeredTelegram.json())
    try holds(() => assert.deepStrictEqual([absentTelegram.status, registeredTelegram.status, telegramInfo], [503, 200, { apiId: 2147483647 }]))
    const missing = try tryPromise(() => alphaCloudWorker.fetch(registration, ready))
    const published = try tryPromise(() => alphaCloudWorker.fetch(registration, { ...ready, SLACK_CLIENT_ID: "123.456" }))
    const body = try tryPromise(() => published.json())
    try holds(() => assert.deepStrictEqual([missing.status, published.status, body], [503, 200, { clientId: "123.456" }]))
    const registrations = (bindings: typeof ready) => {
      const api = { fetch: (request: Request) => alphaCloudWorker.fetch(request, bindings) }
      const reach: typeof fetch = (input, init) => {
        const request = new EdgeRequest(input, init)
        return new URL(request.url).origin === origin
          ? edgeWorker.fetch(request, { CLOUD_ENVIRONMENT: "production", WEB_ORIGIN: origin, PUBLIC_API_ORIGIN: apiOrigin, API: api })
          : api.fetch(request)
      }
      return smoke("production", { api: "https://api.alphaphone.dev", web: "https://cloud.alphaphone.dev" }, "Alpha Cloud", "messaging")
        |> Effect.provide(%, FetchHttpClient.layer) |> Effect.provideService(%, FetchHttpClient.Fetch, reach)
    }
    const invalidId = try registrations({ ...ready, TELEGRAM_API_ID: "2147483648" })
    try holds(() => assert.deepStrictEqual(invalidId.find(gate => gate.gate === "TelegramRegistration"), { gate: "TelegramRegistration", passed: false, detail: "HTTP 503" }))
    const offline = try registrations(ready)
    const partial = try registrations({ ...ready, SLACK_CLIENT_ID: "123.456", TELEGRAM_API_ID: "1234" })
    const disconnectedMailbox = try registrations({ ...ready, ...receiverEnv, WEB_ORIGIN: origin, TELEGRAM_API_ID: "1234" })
    try holds(() => assert.deepStrictEqual(offline.map(gate => [gate.gate, gate.passed, gate.detail]), [["SlackRegistration", false, "HTTP 503"], ["SlackMailbox", false, "HTTP 503"], ["TelegramRegistration", false, "HTTP 503"], ["SlackBrowser", true, "HTTP 200"], ["SlackBrowserReturn", true, "HTTP 200"]]))
    try holds(() => assert.deepStrictEqual(partial.map(gate => gate.passed), [false, false, true, true, true]))
    try holds(() => assert.deepStrictEqual(disconnectedMailbox.map(gate => gate.passed), [true, false, true, true, true]))
  })
})

describe(`Cloud Slack events reach each authorized installation (spec/app/slack/notices.md, "Story: Hear about Slack DMs, mentions and thread replies per workspace")`, () => {
  it.live("exchanges PKCE grants, verifies signed callbacks and rereads a DM with its authorized handset after rotation", () => effect {
    try prepareSlackMailbox
    const slack = try acquireRelease(tryPromise(() => startSlackProvider()), running => promise(() => running.stop()))
    const send = providerAt(slack.origin)
    const now = 1800000000000
    const relay = (request: Request, at = now) => slackRelay(request, receiverEnv, send, at)
    const readFor = (access: string, cursor?: number) => relay(relayRequest("events/read", JSON.stringify({ cursor }), { Authorization: "Bearer " + access }))
    const grant = effect (team: string, redirect: string) => {
      const fields = try tryPromise(() => consentCode(slack.origin, team, redirect))
      const answer = try relay(relayRequest("oauth", fields.toString()))
      const body = try tryPromise(() => answer.json() as Promise<{ authed_user: { access_token: string; refresh_token: string } }>)
      try holds(() => assert.ok(body.authed_user?.access_token, JSON.stringify([answer.status, Object.keys(body)])))
      return body.authed_user
    }
    const alpha = try grant("T01ALPHA", "alphaphone://slack/oauth/callback")
    const design = try grant("T02DESIGN", "alphaphone://slack/oauth/standalone")
    const readBody = (answer: Response) => tryPromise(() => answer.json() as Promise<{ cursor: number; events: { event: { text: string; channel: string } }[] }>)
    const initial = try readBody(try readFor(alpha.access_token))
    try holds(() => assert.deepStrictEqual(initial, { cursor: 0, events: [] }))
    const probe = { type: "url_verification", challenge: "verification" }
    const verified = try relay(signedEvent(probe, now))
    const verifiedBody = try tryPromise(() => verified.json())
    const forged = try relay(signedEvent(probe, now, "wrong"))
    const stale = try relay(signedEvent(probe, now - 360000))
    try holds(() => assert.deepStrictEqual([verifiedBody, forged.status, stale.status], [{ challenge: "verification" },401,401]))
    const callback = { type: "event_callback", api_app_id: "A01ALPHA", event_id: "EvDM01", event_time: now/1000,
      event_context: "EC-local-direct", team_id: "T02DESIGN", authorizations: [{ enterprise_id: null, team_id: "T02DESIGN", user_id: "U11OWNER", is_bot: true }],
      event: { type: "message", channel: "D01MAYA", ts: "1730000360.000200", user: "U11OWNER", text: "callback text must never be delivered" } }
    const accepted = try relay(signedEvent(callback, now))
    const retry = try relay(signedEvent(callback, now))
    const pending = try readBody(try readFor(alpha.access_token, 0))
    try holds(() => assert.deepStrictEqual(pending.events, []))
    try tryPromise(() => limitAuthorizations(slack.origin))
    try dispatchSlackEvents(receiverEnv, send, now)
    try dispatchSlackEvents(receiverEnv, send, now + 1000)
    const delayed = try readBody(try readFor(alpha.access_token, 0))
    try holds(() => assert.deepStrictEqual(delayed.events, []))
    try dispatchSlackEvents(receiverEnv, send, now + 2000)
    const stranger = try readBody(try readFor(design.access_token, 0))
    const foreign = try readFor("xoxp-alpha-team-owner-initial", 0)
    try holds(() => assert.deepStrictEqual([accepted.status, retry.status, stranger, foreign.status], [200,200,{cursor:0,events:[]},401]))
    const rotated = try relay(relayRequest("oauth", new URLSearchParams({ client_id: receiverEnv.SLACK_CLIENT_ID, grant_type: "refresh_token", refresh_token: alpha.refresh_token }).toString()))
    const credentials = try tryPromise(() => rotated.json() as Promise<{ access_token: string }>)
    const retired = try readFor(alpha.access_token, 0)
    const received = try readBody(try readFor(credentials.access_token, initial.cursor))
    const again = try readBody(try readFor(credentials.access_token, received.cursor))
    try holds(() => assert.deepStrictEqual([rotated.status, retired.status, received.events.map(item => item.event.text), again.events],
      [200,401,["Yes! Grabbing coffee and joining in 5."],[]]))
    const thread = { ...callback, event_id: "EvThread", event: { ...callback.event, channel: "C01GENERAL", ts: "1730000130.000300", thread_ts: "1730000100.000100" } }
    try relay(signedEvent(thread, now))
    try dispatchSlackEvents(receiverEnv, send, now)
    const reply = try readBody(try readFor(credentials.access_token, received.cursor))
    try holds(() => assert.deepStrictEqual(reply.events.map(item => item.event.text), ["Design slides are linked in the doc."]))
    const hidden = { ...callback, event_id: "EvHidden", event: { ...callback.event, channel: "D99HIDDEN" } }
    try relay(signedEvent(hidden, now))
    try dispatchSlackEvents(receiverEnv, send, now)
    const denied = try readBody(try readFor(credentials.access_token, reply.cursor))
    try holds(() => assert.deepStrictEqual(denied.events, []))
    try pruneSlackMailbox(now + 3600001)
    const expired = try readBody(try readFor(credentials.access_token, 0))
    try holds(() => assert.deepStrictEqual(expired, { cursor: 0, events: [] }))
  } |> scoped(%) |> Effect.provide(%, storeLayer({ kind: "pglite", file: undefined })), 30000)
})

describe(`The web host returns the owner to the app (spec/cloud/rollout.md, "Story: Bring me back to the app when its link did not open")`, () => {
  const env: EdgeEnv = { CLOUD_ENVIRONMENT: "production", PUBLIC_API_ORIGIN: "https://api.alphaphone.dev", WEB_ORIGIN: "https://cloud.alphaphone.dev", API: { fetch: () => Promise.reject(new Error("unreachable")) } }

  it.effect("hands its own addresses to the API Worker as the web host, answers its health, and refuses every other address", () => effect {
    const routeOf = (address: string) => edgeRouteOf(new URL(address), env)
    const signIn = routeOf("https://cloud.alphaphone.dev/alphaphone/auth/callback?state=x")
    const slackReturn = routeOf("https://cloud.alphaphone.dev/alpha-slack-return?state=private-state&code=single-use-code")
    try holds(() => assert.deepStrictEqual([slackReturn.route, slackReturn.target?.href], ["Forward", "https://api.alphaphone.dev/alpha-slack-return"]))
    try holds(() => assert.deepStrictEqual([signIn.route, signIn.target?.href], ["Forward", "https://api.alphaphone.dev/alphaphone/auth/callback?state=x"]))
    try holds(() => assert.deepStrictEqual(["https://cloud.alphaphone.dev/health", "https://other.alphaphone.dev/x", "http://cloud.alphaphone.dev/x", "https://user:pass@cloud.alphaphone.dev/"].map((address) => routeOf(address).route), ["Health", "NotFound", "NotFound", "NotFound"]))
    const seen: string[] = []
    const api = { fetch: (request: Request) => { seen.push(`${request.url} ${request.headers.get("x-forwarded-host") ?? ""}`); return Promise.resolve(EdgeResponse.json({ ok: true })) } }
    const answered = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://cloud.alphaphone.dev/.well-known/assetlinks.json"), { ...env, API: api }))
    try holds(() => assert.deepStrictEqual([answered.status, seen], [200, ["https://api.alphaphone.dev/.well-known/assetlinks.json cloud.alphaphone.dev"]]))
    const down = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://cloud.alphaphone.dev/alphaphone/auth/callback"), env))
    try holds(() => assert.deepStrictEqual([down.status, down.headers.get("retry-after")], [503, "30"]))
    const refused = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://elsewhere.example/alphaphone/auth/callback"), env))
    try holds(() => assert.strictEqual(refused.status, 404))
    const apiBlocked = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://cloud.alphaphone.dev/api/v1/user"), { ...env, API: api }))
    try holds(() => assert.strictEqual(apiBlocked.status, 404))
    const postBlocked = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://cloud.alphaphone.dev/alphaphone/auth/callback", { method: "POST" }), { ...env, API: api }))
    try holds(() => assert.strictEqual(postBlocked.status, 405))
  })

  it.effect(`names the web host it was asked for and passes no forwarding or hop-by-hop header (spec/cloud/rollout.md, "The API Worker is told the web host it was asked for, and gets none of the caller's forwarding or hop-by-hop headers")`, () => effect {
    const sent = try Effect.try(() => forwardedHeaders(new EdgeHeaders({ host: "cloud.alphaphone.dev", "x-forwarded-host": "evil.example", forwarded: "host=evil.example", connection: "keep-alive, x-custom-hop", "x-custom-hop": "drop-me", accept: "text/html" }), "cloud.alphaphone.dev"))
    try holds(() => assert.deepStrictEqual(Object.fromEntries(sent), { accept: "text/html", "x-forwarded-host": "cloud.alphaphone.dev", "x-forwarded-proto": "https" }))
  })
})

const provided = { DATABASE_URL: "postgres://alpha:secret@db.example:5432/alpha", GOOGLE_CLIENT_SECRET: "g", GOOGLE_CONNECT_CLIENT_SECRET: "g", STRIPE_SECRET_KEY: "sk_test_x", STRIPE_WEBHOOK_SECRET: "whsec_x", CEREBRAS_API_KEY: "c", CARTESIA_API_KEY: "k", GOOGLE_MAPS_API_KEY: "m" }

/** The secrets of `file` as one rollout reads them, frozen as CI's are or not. */
effect function settledIn(file: string, frozen: boolean) {
  provide rollout() {
    if (frozen) try (try Rollout).send({ type: "freeze" })
    return try settledSecrets(file, "staging")
  }
}

describe(`Secrets stay private and fit their environment (spec/cloud/rollout.md, "Story: Keep every secret private and fitting its environment")`, () => {
  it.effect("refuses a secrets file inside the checkout or readable by others, generates internal keys once and never in a frozen rollout, and refuses a test payment key in production", () => effect {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const directory = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-secrets-" })
    const file = path.join(directory, "staging.env")
    try files.writeFileString(file, Object.entries(provided).map(([name, value]) => `${name}=${value}`).join("\n"), { mode: 0o644 })
    const open = readSecrets(file) catch (failure) => failure._tag
    try files.chmod(file, 0o600)
    const frozen = settledIn(file, true) catch (failure) => failure._tag === "OperatorFailed" ? failure.problem : failure._tag
    const first = try settledIn(file, false)
    const second = try settledIn(file, false)
    const publicKey = try Effect.try(() => entitlementPublicKey(first.values.CLOUD_ENTITLEMENT_KEY ?? ""))
    const inside = readSecrets(path.join(path.dirname(import.meta.dirname), "inside.env")) catch (failure) => failure._tag
    const usage = operate("deploy", ["--environment", "staging"]) catch (failure) => failure._tag
    try holds(() => assert.deepStrictEqual([open, inside, usage], ["OperatorFailed", "OperatorFailed", "UsageInvalid"]))
    try holds(() => assert.ok(typeof frozen === "string" && frozen.includes("CLOUD_SEALING_KEY is missing")))
    try holds(() => assert.deepStrictEqual(second.values, first.values))
    try holds(() => assert.deepStrictEqual(first.entitlementPublicKey, publicKey))
    try holds(() => assert.deepStrictEqual(Object.keys(workerSecrets(first.values)).sort(), ["CARTESIA_API_KEY", "CEREBRAS_API_KEY", "CLOUD_DIGEST_KEY", "CLOUD_ENTITLEMENT_KEY", "CLOUD_SEALING_KEY", "EMAIL_CODE_SECRET", "GOOGLE_CLIENT_SECRET", "GOOGLE_CONNECT_CLIENT_SECRET", "GOOGLE_CONNECT_TOKEN_KEY", "GOOGLE_MAPS_API_KEY", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]))
    try holds(() => assert.deepStrictEqual(secretProblems(first.values, "production"), ["STRIPE_SECRET_KEY must be a live key in production"]))
    try holds(() => assert.deepStrictEqual(secretProblems({ ...generated(provided), CARTESIA_API_KEY: "https://api.eliza.app" }, "staging"), ["CARTESIA_API_KEY names a deployed Eliza Cloud host"]))
    try holds(() => assert.strictEqual(hexBytes(first.values.GOOGLE_CONNECT_TOKEN_KEY ?? ""), 32))
    try holds(() => assert.match(first.values.GOOGLE_CONNECT_TOKEN_KEY ?? "", /^[0-9a-fA-F]{64}$/))
    try holds(() => assert.strictEqual(base64Bytes(first.values.CLOUD_SEALING_KEY ?? ""), 32))
    try holds(() => assert.ok(secretProblems({ ...first.values, GOOGLE_CONNECT_TOKEN_KEY: "not-a-64-hex-token-key-even-if-32-bytes-base64url-abcdef" }, "staging").some((p) => p.includes("GOOGLE_CONNECT_TOKEN_KEY"))))
    try holds(() => assert.ok(secretProblems({ ...first.values, CLOUD_SEALING_KEY: oversizedKey() }, "staging").some((p) => p.includes("CLOUD_SEALING_KEY"))))
    const base64urlSealing = `${(first.values.CLOUD_SEALING_KEY ?? "").slice(0, 40)}-_${(first.values.CLOUD_SEALING_KEY ?? "").slice(40)}`
    try holds(() => assert.ok(secretProblems({ ...first.values, CLOUD_SEALING_KEY: base64urlSealing }, "staging").some((p) => p.includes("CLOUD_SEALING_KEY"))))
    try holds(() => assert.ok(secretProblems({ ...first.values, CLOUD_ENTITLEMENT_KEY: "not-a-der-key" }, "staging").some((p) => p.includes("CLOUD_ENTITLEMENT_KEY"))))
    try holds(() => assert.ok(secretProblems({ ...first.values, CLOUD_ENTITLEMENT_KEY: p384Key() }, "staging").some((p) => p.includes("CLOUD_ENTITLEMENT_KEY"))))
    const candidateProfile = try profileNamed("candidate")
    try holds(() => assert.ok(candidateProfile.environments.staging.entitlement.publicKeys.some(isExampleEntitlementPublicKey)))
    try holds(() => assert.strictEqual(entitlementPublicKeyMatches(first.values.CLOUD_ENTITLEMENT_KEY ?? "", candidateProfile.environments.staging.entitlement.publicKeys, candidateProfile.environments.staging.entitlement.keyId), false))
    const exampleRejected = deploy({ environment: "staging", profile: "profile/candidate.example.json", secrets: file, component: "all" }) catch (failure) => failure._tag === "OperatorFailed" ? failure.problem : failure._tag
    try holds(() => assert.ok(typeof exampleRejected === "string" && exampleRejected.includes("placeholder entitlement public key")))
    const badKeyFile = path.join(directory, "bad-entitlement.env")
    try files.writeFileString(badKeyFile, Object.entries({ ...first.values, CLOUD_ENTITLEMENT_KEY: "not-a-key" }).map(([name, value]) => `${name}=${value}`).join("\n"), { mode: 0o600 })
    const badVault = try effect {
      provide rollout() {
        const machine = try Rollout
        const failed = (settledSecrets(badKeyFile, "staging") catch (failure) => failure._tag)
        return { failed, vault: (try machine.get()).vault }
      }
    }
    try holds(() => assert.deepStrictEqual(badVault, { failed: "OperatorFailed", vault: "Incomplete" }))
    const symlinked = path.join(directory, "escape.env")
    try files.symlink(path.join(path.dirname(import.meta.dirname), "inside-symlink.env"), symlinked)
    const escaped = readSecrets(symlinked) catch (failure) => failure._tag
    try holds(() => assert.strictEqual(escaped, "OperatorFailed"))
    const unprovisionedResources = path.join(directory, "unprovisioned-resources.json")
    try files.writeFileString(unprovisionedResources, JSON.stringify({ ...resources, staging: { ...resources.staging, accountId: "PENDING", hyperdriveId: "PENDING" } }))
    const unprovisionedApply = operate("secrets", ["--environment", "staging", "--env-file", file, "--resources", unprovisionedResources, "--apply"]) catch (failure) => failure._tag === "OperatorFailed" ? failure.problem : failure._tag
    try holds(() => assert.ok(typeof unprovisionedApply === "string" && /account|provision/i.test(unprovisionedApply), String(unprovisionedApply)))
    const wrongModePrices = operate("prices", ["--environment", "production", "--profile", "profile/candidate.example.json", "--env-file", file]) catch (failure) => failure._tag === "OperatorFailed" ? failure.problem : failure._tag
    try holds(() => assert.ok(typeof wrongModePrices === "string" && wrongModePrices.includes("STRIPE_SECRET_KEY"), String(wrongModePrices)))
  } |> scoped(%) |> Effect.provide(%, [NodeServices.layer, FetchHttpClient.layer]))
})

describe(`Provisioning creates only what is missing (spec/cloud/rollout.md, "Story: Create an environment's Cloudflare resources once")`, () => {
  it.effect("creates the database binding once, finds it again by name on a rerun, records it, and refuses a binding that is not the one recorded", () => effect {
    const account = resources.production.accountId
    const cloudflare = try acquireRelease(tryPromise(() => startCloudflare({ account, zone: "alphaphone.dev", token: "cf-token" })), (started) => promise(() => started.stop()))
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const ids = { ...resources.staging }
    const at = { ids, sibling: resources.production, apiHost: "api-staging.alphaphone.dev", webHost: "cloud-staging.alphaphone.dev", databaseUrl: provided.DATABASE_URL, accountId: account, token: "cf-token", base: cloudflare.base }
    const preflight = (reconcileResources({ ...at, creating: false }) catch (failure) => failure.problem)
    try holds(() => assert.strictEqual(preflight, "record the account and Hyperdrive IDs (provision --write) before deploying"))
    const created = try reconcileResources({ ...at, creating: true })
    const again = try reconcileResources({ ...at, creating: true })
    try holds(() => assert.deepStrictEqual([cloudflare.hyperdrives.length, again, cloudflare.hyperdrives[0]?.caching.disabled], [1, created, true]))
    try holds(() => assert.notStrictEqual(created.hyperdriveId, ids.hyperdriveId))
    const directory = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-resources-" })
    const file = path.join(directory, "resources.json")
    try files.writeFileString(file, JSON.stringify(resources))
    try recordResources(file, "staging", ids, created)
    const text = try files.readFileString(file)
    const recorded = (try Effect.try(() => JSON.parse(text) as typeof resources)).staging
    const rechecked = try reconcileResources({ ...at, ids: created, creating: false })
    try holds(() => assert.deepStrictEqual([recorded, rechecked], [created, created]))
    const foreign = (reconcileResources({ ...at, ids: { ...created, hyperdriveId: "c".repeat(32) }, creating: false }) catch (failure) => failure.problem)
    try holds(() => assert.strictEqual(foreign, "the Hyperdrive alpha-test-api-staging-db is not the one recorded"))
    const fullPage = Array.from({ length: 50 }, (_, index) => ({
      id: (index + 100).toString(16).padStart(32, "d"),
      name: index === 0 ? `${at.ids.workerName}-db` : `other-db-${index}`,
      origin: { scheme: "postgres", host: "DB.EXAMPLE", port: 5432, database: "alpha", user: "alpha" },
      caching: { disabled: true },
    }))
    const cfFifty = try acquireRelease(tryPromise(() => startCloudflare({ account, zone: "alphaphone.dev", token: "cf-token", hyperdrives: fullPage })), (started) => promise(() => started.stop()))
    const fiftyIds = { ...created, hyperdriveId: fullPage[0]!.id }
    const checkedFifty = try reconcileResources({ ...at, ids: fiftyIds, creating: false, base: cfFifty.base })
    try holds(() => assert.deepStrictEqual(checkedFifty, fiftyIds))
  } |> scoped(%) |> Effect.provide(%, [NodeServices.layer, FetchHttpClient.layer]), 30_000)
})

describe(`A deployed environment is ready when every public gate passes (spec/cloud/rollout.md, "Story: Tell whether a deployed environment is ready")`, () => {
  it.live(`checks Alpha Cloud's staged prices and serves every public gate through the API host and web host Worker (spec/cloud/provisioning.md, "The steps run in one order, the same for staging and production, each one command")`, () => effect {
    const files = try FileSystem.FileSystem
    const cloud = try Effect.try(() => prepared().cloud)
    const profile = try profileNamed("candidate")
    const settings = profile.environments.staging
    const prices = try acquireRelease(tryPromise(() => catalog(settings.billing!.plans)), (opened) => promise(() => opened.close()))
    const run = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-hosted-" })
    const priced = { ...settings, billing: { ...settings.billing!, apiUrl: prices.origin } }
    const local = { ...priced, mail: { kind: "loopback" as const } }
    try files.writeFileString(`${run}/profile.json`, JSON.stringify({ ...profile, environments: { ...profile.environments, staging: local } }))
    try files.writeFileString(`${run}/seed.json`, JSON.stringify({ clients: [entryOf(registrationOn(profile, "staging"))] }))
    const fixture = try files.readFileString(`${cloud}/test/fixtures/secrets.env`)
    const profileFile = `${run}/operator-profile.json`
    const secretsFile = `${run}/secrets.env`
    const store = `pglite:${run}/cloud.pglite`
    const values = { ...provided, DATABASE_URL: store, STRIPE_SECRET_KEY: "sk_test_local" }
    const flags = ["--environment", "staging", "--profile", profileFile, "--env-file", secretsFile]
    try files.writeFileString(profileFile, JSON.stringify({ ...profile, environments: { ...profile.environments, staging: priced } }))
    try files.writeFileString(secretsFile, [fixture, ...Object.entries(values).map(([name, value]) => `${name}=${value}`)].join("\n") + "\n", { mode: 0o600 })
    try operate("migrate", flags)
    const secrets = try readSecrets(secretsFile)
    for (const model of settings.inference!.models) {
      try elizaosCloud(["prices", "set", "--model", model.id, "--input-per-1k", "150", "--output-per-1k", "600", "--profile", profileFile, "--environment", "staging", "--store", store], secrets)
    }
    try operate("prices", flags)
    const origin = try serving(cloud, run)
    const reach = hosting(origin, { api: settings.api, web: settings.web })
    const gates = try (smoke("staging", { api: settings.api, web: settings.web }, settings.name) |> Effect.provide(%, FetchHttpClient.layer) |> Effect.provideService(%, FetchHttpClient.Fetch, reach))
    try holds(() => assert.deepStrictEqual(gates.filter((gate) => !gate.passed), []))
    try holds(() => assert.strictEqual(gates.length, 8))
  } |> scoped(%) |> Effect.provide(%, NodeServices.layer), 600_000)
})

describe(`Alpha's app is registered with each cloud it talks to (spec/cloud/index.md, "Story: Register Alpha's app with the cloud")`, () => {
  it.effect("registers Alpha's package once per hosted environment at its App Link host, with the release signer in production and its returns off the API origin, and serves asset links that name it alone", () => effect {
    const profile = try profileNamed("candidate")
    for (const [name, environment] of [["staging", "Staging"], ["production", "Production"]] as const) {
      const row = try deployment(name)
      if (row.kind !== "hosted") throw new NotHosted({ name })
      const settings = profile.environments[name]
      try holds(() => assert.ok(profileFits(row, { api: settings.api, webHost: settings.web.replace(/^https:\/\//, "") }), `${name}: the profile answers at its deployment's cloud`))
      const registration = registrationAt(environment, row.appLinkHost)
      try holds(() => assert.deepStrictEqual(
        [registration.clientId, registration.androidPackage, registration.displayName, registration.certFingerprints[0], registration.signInReturn, registration.billingReturn],
        [alphaPackage, alphaPackage, alphaName, releaseSigner, { origin: `https://${row.appLinkHost}`, path: "/alphaphone/auth/callback" }, { origin: `https://${row.appLinkHost}`, path: "/alphaphone/billing/return" }]))
      try holds(() => assert.ok(returnsOffApi(registration, settings.api)))
      const links = try assetLinks(registration, settings.api)
      try holds(() => assert.ok(assetLinksNameAlpha(links, environment)))
      const debugSigned = { ...registration, certFingerprints: [...registration.certFingerprints, "00:".repeat(31) + "00"] }
      const debugLinks = try assetLinks(debugSigned, settings.api)
      try holds(() => assert.ok(!assetLinksNameAlpha(debugLinks, environment), `${name}: a signer the environment does not trust is refused`))
    }
  } |> Effect.provide(%, NodeServices.layer))
})

describe(`Alpha's return page hands an authorization back to the app (spec/cloud/index.md, "Story: Come back to Alpha after authorizing a connection in my browser")`, () => {
  const page = "../app/public/delegation-return.html"

  it.effect(`runs one inline script its policy names by hash, sends no referrer and loads nothing else (spec/cloud/index.md, "The return page runs only its own hashed script, sends no referrer and loads nothing else")`, () => effect {
    const parts = returnPageParts(try (try FileSystem.FileSystem).readFileString(page))
    try holds(() => assert.deepStrictEqual([parts.scripts.length, parts.scripts[0]?.attributes, parts.policies], [1, "", 1]))
    try holds(() => assert.deepStrictEqual(
      [parts.policy["script-src"], parts.policy["default-src"], parts.policy["base-uri"], parts.policy["form-action"], parts.noReferrer, parts.loads],
      [parts.hashes, ["'none'"], ["'none'"], ["'none'"], true, 0]))
    try holds(() => assert.ok(returnPageSealed({
      scripts: parts.scripts.length,
      onlyItsHash: parts.scripts[0]?.attributes === "" && JSON.stringify(parts.policy["script-src"]) === JSON.stringify(parts.hashes),
      sendsReferrer: !parts.noReferrer,
      loads: parts.loads,
    })))
  } |> Effect.provide(%, NodeServices.layer))

  it.effect(`clears its address and offers Alpha's link only for a well-formed return with one result (spec/cloud/index.md, "The return page clears the query from its address, and hands back only a well-formed return with exactly one result")`, () => effect {
    const [script] = returnPageParts(try (try FileSystem.FileSystem).readFileString(page)).scripts
    const state = "A".repeat(43)
    const well = { given: 2, repeated: false, unknown: false, stateValid: true, hasCode: true, codeFits: true, hasError: false, hasDescription: false, descriptionFits: true }
    const cases = [
      { query: `?state=${state}&code=granted`, shape: well, link: `alphaphone://cloud-delegation?state=${state}&code=granted` },
      { query: `?state=${state}&error=access_denied&error_description=declined`, shape: { ...well, given: 3, hasCode: false, hasError: true, hasDescription: true }, link: `alphaphone://cloud-delegation?state=${state}&error=access_denied` },
      { query: "", shape: { ...well, given: 0, hasCode: false, stateValid: false }, link: undefined },
      { query: `?state=${state}&code=granted&error=access_denied`, shape: { ...well, given: 3, hasError: true }, link: undefined },
      { query: `?state=${state}&code=granted&code=again`, shape: { ...well, given: 3, repeated: true }, link: undefined },
      { query: `?state=${state}&code=granted&next=elsewhere`, shape: { ...well, given: 3, unknown: true }, link: undefined },
      { query: `?state=short&code=granted`, shape: { ...well, stateValid: false }, link: undefined },
      { query: `?state=${state}&code=${"c".repeat(4097)}`, shape: { ...well, codeFits: false }, link: undefined },
      { query: `?state=${state}&code=granted&error_description=stray`, shape: { ...well, given: 3, hasDescription: true }, link: undefined },
      { query: `?state=${state}&error=access_denied&error_description=${"d".repeat(2001)}`, shape: { ...well, given: 3, hasCode: false, hasError: true, hasDescription: true, descriptionFits: false }, link: undefined },
    ]
    for (const { query, shape, link } of cases) {
      const shown = returnPageAt(script?.text ?? "", `https://return.alpha.test/delegation-return.html${query}`)
      const answer = returnAnswer(shape)
      try holds(() => assert.strictEqual(shown.address, "https://return.alpha.test/delegation-return.html", query))
      try holds(() => assert.strictEqual(shown.link, link, query))
      try holds(() => assert.strictEqual(shown.link !== undefined, answer === "Continue" || answer === "Cancelled", query))
      try holds(() => assert.strictEqual(/reopened/.test(shown.message), answer === "Reopened", query))
      try holds(() => assert.strictEqual(/cancelled/.test(shown.message), answer === "Cancelled", query))
    }
  } |> Effect.provide(%, NodeServices.layer))
})
