// The same token is never opened twice: once a tap's run is opened the adapter records
// `opened := token`; every later check of that token consumes only, until the consume succeeds.
lemma readyTapStep_neverOpensTwice(token: string)
  ensures readyTapStep(token, Some(token)) == "consume-only"
  ensures readyTapStep(token, Some(token)) != "open"
{
}

// 'open' is returned exactly for a token that is not the opened one.
lemma readyTapStep_total(token: string, opened_: Option<string>)
  ensures readyTapStep(token, opened_) == "consume-only" || readyTapStep(token, opened_) == "open"
  ensures readyTapStep(token, opened_) == "open" <==> opened_ != Some(token)
{
}

// Totality and priority over the four inputs, stated pointwise.
lemma tapRecheck_table()
  ensures tapRecheck(TapRecheckState(true, true)) == "after-operation"
  ensures tapRecheck(TapRecheckState(true, false)) == "after-operation"
  ensures tapRecheck(TapRecheckState(false, true)) == "now"
  ensures tapRecheck(TapRecheckState(false, false)) == "none"
{
}

// A running operation wins whatever the generation did.
lemma tapRecheck_priority(state: TapRecheckState)
  requires state.operationRunning
  ensures tapRecheck(state) == "after-operation"
{
}
