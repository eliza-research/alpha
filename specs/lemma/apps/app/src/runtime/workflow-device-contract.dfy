datatype Option<T> = None | Some(value: T)

datatype TapRecheckState = TapRecheckState(operationRunning: bool, generationChanged: bool)

function readyTapStep(token: string, opened_: Option<string>): string
{
  if (match opened_ { case Some(i_value) => (i_value == token) case None => false }) then
    "consume-only"
  else
    "open"
}

lemma readyTapStep_ensures(token: string, opened_: Option<string>)
  ensures ((readyTapStep(token, opened_) == "consume-only") <==> (match opened_ { case Some(i_value) => (i_value == token) case None => false }))
  ensures ((match opened_ { case Some(i_) => false case None => true }) ==> (readyTapStep(token, opened_) == "open"))
{
}

function tapRecheck(state: TapRecheckState): string
{
  if state.operationRunning then
    "after-operation"
  else
    if state.generationChanged then
      "now"
    else
      "none"
}

lemma tapRecheck_ensures(state: TapRecheckState)
  ensures (((tapRecheck(state) == "after-operation") || (tapRecheck(state) == "now")) || (tapRecheck(state) == "none"))
  ensures ((tapRecheck(state) == "after-operation") <==> state.operationRunning)
  ensures ((tapRecheck(state) == "now") <==> (!(state.operationRunning) && state.generationChanged))
  ensures ((tapRecheck(state) == "none") <==> (!(state.operationRunning) && !(state.generationChanged)))
{
}

