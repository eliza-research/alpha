  ensures ((maximum >= 0) ==> (sizeFrom(rows, res, size) <= maximum))
  ensures (((res == 0) || (sizeFrom(rows, (res - 1), size) > maximum)) || (maximum < 0))
  ensures (((res == 0) || (maximum < 0)) || ((size(rows[(res - 1)]) + sizeFrom(rows, res, size)) > maximum))
{
  var total := 0;
