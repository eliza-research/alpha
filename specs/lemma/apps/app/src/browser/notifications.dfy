// Generated by lsc from notifications.ts
// lsc options: string-semantics=javascript-utf16

datatype Option<T> = None | Some(value: T)

datatype Identity = Identity(id: string, revision: string, source: Option<string>)

function noticeRoute(input: Identity): string
{
  if (|input.id| >= |"focus:"| && input.id[..|"focus:"|] == "focus:") then
    "focus"
  else
    if ((match input.source { case Some(i_value) => (i_value == "own") case None => false }) && (|input.id| >= |"workflow:"| && input.id[..|"workflow:"|] == "workflow:")) then
      "workflow"
    else
      if (match input.source { case Some(i_value) => (i_value == "hosted") case None => false }) then
        "hosted"
      else
        if (match input.source { case Some(i_value) => (i_value == "external") case None => false }) then
          "external"
        else
          if (|input.id| >= |"calendar:"| && input.id[..|"calendar:"|] == "calendar:") then
            "calendar"
          else
            "reminder"
}

lemma noticeRoute_ensures(input: Identity)
  ensures ((((((noticeRoute(input) == "focus") || (noticeRoute(input) == "workflow")) || (noticeRoute(input) == "hosted")) || (noticeRoute(input) == "external")) || (noticeRoute(input) == "calendar")) || (noticeRoute(input) == "reminder"))
  ensures ((|input.id| >= |"focus:"| && input.id[..|"focus:"|] == "focus:") <==> (noticeRoute(input) == "focus"))
  ensures ((noticeRoute(input) == "workflow") ==> ((match input.source { case Some(i_value) => (i_value == "own") case None => false }) && (|input.id| >= |"workflow:"| && input.id[..|"workflow:"|] == "workflow:")))
  ensures ((noticeRoute(input) == "hosted") ==> (match input.source { case Some(i_value) => (i_value == "hosted") case None => false }))
  ensures ((noticeRoute(input) == "external") ==> (match input.source { case Some(i_value) => (i_value == "external") case None => false }))
  ensures ((noticeRoute(input) == "calendar") ==> (|input.id| >= |"calendar:"| && input.id[..|"calendar:"|] == "calendar:"))
  ensures (!((|input.id| >= |"focus:"| && input.id[..|"focus:"|] == "focus:")) ==> (match input.source { case Some(i_value) => (i_value == "hosted") case None => false }) ==> (noticeRoute(input) == "hosted"))
  ensures (!((|input.id| >= |"focus:"| && input.id[..|"focus:"|] == "focus:")) ==> (match input.source { case Some(i_value) => (i_value == "external") case None => false }) ==> (noticeRoute(input) == "external"))
  ensures (!((|input.id| >= |"focus:"| && input.id[..|"focus:"|] == "focus:")) ==> (match input.source { case Some(i_value) => (i_value == "own") case None => false }) ==> (|input.id| >= |"workflow:"| && input.id[..|"workflow:"|] == "workflow:") ==> (noticeRoute(input) == "workflow"))
{
}

method retainDismissed(dismissed: seq<string>, live: set<string>, limit: int) returns (res: seq<string>)
  requires (limit >= 0)
  ensures (|res| <= limit)
  ensures ((|dismissed| <= limit) ==> (res == dismissed))
  ensures (res == RetainSpec(dismissed, live, limit))
{
  var excess := (|dismissed| - limit);
  if (excess <= 0) {
    return dismissed;
  }
  var kept: seq<string> := [];
  var i := 0;
  while (i < |dismissed|)
    invariant (0 <= i)
    invariant (i <= |dismissed|)
    invariant (excess >= 0)
    invariant ((((|kept| + |dismissed|) - i) - excess) == limit)
    invariant (Then(kept, DropGone(dismissed[i..], live, excess)) == DropGone(dismissed, live, (|dismissed| - limit)))
  {
    var mark := dismissed[i];
    if ((excess > 0) && !((mark in live))) {
      excess := (excess - 1);
    } else {
      kept := (kept + [mark]);
    }
    i := (i + 1);
  }
  return kept[(|kept| - limit)..];
}

// ---- Hand-written specification and proofs for retainDismissed ----

// Marks whose notice is no longer posted.
function Gone(s: seq<string>, live: set<string>): nat
{
  if |s| == 0 then 0 else (if s[0] in live then 0 else 1) + Gone(s[1..], live)
}

// Marks whose notice is still posted, in their original order.
function Live(s: seq<string>, live: set<string>): seq<string>
{
  if |s| == 0 then [] else (if s[0] in live then [s[0]] else []) + Live(s[1..], live)
}

// s without its n oldest marks whose notice is gone.
function DropGone(s: seq<string>, live: set<string>, n: int): seq<string>
  decreases |s|
{
  if |s| == 0 then []
  else if n > 0 && s[0] !in live then DropGone(s[1..], live, n - 1)
  else [s[0]] + DropGone(s[1..], live, n)
}

function Then(a: seq<string>, b: seq<string>): seq<string>
{
  a + b
}

// The n newest marks of s.
function Newest(s: seq<string>, n: int): seq<string>
{
  if n <= 0 then [] else if |s| <= n then s else s[|s| - n..]
}

// What retainDismissed returns, as a function.
function RetainSpec(dismissed: seq<string>, live: set<string>, limit: int): seq<string>
{
  if |dismissed| <= limit then dismissed
  else Newest(DropGone(dismissed, live, |dismissed| - limit), limit)
}

// a is b with some elements removed: order kept, nothing invented.
predicate Subseq(a: seq<string>, b: seq<string>)
{
  |a| == 0 || (|b| > 0 && ((a[0] == b[0] && Subseq(a[1..], b[1..])) || Subseq(a, b[1..])))
}

lemma SubseqRefl(a: seq<string>)
  ensures Subseq(a, a)
{
}

lemma SubseqDropPrefix(a: seq<string>, b: seq<string>, k: int)
  requires Subseq(a, b)
  requires 0 <= k <= |a|
  ensures Subseq(a[k..], b)
  decreases |b|
{
  if k == 0 {
    assert a[k..] == a;
  } else if |a[k..]| == 0 {
  } else {
    if a[0] == b[0] && Subseq(a[1..], b[1..]) {
      SubseqDropPrefix(a[1..], b[1..], k - 1);
      assert a[1..][k - 1..] == a[k..];
    } else {
      SubseqDropPrefix(a, b[1..], k);
    }
  }
}

lemma LiveGoneLength(s: seq<string>, live: set<string>)
  ensures |Live(s, live)| + Gone(s, live) == |s|
{
}

lemma DropGoneLength(s: seq<string>, live: set<string>, n: int)
  ensures n <= 0 ==> DropGone(s, live, n) == s
  ensures 0 <= n <= Gone(s, live) ==> |DropGone(s, live, n)| == |s| - n
  ensures n >= Gone(s, live) ==> DropGone(s, live, n) == Live(s, live)
  decreases |s|
{
  if |s| != 0 {
    DropGoneLength(s[1..], live, n);
    DropGoneLength(s[1..], live, n - 1);
  }
}

lemma DropGoneSubseq(s: seq<string>, live: set<string>, n: int)
  ensures Subseq(DropGone(s, live, n), s)
  decreases |s|
{
  if |s| != 0 {
    if n > 0 && s[0] !in live {
      DropGoneSubseq(s[1..], live, n - 1);
    } else {
      DropGoneSubseq(s[1..], live, n);
      assert DropGone(s, live, n)[1..] == DropGone(s[1..], live, n);
    }
  }
}

lemma DropGoneLive(s: seq<string>, live: set<string>, n: int)
  ensures Live(DropGone(s, live, n), live) == Live(s, live)
  decreases |s|
{
  if |s| != 0 {
    if n > 0 && s[0] !in live {
      DropGoneLive(s[1..], live, n - 1);
    } else {
      DropGoneLive(s[1..], live, n);
      assert DropGone(s, live, n)[1..] == DropGone(s[1..], live, n);
    }
  }
}

// Removal is oldest-first: once n gone marks have been passed, every later mark is kept as is,
// and before that point exactly the live marks survive.
lemma DropGoneOldestFirst(s: seq<string>, live: set<string>, n: int, k: int)
  requires 0 <= k <= |s|
  requires n >= 0
  requires Gone(s[..k], live) == n
  ensures DropGone(s, live, n) == Live(s[..k], live) + s[k..]
  decreases |s|
{
  if k == 0 {
    assert s[k..] == s;
    DropGoneLength(s, live, n);
  } else {
    assert s[..k][1..] == s[1..][..k - 1];
    assert s[k..] == s[1..][k - 1..];
    if s[0] !in live {
      DropGoneOldestFirst(s[1..], live, n - 1, k - 1);
    } else {
      DropGoneOldestFirst(s[1..], live, n, k - 1);
    }
  }
}

// The result never exceeds the limit, and an input within the limit is returned unchanged.
lemma RetainBound(dismissed: seq<string>, live: set<string>, limit: int)
  requires limit >= 0
  ensures |RetainSpec(dismissed, live, limit)| <= limit
  ensures |dismissed| <= limit ==> RetainSpec(dismissed, live, limit) == dismissed
{
}

// The result is the input with marks removed: order kept, nothing invented.
lemma RetainSubseq(dismissed: seq<string>, live: set<string>, limit: int)
  ensures Subseq(RetainSpec(dismissed, live, limit), dismissed)
{
  if |dismissed| <= limit {
    SubseqRefl(dismissed);
  } else {
    var kept := DropGone(dismissed, live, |dismissed| - limit);
    DropGoneSubseq(dismissed, live, |dismissed| - limit);
    if limit <= 0 {
    } else if |kept| <= limit {
    } else {
      SubseqDropPrefix(kept, dismissed, |kept| - limit);
    }
  }
}

// While the live marks fit within the limit none of them is removed: only the oldest gone
// marks go, exactly as many as needed.
lemma RetainKeepsLive(dismissed: seq<string>, live: set<string>, limit: int)
  requires |Live(dismissed, live)| <= limit < |dismissed|
  ensures RetainSpec(dismissed, live, limit) == DropGone(dismissed, live, |dismissed| - limit)
  ensures |RetainSpec(dismissed, live, limit)| == limit
  ensures Live(RetainSpec(dismissed, live, limit), live) == Live(dismissed, live)
{
  LiveGoneLength(dismissed, live);
  DropGoneLength(dismissed, live, |dismissed| - limit);
  DropGoneLive(dismissed, live, |dismissed| - limit);
}

// A live mark is removed only when the live marks alone exceed the limit; then every gone
// mark is removed and the newest live marks are kept.
lemma RetainNewestLive(dismissed: seq<string>, live: set<string>, limit: int)
  requires 0 <= limit < |Live(dismissed, live)|
  ensures RetainSpec(dismissed, live, limit) == Newest(Live(dismissed, live), limit)
{
  LiveGoneLength(dismissed, live);
  DropGoneLength(dismissed, live, |dismissed| - limit);
}

// Gone marks are removed oldest-first: with k the point where the excess is used up, the
// result is the live marks before k followed by everything from k on.
lemma RetainOldestFirst(dismissed: seq<string>, live: set<string>, limit: int, k: int)
  requires 0 <= limit < |dismissed|
  requires 0 <= k <= |dismissed|
  requires Gone(dismissed[..k], live) == |dismissed| - limit
  ensures RetainSpec(dismissed, live, limit) == Live(dismissed[..k], live) + dismissed[k..]
{
  DropGoneOldestFirst(dismissed, live, |dismissed| - limit, k);
  LiveGoneLength(dismissed[..k], live);
}
