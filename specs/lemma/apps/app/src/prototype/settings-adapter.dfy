datatype Option<T> = None | Some(value: T)

function SeqFilter<T(!new)>(p: T -> bool, xs: seq<T>): seq<T>
  ensures |SeqFilter(p, xs)| <= |xs|
  ensures forall x :: x in SeqFilter(p, xs) <==> x in xs && p(x)
  decreases |xs|
{
  if |xs| == 0 then []
  else (if p(xs[0]) then [xs[0]] else []) + SeqFilter(p, xs[1..])
}

datatype UpdateIdleFacts = UpdateIdleFacts(voiceInactive: bool, home: bool, view: bool, voiceOff: bool, typing: bool, chatResting: bool, drawer: bool, shade: bool, homeEdit: bool, homeAdd: bool, drawerMenu: bool, busy: bool, open: bool, editor: bool)

datatype NavigationRow = NavigationRow(label_: Option<string>, lbl: Option<string>)

function updateCheckDue(checkedAt: int, now: int): bool
{
  !(((now >= checkedAt) && ((now - checkedAt) < UPDATE_CHECK_INTERVAL_MS)))
}

lemma updateCheckDue_ensures(checkedAt: int, now: int)
  ensures (updateCheckDue(checkedAt, now) <==> ((now < checkedAt) || ((now - checkedAt) >= UPDATE_CHECK_INTERVAL_MS)))
  ensures ((now < checkedAt) ==> updateCheckDue(checkedAt, now))
  ensures (!(updateCheckDue(checkedAt, now)) ==> ((0 <= (now - checkedAt)) && ((now - checkedAt) < UPDATE_CHECK_INTERVAL_MS)))
{
}

function updateIdle(facts: UpdateIdleFacts): bool
{
  (((((((((((((facts.voiceInactive && facts.home) && !(facts.view)) && facts.voiceOff) && !(facts.typing)) && facts.chatResting) && !(facts.drawer)) && !(facts.shade)) && !(facts.homeEdit)) && !(facts.homeAdd)) && !(facts.drawerMenu)) && !(facts.busy)) && !(facts.open)) && !(facts.editor))
}

lemma updateIdle_ensures(facts: UpdateIdleFacts)
  ensures (updateIdle(facts) ==> (facts.voiceInactive && facts.voiceOff))
  ensures (updateIdle(facts) ==> (facts.home && !(facts.view)))
  ensures (updateIdle(facts) ==> ((!(facts.typing) && facts.chatResting) && !(facts.editor)))
