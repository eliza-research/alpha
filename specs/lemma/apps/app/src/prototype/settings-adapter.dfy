  ensures (updateIdle(facts) ==> (!(facts.homeEdit) && !(facts.homeAdd)))
  ensures (updateIdle(facts) ==> (!(facts.busy) && !(facts.open)))
  ensures (facts.voiceInactive ==> facts.voiceOff ==> facts.home ==> !(facts.view) ==> !(facts.typing) ==> facts.chatResting ==> !(facts.editor) ==> !(facts.drawer) ==> !(facts.shade) ==> !(facts.drawerMenu) ==> !(facts.homeEdit) ==> !(facts.homeAdd) ==> !(facts.busy) ==> !(facts.open) ==> updateIdle(facts))
{
}

function settingsPage(page: Option<string>, developerSurfaces: bool): Option<string>
{
  if (((match page { case Some(i_value) => (i_value == "developer") case None => false }) || (match page { case Some(i_value) => (i_value == "character") case None => false })) && !(developerSurfaces)) then
    Option.None
  else
    page
}

lemma settingsPage_ensures(page: Option<string>, developerSurfaces: bool)
  ensures (!(developerSurfaces) ==> ((match settingsPage(page, developerSurfaces) { case Some(i_value) => (i_value != "developer") case None => true }) && (match settingsPage(page, developerSurfaces) { case Some(i_value) => (i_value != "character") case None => true })))
  ensures (developerSurfaces ==> (settingsPage(page, developerSurfaces) == page))
  ensures ((match page { case Some(i_value) => (i_value != "developer") case None => true }) ==> (match page { case Some(i_value) => (i_value != "character") case None => true }) ==> (settingsPage(page, developerSurfaces) == page))
  ensures (!(developerSurfaces) ==> ((match page { case Some(i_value) => (i_value == "developer") case None => false }) || (match page { case Some(i_value) => (i_value == "character") case None => false })) ==> (match settingsPage(page, developerSurfaces) { case Some(i_) => false case None => true }))
{
}

function settingsNavigationRows(rows: seq<NavigationRow>, developerSurfaces: bool): seq<NavigationRow>
{
  if developerSurfaces then
    rows
  else
    SeqFilter((row: NavigationRow) => ((match row.label_ { case Some(i_value) => (i_value != "Developer") case None => true }) && (match row.lbl { case Some(i_value) => (i_value != "Developer") case None => true })), rows)
}

lemma settingsNavigationRows_ensures(rows: seq<NavigationRow>, developerSurfaces: bool)
  ensures (developerSurfaces ==> (settingsNavigationRows(rows, developerSurfaces) == rows))
  ensures (!(developerSurfaces) ==> forall k: int :: ((0 <= k) ==> (k < |settingsNavigationRows(rows, developerSurfaces)|) ==> ((match settingsNavigationRows(rows, developerSurfaces)[k].label_ { case Some(i_value) => (i_value != "Developer") case None => true }) && (match settingsNavigationRows(rows, developerSurfaces)[k].lbl { case Some(i_value) => (i_value != "Developer") case None => true }))))
{
}

const UPDATE_CHECK_INTERVAL_MS: int := ((15 * 60) * 1000)

// Hand-written: exactly which rows settingsNavigationRows keeps and drops.

predicate DeveloperRow(row: NavigationRow)
{
  row.label_ == Some("Developer") || row.lbl == Some("Developer")
}

function DeveloperRowCount(rows: seq<NavigationRow>): nat
{
  if |rows| == 0 then 0 else (if DeveloperRow(rows[0]) then 1 else 0) + DeveloperRowCount(rows[1..])
}

// `part` is `whole` with some elements removed and the order kept.
predicate Subsequence<T(==)>(part: seq<T>, whole: seq<T>)
{
  if |part| == 0 then true
  else if |whole| == 0 then false
  else if part[0] == whole[0] && Subsequence(part[1..], whole[1..]) then true
  else Subsequence(part, whole[1..])
}

lemma SubsequenceOfItself<T>(rows: seq<T>)
  ensures Subsequence(rows, rows)
{
}

lemma settingsNavigationRows_step(rows: seq<NavigationRow>)
  requires |rows| > 0
  ensures settingsNavigationRows(rows, false) ==
    (if DeveloperRow(rows[0]) then [] else [rows[0]]) + settingsNavigationRows(rows[1..], false)
{
  reveal Std.Collections.Seq.Filter();
}

lemma settingsNavigationRows_shape(rows: seq<NavigationRow>, developerSurfaces: bool)
  ensures Subsequence(settingsNavigationRows(rows, developerSurfaces), rows)
  ensures developerSurfaces ==> settingsNavigationRows(rows, developerSurfaces) == rows
  ensures !developerSurfaces ==> |settingsNavigationRows(rows, developerSurfaces)| == |rows| - DeveloperRowCount(rows)
  ensures !developerSurfaces ==> forall row :: row in settingsNavigationRows(rows, developerSurfaces) ==> !DeveloperRow(row)
  ensures !developerSurfaces ==> forall row :: !DeveloperRow(row) ==>
    multiset(settingsNavigationRows(rows, developerSurfaces))[row] == multiset(rows)[row]
  decreases |rows|
{
  if developerSurfaces {
    SubsequenceOfItself(rows);
  } else if |rows| > 0 {
    settingsNavigationRows_step(rows);
    settingsNavigationRows_shape(rows[1..], false);
    assert rows == [rows[0]] + rows[1..];
    var kept := settingsNavigationRows(rows, false);
    var rest := settingsNavigationRows(rows[1..], false);
    if DeveloperRow(rows[0]) {
      assert kept == rest;
    } else {
      assert kept[0] == rows[0] && kept[1..] == rest;
    }
  }
}
