// Generated by lsc from context-selection.ts
// lsc options: string-semantics=javascript-utf16

datatype Option<T> = None | Some(value: T)

function SeqFilter<T(!new)>(p: T -> bool, xs: seq<T>): seq<T>
  ensures |SeqFilter(p, xs)| <= |xs|
  ensures forall x :: x in SeqFilter(p, xs) <==> x in xs && p(x)
  decreases |xs|
{
  if |xs| == 0 then []
  else (if p(xs[0]) then [xs[0]] else []) + SeqFilter(p, xs[1..])
}

datatype NoticeIdentity = NoticeIdentity(id: string, revision: string, source: string)

datatype CaptureRevisionFields = CaptureRevisionFields(trashed: Option<bool>, revision: string, mutationRevision: Option<string>, contentRevision: Option<string>)

datatype Notice = Notice(id: string, revision: string, source: string, kind: Option<string>, title: Option<string>, text: Option<string>, appLabel: Option<string>)

function noticeCurrent(reviewed: NoticeIdentity, items: Option<seq<Notice>>): bool
{
  match items {
    case Some(i_items_val) =>
      ((|SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), i_items_val)| == 1) && (exists item :: item in i_items_val && (((item.id == reviewed.id) && (item.source == reviewed.source)) && (item.revision == reviewed.revision))))
    case None =>
      false
  }
}

// ---- Hand-written proof support for noticeCurrent ----

// A listed row with the reviewed notice's identity (id and source).
predicate SameNotice(reviewed: NoticeIdentity, item: Notice)
{
  item.id == reviewed.id && item.source == reviewed.source
}

// Row k has the reviewed identity and no other row does.
predicate OnlyAt(reviewed: NoticeIdentity, xs: seq<Notice>, k: int)
{
  0 <= k < |xs| && SameNotice(reviewed, xs[k]) && forall j :: 0 <= j < |xs| && SameNotice(reviewed, xs[j]) ==> j == k
}

// What the number of rows kept by the identity filter says about the list: none kept means
// no row has the identity; one kept means exactly one index has it.
lemma IdentityCount(reviewed: NoticeIdentity, xs: seq<Notice>)
  ensures |SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs)| == 0 <==> forall j :: 0 <= j < |xs| ==> !SameNotice(reviewed, xs[j])
  ensures |SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs)| == 1 <==> exists k :: OnlyAt(reviewed, xs, k)
  decreases |xs|
{
  reveal SeqFilter();
  if |xs| != 0 {
    var tail := xs[1..];
    IdentityCount(reviewed, tail);
    assert forall j :: 0 <= j < |tail| ==> tail[j] == xs[j + 1];
    var all := SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs);
    var rest := SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), tail);
    assert all == (if SameNotice(reviewed, xs[0]) then [xs[0]] else []) + rest;
    if SameNotice(reviewed, xs[0]) {
      assert |all| == 1 + |rest|;
      if |rest| == 0 {
        forall j | 0 <= j < |xs| && SameNotice(reviewed, xs[j]) ensures j == 0 {
          if j > 0 { assert tail[j - 1] == xs[j]; }
        }
        assert OnlyAt(reviewed, xs, 0);
      } else {
        var m :| 0 <= m < |tail| && SameNotice(reviewed, tail[m]);
        assert SameNotice(reviewed, xs[m + 1]);
        forall k | OnlyAt(reviewed, xs, k) ensures false {
          assert k == 0 && m + 1 == k;
        }
      }
    } else {
      assert |all| == |rest|;
      if |rest| == 0 {
        forall j | 0 <= j < |xs| ensures !SameNotice(reviewed, xs[j]) {
          if j > 0 { assert tail[j - 1] == xs[j]; }
        }
      } else {
        var m :| 0 <= m < |tail| && SameNotice(reviewed, tail[m]);
        assert SameNotice(reviewed, xs[m + 1]);
      }
      if |rest| == 1 {
        var k :| OnlyAt(reviewed, tail, k);
        forall j | 0 <= j < |xs| && SameNotice(reviewed, xs[j]) ensures j == k + 1 {
          assert j > 0;
          assert tail[j - 1] == xs[j];
        }
        assert OnlyAt(reviewed, xs, k + 1);
      }
      forall k | OnlyAt(reviewed, xs, k) ensures |rest| == 1 {
        assert k > 0;
        assert SameNotice(reviewed, tail[k - 1]);
        forall j | 0 <= j < |tail| && SameNotice(reviewed, tail[j]) ensures j == k - 1 {
          assert SameNotice(reviewed, xs[j + 1]);
        }
        assert OnlyAt(reviewed, tail, k - 1);
      }
    }
  }
}

// Two rows with the reviewed identity are never counted as one.
lemma IdentityTwice(reviewed: NoticeIdentity, xs: seq<Notice>, a: int, b: int)
  requires 0 <= a < b < |xs|
  requires SameNotice(reviewed, xs[a]) && SameNotice(reviewed, xs[b])
  ensures |SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs)| != 1
{
  IdentityCount(reviewed, xs);
  forall k | OnlyAt(reviewed, xs, k) ensures false {
    assert a == k && b == k;
  }
}

// A current notice passed the identity filter exactly once.
lemma CurrentCountsOne(reviewed: NoticeIdentity, xs: seq<Notice>)
  requires noticeCurrent(reviewed, Some(xs))
  ensures |SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs)| == 1
{
}

// A current notice is listed exactly once and that row carries the reviewed revision.
lemma CurrentSound(reviewed: NoticeIdentity, xs: seq<Notice>)
  requires noticeCurrent(reviewed, Some(xs))
  ensures exists k: int :: ((((((0 <= k) && (k < |xs|)) && (xs[k].id == reviewed.id)) && (xs[k].source == reviewed.source)) && (xs[k].revision == reviewed.revision)) && forall j: int :: ((0 <= j) ==> (j < |xs|) ==> (xs[j].id == reviewed.id) ==> (xs[j].source == reviewed.source) ==> (j == k)))
{
  IdentityCount(reviewed, xs);
  assert |SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs)| == 1;
  var k :| OnlyAt(reviewed, xs, k);
  var item :| item in xs && (((item.id == reviewed.id) && (item.source == reviewed.source)) && (item.revision == reviewed.revision));
  var m :| 0 <= m < |xs| && xs[m] == item;
  assert SameNotice(reviewed, xs[m]);
  assert m == k;
  forall j: int | 0 <= j < |xs| && xs[j].id == reviewed.id && xs[j].source == reviewed.source ensures j == k {
    assert SameNotice(reviewed, xs[j]);
  }
}

// A notice listed exactly once with the reviewed revision is current.
lemma CurrentComplete(reviewed: NoticeIdentity, xs: seq<Notice>)
  requires exists k: int :: ((((((0 <= k) && (k < |xs|)) && (xs[k].id == reviewed.id)) && (xs[k].source == reviewed.source)) && (xs[k].revision == reviewed.revision)) && forall j: int :: ((0 <= j) ==> (j < |xs|) ==> (xs[j].id == reviewed.id) ==> (xs[j].source == reviewed.source) ==> (j == k)))
  ensures noticeCurrent(reviewed, Some(xs))
{
  var k: int :| ((((((0 <= k) && (k < |xs|)) && (xs[k].id == reviewed.id)) && (xs[k].source == reviewed.source)) && (xs[k].revision == reviewed.revision)) && forall j: int :: ((0 <= j) ==> (j < |xs|) ==> (xs[j].id == reviewed.id) ==> (xs[j].source == reviewed.source) ==> (j == k)));
  assert OnlyAt(reviewed, xs, k);
  IdentityCount(reviewed, xs);
  assert |SeqFilter((item: Notice) => ((item.id == reviewed.id) && (item.source == reviewed.source)), xs)| == 1;
  assert xs[k] in xs;
}

// Two rows with the reviewed identity make the notice not current.
lemma CurrentRejectsDuplicates(reviewed: NoticeIdentity, xs: seq<Notice>)
  requires exists j: int, k: int :: (((((((0 <= j) && (j < k)) && (k < |xs|)) && (xs[j].id == reviewed.id)) && (xs[j].source == reviewed.source)) && (xs[k].id == reviewed.id)) && (xs[k].source == reviewed.source))
  ensures !noticeCurrent(reviewed, Some(xs))
{
  var a: int, b: int :| 0 <= a < b < |xs| && xs[a].id == reviewed.id && xs[a].source == reviewed.source && xs[b].id == reviewed.id && xs[b].source == reviewed.source;
  IdentityTwice(reviewed, xs, a, b);
  if noticeCurrent(reviewed, Some(xs)) {
    CurrentCountsOne(reviewed, xs);
  }
}

lemma noticeCurrent_ensures(reviewed: NoticeIdentity, items: Option<seq<Notice>>)
  ensures ((match items { case Some(i_) => false case None => true }) ==> !(noticeCurrent(reviewed, items)))
  ensures (match items { case Some(i_items_val) => ((|i_items_val| == 0) ==> !(noticeCurrent(reviewed, items))) case None => true })
  ensures (noticeCurrent(reviewed, items) ==> (match items { case Some(i_) => true case None => false }))
  ensures (match items { case Some(i_items_val) => (noticeCurrent(reviewed, items) ==> exists k: int :: ((((((0 <= k) && (k < |i_items_val|)) && (i_items_val[k].id == reviewed.id)) && (i_items_val[k].source == reviewed.source)) && (i_items_val[k].revision == reviewed.revision)) && forall j: int :: ((0 <= j) ==> (j < |i_items_val|) ==> (i_items_val[j].id == reviewed.id) ==> (i_items_val[j].source == reviewed.source) ==> (j == k)))) case None => true })
  ensures (match items { case Some(i_items_val) => ((exists j: int, k: int :: (((((((0 <= j) && (j < k)) && (k < |i_items_val|)) && (i_items_val[j].id == reviewed.id)) && (i_items_val[j].source == reviewed.source)) && (i_items_val[k].id == reviewed.id)) && (i_items_val[k].source == reviewed.source))) ==> !(noticeCurrent(reviewed, items))) case None => true })
  ensures (match items { case Some(i_items_val) => ((exists k: int :: ((((((0 <= k) && (k < |i_items_val|)) && (i_items_val[k].id == reviewed.id)) && (i_items_val[k].source == reviewed.source)) && (i_items_val[k].revision == reviewed.revision)) && forall j: int :: ((0 <= j) ==> (j < |i_items_val|) ==> (i_items_val[j].id == reviewed.id) ==> (i_items_val[j].source == reviewed.source) ==> (j == k)))) ==> noticeCurrent(reviewed, items)) case None => true })
{
  match items {
    case Some(xs) =>
      if noticeCurrent(reviewed, items) {
        CurrentSound(reviewed, xs);
      }
      if exists k: int :: ((((((0 <= k) && (k < |xs|)) && (xs[k].id == reviewed.id)) && (xs[k].source == reviewed.source)) && (xs[k].revision == reviewed.revision)) && forall j: int :: ((0 <= j) ==> (j < |xs|) ==> (xs[j].id == reviewed.id) ==> (xs[j].source == reviewed.source) ==> (j == k))) {
        CurrentComplete(reviewed, xs);
      }
      if exists j: int, k: int :: (((((((0 <= j) && (j < k)) && (k < |xs|)) && (xs[j].id == reviewed.id)) && (xs[j].source == reviewed.source)) && (xs[k].id == reviewed.id)) && (xs[k].source == reviewed.source)) {
        CurrentRejectsDuplicates(reviewed, xs);
      }
    case None =>
  }
}

function captureUnchanged(reviewed: CaptureRevisionFields, current: Option<CaptureRevisionFields>): bool
{
  match current {
    case Some(i_current_val) =>
      if ((match i_current_val.trashed { case Some(i_value) => !(i_value) case None => true }) != (match reviewed.trashed { case Some(i_value) => !(i_value) case None => true })) then
        false
      else
        if (match reviewed.mutationRevision { case Some(i_reviewed_mutationRevision_val) => (if (|i_reviewed_mutationRevision_val| > 0) then (match i_current_val.mutationRevision { case Some(i_value) => (i_value != i_reviewed_mutationRevision_val) case None => true }) else (i_current_val.revision != reviewed.revision)) case None => (i_current_val.revision != reviewed.revision) }) then
          false
        else
          ((match reviewed.contentRevision { case Some(i_) => false case None => true }) || (i_current_val.contentRevision == reviewed.contentRevision))
    case None =>
      false
  }
}

lemma captureUnchanged_ensures(reviewed: CaptureRevisionFields, current: Option<CaptureRevisionFields>)
  ensures ((match current { case Some(i_) => false case None => true }) ==> !(captureUnchanged(reviewed, current)))
  ensures ((match current { case Some(i_value) => (i_value == reviewed) case None => false }) ==> captureUnchanged(reviewed, current))
  ensures (match current { case Some(i_current_val) => (captureUnchanged(reviewed, current) ==> ((match i_current_val.trashed { case Some(i_value) => !(i_value) case None => true }) == (match reviewed.trashed { case Some(i_value) => !(i_value) case None => true }))) case None => true })
  ensures (match current { case Some(i_current_val) => (match reviewed.mutationRevision { case Some(i_reviewed_mutationRevision_val) => (captureUnchanged(reviewed, current) ==> (i_reviewed_mutationRevision_val != "") ==> (match i_current_val.mutationRevision { case Some(i_value) => (i_value == i_reviewed_mutationRevision_val) case None => false })) case None => true }) case None => true })
  ensures (match current { case Some(i_current_val) => (captureUnchanged(reviewed, current) ==> ((match reviewed.mutationRevision { case Some(i_) => false case None => true }) || (match reviewed.mutationRevision { case Some(i_value) => (i_value == "") case None => false })) ==> (i_current_val.revision == reviewed.revision)) case None => true })
  ensures (match current { case Some(i_current_val) => (match reviewed.contentRevision { case Some(i_reviewed_contentRevision_val) => ((match i_current_val.contentRevision { case Some(i_value) => (i_value != i_reviewed_contentRevision_val) case None => true }) ==> !(captureUnchanged(reviewed, current))) case None => true }) case None => true })
