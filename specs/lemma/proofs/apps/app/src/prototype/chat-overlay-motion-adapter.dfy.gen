datatype Option<T> = None | Some(value: T)

function SeqFind<T>(s: seq<T>, p: T -> bool): Option<T>
  ensures SeqFind(s, p).Some? ==> p(SeqFind(s, p).value)
  ensures SeqFind(s, p).Some? ==> SeqFind(s, p).value in s
  ensures SeqFind(s, p).Some? ==>
    exists i: nat :: i < |s| && s[i] == SeqFind(s, p).value && p(s[i]) &&
                     (forall j: nat :: j < i ==> !p(s[j]))
  ensures SeqFind(s, p).None? ==> forall i :: 0 <= i < |s| ==> !p(s[i])
  decreases |s|
{
  if |s| == 0 then None
  else if p(s[0]) then Some(s[0])
  else SeqFind(s[1..], p)
}

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Mode = hidden | input | sheet | full

datatype Sample = Sample(y: int, t: int)

datatype ReleaseOptions = ReleaseOptions(mode: Mode, direction: string, height: int, floor: int, full: int, flick: bool)

datatype FlickSpanResult = FlickSpanResult(rise: int, run: int)

datatype ChatReleaseResult = ChatReleaseResult(chat: string, height: Option<int>)

function flickSpan(track: seq<Sample>, time: int): FlickSpanResult
{
  var last := (if ((0 <= (|track| - 1)) && ((|track| - 1) < |track|)) then Option.Some(track[(|track| - 1)]) else Option.None);
  match last {
    case Some(i_last_val) =>
      if ((time - i_last_val.t) > FLICK_HOLD_MS) then
        FlickSpanResult(0, 0)
      else
        var end := i_last_val.t;
        var first := SeqFind(track, (sample: Sample) => ((end - sample.t) <= FLICK_WINDOW_MS));
        match first {
          case Some(i_first_val) =>
            if (end > i_first_val.t) then
              FlickSpanResult((i_first_val.y - i_last_val.y), (end - i_first_val.t))
            else
              FlickSpanResult(0, 0)
          case None =>
            FlickSpanResult(0, 0)
        }
    case None =>
      FlickSpanResult(0, 0)
  }
}

