  ensures ((flickSpan(track, time).run > 0) ==> (flickSpan(track, time).run <= 100))
  ensures ((flickSpan(track, time).run > 0) ==> exists k: int :: ((((0 <= k) && (k < |track|)) && (flickSpan(track, time).run == (track[(|track| - 1)].t - track[k].t))) && (flickSpan(track, time).rise == (track[k].y - track[(|track| - 1)].y))))
{
}

function clampSheetHeight(rounded: int, full: int, half: int): int
  requires (0 < half)
  requires (half <= full)
{
  MathMin(full, MathMax(rounded, MathMin(SHEET_MIN_HEIGHT, half)))
}

