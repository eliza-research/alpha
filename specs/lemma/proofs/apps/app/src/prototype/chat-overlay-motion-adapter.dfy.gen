  ensures ((half >= 200) ==> (clampSheetHeight(rounded, full, half) >= 200))
  ensures ((rounded >= 200) ==> (rounded <= full) ==> (clampSheetHeight(rounded, full, half) == rounded))
  ensures ((rounded > full) ==> (clampSheetHeight(rounded, full, half) == full))
