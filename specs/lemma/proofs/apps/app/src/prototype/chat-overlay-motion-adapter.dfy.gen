  ensures (flickSpan(track, time).run >= 0)
  ensures ((flickSpan(track, time).run == 0) ==> (flickSpan(track, time).rise == 0))
  ensures ((|track| == 0) ==> (flickSpan(track, time).run == 0))
  ensures ((|track| > 0) ==> ((time - track[(|track| - 1)].t) > 80) ==> (flickSpan(track, time).run == 0))
