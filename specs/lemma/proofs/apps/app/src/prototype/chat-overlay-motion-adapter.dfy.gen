  ensures ((options.mode.sheet? || options.mode.full?) ==> !(options.flick) ==> (options.height > (options.floor + 120)) ==> (options.height < (options.full - 120)) ==> ((chatRelease(options).chat == "sheet") && (match chatRelease(options).height { case Some(i_) => true case None => false })))
  ensures ((options.mode.input? || options.mode.hidden?) ==> (options.direction == "up") ==> !(options.flick) ==> (options.height > (options.floor + 120)) ==> (options.height < (options.full - 120)) ==> ((chatRelease(options).chat == "sheet") && (match chatRelease(options).height { case Some(i_) => true case None => false })))
