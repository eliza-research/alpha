// Generated by lsc from journal-retention.ts

datatype Option<T> = None | Some(value: T)

function MathMax(a: int, b: int): int { if a >= b then a else b }

function journalRowRetires(index: int, doneCount: int, at: Option<int>, now: int): bool
{
  ((index < (doneCount - KEEP)) || (match at { case Some(i_at_val) => ((now - i_at_val) > AGE) case None => false }))
}

lemma journalRowRetires_ensures(index: int, doneCount: int, at: Option<int>, now: int)
  ensures (match at { case Some(i_at_val) => (journalRowRetires(index, doneCount, at, now) <==> ((index < (doneCount - KEEP)) || ((now - i_at_val) > AGE))) case None => true })
  ensures ((match at { case Some(i_) => false case None => true }) ==> (journalRowRetires(index, doneCount, at, now) <==> (index < (doneCount - KEEP))))
  ensures ((index < (doneCount - KEEP)) ==> journalRowRetires(index, doneCount, at, now))
  ensures (!(journalRowRetires(index, doneCount, at, now)) ==> (index >= (doneCount - KEEP)))
  ensures (match at { case Some(i_at_val) => (!(journalRowRetires(index, doneCount, at, now)) ==> ((now - i_at_val) <= AGE)) case None => true })
{
}

function deletionSettled(phase: string): bool
{
  (phase in ["deleted", "undone", "conflict"])
}

lemma deletionSettled_ensures(phase: string)
  ensures (deletionSettled(phase) <==> (((phase == "deleted") || (phase == "undone")) || (phase == "conflict")))
  ensures (((phase == "queued") || (phase == "paused")) ==> !(deletionSettled(phase)))
{
}

function settledDeletionsToTrim(terminal: int): int
  requires (terminal >= 0)
{
  MathMax(0, (terminal - SETTLED))
}

lemma settledDeletionsToTrim_ensures(terminal: int)
  requires (terminal >= 0)
  ensures (0 <= settledDeletionsToTrim(terminal))
  ensures (settledDeletionsToTrim(terminal) <= terminal)
  ensures ((terminal - settledDeletionsToTrim(terminal)) <= SETTLED)
  ensures ((terminal <= SETTLED) ==> (settledDeletionsToTrim(terminal) == 0))
  ensures ((terminal > SETTLED) ==> ((terminal - settledDeletionsToTrim(terminal)) == SETTLED))
{
}

const KEEP: int := 200

const AGE: int := (30 * 86400000)

const SETTLED: int := 127

// ---- Hand-written additions: one whole retireJournal pass over the per-row decision ----
// `ats[i]` is the saved time of the definite row at sorted position i (oldest first); the pass
// calls journalRowRetires(i, |ats|, ats[i], now) once per position, as retireJournal does.

/** Rows among the first `i` positions that retire by count (position below doneCount - KEEP). */
function RetiredByCount(doneCount: int, i: int): int
  requires 0 <= i <= doneCount
{
  if i == 0 then 0 else RetiredByCount(doneCount, i - 1) + (if i - 1 < doneCount - KEEP then 1 else 0)
}

/** Rows among the first `i` positions that the pass keeps. */
function Survivors(ats: seq<Option<int>>, now: int, i: int): int
  requires 0 <= i <= |ats|
{
  if i == 0 then 0
  else Survivors(ats, now, i - 1) + (if journalRowRetires(i - 1, |ats|, ats[i - 1], now) then 0 else 1)
}

lemma RetiredByCountPrefix(doneCount: int, i: int)
  requires 0 <= i <= doneCount
  ensures RetiredByCount(doneCount, i) == (if i <= doneCount - KEEP then i else MathMax(0, doneCount - KEEP))
{
  if i > 0 { RetiredByCountPrefix(doneCount, i - 1); }
}

/** Exactly max(0, doneCount - 200) rows retire by count. */
lemma RetiredByCountTotal(doneCount: int)
  requires 0 <= doneCount
  ensures RetiredByCount(doneCount, doneCount) == MathMax(0, doneCount - KEEP)
{
  RetiredByCountPrefix(doneCount, doneCount);
}

lemma SurvivorsPrefix(ats: seq<Option<int>>, now: int, i: int)
  requires 0 <= i <= |ats|
  ensures Survivors(ats, now, i) <= (if i <= |ats| - KEEP then 0 else i - MathMax(0, |ats| - KEEP))
{
  if i > 0 {
    SurvivorsPrefix(ats, now, i - 1);
    journalRowRetires_ensures(i - 1, |ats|, ats[i - 1], now);
  }
}

/** After the pass at most 200 definite rows remain, and each one that has a time is at most 30 days old. */
lemma RetireJournalPassBound(ats: seq<Option<int>>, now: int)
  ensures Survivors(ats, now, |ats|) <= KEEP
  ensures forall i :: 0 <= i < |ats| && !journalRowRetires(i, |ats|, ats[i], now) ==> i >= |ats| - KEEP
  ensures forall i :: 0 <= i < |ats| && !journalRowRetires(i, |ats|, ats[i], now) && ats[i].Some? ==> now - ats[i].value <= AGE
  ensures forall i :: 0 <= i < |ats| && ats[i].None? ==> (journalRowRetires(i, |ats|, ats[i], now) <==> i < |ats| - KEEP)
{
  SurvivorsPrefix(ats, now, |ats|);
}

/** A trim leaves at most 127 settled deletions and removes only settled ones: a queued or paused
 * deletion is not settled, so it is never in the list the trim count is applied to. */
lemma TrimDeletionJournalBound(terminal: int)
  requires terminal >= 0
  ensures terminal - settledDeletionsToTrim(terminal) <= SETTLED
  ensures settledDeletionsToTrim(terminal) == MathMax(0, terminal - SETTLED)
  ensures !deletionSettled("queued") && !deletionSettled("paused")
{
}
