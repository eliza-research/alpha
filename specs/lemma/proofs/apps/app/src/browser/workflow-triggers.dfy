lemma placeChanged_irreflexive(x: Option<string>)
  ensures !placeChanged(x, x)
{
}

lemma placeChanged_symmetric(a: Option<string>, b: Option<string>)
  ensures placeChanged(a, b) == placeChanged(b, a)
{
}

// Independence: a blocked scan never stops dispatch, and a held dispatch never stops a scan.
lemma triggerTickPlan_independent(foreground: bool, scanBlocked: bool, dispatchHeld: bool)
  ensures triggerTickPlan(TriggerTickState(foreground, scanBlocked, dispatchHeld)).dispatch
       == triggerTickPlan(TriggerTickState(foreground, !scanBlocked, dispatchHeld)).dispatch
  ensures triggerTickPlan(TriggerTickState(foreground, scanBlocked, dispatchHeld)).scan
       == triggerTickPlan(TriggerTickState(foreground, scanBlocked, !dispatchHeld)).scan
{
}

// The cursor after `n` passes at the same `now`.
function cursorAfter(old_: int, now: int, n: nat): int
  decreases n
{
  if n == 0 then old_ else cursorAfter(cursorThrough(old_, now), now, n - 1)
}

// Monotone: no number of passes moves the cursor backwards or past max(old, now).
lemma cursorAfter_monotone(old_: int, now: int, n: nat)
  ensures old_ <= cursorAfter(old_, now, n) <= MathMax(old_, now)
  decreases n
{
  if n > 0 {
    cursorAfter_monotone(cursorThrough(old_, now), now, n - 1);
  }
}

// Progress: a cursor that is behind `now` reaches it after ceil((now - old) / one day) passes,
// and stays there.
lemma cursorAfter_reachesNow(old_: int, now: int)
  requires now >= old_
  ensures cursorAfter(old_, now, (now - old_ + 86399999) / 86400000) == now
  ensures forall m: nat :: cursorAfter(now, now, m) == now
  decreases now - old_
{
  forall m: nat ensures cursorAfter(now, now, m) == now { cursorAfter_fixed(now, m); }
  if now > old_ {
    var next := cursorThrough(old_, now);
    if next == now {
      assert (now - old_ + 86399999) / 86400000 == 1;
      assert cursorAfter(now, now, 0) == now;
    } else {
      assert next == old_ + 86400000;
      assert (now - old_ + 86399999) / 86400000 == (now - next + 86399999) / 86400000 + 1;
      cursorAfter_reachesNow(next, now);
    }
  }
}

lemma cursorAfter_fixed(now: int, m: nat)
  ensures cursorAfter(now, now, m) == now
  decreases m
{
  if m > 0 { cursorAfter_fixed(now, m - 1); }
}
