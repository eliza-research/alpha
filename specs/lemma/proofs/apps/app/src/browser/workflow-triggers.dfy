// Generated by lsc from workflow-triggers.ts

datatype Option<T> = None | Some(value: T)

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype TriggerTickState = TriggerTickState(foreground: bool, scanBlocked: bool, dispatchHeld: bool)

datatype TriggerTickPlanResult = TriggerTickPlanResult(scan: bool, dispatch: bool)

function cursorThrough(old_: int, now: int): int
{
  MathMax(old_, MathMin(now, (old_ + 86400000)))
}

lemma cursorThrough_ensures(old_: int, now: int)
  ensures (old_ <= cursorThrough(old_, now))
  ensures (cursorThrough(old_, now) <= MathMax(old_, now))
  ensures ((cursorThrough(old_, now) - old_) <= 86400000)
  ensures ((now >= old_) ==> (cursorThrough(old_, now) <= now))
  ensures ((now >= old_) ==> ((cursorThrough(old_, now) == now) || (cursorThrough(old_, now) == (old_ + 86400000))))
  ensures ((now <= old_) ==> (cursorThrough(old_, now) == old_))
{
}

function placeChanged(stored: Option<string>, current: Option<string>): bool
{
  (((match stored { case Some(i_) => true case None => false }) && (match current { case Some(i_) => true case None => false })) && (stored != current))
}

lemma placeChanged_ensures(stored: Option<string>, current: Option<string>)
  ensures (((match stored { case Some(i_) => false case None => true }) || (match current { case Some(i_) => false case None => true })) ==> !(placeChanged(stored, current)))
  ensures ((stored == current) ==> !(placeChanged(stored, current)))
  ensures (placeChanged(stored, current) <==> (((match stored { case Some(i_) => true case None => false }) && (match current { case Some(i_) => true case None => false })) && (stored != current)))
{
}

function triggerTickPlan(state: TriggerTickState): TriggerTickPlanResult
{
  TriggerTickPlanResult((state.foreground && !(state.scanBlocked)), (state.foreground && !(state.dispatchHeld)))
}

lemma triggerTickPlan_ensures(state: TriggerTickState)
  ensures (!(state.foreground) ==> (!(triggerTickPlan(state).scan) && !(triggerTickPlan(state).dispatch)))
  ensures (triggerTickPlan(state).scan <==> (state.foreground && !(state.scanBlocked)))
  ensures (triggerTickPlan(state).dispatch <==> (state.foreground && !(state.dispatchHeld)))
{
}

