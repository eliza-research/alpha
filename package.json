{
  "name": "@alphacompute/alphaphone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/dev-local.ts",
    "dev:ui": "bun run upstream:prepare-client && bun scripts/with-test-mocks.ts vite --host 127.0.0.1",
    "dev:maps": "bun run upstream:prepare-client && bun scripts/maps/dev.ts",
    "build": "bun run upstream:prepare-client && bun run build:only",
    "build:test-mocks": "bun run upstream:prepare-client && bun scripts/with-test-mocks.ts vite build",
    "audit:bundle": "bun scripts/audit-production-bundle.ts web-dist",
    "typecheck": "bun run upstream:prepare-client && bun run typecheck:only",
    "test": "bun run upstream:prepare-client && bun run test:only",
    "verify": "bun scripts/cloud-deployment.ts --check && bun run upstream:prepare-client && bun run typecheck:only && bun run test:only && bun run build:only && bun run audit:bundle",
    "android:sync": "bun run build && cap sync android && bun scripts/android-gzip-assets.ts protect",
    "android:host": "bun scripts/android-host.ts",
    "android:build": "bun scripts/build-android.ts",
    "android:verify": "bun scripts/verify-apks.ts",
    "test:android:instrumentation": "bun scripts/android-instrumentation.ts",
    "aosp:stage": "bun scripts/stage-aosp.ts",
    "test:browser": "playwright test --project=chromium",
    "test:browser:production": "playwright test --project=production",
    "test:browser:live": "ELIZA_DEV_ALLOW_TEST_MOCKS=1 VITE_LOCAL_AGENT=1 ALPHA_LOCAL_AGENT_TOKEN_FILE=\"${ALPHA_LOCAL_AGENT_TOKEN_FILE:-$HOME/.local/share/alphaphone/local-remote/owner-token}\" playwright test --project=live --workers=1",
    "agent:prepare": "bun scripts/prepare-local-agent.ts",
    "agent:test": "bun scripts/test-local-agent-source.ts",
    "agent:test-digest-restart": "bun scripts/test-local-digest-restart.ts",
    "agent:build-workflow-worker": "bun scripts/build-workflow-worker.ts",
    "agent:test-mobile-workflow-bundle": "bun scripts/test-mobile-workflow-bundle.ts",
    "agent:test-workflow-compiler": "bun scripts/test-workflow-compiler.ts",
    "agent:test-workflow-worker": "bun scripts/test-workflow-worker.ts",
    "agent:stage-android": "bun scripts/stage-local-agent-runtime.ts",
    "agent:build-embedding-host": "bun scripts/build-embedding-host.ts",
    "android:build:inputs": "bun scripts/android-build-preflight.ts --report",
    "android:build:local": "bun scripts/android-build-preflight.ts && bun run agent:build-embedding-host && bun run agent:prepare && bun run agent:build-workflow-worker && bun run agent:stage-android && bun run licenses:packaged-runtime && bun run android:build",
    "android:deps:check": "bun scripts/gradle-verification.ts --check",
    "android:deps:write-verification": "bun scripts/gradle-verification.ts --write",
    "licenses:packaged-runtime": "bun scripts/generate-licenses.ts --packaged-runtime",
    "agent:test-device-timing": "bun scripts/test-device-timing-source.ts",
    "upstream:prepare-client": "bun scripts/prepare-client-features.ts",
    "dev:cloud": "bun scripts/dev-cloud.ts",
    "cloud:local": "bun scripts/local-cloud.ts",
    "cloud:worker": "bun scripts/cloud-worker.ts",
    "quint:check": "bun scripts/check-quint.ts check",
    "lemma:check": "bun scripts/check-lemma.ts",
    "lemma:regen": "lsc gen --backend=dafny",
    "typecheck:scripts": "bun scripts/typecheck-scripts.ts",
    "typecheck:only": "tsc --noEmit && bun run typecheck:scripts",
    "test:only": "bun scripts/run-tests.ts",
    "test:node": "bun scripts/run-node-only-tests.ts",
    "build:only": "vite build",
    "quint:tests": "bun scripts/prepare-quint-history.ts && bun scripts/run-tests.ts 'test/quint-*.test.mjs' 'test/quint-*.test.ts' && bun run test:node"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@tesseract.js-data/eng": "1.0.0",
    "dompurify": "3.4.17",
    "maplibre-gl": "6.11.2",
    "mediabunny": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.0.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.4.6",
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/public-sans": "^5.2.0",
    "@informalsystems/quint": "0.33.1",
    "@noble/hashes": "2.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "adze": "2.3.0",
    "amaro": "1.3.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.2",
    "json5": "2.2.3",
    "lemmascript": "0.6.6",
    "markdown-it": "14.3.3",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@6.0.3",
    "uuid": "14.0.2",
    "vite": "8.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
