{
  "name": "@eliza-research/alphaphone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev-local.ts",
    "dev:ui": "node scripts/with-test-mocks.ts vite --host 127.0.0.1",
    "dev:maps": "node scripts/maps/dev.ts",
    "build": "vite build",
    "build:test-mocks": "node scripts/with-test-mocks.ts vite build",
    "audit:bundle": "node scripts/audit-production-bundle.ts web-dist",
    "typecheck": "tsc --noEmit && node scripts/typecheck-scripts.ts",
    "test": "node scripts/run-node-tests.ts",
    "verify": "node scripts/cloud-deployment.ts --check && npm run upstream:prepare-client && npm run quint:prepare-history && npm run quint:check && npm run --ignore-scripts typecheck && npm --ignore-scripts test && npm run --ignore-scripts build && npm run audit:bundle",
    "android:sync": "npm run build && cap sync android && node scripts/android-gzip-assets.ts protect",
    "android:host": "node scripts/android-host.ts",
    "android:build": "node scripts/build-android.ts",
    "android:verify": "node scripts/verify-apks.ts",
    "test:android:instrumentation": "node scripts/android-instrumentation.ts",
    "aosp:stage": "node scripts/stage-aosp.ts",
    "aosp:retain-known-good": "node scripts/aosp-ota-update.ts retain-known-good",
    "aosp:verify-secure-camera": "node scripts/verify-aosp-secure-camera.ts",
    "upstream:verify": "node scripts/verify-upstream.ts",
    "agent:local": "node scripts/start-local-remote.ts",
    "test:browser": "playwright test --project=chromium",
    "test:browser:production": "playwright test --project=production",
    "test:browser:storage": "playwright test --project=firefox --project=webkit",
    "test:browser:live": "ELIZA_DEV_ALLOW_TEST_MOCKS=1 VITE_LOCAL_AGENT=1 ALPHA_LOCAL_AGENT_TOKEN_FILE=\"${ALPHA_LOCAL_AGENT_TOKEN_FILE:-$HOME/.local/share/alphaphone/local-remote/owner-token}\" playwright test --project=live --workers=1",
    "dev:local": "node scripts/dev-local.ts",
    "agent:prepare": "node scripts/prepare-local-agent.ts",
    "agent:test": "node scripts/test-local-agent-source.ts",
    "agent:test-redaction": "node scripts/test-local-redaction.ts",
    "agent:test-digest-restart": "node scripts/test-local-digest-restart.ts",
    "agent:build-workflow-worker": "bun scripts/build-workflow-worker.ts",
    "agent:test-mobile-workflow-bundle": "node scripts/test-mobile-workflow-bundle.ts",
    "agent:test-workflow-compiler": "node scripts/test-workflow-compiler.ts",
    "agent:test-workflow-worker": "node scripts/test-workflow-worker.ts",
    "agent:stage-workflow-worker": "node scripts/stage-workflow-worker.ts",
    "agent:stage-android": "node scripts/stage-local-agent-runtime.ts",
    "agent:build-embedding-host": "node scripts/build-embedding-host.ts",
    "android:build:inputs": "node scripts/android-build-preflight.ts --report",
    "android:build:local": "node scripts/android-build-preflight.ts --before-prepare && npm run agent:build-embedding-host && npm run agent:prepare && npm run agent:build-workflow-worker && npm run agent:stage-android && npm run licenses:packaged-runtime && npm run android:build",
    "android:deps:check": "node scripts/gradle-verification.ts --check",
    "android:deps:write-verification": "node scripts/gradle-verification.ts --write",
    "licenses:packaged-runtime": "node scripts/generate-licenses.ts --packaged-runtime",
    "sbom": "node scripts/generate-sbom.ts",
    "agent:test-device-timing": "node scripts/test-device-timing-source.ts",
    "upstream:prepare-client": "node scripts/prepare-client-features.ts",
    "predev": "npm run upstream:prepare-client",
    "predev:ui": "npm run upstream:prepare-client",
    "prebuild": "npm run upstream:prepare-client",
    "pretypecheck": "npm run upstream:prepare-client",
    "pretest": "npm run upstream:prepare-client",
    "predev:maps": "npm run upstream:prepare-client",
    "prebuild:test-mocks": "npm run upstream:prepare-client",
    "dev:cloud": "node scripts/dev-cloud.ts",
    "quint:prepare-history": "node scripts/prepare-quint-history.ts",
    "quint:check": "node scripts/check-quint.ts check",
    "quint:typecheck": "node scripts/check-quint.ts typecheck",
    "quint:test": "node scripts/check-quint.ts test",
    "quint:simulate": "node scripts/check-quint.ts simulate",
    "quint:verify": "node scripts/check-quint.ts verify",
    "quint:temporal": "node scripts/check-quint.ts temporal",
    "quint:compare": "node scripts/check-quint.ts compare",
    "quint:conformance": "node --test test/quint-conformance.test.mjs test/quint-native-conformance.test.mjs test/quint-scan-conformance.test.mjs test/quint-recovery-vad-conformance.test.mjs",
    "quint:refinement": "node scripts/check-quint-refinement.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@tesseract.js-data/eng": "1.0.0",
    "dompurify": "3.4.17",
    "maplibre-gl": "6.11.2",
    "mediabunny": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.0.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.4.6",
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/public-sans": "^5.2.0",
    "@informalsystems/quint": "0.33.1",
    "@noble/hashes": "2.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "adze": "2.3.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.2",
    "json5": "2.2.3",
    "markdown-it": "14.3.3",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@6.0.3",
    "uuid": "14.0.2",
    "vite": "8.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
