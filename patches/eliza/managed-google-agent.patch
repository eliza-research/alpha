index 0000000000..9edf6c5add
--- /dev/null
+++ b/packages/app/src/runtime/managed-google-agent/native-google-agent-host.ts
@@ -0,0 +1,152 @@
+import { timingSafeEqual } from "node:crypto";
+import {
+  closeSync,
+  constants,
+  fstatSync,
+  lstatSync,
+  openSync,
+  readFileSync,
+} from "node:fs";
+import { createServer } from "node:http";
+import { dirname } from "node:path";
+import {
+  createManagedGoogleAgentBroker,
+  type ManagedGoogleBrokerDiagnostic,
+} from "./managed-google-agent-broker.ts";
+import {
+  createManagedGoogleAgentHost,
+  type GoogleAgentAccess,
+  type ManagedGoogleAgentHostOptions,
+  type ManagedGoogleAgentPort,
+} from "./managed-google-agent-host.ts";
+import {
+  createNativeGoogleCloudPort,
+  type NativeGoogleBinding,
+} from "./native-google-cloud-port.ts";
+
+/** The owner's Settings switches from the native application. Read before every
+ * agent write so a toggle applies without a restart; no file, or anything but version 1 booleans, is off. */
+export function readGoogleAgentAccessFile(file?: string): GoogleAgentAccess {
+  const off = { gmailChanges: false, calendarEdits: false };
+  if (!file) return off;
+  try {
+    // Match the writer's private directory and reject special targets without
+    // blocking. Read the opened inode so an atomic replacement cannot splice it.
+    if (!lstatSync(dirname(file)).isDirectory()) return off;
+    const fd = openSync(
+      file,
+      constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK,
+    );
+    try {
+      if (!fstatSync(fd).isFile()) return off;
+      const saved = JSON.parse(readFileSync(fd, "utf8"));
+      if (
+        saved?.version !== 1 ||
+        typeof saved.gmailChanges !== "boolean" ||
+        typeof saved.calendarEdits !== "boolean"
+      )
+        return off;
+      return {
+        gmailChanges: saved.gmailChanges,
+        calendarEdits: saved.calendarEdits,
+      };
+    } finally {
+      closeSync(fd);
+    }
+  } catch {
+    return off;
+  }
+}
+
+/** Signed in-process application host; no renderer, browser profile or credential writes. */
+export async function startNativeGoogleAgentHost(
+  options: ManagedGoogleAgentHostOptions & {
+    binding: NativeGoogleBinding;
+    apiToken: string;
+    userAgent: string;
+    request?: typeof fetch;
+    assertCurrent?: () => void;
+  },
+) {
+  if (!/^[A-Za-z0-9_-]{64}$/.test(options.apiToken))
+    throw Error("Private native agent authentication is unavailable");
+  const retired = new AbortController();
+  const port = createNativeGoogleCloudPort(options.binding, {
+    apiOrigin: options.apiOrigin,
+    userAgent: options.userAgent,
+    request: options.request,
+    assertCurrent: () => {
+      retired.signal.throwIfAborted();
+      options.assertCurrent?.();
+    },
+  });
+  const host = await startManagedGoogleAgentHost({
+    port,
+    apiToken: options.apiToken,
+    access: options.access,
+    apiOrigin: options.apiOrigin,
+    calendarReadTiming: options.calendarReadTiming,
+  });
+  return {
+    port: host.port,
+    async close() {
+      if (!retired.signal.aborted) retired.abort();
+      await host.close();
+    },
+  };
+}
+
+/** Same private broker lifecycle for an existing host-owned Cloud port. */
+export async function startManagedGoogleAgentHost(
+  options: ManagedGoogleAgentHostOptions & {
+    port: ManagedGoogleAgentPort;
+    apiToken: string;
+    diagnostic?: (value: ManagedGoogleBrokerDiagnostic) => void;
+  },
+) {
+  if (!/^[A-Za-z0-9_-]{64}$/.test(options.apiToken))
+    throw Error("Private agent authentication is unavailable");
+  const broker = createManagedGoogleAgentBroker({
+    host: createManagedGoogleAgentHost(options.port, options),
+    diagnostic: options.diagnostic,
+    async authorized(value) {
+      const actual = Buffer.from(value ?? ""),
+        expected = Buffer.from(`Bearer ${options.apiToken}`);
+      return (
+        actual.length === expected.length && timingSafeEqual(actual, expected)
+      );
+    },
+  });
+  const server = createServer(
+    { maxHeaderSize: 8192 },
+    (req, res) => void broker(req, res),
+  );
+  server.requestTimeout = 35000;
+  server.headersTimeout = 5000;
+  let closing: Promise<void> | undefined;
+  const close = () =>
+    (closing ??= new Promise<void>((resolve, reject) => {
+      if (!server.listening) {
+        resolve();
+        return;
+      }
+      server.close((error) => (error ? reject(error) : resolve()));
+      server.closeAllConnections();
+    }));
+  try {
+    await new Promise<void>((resolve, reject) => {
+      server.once("error", reject);
+      server.listen(0, "127.0.0.1", () => {
+        server.removeListener("error", reject);
+        resolve();
+      });
+    });
+    const address = server.address();
+    if (!address || typeof address === "string")
+      throw Error("Private Google host did not bind");
+    return { port: address.port, close };
+  } catch (error) {
+    await close();
+    throw error;
+  }
+}
diff --git a/packages/app/src/runtime/managed-google-agent/native-google-cloud-port.ts b/packages/app/src/runtime/managed-google-agent/native-google-cloud-port.ts
new file mode 100644
index 0000000000..f59361ea03
--- /dev/null
+++ b/packages/app/src/runtime/managed-google-agent/native-google-cloud-port.ts
@@ -0,0 +1,161 @@
+import type { ManagedGoogleAgentPort } from "./managed-google-agent-host.ts";
+import {
+  type ManagedGoogleFailureStage,
+  recordManagedGoogleFailure,
+} from "./managed-google-failure-stage.ts";
+import {
+  boundedServiceJson,
+  managedGoogleRequest,
+} from "./managed-google-route-policy.ts";
+
+/** Supplied by the native provider admission, never by a tool or renderer. */
+export type NativeGoogleBinding = {
+  credentialId: string;
+  userId: string;
+  organizationId: string;
+  accountRef: string;
+  sessionGeneration: string;
+  token: string;
+  expiresAt?: number;
+};
+type RequestInput = Parameters<ManagedGoogleAgentPort["agentRead"]>[0];
+const UUID =
+  /^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i;
+const readPaths = new Set([
+  "/api/v1/eliza/google/accounts",
+  "/api/v1/eliza/google/gmail/search",
+  "/api/v1/eliza/google/gmail/read",
+  "/api/v1/eliza/google/calendar/calendars",
+  "/api/v1/eliza/google/calendar/feed",
+]);
+
+export function createNativeGoogleCloudPort(
+  binding: NativeGoogleBinding,
+  options: {
+    apiOrigin: string;
+    userAgent: string;
+    assertCurrent: () => void;
+    request?: typeof fetch;
+  },
+): ManagedGoogleAgentPort {
+  const { apiOrigin, userAgent, assertCurrent, request = fetch } = options;
+  if (
+    ![binding.credentialId, binding.userId, binding.organizationId].every(
+      (value) => UUID.test(value),
+    ) ||
+    typeof binding.sessionGeneration !== "string" ||
+    !binding.sessionGeneration ||
+    binding.sessionGeneration.length > 256 ||
+    typeof binding.token !== "string" ||
+    binding.token.length < 8 ||
+    binding.token.length > 16384 ||
+    /[^\x21-\x7e]/.test(binding.token) ||
+    binding.accountRef !==
+      JSON.stringify([
+        "cloud",
+        "production",
+        binding.userId,
+        binding.organizationId,
+      ]) ||
+    (binding.expiresAt !== undefined &&
+      (!Number.isFinite(binding.expiresAt) || binding.expiresAt <= Date.now()))
+  )
+    throw Error("Native Google provider binding is unavailable");
+  const reference = `native-google-reference:${binding.credentialId}`;
+  const credential = {
+    credentialReference: reference,
+    credentialId: binding.credentialId,
+    userId: binding.userId,
+    organizationId: binding.organizationId,
+    ...(binding.expiresAt === undefined
+      ? {}
+      : { expiresAt: binding.expiresAt }),
+  };
+  const current = () => {
+    assertCurrent();
+    if (binding.expiresAt !== undefined && binding.expiresAt <= Date.now())
+      throw Error("Native Google provider binding expired");
+  };
+  async function call(
+    input: RequestInput,
+    purpose: "read" | "gmail" | "calendar",
+  ) {
+    let stage: ManagedGoogleFailureStage = "request-validation";
+    try {
+      current();
+      input.signal.throwIfAborted();
+      const url = new URL(input.url),
+        body =
+          input.body === undefined ? undefined : JSON.stringify(input.body);
+      if (
+        url.origin !== apiOrigin ||
+        url.username ||
+        url.password ||
+        url.hash ||
+        url.port ||
+        input.credentialReference !== reference
+      )
+        throw Error("Native Google request refused");
+      const read =
+        input.method === "GET" &&
+        body === undefined &&
+        ((url.pathname === "/api/v1/user" && !url.search) ||
+          (readPaths.has(url.pathname) &&
+            managedGoogleRequest(url, "GET", undefined)));
+      let permitted = read;
+      if (
+        purpose === "gmail" &&
+        /^\/api\/v1\/eliza\/google\/gmail\/inbox-v1\/operations(?:\/[A-Za-z0-9_-]{1,160}(?:\/dispatch)?)?$/.test(
+          url.pathname,
+        )
+      ) {
+        permitted = managedGoogleRequest(url, input.method, body);
+        if (permitted && input.method === "POST")
+          permitted = [
+            "send",
+            "archive",
+            "trash",
+            "mark-read",
+            "mark-unread",
+          ].includes(JSON.parse(body ?? "{}").proposal.kind);
+      }
+      if (
+        purpose === "calendar" &&
+        url.pathname.startsWith("/api/v1/eliza/google/calendar/sync-v1/")
+      )
+        permitted = managedGoogleRequest(url, input.method, body);
+      if (!permitted)
+        throw Error("Native Google operation is outside this host");
+      stage = "fetch";
+      const response = await request(url.toString(), {
+        method: input.method,
+        redirect: "error",
+        signal: input.signal,
+        headers: {
+          Accept: "application/json",
+          Authorization: `Bearer ${binding.token}`,
+          "User-Agent": userAgent,
+          ...(body === undefined ? {} : { "Content-Type": "application/json" }),
+        },
+        ...(body === undefined ? {} : { body }),
+      });
+      stage = "response-json";
+      const data = await boundedServiceJson(response);
+      current();
+      input.signal.throwIfAborted();
+      return { status: response.status, data };
+    } catch (error) {
+      recordManagedGoogleFailure(error, stage);
+      throw error;
+    }
+  }
+  return {
+    async agentCredential() {
+      current();
+      return { ...credential };
+    },
+    agentRead: (input) => call(input, "read"),
+    agentGmailOperation: (input) => call(input, "gmail"),
+    agentCalendarOperation: (input) => call(input, "calendar"),
+  };
+}
