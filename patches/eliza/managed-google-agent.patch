diff --git a/packages/app/src/runtime/managed-google-agent/calendar-read-timing.ts b/packages/app/src/runtime/managed-google-agent/calendar-read-timing.ts
new file mode 100644
index 0000000000..2095d480aa
--- /dev/null
+++ b/packages/app/src/runtime/managed-google-agent/calendar-read-timing.ts
@@ -0,0 +1,90 @@
+import type { ManagedGoogleRequest } from "./managed-google-client.ts";
+
+export type CalendarCacheBucket = "owner-cache" | "calendars-cache";
+type RouteBucket = "identity" | "accounts" | "calendars" | "feed";
+export type CalendarReadTiming =
+  | {
+      version: 1;
+      routeBucket: RouteBucket;
+      status: number | null;
+      durationMs: number;
+    }
+  | {
+      version: 1;
+      routeBucket: CalendarCacheBucket;
+      cacheHit: "miss" | "in-flight" | "completed";
+      ageMs: number | null;
+    };
+const routes: Record<string, RouteBucket> = {
+  "/api/v1/user": "identity",
+  "/api/v1/eliza/google/accounts": "accounts",
+  "/api/v1/eliza/google/calendar/calendars": "calendars",
+  "/api/v1/eliza/google/calendar/feed": "feed",
+};
+const rounded = (n: number) =>
+  Number.isFinite(n)
+    ? Math.min(Number.MAX_SAFE_INTEGER, Math.max(0, Math.round(n)))
+    : 0;
+/** Private host diagnostic only. Cost: one fixed-field line per existing RPC or cache lookup,
+ * zero additional I/O requests. Disabled by default; never records URLs, identities or data.
+ */
+export function createCalendarReadTiming(
+  enabled: boolean,
+  emit: (value: CalendarReadTiming) => void = (value) =>
+    console.info("[alpha-calendar-read-timing]", JSON.stringify(value)),
+) {
+  const record = (value: CalendarReadTiming) => {
+    try {
+      emit(value);
+    } catch {
+      /* Diagnostics cannot change reads or errors. */
+    }
+  };
+  return {
+    request(read: ManagedGoogleRequest): ManagedGoogleRequest {
+      if (!enabled) return read;
+      return async (input) => {
+        let bucket: RouteBucket | undefined;
+        try {
+          if (input.method === "GET")
+            bucket = routes[new URL(input.url).pathname];
+        } catch {
+          /* Transport retains invalid URL handling. */
+        }
+        if (!bucket) return read(input);
+        const start = performance.now();
+        let status: number | null = null;
+        try {
+          const result = await read(input);
+          status =
+            Number.isInteger(result.status) &&
+            result.status >= 100 &&
+            result.status <= 599
+              ? result.status
+              : null;
+          return result;
+        } finally {
+          record({
+            version: 1,
+            routeBucket: bucket,
+            status,
+            durationMs: rounded(performance.now() - start),
+          });
+        }
+      };
+    },
+    cache(
+      routeBucket: CalendarCacheBucket,
+      cacheHit: "miss" | "in-flight" | "completed",
+      ageMs: number | null,
+    ) {
+      if (enabled)
+        record({
+          version: 1,
+          routeBucket,
+          cacheHit,
+          ageMs: ageMs === null ? null : rounded(ageMs),
+        });
+    },
+  };
+}
diff --git a/packages/app/src/runtime/managed-google-agent/gmail-agent-mailbox-host.ts b/packages/app/src/runtime/managed-google-agent/gmail-agent-mailbox-host.ts
new file mode 100644
index 0000000000..e2cf45a60e
--- /dev/null
+++ b/packages/app/src/runtime/managed-google-agent/gmail-agent-mailbox-host.ts
@@ -0,0 +1,148 @@
+import { createHash } from "node:crypto";
+import type { GmailInboxReceipt } from "../../../../../plugins/plugin-inbox/src/mailbox/types.ts";
+import {
+  CloudProtocolError,
+  type ManagedGoogleClient,
+} from "./managed-google-client.ts";
+export type AgentMailboxChange = {
+  messageId: string;
+  kind: "archive" | "trash" | "mark-read" | "mark-unread";
+  requestId: string;
+};
+/** Stable caller-turn identity reaches the durable provider ledger before a mutation.
+ * A lost response reads that receipt once; an uncertain state is never dispatched again. */
+export async function gmailAgentMailbox(
+  client: ManagedGoogleClient,
+  grantId: string,
+  scope: string,
+  input: AgentMailboxChange,
+  signal: AbortSignal,
+) {
+  const prefix = `alpha-gmail:${scope}:`,
+    providerId = input.messageId.slice(prefix.length);
+  if (
+    !input.messageId.startsWith(prefix) ||
+    !/^[A-Za-z0-9_-]{1,160}$/.test(providerId) ||
+    !["archive", "trash", "mark-read", "mark-unread"].includes(input.kind) ||
+    !/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(
+      input.requestId,
+    )
+  )
+    throw Error(
+      "Select an exact message from the current Gmail owner account.",
+    );
+  const outcome = (receipt: GmailInboxReceipt) => {
+    if (receipt.requestId !== input.requestId || receipt.kind !== input.kind)
+      throw Error("Mailbox receipt belongs to another operation.");
+    if (receipt.state !== "succeeded")
+      return {
+        requestId: input.requestId,
+        kind: input.kind,
+        messageId: input.messageId,
+        ok: false,
+      };
+    const result = receipt.providerResult,
+      labels = result?.labelIds;
+    if (
+      result?.messageId !== providerId ||
+      !Array.isArray(labels) ||
+      !labels.every((x) => typeof x === "string") ||
+      (input.kind === "archive" && labels.includes("INBOX")) ||
+      (input.kind === "trash" && !labels.includes("TRASH")) ||
+      (input.kind === "mark-read" &&
+        (labels.includes("UNREAD") || result.unread !== false)) ||
+      (input.kind === "mark-unread" &&
+        (!labels.includes("UNREAD") || result.unread !== true))
+    )
+      throw Error(
+        "Provider labels did not verify the requested mailbox change.",
+      );
+    return {
+      requestId: input.requestId,
+      kind: input.kind,
+      messageId: input.messageId,
+      ok: true,
+    };
+  };
+  let prior: GmailInboxReceipt | undefined;
+  try {
+    prior = await client.gmailOperation(grantId, input.requestId, signal);
+  } catch (error) {
+    if (
+      !(
+        error instanceof CloudProtocolError &&
+        error.code === "http" &&
+        error.status === 404 &&
+        error.data &&
+        typeof error.data === "object" &&
+        !Array.isArray(error.data) &&
+        (error.data as Record<string, unknown>).error === "Operation not found"
+      )
+    )
+      throw error;
+  }
+  if (prior) {
+    if (prior.kind !== input.kind)
+      throw Error("Mailbox request is bound to another operation.");
+    if (prior.state !== "prepared") return outcome(prior);
+  }
+  const selected = await client.gmailRead(grantId, providerId, signal);
+  if (!selected.historyId)
+    throw Error("The current Gmail message revision is unavailable.");
+  const proposal = {
+    kind: input.kind,
+    messageId: providerId,
+    expectedHistoryId: selected.historyId,
+  };
+  const prepared = await client.gmailPrepareOperation(
+      grantId,
+      input.requestId,
+      proposal,
+      signal,
+    ),
+    review = prepared.review;
+  if (
+    prepared.receipt.requestId !== input.requestId ||
+    prepared.receipt.kind !== input.kind ||
+    prepared.receipt.state !== "prepared" ||
+    review.kind !== input.kind ||
+    review.messageId !== providerId ||
+    review.expectedHistoryId !== selected.historyId ||
+    typeof review.from !== "string" ||
+    !review.from ||
+    prepared.receipt.reviewDigest !==
+      createHash("sha256").update(JSON.stringify(review)).digest("hex")
+  )
+    throw Error("The mailbox review changed. Nothing was dispatched.");
+  const grants = await client.gmailAccounts(signal);
+  if (
+    !grants.some(
+      (a) =>
+        a.connectionId === grantId &&
+        a.connected &&
+        a.grantedCapabilities.includes("google.gmail.mailbox"),
+    )
+  )
+    throw Error("Gmail mailbox permission changed before dispatch.");
+  signal.throwIfAborted();
+  try {
+    return outcome(
+      await client.gmailDispatchOperation(
+        grantId,
+        input.requestId,
+        prepared.receipt.reviewDigest,
+        proposal,
+        signal,
+      ),
+    );
+  } catch (error) {
+    signal.throwIfAborted();
+    try {
+      return outcome(
+        await client.gmailOperation(grantId, input.requestId, signal),
+      );
+    } catch {
+      throw error;
+    }
+  }
+}
