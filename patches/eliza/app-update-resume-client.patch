+
+export type AppUpdateSchedule = {
+  active: boolean;
+  disposed: boolean;
+  busy: boolean;
+  failures: number;
+  wakeAt: number;
+};
+
+/** Foreground upkeep. Native owns package admission, draft receipts and installation.
+ * A suspended/disposed owner cannot start a later effect after an awaited read.
+ * Never overlap a still-running native call, even across background/resume.
+ */
+export function createAppUpdateScheduler(options: {
+  run(current: () => boolean): Promise<void>;
+  now?: () => number;
+  schedule?: (callback: () => void, delay: number) => unknown;
+  cancel?: (timer: unknown) => void;
+  intervalMs?: number;
+  retryMs?: number;
+}) {
+  const now = options.now ?? (() => performance.now());
+  const schedule = options.schedule ?? ((callback, delay) => setTimeout(callback, delay));
+  const cancel = options.cancel ?? ((timer) => clearTimeout(timer as ReturnType<typeof setTimeout>));
+  const interval = options.intervalMs ?? 15 * 60 * 1000;
+  const retry = options.retryMs ?? 60 * 1000;
+  if (!Number.isSafeInteger(interval) || interval <= 0 || !Number.isSafeInteger(retry) || retry <= 0 || retry > interval)
+    throw Error("Invalid app update schedule");
+  let state: AppUpdateSchedule = {active: false, disposed: false, busy: false, failures: 0, wakeAt: 0};
+  let timer: unknown;
+  let generation = 0;
+  const clear = () => { if (timer !== undefined) cancel(timer); timer = undefined; };
+  const arm = () => {
+    clear();
+    if (!state.active || state.disposed || state.busy) return;
+    timer = schedule(() => { timer = undefined; void poll(); }, Math.max(0, state.wakeAt - now()));
+  };
+  async function poll() {
+    if (!state.active || state.disposed || state.busy) return;
+    if (now() < state.wakeAt) { arm(); return; }
+    clear();
+    state = {...state, busy: true};
+    const owner = generation;
+    const current = () => !state.disposed && state.active && owner === generation;
+    let failed = false;
+    try { await options.run(current); } catch { failed = true; }
+    const failures = failed ? Math.min(state.failures + 1, 20) : 0;
+    state = {...state, busy: false, failures,
+      wakeAt: owner !== generation ? now() : now() + (failed ? Math.min(interval, retry * 2 ** (failures - 1)) : interval)};
+    arm();
+  }
+  return {
+    snapshot: (): AppUpdateSchedule => ({...state}),
+    setActive(active: boolean) {
+      if (state.disposed) return;
+      if (state.active !== active) generation++;
+      state = {...state, active};
+      if (active) arm(); else clear();
+    },
+    dispose() {
+      generation++;
+      state = {...state, active: false, disposed: true};
+      clear();
+    },
+  };
